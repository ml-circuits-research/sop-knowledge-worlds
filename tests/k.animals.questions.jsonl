{"id":"an-07","ask":"what does a panda eat","query":{"type":"k.animals.animal","where":{"name":"panda"},"seek":"eats"},"expect":{"status":"supported","value":"bamboo"}}
{"id":"an-08","ask":"where does a camel live","query":{"type":"k.animals.animal","where":{"name":"camel"},"seek":"habitat"},"expect":{"status":"supported","value":"desert"}}
{"id":"an-09","ask":"which animal says quack","query":{"type":"k.animals.animal","where":{"sound":"quack"},"seek":"name"},"expect":{"status":"supported","value":"duck"}}
