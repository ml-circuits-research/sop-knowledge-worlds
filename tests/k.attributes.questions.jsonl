{"id":"at-01","ask":"what colour is grass","query":{"type":"k.attributes.thing","where":{"name":"grass"},"seek":"colour"},"expect":{"status":"supported","value":"green"}}
{"id":"at-02","ask":"what colours is a zebra","query":{"type":"k.attributes.thing","where":{"name":"zebra"},"seek":"colour","mode":"list"},"expect":{"status":"supported","values":["black","white"]}}
{"id":"at-03","ask":"how many wheels does a bicycle have","query":{"type":"k.attributes.thing","where":{"name":"bicycle"},"seek":"wheels"},"expect":{"status":"supported","value":"2"}}
{"id":"at-04","ask":"what is a window made of","query":{"type":"k.attributes.thing","where":{"name":"window"},"seek":"material"},"expect":{"status":"supported","value":"glass"}}
{"id":"at-05","ask":"what can a helicopter do","query":{"type":"k.attributes.thing","where":{"name":"helicopter"},"seek":"can","mode":"list"},"expect":{"status":"supported","values":["fly","move"]}}
{"id":"at-06","ask":"what is a ladder used for","query":{"type":"k.attributes.thing","where":{"name":"ladder"},"seek":"used_for"},"expect":{"status":"supported","value":"\"climbing\""}}
{"id":"at-07","ask":"which things are usually pink","query":{"type":"k.attributes.thing","where":{"colour":"pink"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["flamingo","pig","worm","blossom","\"cherry blossom\"","lotus"]}}
{"id":"at-08","ask":"where is the number of legs of an animal found","query":{"type":"k.attributes.found","where":{"attribute":"legs"},"seek":"type"},"expect":{"status":"supported","value":"k.animals.animal"}}
{"id":"at-09","ask":"which attributes does a vehicle usually have","query":{"type":"k.attributes.kind","where":{"name":"vehicle"},"seek":"attribute","mode":"list"},"expect":{"status":"supported","values":["colour","size","place","parts","material","wheels","can","used_for"]}}
{"id":"at-10","ask":"what kind of thing is a violin","query":{"type":"k.attributes.thing","where":{"name":"violin"},"seek":"kind"},"expect":{"status":"supported","value":"instrument"}}
{"id":"at-11","ask":"which aspect does colour belong to","query":{"type":"k.attributes.attribute","where":{"name":"colour"},"seek":"aspect"},"expect":{"status":"supported","value":"visual"}}
{"id":"at-12","ask":"which view shows the numeric aspect","query":{"type":"k.attributes.aspect","where":{"name":"numeric"},"seek":"shown_in"},"expect":{"status":"supported","value":"chart"}}
{"id":"at-13","ask":"which keys hold the geographic aspect of a city","query":{"type":"k.attributes.shows","where":{"family":"city","aspect":"geographic"},"seek":"key","mode":"list"},"expect":{"status":"supported","values":["lat","lon"]}}
{"id":"at-14","ask":"which aspects does a mountain show","query":{"type":"k.attributes.shows","where":{"family":"mountain"},"seek":"aspect","mode":"list"},"expect":{"status":"supported","values":["relational","numeric","geographic"]}}
{"id":"at-15","ask":"in which type is the numeric aspect of a country","query":{"type":"k.attributes.shows","where":{"family":"country","aspect":"numeric","key":"population"},"seek":"type"},"expect":{"status":"supported","value":"k.geo.country"}}
{"id":"at-16","ask":"what colour is a car","query":{"type":"k.attributes.thing","where":{"name":"car"},"seek":"colour"},"expect":{"status":"supported","value":"any"}}
{"id":"at-17","ask":"in which colour is the elephant drawn","query":{"type":"k.attributes.drawn","where":{"name":"elephant"},"seek":"drawn_colour"},"expect":{"status":"supported","value":"grey"}}
{"id":"at-18","ask":"which shades is the budgie drawn in","query":{"type":"k.attributes.drawn","where":{"name":"budgie"},"seek":"drawn_shade","mode":"list"},"expect":{"status":"supported","values":["lemon","lime"]}}
