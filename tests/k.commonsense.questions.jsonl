{"id":"cs-01","ask":"where does a fish live","query":{"type":"k.commonsense.thing","where":{"name":"fish"},"seek":"at"},"expect":{"status":"supported","value":"water"}}
{"id":"cs-02","ask":"where is a bird","query":{"type":"k.commonsense.thing","where":{"name":"bird"},"seek":"at"},"expect":{"status":"supported","values":["sky","tree"]}}
{"id":"cs-03","ask":"what can a bird do","query":{"type":"k.commonsense.thing","where":{"name":"bird"},"seek":"can"},"expect":{"status":"supported","values":["fly","sing"]}}
{"id":"cs-04","ask":"what is a boat used for","query":{"type":"k.commonsense.thing","where":{"name":"boat"},"seek":"used_for"},"expect":{"status":"supported","value":"travel"}}
{"id":"cs-05","ask":"what is a house made of","query":{"type":"k.commonsense.thing","where":{"name":"house"},"seek":"made_of"},"expect":{"status":"supported","values":["brick","wood"]}}
{"id":"cs-07","ask":"how many suns does a scene usually have","query":{"type":"k.commonsense.thing","where":{"name":"sun"},"seek":"usually_count"},"expect":{"status":"supported","value":"1"}}
{"id":"cs-08","ask":"can a plane fly","query":{"type":"k.commonsense.thing","where":{"name":"plane","can":"fly"},"seek":"can","mode":"check"},"expect":{"status":"supported","value":"yes"}}
{"id":"cs-09","ask":"which things are usually in the sky","query":{"type":"k.commonsense.thing","where":{"at":"sky"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["bird","sun","moon","cloud","plane","star"]}}
{"id":"cs-10","ask":"how many things does the world know","query":{"type":"k.commonsense.thing","mode":"count"},"expect":{"status":"supported","value":"15"}}
{"id":"cs-11","ask":"a fish in the sky","tell":"@p1 k.commonsense.placed thing=fish at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":["A fish is usually in water, not in the sky.","A fish cannot fly, so it is not usually in the sky."]}}
{"id":"cs-12","ask":"a fish on the grass","tell":"@p1 k.commonsense.placed thing=fish at=grass scene=s1","ns":"scene","expect":{"ok":true,"issues":["A fish is usually in water, not on the grass."]}}
{"id":"cs-13","ask":"a boat on the grass","tell":"@p1 k.commonsense.placed thing=boat at=grass scene=s1","ns":"scene","expect":{"ok":true,"issues":["A boat is usually in water, not on the grass."]}}
{"id":"cs-14","ask":"a car in the sky","tell":"@p1 k.commonsense.placed thing=car at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":["A car cannot fly, so it is not usually in the sky."]}}
{"id":"cs-15","ask":"a bird, a plane, a cloud and the sun in the sky","tell":"@p1 k.commonsense.placed thing=bird at=sky scene=s1 @p2 k.commonsense.placed thing=plane at=sky scene=s1 @p3 k.commonsense.placed thing=cloud at=sky scene=s1 @p4 k.commonsense.placed thing=sun at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":[]}}
{"id":"cs-16","ask":"two suns in one scene","tell":"@p1 k.commonsense.placed thing=sun at=sky scene=s1 @p2 k.commonsense.placed thing=sun at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":["A scene usually has only 1 sun, not 2."]}}
{"id":"cs-17","ask":"one sun in each of two scenes","tell":"@p1 k.commonsense.placed thing=sun at=sky scene=s1 @p2 k.commonsense.placed thing=sun at=sky scene=s2","ns":"scene","expect":{"ok":true,"issues":[]}}
{"id":"cs-18","ask":"a fish in the water","tell":"@p1 k.commonsense.placed thing=fish at=water scene=s1","ns":"scene","expect":{"ok":true,"issues":[]}}
{"id":"cs-19","ask":"a dog in the sky","tell":"@p1 k.commonsense.placed thing=dog at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":["A dog cannot fly, so it is not usually in the sky."]}}
{"id":"cs-20","ask":"a thing the world does not know, in the sky","tell":"@p1 k.commonsense.placed thing=unicorn at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":[]}}
