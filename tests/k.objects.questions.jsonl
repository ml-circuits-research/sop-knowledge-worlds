{"id":"ob-01","ask":"what are the parts of a house","query":{"type":"k.objects.part","where":{"of":"house"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["body","roof","chimney","door","left_window","right_window"]}}
{"id":"ob-02","ask":"where is the roof of a house","query":{"type":"k.objects.part","where":{"of":"house","name":"roof"},"seek":"above"},"expect":{"status":"supported","value":"body"}}
{"id":"ob-03","ask":"what colour is a tree's crown","query":{"type":"k.objects.part","where":{"of":"tree","name":"crown"},"seek":"colour"},"expect":{"status":"supported","value":"green"}}
{"id":"ob-04","ask":"how many windows does a house have","query":{"type":"k.objects.part","where":{"of":"house","kind":"window"},"mode":"count"},"expect":{"status":"supported","value":"2"}}
{"id":"ob-05","ask":"where is the chimney of a house","query":{"type":"k.objects.part","where":{"of":"house","name":"chimney"},"seek":"on"},"expect":{"status":"supported","value":"roof"}}
{"id":"ob-06","ask":"where is the door of a house","query":{"type":"k.objects.part","where":{"of":"house","name":"door"},"seek":"inside"},"expect":{"status":"supported","value":"body"}}
{"id":"ob-07","ask":"is the door of a house centred","query":{"type":"k.objects.part","where":{"of":"house","name":"door"},"seek":"centered"},"expect":{"status":"supported","value":"true"}}
{"id":"ob-08","ask":"what shape is the roof of a house","query":{"type":"k.objects.part","where":{"of":"house","name":"roof"},"seek":"shape"},"expect":{"status":"supported","value":"triangle"}}
{"id":"ob-09","ask":"how many wheels does a bicycle have","query":{"type":"k.objects.part","where":{"of":"bicycle","kind":"wheel"},"mode":"count"},"expect":{"status":"supported","value":"2"}}
{"id":"ob-10","ask":"what colours can a cat be","query":{"type":"k.objects.part","where":{"of":"cat","name":"body"},"seek":"colour"},"expect":{"status":"supported","values":["grey","black","orange"]}}
{"id":"ob-13","ask":"where does a fish live (common sense comes with k.objects)","query":{"type":"k.commonsense.thing","where":{"name":"fish"},"seek":"at"},"expect":{"status":"supported","value":"water"}}
{"id":"ob-14","ask":"a fish in the sky, in a world that composes k.objects","tell":"@p1 k.commonsense.placed thing=fish at=sky scene=s1","ns":"scene","expect":{"ok":true,"issues":["A fish is usually in water, not in the sky.","A fish cannot fly, so it is not usually in the sky."]}}
{"id":"ob-r4-1","ask":"how many bars does a jail have","query":{"type":"k.objects.part","where":{"of":"jail","kind":"bar"},"mode":"count"},"expect":{"status":"supported","value":"6"}}
{"id":"ob-r4-2","ask":"what is above the body of a restaurant","query":{"type":"k.objects.part","where":{"of":"restaurant","above":"body"},"seek":"name"},"expect":{"status":"supported","value":"awning"}}
{"id":"ob-r4-3","ask":"what colour is the blade of a sword","query":{"type":"k.objects.part","where":{"of":"sword","name":"blade"},"seek":"colour","mode":"list"},"expect":{"status":"supported","values":["grey","white"]}}
