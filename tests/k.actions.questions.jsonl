{"id":"ac-03","ask":"what does enlarge change","query":{"type":"k.actions.verb","where":{"text":"enlarge"},"seek":"attribute"},"expect":{"status":"supported","value":"size"}}
{"id":"ac-04","ask":"which way does shrink change the size","query":{"type":"k.actions.verb","where":{"text":"shrink"},"seek":"value"},"expect":{"status":"supported","value":"smaller"}}
{"id":"ac-05","ask":"after replace, what does with mark","query":{"type":"k.actions.marking","where":{"verb":"replace","marker":"with"},"seek":"role"},"expect":{"status":"supported","value":"replacement"}}
{"id":"ac-06","ask":"what is the opposite of make","query":{"type":"k.actions.act","where":{"name":"make"},"seek":"opposite"},"expect":{"status":"supported","value":"remove"}}
{"id":"ac-07","ask":"which roles does the act remove take","query":{"type":"k.actions.act","where":{"name":"remove"},"seek":"role","mode":"list"},"expect":{"status":"supported","values":["thing","source"]}}
