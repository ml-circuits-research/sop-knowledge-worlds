{"id":"un-01","ask":"how many metres is a kilometre","query":{"type":"k.units.unit","where":{"name":"kilometre"},"seek":"factor"},"expect":{"status":"supported","value":"1000"}}
{"id":"un-02","ask":"what does a pound measure","query":{"type":"k.units.unit","where":{"name":"pound"},"seek":"quantity"},"expect":{"status":"supported","value":"mass"}}
{"id":"un-03","ask":"what is the symbol of the litre","query":{"type":"k.units.unit","where":{"name":"litre"},"seek":"symbol"},"expect":{"status":"supported","value":"l"}}
{"id":"un-04","ask":"which units measure length","query":{"type":"k.units.unit","where":{"quantity":"length"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["millimetre","centimetre","decimetre","metre","kilometre","inch","foot","yard","mile","\"light year\""]}}
{"id":"un-05","ask":"what is the base unit of mass","query":{"type":"k.units.quantity","where":{"name":"mass"},"seek":"base"},"expect":{"status":"supported","value":"kilogram"}}
{"id":"un-06","ask":"what is added to degrees Celsius to get kelvin","query":{"type":"k.units.unit","where":{"name":"\"degree Celsius\""},"seek":"offset"},"expect":{"status":"supported","value":"273.15"}}
{"id":"un-07","ask":"how many seconds is an hour","query":{"type":"k.units.unit","where":{"name":"hour"},"seek":"factor"},"expect":{"status":"supported","value":"3600"}}
{"id":"un-08","ask":"which unit has the symbol kg","query":{"type":"k.units.unit","where":{"symbol":"kg"},"seek":"name"},"expect":{"status":"supported","value":"kilogram"}}
{"id":"un-09","ask":"how many imperial units are there","query":{"type":"k.units.unit","where":{"system":"imperial"},"mode":"count"},"expect":{"status":"supported","value":"11"}}
{"id":"un-10","ask":"an inch is 2.54 centimetres: its factor to the metre","query":{"type":"k.units.unit","where":{"name":"inch"},"seek":"factor"},"expect":{"status":"supported","value":"0.0254"}}
{"id":"un-11","ask":"an application's own unit is accepted","tell":"@u1 k.units.unit name=smoot quantity=length factor=1.7018 system=other","ns":"app","expect":{"issues":[]}}
{"id":"un-12","ask":"in which unit is the height of a mountain given","query":{"type":"k.units.measure","where":{"world":"k.geo","type":"mountain","key":"elevation"},"seek":"unit"},"expect":{"status":"supported","value":"metre"}}
{"id":"un-13","ask":"what does the population of a country count","query":{"type":"k.units.measure","where":{"world":"k.geo","type":"country","key":"population"},"seek":"counts"},"expect":{"status":"supported","value":"person"}}
{"id":"un-14","ask":"in which unit is the distance of a star given","query":{"type":"k.units.measure","where":{"world":"k.space","type":"body","key":"light_years_about"},"seek":"unit"},"expect":{"status":"supported","value":"\"light year\""}}
{"id":"un-c1","ask":"what is the symbol of the US dollar","query":{"type":"k.units.currency","where":{"code":"USD"},"seek":"symbol"},"expect":{"status":"supported","value":"\"$\""}}
{"id":"un-c2","ask":"which currency has the sign €","query":{"type":"k.units.currency","where":{"symbol":"€"},"seek":"code"},"expect":{"status":"supported","value":"EUR"}}
{"id":"un-c3","ask":"which currencies are counted in lei","query":{"type":"k.units.currency","where":{"unit_plural":"lei"},"seek":"code","mode":"list"},"expect":{"status":"supported","values":["MDL","RON"]}}
{"id":"un-c4","ask":"what are a hundredth of a pound called","query":{"type":"k.units.currency","where":{"code":"GBP"},"seek":"minor_plural"},"expect":{"status":"supported","value":"pence"}}
{"id":"un-c5","ask":"what money do they use in Japan","query":{"type":"k.units.currency","where":{"country":"Japan"},"seek":"name"},"expect":{"status":"supported","value":"\"Japanese yen\""}}
{"id":"un-c6","ask":"how many decimals has the yen","query":{"type":"k.units.currency","where":{"code":"JPY"},"seek":"decimals"},"expect":{"status":"supported","value":"0"}}
{"id":"un-c7","ask":"what is the currency of France","query":{"type":"k.units.currency","where":{"country":"France"},"seek":"name"},"expect":{"status":"supported","value":"euro"}}
{"id":"un-t1","ask":"how many seconds is a century","query":{"type":"k.units.unit","where":{"name":"century"},"seek":"factor"},"expect":{"status":"supported","value":"3155760000"}}
{"id":"un-t2","ask":"what does a month measure","query":{"type":"k.units.unit","where":{"name":"month"},"seek":"quantity"},"expect":{"status":"supported","value":"time"}}
{"id":"un-t3","ask":"how long is a decade in seconds","query":{"type":"k.units.unit","where":{"name":"decade"},"seek":"factor"},"expect":{"status":"supported","value":"315576000"}}
