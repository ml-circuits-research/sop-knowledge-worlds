{"id":"la-01","ask":"which places does a landscape have","query":{"type":"k.layouts.slot","where":{"layout":"landscape"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["sky","far","ground","water","foreground"]}}
{"id":"la-02","ask":"what goes in the sky of a landscape","query":{"type":"k.layouts.slot","where":{"layout":"landscape","name":"sky"},"seek":"holds","mode":"list"},"expect":{"status":"supported","values":["sun","moon","cloud","star","bird","rainbow","plane"]}}
{"id":"la-03","ask":"what is the sky above in a landscape","query":{"type":"k.layouts.relation","where":{"layout":"landscape","a":"sky","rel":"above"},"seek":"b","mode":"list"},"expect":{"status":"supported","values":["ground","far"]}}
{"id":"la-04","ask":"where does the water of a landscape lie","query":{"type":"k.layouts.relation","where":{"layout":"landscape","a":"water","rel":"inside"},"seek":"b"},"expect":{"status":"supported","value":"ground"}}
{"id":"la-05","ask":"how do the things of a row sit to each other","query":{"type":"k.layouts.relation","where":{"layout":"row","among":"neighbours"},"seek":"rel","mode":"list"},"expect":{"status":"supported","values":["left_of","evenly_spaced"]}}
{"id":"la-06","ask":"is a flow ordered","query":{"type":"k.layouts.layout","where":{"name":"flow"},"seek":"ordered"},"expect":{"status":"supported","value":"true"}}
{"id":"la-07","ask":"how are the rows of a grid arranged","query":{"type":"k.layouts.slot","where":{"layout":"grid","name":"row"},"seek":"arranged"},"expect":{"status":"supported","value":"row"}}
{"id":"la-08","ask":"what is above the eyes in a face","query":{"type":"k.layouts.relation","where":{"layout":"face","rel":"above","b":"eyes"},"seek":"a","mode":"list"},"expect":{"status":"supported","values":["eyebrows","hat"]}}
{"id":"la-09","ask":"which places of a face come in pairs","query":{"type":"k.layouts.slot","where":{"layout":"face","pair":"true"},"seek":"name","mode":"list"},"expect":{"status":"supported","values":["ears","cheeks","eyes","eyebrows","earrings"]}}
{"id":"la-10","ask":"where does a person sit on a chair","query":{"type":"k.layouts.anchor","where":{"of":"chair","kind":"seat"},"seek":"y"},"expect":{"status":"supported","value":"55"}}
{"id":"la-11","ask":"what goes on top of a person's head","query":{"type":"k.layouts.anchor","where":{"of":"person","name":"head_top"},"seek":"holds","mode":"list"},"expect":{"status":"supported","values":["hat","cap","crown","helmet"]}}
{"id":"la-12","ask":"which things have a water surface","query":{"type":"k.layouts.anchor","where":{"kind":"water"},"seek":"of","mode":"list"},"expect":{"status":"supported","values":["pond","pool","lake","\"mountain lake\"","river","sea","swamp","bridge"]}}
{"id":"la-13","ask":"what does a hat sit on","query":{"type":"k.layouts.joins","where":{"a":"hat","rel":"sits_on"},"seek":"b"},"expect":{"status":"supported","value":"head"}}
{"id":"la-14","ask":"on which side of a wall does a roof attach","query":{"type":"k.layouts.joins","where":{"a":"roof","rel":"attaches_to","b":"wall"},"seek":"side"},"expect":{"status":"supported","value":"top"}}
{"id":"la-15","ask":"what is a wheel part of","query":{"type":"k.layouts.joins","where":{"a":"wheel","rel":"part_of"},"seek":"b","mode":"list"},"expect":{"status":"supported","values":["car","bicycle","truck","train","wagon"]}}
{"id":"la-16","ask":"what does an arrow connect","query":{"type":"k.layouts.joins","where":{"a":"arrow","rel":"connects"},"seek":"b"},"expect":{"status":"supported","value":"box"}}
{"id":"la-17","ask":"what is worn on the neck","query":{"type":"k.layouts.joins","where":{"rel":"worn_on","b":"neck"},"seek":"a","mode":"list"},"expect":{"status":"supported","values":["necklace","scarf","tie","collar"]}}
{"id":"la-18","ask":"what is a stack usual for","query":{"type":"k.layouts.layout","where":{"name":"stack"},"seek":"usual_for","mode":"list"},"expect":{"status":"supported","values":["\"books\"","\"plates\"","\"boxes\"","\"the blocks of a tower\"","\"pancakes\"","\"coins\""]}}
{"id":"la-19","ask":"where does a child sit on a swing","query":{"type":"k.layouts.anchor","where":{"of":"swing","kind":"seat"},"seek":"y"},"expect":{"status":"supported","value":"61"}}
{"id":"la-20","ask":"what can be put on a bed","query":{"type":"k.layouts.anchor","where":{"of":"bed","name":"top"},"seek":"holds","mode":"list"},"expect":{"status":"supported","values":["person","cat","\"teddy bear\"","blanket"]}}
{"id":"la-21","ask":"what hangs from the branch of a tree","query":{"type":"k.layouts.anchor","where":{"of":"tree","kind":"hook"},"seek":"holds","mode":"list"},"expect":{"status":"supported","values":["swing","rope","tyre"]}}
{"id":"la-22","ask":"what does a sitting person sit on","query":{"type":"k.layouts.anchor","where":{"of":"person","name":"hips"},"seek":"on","mode":"list"},"expect":{"status":"supported","values":["chair","bench","swing","horse","bicycle","sofa","stool"]}}
{"id":"la-23","ask":"which things have a seat","query":{"type":"k.layouts.anchor","where":{"kind":"seat"},"seek":"of","mode":"count"},"expect":{"status":"supported","value":"22"}}
{"id":"la-p1","ask":"what stands around a table","query":{"type":"k.layouts.joins","where":{"rel":"around","b":"table"},"seek":"a","mode":"list"},"expect":{"status":"supported","values":["chair","stool","plate","person","cup"]}}
