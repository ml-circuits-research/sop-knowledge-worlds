{"id":"bd-18","ask":"about how many muscles does a person have","query":{"type":"k.body.part","where":{"name":"muscle"},"seek":"count_about"},"expect":{"status":"supported","value":"600"}}
{"id":"bd-19","ask":"what does the pupil do","query":{"type":"k.body.part","where":{"name":"pupil"},"seek":"does"},"expect":{"status":"supported","value":"\"lets light into the eye\""}}
