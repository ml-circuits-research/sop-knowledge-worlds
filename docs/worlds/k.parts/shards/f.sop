# k.parts/shards/f: the usual parts of 23 common things whose name starts with "f" (factory, farmhouse, faucet, feather, fern, fiddle ...): the parts WordNet gives the thing, and the parts it gives what the thing is a kind of.
# sources: wordnet 3.1 (Princeton WordNet 3.1: part meronyms, hypernyms, glosses); which words are common things: tools/coverage.mjs (frequency-words 2018, wordnet 3.1)
# license: WordNet-3.0
# script: tools/import/parts.mjs

@k.parts.whole.factory k.parts.whole name=factory gloss="a plant consisting of one or more buildings with facilities for manufacturing" has="production line" has="shop floor" core.source="wordnet 3.1"
@k.parts.inherited.farmhouse.house k.parts.inherited name=farmhouse from=house steps=1 has=library has=loft has=porch has=study core.source="wordnet 3.1"
@k.parts.inherited.farmhouse.dwelling k.parts.inherited name=farmhouse from=dwelling steps=2 has=bathroom has=bedroom has=den has=dinette has="dining room" has="dressing room" has="family room" has=kitchen has="living room" core.source="wordnet 3.1"
@k.parts.whole.faucet k.parts.whole name=faucet gloss="a regulator for controlling the flow of a liquid from a reservoir" has=handle core.source="wordnet 3.1"
@k.parts.whole.feather k.parts.whole name=feather gloss="the light horny waterproof structure forming the external covering of birds" has=vane has=quill core.source="wordnet 3.1"
@k.parts.whole.fern k.parts.whole name=fern gloss="any of numerous flowerless and seedless vascular plants having true roots from a rhizome and fronds that uncurl upward; reproduce by spores" has="fern seed" core.source="wordnet 3.1"
@k.parts.whole.fiddle k.parts.whole name=fiddle gloss="bowed stringed instrument that is the highest member of the violin family; this instrument has four strings and a hollow body and an unfretted fingerboard and is played with a bow" has="chin rest" has=fiddlestick core.source="wordnet 3.1"
@k.parts.inherited.fiddle.bowed_stringed_instrument k.parts.inherited name=fiddle from="bowed stringed instrument" steps=1 has=fingerboard core.source="wordnet 3.1"
@k.parts.inherited.fiddle.stringed_instrument k.parts.inherited name=fiddle from="stringed instrument" steps=2 has=bridge has=peg has="sounding board" core.source="wordnet 3.1"
@k.parts.whole.fireplace k.parts.whole name=fireplace gloss="an open recess in a wall at the base of a chimney where a fire can be built" has="fire iron" has=hearth has=hearthstone has=mantel has="water back" core.source="wordnet 3.1"
@k.parts.whole.fish k.parts.whole name=fish gloss="any of various mostly cold-blooded aquatic vertebrates usually having scales and breathing through gills" has="fish scale" has=roe has=milt has="lateral line" has=fin has="tail fin" has=fishbone core.source="wordnet 3.1"
@k.parts.whole.flashlight k.parts.whole name=flashlight gloss="a small portable battery-powered electric lamp" has="flashlight battery" core.source="wordnet 3.1"
