@k.parts.inherited.dollhouse.dwelling k.parts.inherited name=dollhouse from=dwelling steps=2 has=bathroom has=bedroom has=den has=dinette has="dining room" has="dressing room" has="family room" has=kitchen has="living room" plain=room core.source="wordnet 3.1"
@k.parts.whole.door k.parts.whole name=door gloss="a swinging or sliding barrier that will close the entrance to a room or building or vehicle" has=lock core.source="wordnet 3.1"
@k.parts.whole.drawer k.parts.whole name=drawer gloss="a boxlike container in a piece of furniture; made so as to slide in and out" has=lock core.source="wordnet 3.1"
@k.parts.whole.dredge k.parts.whole name=dredge gloss="a power shovel to remove material from a channel or riverbed" has="dredging bucket" has=scoop plain=bucket core.source="wordnet 3.1"
@k.parts.whole.dresser k.parts.whole name=dresser gloss="furniture with drawers for keeping clothes" has=drawer has=shelf core.source="wordnet 3.1"
@k.parts.whole.driveway k.parts.whole name=driveway gloss="a road leading up to a private house" has=turnaround core.source="wordnet 3.1"
