# script: tools/import/parts.mjs

@k.parts.whole.dagger k.parts.whole name=dagger gloss="a short knife with a pointed blade used for piercing or stabbing" has=haft has=hilt core.source="wordnet 3.1"
@k.parts.inherited.dagger.knife k.parts.inherited name=dagger from=knife steps=1 has=point core.source="wordnet 3.1"
