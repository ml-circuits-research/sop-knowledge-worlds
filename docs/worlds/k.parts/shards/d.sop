@k.parts.whole.dinghy k.parts.whole name=dinghy gloss="a small boat of shallow draft with cross thwarts for seats and rowlocks for oars with which it is propelled" has=peg has=thwart core.source="wordnet 3.1"
@k.parts.inherited.dipper.ladle k.parts.inherited name=dipper from=ladle steps=1 has=handle core.source="wordnet 3.1"
@k.parts.inherited.dipper.vessel k.parts.inherited name=dipper from=vessel steps=2 has=base has=brim core.source="wordnet 3.1"
@k.parts.whole.disc k.parts.whole name=disc gloss="sound recording consisting of a disk with a continuous groove; used to reproduce music by rotating while a phonograph needle tracks in the groove" has="acetate disk" plain=disk core.source="wordnet 3.1"
@k.parts.whole.dog k.parts.whole name=dog gloss="a member of the genus Canis (probably descended from the common wolf) that has been domesticated by man since prehistoric times; occurs in many breeds" has=flag core.source="wordnet 3.1"
@k.parts.inherited.dog.canine k.parts.inherited name=dog from=canine steps=1 has=paw core.source="wordnet 3.1"
