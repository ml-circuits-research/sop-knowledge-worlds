# k.parts/shards/n: the usual parts of 4 common things whose name starts with "n" (nautilus, necklace, nightgown, nut ...): the parts WordNet gives the thing, and the parts it gives what the thing is a kind of.
# sources: wordnet 3.1 (Princeton WordNet 3.1: part meronyms, hypernyms, glosses); which words are common things: tools/coverage.mjs (frequency-words 2018, wordnet 3.1)
# license: WordNet-3.0
# script: tools/import/parts.mjs

@k.parts.inherited.nautilus.submarine k.parts.inherited name=nautilus from=submarine steps=1 has="conning tower" has="escape hatch" has=periscope has=snorkel has=sonar core.source="wordnet 3.1"
@k.parts.whole.necklace k.parts.whole name=necklace gloss="jewelry consisting of a cord or chain (often bearing gems) worn about the neck as an ornament (especially by women)" has=pendant core.source="wordnet 3.1"
@k.parts.whole.nightgown k.parts.whole name=nightgown gloss="lingerie consisting of a loose dress designed to be worn in bed by women" has=nightcap core.source="wordnet 3.1"
@k.parts.inherited.nut.seed k.parts.inherited name=nut from=seed steps=1 has=kernel core.source="wordnet 3.1"
