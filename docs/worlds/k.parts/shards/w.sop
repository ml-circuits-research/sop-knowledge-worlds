# script: tools/import/parts.mjs

@k.parts.whole.wagon k.parts.whole name=wagon gloss="any of various kinds of wheeled vehicles drawn by an animal or a tractor" has=axletree has="wagon wheel" core.source="wordnet 3.1"
@k.parts.inherited.wagon.wheeled_vehicle k.parts.inherited name=wagon from="wheeled vehicle" steps=1 has=axle has=brake has=splasher has=wheel core.source="wordnet 3.1"
