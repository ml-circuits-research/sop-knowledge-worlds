# k.people: kinds of person (baby, child, man, grandmother ...) as variants of one person drawing, and (from R7.5)
# roles and jobs: what they wear, hold and use, where they work, and the features that map to k.faces.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.people core.module name=k.people version=1 exports=kind exports=role core.source="hand-core 1"

# A kind of person by age and sex. All kinds are drawn by the one person drawing of k.objects (`drawing`), varied by
# what the fact says: `age` (baby, child, adult, old), `sex` where the word says it, `height_about`: the usual
# height in per cent of the height of a grown man (an approximate number, so the key ends in `_about`), `hair`:
# what the hair is usually like (`little`, `short`, `long`, `grey`, `white`; many), and `face`: the name of the
# k.faces preset (style `plain`) that shows such a face. `is_a` names the wider kind (a boy is a child, a
# grandfather is a man). Other names for the kind (kid, grandpa, lady) are core.word facts.
@k.people.kind core.type of=k.people.kind shared=true closed=true core.source="hand-core 1"
@k.people.kind.name core.slot of=k.people.kind key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.people.kind.age core.slot of=k.people.kind key=age required=true enum=baby enum=child enum=adult enum=old core.source="hand-core 1"
@k.people.kind.sex core.slot of=k.people.kind key=sex enum=male enum=female core.source="hand-core 1"
@k.people.kind.height_about core.slot of=k.people.kind key=height_about required=true kind=integer min=1 max=120 core.source="hand-core 1"
@k.people.kind.hair core.slot of=k.people.kind key=hair many=true kind=atom kind=string core.source="hand-core 1"
@k.people.kind.face core.slot of=k.people.kind key=face kind=atom kind=string core.source="hand-core 1"
@k.people.kind.is_a core.slot of=k.people.kind key=is_a many=true kind=atom kind=string core.source="hand-core 1"
@k.people.kind.drawing core.slot of=k.people.kind key=drawing required=true kind=atom kind=string core.source="hand-core 1"

# Words for the types and keys of this world.
@k.people.word.kind core.word text=person text=people text=persons means=k.people.kind core.source="hand-core 1"
@k.people.word.age core.word text=age text=old means=k.people.kind.age core.source="hand-core 1"
@k.people.word.height core.word text=height text=tall means=k.people.kind.height_about core.source="hand-core 1"
@k.people.word.hair core.word text=hair means=k.people.kind.hair core.source="hand-core 1"
@k.people.word.face core.word text=face means=k.people.kind.face core.source="hand-core 1"
