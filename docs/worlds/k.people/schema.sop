@k.people.word.key.role.glasses core.word text=glasses means=k.people.role.glasses core.source="hand-core 1"
@k.people.word.key.role.beard core.word text=beard means=k.people.role.beard core.source="hand-core 1"
@k.people.word.key.role.moustache core.word text=moustache means=k.people.role.moustache core.source="hand-core 1"
