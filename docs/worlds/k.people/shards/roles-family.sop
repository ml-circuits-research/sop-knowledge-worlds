@k.people.role.mother k.people.role name=mother group=family is=woman is_a=relative does="look after the children" face=woman drawing=person core.source="hand-core 1"
@k.people.role.father k.people.role name=father group=family is=man is_a=relative does="look after the children" face=man drawing=person core.source="hand-core 1"
@k.people.role.grandmother k.people.role name=grandmother group=family is=grandmother is_a=relative wears=glasses holds=yarn uses="rocking chair" uses="walking stick" does="tell stories" does=knit does=bake glasses="small round" face="old woman" drawing=person core.source="hand-core 1"
@k.people.role.grandfather k.people.role name=grandfather group=family is=grandfather is_a=relative wears=glasses holds="walking stick" uses=armchair uses=newspaper does="tell stories" does="read the newspaper" moustache=walrus face="old man" drawing=person core.source="hand-core 1"
@k.people.role.sister k.people.role name=sister group=family is=girl is_a=relative does=play face=girl drawing=person core.source="hand-core 1"
@k.people.role.brother k.people.role name=brother group=family is=boy is_a=relative does=play face=boy drawing=person core.source="hand-core 1"
@k.people.role.aunt k.people.role name=aunt group=family is=woman is_a=relative does=visit face=woman drawing=person core.source="hand-core 1"
@k.people.role.uncle k.people.role name=uncle group=family is=man is_a=relative does=visit face="bearded man" drawing=person core.source="hand-core 1"

