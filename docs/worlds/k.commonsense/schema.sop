# k.commonsense: everyday common sense: where things usually are, what they can do, what they are used for and made
# of, and how many of them a scene usually has. Soft rules give advice, never refusals.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.commonsense core.module name=k.commonsense version=4 imports=k.kinds imports=k.animals imports=k.food exports=thing exports=placed exports=lives core.source="hand-core 1"

# A thing of everyday life, named by an English lemma. Shared: it belongs to every namespace, so an application's
# facts in its own namespace join with it.
@k.commonsense.thing core.type of=k.commonsense.thing extends=k.kinds.kind shared=true closed=true core.source="hand-core 1"
@k.commonsense.thing.at core.slot of=k.commonsense.thing key=at many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.can core.slot of=k.commonsense.thing key=can many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.used_for core.slot of=k.commonsense.thing key=used_for many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.made_of core.slot of=k.commonsense.thing key=made_of many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.part_of core.slot of=k.commonsense.thing key=part_of many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.has core.slot of=k.commonsense.thing key=has many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.cannot core.slot of=k.commonsense.thing key=cannot many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.thing.usually_count core.slot of=k.commonsense.thing key=usually_count kind=integer min=1 core.source="hand-core 1"

# A thing placed somewhere in a scene, as an application tells it (it may extend this type with its own).
@k.commonsense.placed core.type of=k.commonsense.placed core.source="hand-core 1"
@k.commonsense.placed.thing core.slot of=k.commonsense.placed key=thing required=true kind=atom core.source="hand-core 1"
@k.commonsense.placed.at core.slot of=k.commonsense.placed key=at kind=atom core.source="hand-core 1"
@k.commonsense.placed.scene core.slot of=k.commonsense.placed key=scene kind=atom core.source="hand-core 1"
# `on`: the placed thing of the same scene that carries it (a cat on a boat); `in`: what holds it (milk in a cup).
@k.commonsense.placed.on core.slot of=k.commonsense.placed key=on kind=atom core.source="hand-core 1"
@k.commonsense.placed.in core.slot of=k.commonsense.placed key=in kind=atom core.source="hand-core 1"

# Soft rule: a thing that is usually in water and cannot fly, placed in the sky (a duck lives on a pond and flies).
@k.commonsense.water.sky.thing k.commonsense.thing name=?thing at=water
@k.commonsense.water.sky.placed k.commonsense.placed thing=?thing at=?place
@k.commonsense.water.sky.is core.check fn=eq args=?place args=sky
@k.commonsense.water.sky.flies k.commonsense.thing name=?thing can=fly
@k.commonsense.water.sky core.deny when=$k.commonsense.water.sky.thing when=$k.commonsense.water.sky.placed not=$k.commonsense.water.sky.flies if=$k.commonsense.water.sky.is soft=true why="A ?thing is usually in water, not in the ?place." core.source="hand-core 1"

# Soft rule: a thing that is usually in water and not on land, placed on grass.
@k.commonsense.water.grass.thing k.commonsense.thing name=?thing at=water
@k.commonsense.water.grass.placed k.commonsense.placed thing=?thing at=?place
@k.commonsense.water.grass.is core.check fn=eq args=?place args=grass
@k.commonsense.water.grass.land k.commonsense.thing name=?thing at=ground
@k.commonsense.water.grass core.deny when=$k.commonsense.water.grass.thing when=$k.commonsense.water.grass.placed not=$k.commonsense.water.grass.land if=$k.commonsense.water.grass.is soft=true why="A ?thing is usually in water, not on the ?place." core.source="hand-core 1"

# Soft rule: a thing that cannot fly and is not usually in the sky, placed in the sky on nothing that carries it.
@k.commonsense.nofly.thing k.commonsense.thing name=?thing
@k.commonsense.nofly.placed k.commonsense.placed thing=?thing at=sky core.absent=on
@k.commonsense.nofly.flies k.commonsense.thing name=?thing can=fly
@k.commonsense.nofly.sky k.commonsense.thing name=?thing at=sky
@k.commonsense.nofly core.deny when=$k.commonsense.nofly.thing when=$k.commonsense.nofly.placed not=$k.commonsense.nofly.flies not=$k.commonsense.nofly.sky soft=true why="A ?thing cannot fly, so it is not usually in the sky." core.source="hand-core 1"

# Soft rule: more of a thing in one scene than it usually has (one issue per scene and thing).
@k.commonsense.count.thing k.commonsense.thing name=?thing usually_count=?usual
@k.commonsense.count.first k.commonsense.placed thing=?thing scene=?scene core.select=first
@k.commonsense.count.all k.commonsense.placed thing=?thing scene=?scene
@k.commonsense.count.n core.calc out=?n fn=count over=$k.commonsense.count.all
@k.commonsense.count.more core.check fn=gt args=?n args=?usual
@k.commonsense.count core.deny when=$k.commonsense.count.thing when=$k.commonsense.count.first with=$k.commonsense.count.n if=$k.commonsense.count.more soft=true why="A scene usually has only ?usual ?thing, not ?n." core.source="hand-core 1"

# Rules about kinds (Round 11 item 4): they make facts from facts, so a host that loads k.animals or k.food with
# this world gets common sense about every animal and every drink without one fact written for each. What they
# cannot say and needs a function (positions as numbers, the size of a container against an amount) is left to
# the library.

# Rule: what an animal lives in is where it usually is (`k.animals.animal habitat=sea` gives
# `k.commonsense.thing at=sea`), and a habitat that `k.commonsense.lives` names gives the place word as well
# (`sea` is `water`; a pond is `water` and `ground`, its shore), so the soft rules above about water and the sky
# apply to every animal.
@k.commonsense.lives core.type of=k.commonsense.lives closed=true core.source="hand-core 1"
@k.commonsense.lives.in core.slot of=k.commonsense.lives key=in id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.lives.at core.slot of=k.commonsense.lives key=at required=true many=true kind=atom kind=string core.source="hand-core 1"
@k.commonsense.habitat.animal k.animals.animal name=?thing habitat=?habitat
@k.commonsense.habitat.at k.commonsense.thing name=?thing at=?habitat
@k.commonsense.habitat core.rule when=$k.commonsense.habitat.animal then=$k.commonsense.habitat.at core.source="hand-core 1"
@k.commonsense.habitat.place.animal k.animals.animal name=?thing habitat=?habitat
@k.commonsense.habitat.place.lives k.commonsense.lives in=?habitat at=?place
@k.commonsense.habitat.place.at k.commonsense.thing name=?thing at=?place
@k.commonsense.habitat.place core.rule when=$k.commonsense.habitat.place.animal when=$k.commonsense.habitat.place.lives then=$k.commonsense.habitat.place.at core.source="hand-core 1"

# Rule: what an animal can and cannot do, the thing of that name can and cannot do (`can=fly`, `cannot=fly`).
@k.commonsense.ability.animal k.animals.animal name=?thing can=?verb
@k.commonsense.ability.can k.commonsense.thing name=?thing can=?verb
@k.commonsense.ability core.rule when=$k.commonsense.ability.animal then=$k.commonsense.ability.can core.source="hand-core 1"
@k.commonsense.inability.animal k.animals.animal name=?thing cannot=?verb
@k.commonsense.inability.cannot k.commonsense.thing name=?thing cannot=?verb
@k.commonsense.inability core.rule when=$k.commonsense.inability.animal then=$k.commonsense.inability.cannot core.source="hand-core 1"

# Rule: a drink of k.food is a liquid.
@k.commonsense.drink.food k.food.food name=?thing kind=drink
@k.commonsense.drink.liquid k.commonsense.thing name=?thing is_a=liquid
@k.commonsense.drink core.rule when=$k.commonsense.drink.food then=$k.commonsense.drink.liquid core.source="hand-core 1"

# Rule: a thing on a carrier is where the carrier is, and goes where it goes (a cat on a boat is on the water;
# when the boat is placed elsewhere, so is the cat). Placed things of one scene, the carrier named by `on`.
@k.commonsense.carried.rider k.commonsense.placed thing=?thing on=?carrier scene=?scene
@k.commonsense.carried.carrier k.commonsense.placed thing=?carrier scene=?scene at=?place
@k.commonsense.carried.at k.commonsense.placed core.on=$k.commonsense.carried.rider at=?place
@k.commonsense.carried core.rule when=$k.commonsense.carried.rider when=$k.commonsense.carried.carrier then=$k.commonsense.carried.at core.source="hand-core 1"

# Soft rule: a liquid placed with nothing to hold it (`in`: a cup, a bottle, a lake).
@k.commonsense.liquid.thing k.commonsense.thing name=?thing is_a=liquid
@k.commonsense.liquid.placed k.commonsense.placed thing=?thing core.absent=in
@k.commonsense.liquid core.deny when=$k.commonsense.liquid.thing when=$k.commonsense.liquid.placed soft=true why="?thing is a liquid: it needs something to hold it (a cup, a bottle, a lake)." core.source="hand-core 1"

# Words for the types and keys of this world.
@k.commonsense.word.thing core.word text=thing text=things means=k.commonsense.thing core.source="hand-core 1"
@k.commonsense.word.at core.word text=where text=live text=lives means=k.commonsense.thing.at core.source="hand-core 1"
@k.commonsense.word.used_for core.word text=use text=used means=k.commonsense.thing.used_for core.source="hand-core 1"
@k.commonsense.word.lives core.word text="where it lives" means=k.commonsense.lives core.source="hand-core 1"
@k.commonsense.word.lives.in core.word text=habitat text="lives in" means=k.commonsense.lives.in core.source="hand-core 1"
@k.commonsense.word.made_of core.word text=made text=material means=k.commonsense.thing.made_of core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.commonsense.word.key.thing.at core.word text=at text=find text=found text=place means=k.commonsense.thing.at core.source="hand-core 1"
@k.commonsense.word.key.thing.can core.word text=can text=able text=do means=k.commonsense.thing.can core.source="hand-core 1"
@k.commonsense.word.key.thing.used_for core.word text="used for" means=k.commonsense.thing.used_for core.source="hand-core 1"
@k.commonsense.word.key.thing.made_of core.word text="made of" means=k.commonsense.thing.made_of core.source="hand-core 1"
@k.commonsense.word.key.thing.part_of core.word text="part of" means=k.commonsense.thing.part_of core.source="hand-core 1"
@k.commonsense.word.key.thing.has core.word text=has means=k.commonsense.thing.has core.source="hand-core 1"
@k.commonsense.word.key.thing.cannot core.word text=cannot means=k.commonsense.thing.cannot core.source="hand-core 1"
@k.commonsense.word.key.thing.usually_count core.word text="usually count" means=k.commonsense.thing.usually_count core.source="hand-core 1"
@k.commonsense.word.key.placed.thing core.word text=thing means=k.commonsense.placed.thing core.source="hand-core 1"
@k.commonsense.word.key.placed.at core.word text=at means=k.commonsense.placed.at core.source="hand-core 1"
@k.commonsense.word.key.placed.scene core.word text=scene means=k.commonsense.placed.scene core.source="hand-core 1"
@k.commonsense.word.key.placed.on core.word text=on means=k.commonsense.placed.on core.source="hand-core 1"
@k.commonsense.word.key.placed.in core.word text=in means=k.commonsense.placed.in core.source="hand-core 1"
@k.commonsense.word.key.lives.at core.word text=at means=k.commonsense.lives.at core.source="hand-core 1"
