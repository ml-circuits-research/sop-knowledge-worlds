@k.music.note.Dss k.music.note name=D## letter=D accidental="double sharp" pitch_class=4 enharmonic=E enharmonic=Fb core.source="hand-core 1"
@k.music.note.Ebb k.music.note name=Ebb letter=E accidental="double flat" pitch_class=2 enharmonic=C## enharmonic=D core.source="hand-core 1"
@k.music.note.Eb k.music.note name=Eb letter=E accidental=flat pitch_class=3 enharmonic=D# enharmonic=Fbb core.source="hand-core 1"
@k.music.note.E k.music.note name=E letter=E accidental=natural pitch_class=4 enharmonic=D## enharmonic=Fb core.source="hand-core 1"
@k.music.note.Es k.music.note name=E# letter=E accidental=sharp pitch_class=5 enharmonic=F enharmonic=Gbb core.source="hand-core 1"
@k.music.note.Ess k.music.note name=E## letter=E accidental="double sharp" pitch_class=6 enharmonic=F# enharmonic=Gb core.source="hand-core 1"
@k.music.note.Fbb k.music.note name=Fbb letter=F accidental="double flat" pitch_class=3 enharmonic=D# enharmonic=Eb core.source="hand-core 1"
@k.music.note.Fb k.music.note name=Fb letter=F accidental=flat pitch_class=4 enharmonic=D## enharmonic=E core.source="hand-core 1"
@k.music.note.F k.music.note name=F letter=F accidental=natural pitch_class=5 enharmonic=E# enharmonic=Gbb core.source="hand-core 1"
@k.music.note.Fs k.music.note name=F# letter=F accidental=sharp pitch_class=6 enharmonic=E## enharmonic=Gb core.source="hand-core 1"
@k.music.note.Fss k.music.note name=F## letter=F accidental="double sharp" pitch_class=7 enharmonic=G enharmonic=Abb core.source="hand-core 1"
@k.music.note.Gbb k.music.note name=Gbb letter=G accidental="double flat" pitch_class=5 enharmonic=E# enharmonic=F core.source="hand-core 1"
@k.music.note.Gb k.music.note name=Gb letter=G accidental=flat pitch_class=6 enharmonic=E## enharmonic=F# core.source="hand-core 1"
@k.music.note.G k.music.note name=G letter=G accidental=natural pitch_class=7 enharmonic=F## enharmonic=Abb core.source="hand-core 1"
@k.music.note.Gs k.music.note name=G# letter=G accidental=sharp pitch_class=8 enharmonic=Ab core.source="hand-core 1"
@k.music.note.Gss k.music.note name=G## letter=G accidental="double sharp" pitch_class=9 enharmonic=A enharmonic=Bbb core.source="hand-core 1"
@k.music.note.Abb k.music.note name=Abb letter=A accidental="double flat" pitch_class=7 enharmonic=F## enharmonic=G core.source="hand-core 1"
@k.music.note.Ab k.music.note name=Ab letter=A accidental=flat pitch_class=8 enharmonic=G# core.source="hand-core 1"
@k.music.note.A k.music.note name=A letter=A accidental=natural pitch_class=9 enharmonic=G## enharmonic=Bbb core.source="hand-core 1"
@k.music.note.As k.music.note name=A# letter=A accidental=sharp pitch_class=10 enharmonic=Cbb enharmonic=Bb core.source="hand-core 1"
