@k.music.note.Bs k.music.note name=B# letter=B accidental=sharp pitch_class=0 enharmonic=C enharmonic=Dbb core.source="hand-core 1"
@k.music.note.Bss k.music.note name=B## letter=B accidental="double sharp" pitch_class=1 enharmonic=C# enharmonic=Db core.source="hand-core 1"

@k.music.interval.perfect_unison k.music.interval name="perfect unison" semitones=0 number=1 quality=perfect core.source="hand-core 1"
@k.music.interval.minor_second k.music.interval name="minor second" semitones=1 number=2 quality=minor core.source="hand-core 1"
