# k.music/shards/notes: the 35 note names (7 letters, each natural, sharp, flat, double sharp and double flat) with their pitch class and other spellings; the 16 intervals up to the octave; and the spoken forms ("C sharp", "B flat", "tritone").
# sources: hand-core 1 (written by rule: tools/music-core.mjs, from the note letters, semitone patterns and orders of sharps and flats of Western music theory)
# license: CC0-1.0
# script: tools/music-core.mjs

@k.music.note.Cbb k.music.note name=Cbb letter=C accidental="double flat" pitch_class=10 enharmonic=A# enharmonic=Bb core.source="hand-core 1"
@k.music.note.Cb k.music.note name=Cb letter=C accidental=flat pitch_class=11 enharmonic=A## enharmonic=B core.source="hand-core 1"
@k.music.note.C k.music.note name=C letter=C accidental=natural pitch_class=0 enharmonic=Dbb enharmonic=B# core.source="hand-core 1"
@k.music.note.Cs k.music.note name=C# letter=C accidental=sharp pitch_class=1 enharmonic=Db enharmonic=B## core.source="hand-core 1"
@k.music.note.Css k.music.note name=C## letter=C accidental="double sharp" pitch_class=2 enharmonic=D enharmonic=Ebb core.source="hand-core 1"
@k.music.note.Dbb k.music.note name=Dbb letter=D accidental="double flat" pitch_class=0 enharmonic=C enharmonic=B# core.source="hand-core 1"
@k.music.note.Db k.music.note name=Db letter=D accidental=flat pitch_class=1 enharmonic=C# enharmonic=B## core.source="hand-core 1"
@k.music.note.D k.music.note name=D letter=D accidental=natural pitch_class=2 enharmonic=C## enharmonic=Ebb core.source="hand-core 1"
