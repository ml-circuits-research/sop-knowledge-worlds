# k.interest/shards/sources: the 23 published works the features of interest rest on: reference, year, DOI where there is one, and what this world takes from each.
# sources: hand-core 1 (hand-written in this repository: tools/interest-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/interest-core.mjs

@k.interest.source.berlyne1960 k.interest.source name=berlyne1960 cite="Berlyne, D. E. (1960). Conflict, Arousal, and Curiosity. New York: McGraw-Hill." year=1960 finding="The collative variables novelty, complexity, surprise and incongruity draw attention and exploration; repeated exposure habituates them." core.source="hand-core 1"
@k.interest.source.silvia2005 k.interest.source name=silvia2005 cite="Silvia, P. J. (2005). What is interesting? Exploring the appraisal structure of interest. Emotion, 5(1), 89-102." year=2005 doi="10.1037/1528-3542.5.1.89" finding="Interest comes from two appraisals together: that something is new and complex, and that one can understand it (coping potential)." core.source="hand-core 1"
@k.interest.source.silvia2008 k.interest.source name=silvia2008 cite="Silvia, P. J. (2008). Interest - the curious emotion. Current Directions in Psychological Science, 17(1), 57-60." year=2008 doi="10.1111/j.1467-8721.2008.00548.x" finding="Novelty-complexity and comprehensibility appraisals predict interest across texts, pictures and people; too complex to understand is not interesting." core.source="hand-core 1"
@k.interest.source.loewenstein1994 k.interest.source name=loewenstein1994 cite="Loewenstein, G. (1994). The psychology of curiosity: A review and reinterpretation. Psychological Bulletin, 116(1), 75-98." year=1994 doi="10.1037/0033-2909.116.1.75" finding="Curiosity is felt when attention falls on a gap in what one knows (the information gap), and grows when the gap is small enough to be closed." core.source="hand-core 1"
@k.interest.source.kang2009 k.interest.source name=kang2009 cite="Kang, M. J., Hsu, M., Krajbich, I. M., Loewenstein, G., McClure, S. M., Wang, J. T., & Camerer, C. F. (2009). The wick in the candle of learning: Epistemic curiosity activates reward circuitry and enhances memory. Psychological Science, 20(8), 963-973." year=2009 doi="10.1111/j.1467-9280.2009.02402.x" finding="Curiosity about the answer to a question is highest at middling confidence (an inverted U), lower when one knows nothing or already knows." core.source="hand-core 1"
@k.interest.source.hidi1986 k.interest.source name=hidi1986 cite="Hidi, S., & Baird, W. (1986). Interestingness - a neglected variable in discourse processing. Cognitive Science, 10(2), 179-194." year=1986 finding="The interest of a text comes from novelty, activity and character identification, and from information that is important and new to the reader." core.source="hand-core 1"
@k.interest.source.hidi2006 k.interest.source name=hidi2006 cite="Hidi, S., & Renninger, K. A. (2006). The four-phase model of interest development. Educational Psychologist, 41(2), 111-127." year=2006 doi="10.1207/s15326985ep4102_4" finding="Situational interest is triggered by features of the text (surprise, personal relevance) and held by meaningfulness; individual interest follows what a reader already cares about." core.source="hand-core 1"
@k.interest.source.schank1979 k.interest.source name=schank1979 cite="Schank, R. C. (1979). Interestingness: Controlling inferences. Artificial Intelligence, 12(3), 273-297." year=1979 doi="10.1016/0004-3702(79)90009-2" finding="What is interesting is the unexpected, the personally relevant and a few absolute interests (people, danger, death); a program should follow those and leave the expected." core.source="hand-core 1"
@k.interest.source.davis1971 k.interest.source name=davis1971 cite="Davis, M. S. (1971). That's interesting! Towards a phenomenology of sociology and a sociology of phenomenology. Philosophy of the Social Sciences, 1(4), 309-344." year=1971 finding="A claim is interesting when it denies something its audience assumes (\"what seems to be X is in reality non-X\"); one that confirms an assumption is obvious." core.source="hand-core 1"
@k.interest.source.iranNejad1987 k.interest.source name=iranNejad1987 cite="Iran-Nejad, A. (1987). Cognitive and affective causes of interest and liking. Journal of Educational Psychology, 79(2), 120-130." year=1987 doi="10.1037/0022-0663.79.2.120" finding="Unexpectedness, and its resolution, raised the interest of stories; interest and liking have partly different causes." core.source="hand-core 1"
@k.interest.source.kintsch1980 k.interest.source name=kintsch1980 cite="Kintsch, W. (1980). Learning from text, levels of comprehension, or: Why anyone would read a story anyway. Poetics, 9(1-3), 87-98." year=1980 finding="Cognitive interest in a text comes from surprise that can be made sense of afterwards (unexpected but postdictable), and depends on what the reader knows." core.source="hand-core 1"
@k.interest.source.sadoski1993 k.interest.source name=sadoski1993 cite="Sadoski, M., Goetz, E. T., & Fritz, J. B. (1993). Impact of concreteness on comprehensibility, interest, and memory for text. Journal of Educational Psychology, 85(2), 291-304." year=1993 doi="10.1037/0022-0663.85.2.291" finding="Concreteness was the strongest predictor of how comprehensible and how interesting readers found a passage, and of what they remembered." core.source="hand-core 1"
@k.interest.source.schraw1995 k.interest.source name=schraw1995 cite="Schraw, G., Bruning, R., & Svoboda, C. (1995). Sources of situational interest. Journal of Reading Behavior, 27(1), 1-17." year=1995 finding="Ease of comprehension, cohesion, vividness, engagement, emotiveness and prior knowledge each raised the interest readers reported." core.source="hand-core 1"
@k.interest.source.garner1989 k.interest.source name=garner1989 cite="Garner, R., Gillingham, M. G., & White, C. S. (1989). Effects of \"seductive details\" on macroprocessing and microprocessing in adults and children. Cognition and Instruction, 6(1), 41-57." year=1989 finding="Interesting details that are off the point (\"seductive details\") lowered what readers took from the main ideas." core.source="hand-core 1"
@k.interest.source.sperber1986 k.interest.source name=sperber1986 cite="Sperber, D., & Wilson, D. (1986). Relevance: Communication and Cognition. Oxford: Blackwell." year=1986 finding="An utterance is relevant to the degree that it changes what the hearer believes, for as little effort of understanding as possible." core.source="hand-core 1"
@k.interest.source.grice1975 k.interest.source name=grice1975 cite="Grice, H. P. (1975). Logic and conversation. In P. Cole & J. L. Morgan (Eds.), Syntax and Semantics 3: Speech Acts (pp. 41-58). New York: Academic Press." year=1975 finding="Speakers are expected to say as much as is needed and no more (quantity), and what bears on the point (relation); saying the known or the beside-the-point breaks the expectation." core.source="hand-core 1"
@k.interest.source.labov1972 k.interest.source name=labov1972 cite="Labov, W. (1972). The transformation of experience in narrative syntax. In Language in the Inner City (pp. 354-396). Philadelphia: University of Pennsylvania Press." year=1972 finding="A narrative needs evaluation, the part that says why it is worth telling; without it a hearer asks \"so what?\"." core.source="hand-core 1"
@k.interest.source.cowan2001 k.interest.source name=cowan2001 cite="Cowan, N. (2001). The magical number 4 in short-term memory: A reconsideration of mental storage capacity. Behavioral and Brain Sciences, 24(1), 87-114." year=2001 doi="10.1017/S0140525X01003922" finding="About three to five chunks can be held in mind at once." core.source="hand-core 1"
@k.interest.source.koestler1964 k.interest.source name=koestler1964 cite="Koestler, A. (1964). The Act of Creation. London: Hutchinson." year=1964 finding="The creative and the funny join two frames of reference that are usually apart (bisociation)." core.source="hand-core 1"
@k.interest.source.mednick1962 k.interest.source name=mednick1962 cite="Mednick, S. A. (1962). The associative basis of the creative process. Psychological Review, 69(3), 220-232." year=1962 doi="10.1037/h0048850" finding="Bringing together ideas that are remote from each other is what makes an association creative." core.source="hand-core 1"
@k.interest.source.itti2009 k.interest.source name=itti2009 cite="Itti, L., & Baldi, P. (2009). Bayesian surprise attracts human attention. Vision Research, 49(10), 1295-1306." year=2009 doi="10.1016/j.visres.2008.09.007" finding="Attention goes to what changes an observer's expectations most (surprise as the distance between what was expected and what is seen)." core.source="hand-core 1"
@k.interest.source.new2007 k.interest.source name=new2007 cite="New, J., Cosmides, L., & Tooby, J. (2007). Category-specific attention for animals reflects ancestral priorities, not expertise. Proceedings of the National Academy of Sciences, 104(42), 16598-16603." year=2007 doi="10.1073/pnas.0703913104" finding="People and animals draw attention faster than other things, even vehicles one has learnt to watch." core.source="hand-core 1"
@k.interest.source.geng2006 k.interest.source name=geng2006 cite="Geng, L., & Hamilton, H. J. (2006). Interestingness measures for data mining: A survey. ACM Computing Surveys, 38(3), article 9." year=2006 doi="10.1145/1132960.1132963" finding="Programs score a found pattern by conciseness, coverage, peculiarity, novelty, surprisingness and use; peculiarity is distance from the other records." core.source="hand-core 1"
