# k.interest/shards/features: 4 appraisals (novelty, coping, relevance, penalty), 20 measures a program computes over facts and text, and 21 features with weight ranges.
# sources: hand-core 1 (hand-written in this repository: tools/interest-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/interest-core.mjs

# Appraisals: score = novelty * coping * relevance - penalty, each held between 0 and 1.
@k.interest.appraisal.novelty k.interest.appraisal name=novelty about="Is it new, complex or unexpected: a link between distant worlds, an exception to what most things of its kind do, a number far from the usual, a question it opens." combine=multiply base=0 source=silvia2005 source=silvia2008 source=berlyne1960 own="Base 0: a fact with nothing new in it scores nothing however clear it is." core.source="hand-core 1"
@k.interest.appraisal.coping k.interest.appraisal name=coping about="Can the reader understand it: concrete things, words the reader knows, sentences of a manageable length, an example after a claim." combine=multiply base=0.7 source=silvia2005 source=silvia2008 source=schraw1995 own="Base 0.7: a plain sentence is understood; concreteness and examples add, unknown words and long sentences take away." core.source="hand-core 1"
@k.interest.appraisal.relevance k.interest.appraisal name=relevance about="Does it bear on the topic and on the reader: on the topic or near it, about what the reader has just used, about people and animals." combine=multiply base=0.4 source=sperber1986 source=hidi2006 source=garner1989 own="Base 0.4: a fact that is neither on nor off the topic counts less than half; the topic itself brings it to about 1." core.source="hand-core 1"
@k.interest.appraisal.penalty k.interest.appraisal name=penalty about="What makes text dull: saying a fact again, the same pattern again and again, the obvious, a list without a point." combine=subtract base=0 source=grice1975 source=berlyne1960 source=labov1972 own="Subtracted from the product, so a repeated fact (penalty 1) is never chosen." core.source="hand-core 1"

# Measures: what a program computes.
@k.interest.measure.world_distance k.interest.measure name=world_distance scope=link reads=k.attributes.found gives="a whole number from 0: 0 when the two things are in one world" about="The fewest joins of the catalog (a value of one world that names a fact of another: an animal's habitat a scene, a food's drawing an object) between the worlds of the two things a fact links." core.source="hand-core 1"
@k.interest.measure.sibling_contrast k.interest.measure name=sibling_contrast scope=fact reads=k.animals.animal reads=k.attributes.thing reads=k.kinds.kind gives="a share from 0 to 1" about="Among the siblings of the thing (things of the same class or kind), the share that have another value for the key than this fact gives, when at least 5 siblings say the key (a penguin cannot fly: most birds can). 0 when fewer say it." core.source="hand-core 1"
@k.interest.measure.rule_exception k.interest.measure name=rule_exception scope=fact reads=k.commonsense.thing gives="1 or 0" about="1 when the fact breaks a soft rule or a default of k.commonsense (a soft deny holds for its kind but not for it), else 0." core.source="hand-core 1"
@k.interest.measure.range_distance k.interest.measure name=range_distance scope=fact reads=k.attributes.number gives="a number from 0: widths of the typical range" about="How far a number lies outside the typical range of its key for things of its kind: the distance to the nearer end divided by the width of the range; 0 inside the range." core.source="hand-core 1"
@k.interest.measure.sibling_rank k.interest.measure name=sibling_rank scope=fact reads=k.attributes.number reads=k.kinds.kind gives="1 or 0" about="1 when the number is the largest or the smallest of its key among at least 5 siblings that say the key (the fastest, the heaviest), else 0." core.source="hand-core 1"
@k.interest.measure.word_band k.interest.measure name=word_band scope=fact reads=k.words.frequency gives="a whole number from 1 (very common words) to 5 (rare)" about="The frequency band of the word for the thing (k.words.frequency); a word with no frequency fact counts as band 5." core.source="hand-core 1"
@k.interest.measure.known_share k.interest.measure name=known_share scope=sentence reads=w.document.sentence gives="a share from 0 to 1" about="For a question the text asks: the share of the facts that answer it which the text has already said. Only a question the catalog can answer is measured." core.source="hand-core 1"
@k.interest.measure.number_with_unit k.interest.measure name=number_with_unit scope=fact reads=k.units.measure gives="1 or 0" about="1 when the fact gives a number with its unit or what it counts (k.units.measure), else 0." core.source="hand-core 1"
@k.interest.measure.concreteness k.interest.measure name=concreteness scope=fact reads=k.objects.object reads=k.words.sense gives="1 or 0" about="1 when the thing can be drawn (a k.objects drawing) or its chain of kinds reaches \"physical entity\", else 0." core.source="hand-core 1"
@k.interest.measure.share_beyond_band k.interest.measure name=share_beyond_band scope=sentence reads=w.document.sentence reads=k.words.frequency gives="a share from 0 to 1" about="The share of the content words of a sentence whose frequency band is above the vocabulary band of the register (k.genres)." core.source="hand-core 1"
@k.interest.measure.words_over_max k.interest.measure name=words_over_max scope=sentence reads=w.document.sentence gives="a whole number from 0" about="How many words a sentence has beyond the longest sentence its register allows (k.genres)." core.source="hand-core 1"
@k.interest.measure.example_after_claim k.interest.measure name=example_after_claim scope=passage reads=w.document.paragraph reads=w.document.sentence gives="1 or 0" about="1 when a general statement in the passage is followed by an example of it (a thing that is one of the kind it speaks of), else 0." core.source="hand-core 1"
@k.interest.measure.topic_distance k.interest.measure name=topic_distance scope=fact reads=k.attributes.found gives="a whole number from 0: 0 for a fact about the topic itself" about="The fewest joins between the thing the fact is about and the topic of the text." core.source="hand-core 1"
@k.interest.measure.seen_in_session k.interest.measure name=seen_in_session scope=fact gives="1 or 0" about="1 when the reader named or used the thing earlier in the session (the host's history), else 0." core.source="hand-core 1"
@k.interest.measure.animacy k.interest.measure name=animacy scope=fact reads=k.animals.animal reads=k.people.kind reads=k.people.role gives="1 or 0" about="1 when the thing is an animal or a person, else 0." core.source="hand-core 1"
@k.interest.measure.said_before k.interest.measure name=said_before scope=sentence reads=w.document.sentence gives="1 or 0" about="1 when the text has already stated this key of this fact, else 0." core.source="hand-core 1"
@k.interest.measure.same_move_run k.interest.measure name=same_move_run scope=passage reads=w.document.sentence gives="a whole number from 1" about="How many sentences in a row, ending with this one, have the same rhetorical move and the same key." core.source="hand-core 1"
@k.interest.measure.obviousness k.interest.measure name=obviousness scope=fact reads=k.kinds.kind reads=k.words.sense gives="1 or 0" about="1 when the fact is what the reader assumes: made by a rule (derived=true), a value that at least 9 in 10 of its siblings share (a dog has four legs), or a kind one step above in an everyday word (a dog is an animal); else 0." core.source="hand-core 1"
@k.interest.measure.items_without_point k.interest.measure name=items_without_point scope=passage reads=w.document.sentence gives="a whole number from 0" about="How many facts in a row the passage has stated since its last comparison, contrast, surprising fact or conclusion." core.source="hand-core 1"
@k.interest.measure.ends_without_point k.interest.measure name=ends_without_point scope=passage reads=w.document.paragraph reads=w.document.sentence gives="1 or 0" about="1 when the passage ends without a conclusion or an evaluation (why it matters), else 0." core.source="hand-core 1"

# Features: weight * shape(measure), added to their appraisal.
@k.interest.feature.distant_link k.interest.feature name=distant_link appraisal=novelty measure=world_distance shape=rising start_at=0 full_at=3 weight_min=0.25 weight_max=0.45 about="A fact that links things of distant worlds (an animal and a planet, a food and a country) is new and makes a connection the reader had not made." source=koestler1964 source=mednick1962 source=silvia2005 own="Distance counted in joins of the catalog; full at 3 joins; the weights." core.source="hand-core 1"
@k.interest.feature.sibling_contrast k.interest.feature name=sibling_contrast appraisal=novelty measure=sibling_contrast shape=rising start_at=0.5 full_at=0.9 weight_min=0.4 weight_max=0.6 about="A thing that does not do what most things of its kind do (a bird that cannot fly, a mammal that lays eggs) denies an assumption of the reader." source=davis1971 source=schank1979 source=iranNejad1987 source=kintsch1980 own="What most siblings do stands for what the reader assumes; starts at a half, full at nine in ten; the weights." core.source="hand-core 1"
@k.interest.feature.rule_exception k.interest.feature name=rule_exception appraisal=novelty measure=rule_exception shape=step full_at=1 weight_min=0.4 weight_max=0.6 about="A fact that breaks a common-sense rule of k.commonsense is surprising, and can be made sense of afterwards." source=davis1971 source=iranNejad1987 source=kintsch1980 own="k.commonsense soft rules stand for what the reader assumes; the weights." core.source="hand-core 1"
@k.interest.feature.far_number k.interest.feature name=far_number appraisal=novelty measure=range_distance shape=rising start_at=0 full_at=2 weight_min=0.3 weight_max=0.5 about="A number far from what is usual for its kind (a whale 30 m long, a hummingbird of 3 g) surprises." source=itti2009 source=berlyne1960 own="Distance in widths of the typical range; full at 2 widths; the weights." core.source="hand-core 1"
@k.interest.feature.extreme k.interest.feature name=extreme appraisal=novelty measure=sibling_rank shape=step full_at=1 weight_min=0.2 weight_max=0.35 about="The largest, smallest, fastest or slowest of its kind is peculiar and easy to remember." source=geng2006 source=schank1979 own="Among at least 5 siblings; the weights." core.source="hand-core 1"
@k.interest.feature.rare_kind k.interest.feature name=rare_kind appraisal=novelty measure=word_band shape=rising start_at=2 full_at=5 weight_min=0.05 weight_max=0.2 about="A thing the reader meets rarely (its word is rare) is new." source=berlyne1960 source=silvia2005 own="The frequency of the word stands for how familiar the thing is; bands; the weights." core.source="hand-core 1"
@k.interest.feature.opens_question k.interest.feature name=opens_question appraisal=novelty measure=known_share shape=peak start_at=0 peak_at=0.5 full_at=1 weight_min=0.2 weight_max=0.4 about="A question the text asks (why can a penguin not fly?) draws the reader on when part of the answer is known and the rest can be given." source=loewenstein1994 source=kang2009 own="The share of the answer already said stands for confidence; peak at a half; only questions the catalog answers; the weights." core.source="hand-core 1"
@k.interest.feature.number_given k.interest.feature name=number_given appraisal=coping measure=number_with_unit shape=step full_at=1 weight_min=0.05 weight_max=0.15 about="A number with its unit makes a statement concrete, easier to picture and to check." source=sadoski1993 own="A number counted as a kind of concreteness; the weights." core.source="hand-core 1"
@k.interest.feature.concrete_thing k.interest.feature name=concrete_thing appraisal=coping measure=concreteness shape=step full_at=1 weight_min=0.15 weight_max=0.3 about="Concrete things that can be pictured make a text easier to understand and more interesting." source=sadoski1993 source=schraw1995 own="Drawable or physical stands for concrete; the weights." core.source="hand-core 1"
@k.interest.feature.unknown_words k.interest.feature name=unknown_words appraisal=coping measure=share_beyond_band shape=rising start_at=0.05 full_at=0.3 weight_min=-0.6 weight_max=-0.3 about="Words beyond the reader's vocabulary make a text hard to understand, and what cannot be understood is not interesting." source=silvia2005 source=silvia2008 source=schraw1995 own="Frequency bands stand for the vocabulary of the register; starts at 1 word in 20, full at 3 in 10; the weights." core.source="hand-core 1"
@k.interest.feature.long_sentence k.interest.feature name=long_sentence appraisal=coping measure=words_over_max shape=rising start_at=0 full_at=10 weight_min=-0.25 weight_max=-0.1 about="A sentence longer than its register allows is harder to follow." source=schraw1995 own="Full at 10 words over the register's longest sentence; the weights." core.source="hand-core 1"
@k.interest.feature.example_after_claim k.interest.feature name=example_after_claim appraisal=coping measure=example_after_claim shape=step full_at=1 weight_min=0.1 weight_max=0.2 about="An example after a general statement makes it concrete and easier to understand." source=sadoski1993 source=schraw1995 own="The weights." core.source="hand-core 1"
@k.interest.feature.on_topic k.interest.feature name=on_topic appraisal=relevance measure=topic_distance shape=falling start_at=0 full_at=2 weight_min=0.4 weight_max=0.6 about="A fact about the topic, or one join from it, bears on what the text is about." source=sperber1986 source=hidi2006 own="Full on the topic itself, none from 2 joins; the weights." core.source="hand-core 1"
@k.interest.feature.off_topic k.interest.feature name=off_topic appraisal=relevance measure=topic_distance shape=step full_at=3 weight_min=-0.4 weight_max=-0.3 about="An interesting fact far from the topic distracts from the main ideas (a seductive detail)." source=garner1989 own="From 3 joins away; the weights." core.source="hand-core 1"
@k.interest.feature.personal k.interest.feature name=personal appraisal=relevance measure=seen_in_session shape=step full_at=1 weight_min=0.2 weight_max=0.4 about="What the reader has just named or used is personally relevant." source=hidi2006 source=schank1979 own="The session's history stands for personal relevance; the weights." core.source="hand-core 1"
@k.interest.feature.animate k.interest.feature name=animate appraisal=relevance measure=animacy shape=step full_at=1 weight_min=0.1 weight_max=0.2 about="People and animals draw attention before other things." source=new2007 source=schank1979 source=hidi1986 own="The weights." core.source="hand-core 1"
@k.interest.feature.repeated_fact k.interest.feature name=repeated_fact appraisal=penalty measure=said_before shape=step full_at=1 weight_min=1 weight_max=1 about="Saying a fact again tells the reader nothing." source=grice1975 own="A penalty of 1: never chosen." core.source="hand-core 1"
@k.interest.feature.repeated_pattern k.interest.feature name=repeated_pattern appraisal=penalty measure=same_move_run shape=rising start_at=2 full_at=4 weight_min=0.1 weight_max=0.25 about="The same kind of sentence again and again habituates the reader." source=berlyne1960 own="Starts at the second sentence of one move and key in a row, full at the fourth; the weights." core.source="hand-core 1"
@k.interest.feature.obvious k.interest.feature name=obvious appraisal=penalty measure=obviousness shape=step full_at=1 weight_min=0.3 weight_max=0.5 about="What the reader already assumes (a dog is an animal, grass is green) is not worth saying." source=grice1975 source=davis1971 own="Derived, nine in ten siblings, or one kind step stand for the obvious; the weights." core.source="hand-core 1"
@k.interest.feature.list_without_point k.interest.feature name=list_without_point appraisal=penalty measure=items_without_point shape=rising start_at=3 full_at=6 weight_min=0.2 weight_max=0.4 about="A run of facts with no comparison, contrast or conclusion has no point, and holds more than a reader keeps in mind." source=labov1972 source=grice1975 source=cowan2001 own="Starts after 3 facts (about what is held in mind at once), full at 6; the weights." core.source="hand-core 1"
@k.interest.feature.no_point_at_end k.interest.feature name=no_point_at_end appraisal=penalty measure=ends_without_point shape=step full_at=1 weight_min=0.1 weight_max=0.2 about="A passage that does not end by saying why it matters leaves the reader asking \"so what?\"." source=labov1972 own="The weights." core.source="hand-core 1"
