# w.face: a world schema: a drawn face, built from parts a user adds, removes, recolours, resizes and moves (an
# avatar, a character, a portrait). Its kinds are the places of a face in k.faces (one kind per slot name); what a
# part looks like is a variant of k.faces, read from there with its shapes, never written here. Declared in the
# library's std.schema format; the acts of std.acts drive it; one deny keeps one part of each kind on a face; it
# has no function of its own (the drawing is the host's renderer, as for k.objects).
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)
# needs: sopworld with std.schema and std.acts (tools/sopworld/VERSION, 0.30.0 or later)

@w.face core.module name=w.face version=1 exports=face exports=part exports=hair_back exports=shoulders exports=clothes exports=neck exports=ears exports=head exports=cheeks exports=beard exports=mouth exports=moustache exports=nose exports=eyes exports=eyebrows exports=glasses exports=hair_front exports=earrings exports=hat exports=accessories core.source="hand-core 1"
@w.face.world std.schema.world name=w.face doc="a drawn face: parts with their variant, colour, size and place, and an expression" core.source="hand-core 1"

# A face. `name` what it is called; `style` the style of k.faces its parts are drawn in (`k.faces.slot.style`:
# plain, micah, pixel-art ...; a face does not mix styles); `preset` the k.faces preset it started from (child,
# robot, queen); `skin`, `hair_colour`, `eye_colour`, `clothes` the names of k.faces colours of that use (the keys of
# `k.faces.preset`, so a preset is copied key for key); the parts take their colour from these by their `tint` in
# k.faces. `expression` is a mode, not a part: the name of a k.faces expression (happy, sad, wink, talking) whose
# variants of mouth, eyebrows and eyes are drawn over the face's own while it is set; the parts keep their own
# variants, so leaving the mode (removing `expression`, or undo) shows them again. No expression: the face is calm.
@w.face.face core.type of=w.face.face extends=std.schema.thing closed=true core.source="hand-core 1"
@w.face.face.name core.slot of=w.face.face key=name kind=atom kind=string core.source="hand-core 1"
@w.face.face.style core.slot of=w.face.face key=style kind=atom kind=string default=plain core.source="hand-core 1"
@w.face.face.preset core.slot of=w.face.face key=preset kind=atom kind=string core.source="hand-core 1"
@w.face.face.skin core.slot of=w.face.face key=skin kind=atom kind=string core.source="hand-core 1"
@w.face.face.hair_colour core.slot of=w.face.face key=hair_colour kind=atom kind=string core.source="hand-core 1"
@w.face.face.eye_colour core.slot of=w.face.face key=eye_colour kind=atom kind=string core.source="hand-core 1"
@w.face.face.clothes core.slot of=w.face.face key=clothes kind=atom kind=string core.source="hand-core 1"
@w.face.face.expression core.slot of=w.face.face key=expression kind=atom kind=string core.source="hand-core 1"

# A part of a face, the parent of every kind of part. `face` refers to the face it belongs to (a host with one face
# may leave it out); `variant` names a k.faces variant of the part's slot in the face's style (`k.faces.variant`,
# identity slot and name: "round", "big smile", "micah mouth smile"), whose parts are the shapes drawn; `colour`
# paints the part over the face colour its tint names (any colour name of k.values); `size` scales it about its
# centre, 1 as the style draws it (0.6 to 1.5, by tenths); `x` and `y` move it from its place in the slot's box, in
# the 0 to 100 frame of the face (x to the right, y downwards: "raise the eyebrows" is less y). A pair (eyes, ears)
# is one part drawn twice, mirrored at the middle: `x` moves the side on the viewer's left, so more x brings the two
# closer together.
@w.face.part core.type of=w.face.part extends=std.schema.thing closed=true core.source="hand-core 1"
@w.face.part.face core.slot of=w.face.part key=face type=w.face.face core.source="hand-core 1"
@w.face.part.variant core.slot of=w.face.part key=variant kind=atom kind=string core.source="hand-core 1"
@w.face.part.colour core.slot of=w.face.part key=colour kind=atom kind=string core.source="hand-core 1"
@w.face.part.size core.slot of=w.face.part key=size kind=number min=0.6 max=1.5 step=0.1 default=1 core.source="hand-core 1"
@w.face.part.x core.slot of=w.face.part key=x kind=number min=-50 max=50 step=1 default=0 core.source="hand-core 1"
@w.face.part.y core.slot of=w.face.part key=y kind=number min=-50 max=50 step=1 default=0 core.source="hand-core 1"

# The kinds of part: one per slot name of k.faces (every style together; a style has some of them). Each takes the
# keys of w.face.part.
@w.face.hair_back core.type of=w.face.hair_back extends=w.face.part closed=true core.source="hand-core 1"
@w.face.shoulders core.type of=w.face.shoulders extends=w.face.part closed=true core.source="hand-core 1"
@w.face.clothes core.type of=w.face.clothes extends=w.face.part closed=true core.source="hand-core 1"
@w.face.neck core.type of=w.face.neck extends=w.face.part closed=true core.source="hand-core 1"
@w.face.ears core.type of=w.face.ears extends=w.face.part closed=true core.source="hand-core 1"
@w.face.head core.type of=w.face.head extends=w.face.part closed=true core.source="hand-core 1"
@w.face.cheeks core.type of=w.face.cheeks extends=w.face.part closed=true core.source="hand-core 1"
@w.face.beard core.type of=w.face.beard extends=w.face.part closed=true core.source="hand-core 1"
@w.face.mouth core.type of=w.face.mouth extends=w.face.part closed=true core.source="hand-core 1"
@w.face.moustache core.type of=w.face.moustache extends=w.face.part closed=true core.source="hand-core 1"
@w.face.nose core.type of=w.face.nose extends=w.face.part closed=true core.source="hand-core 1"
@w.face.eyes core.type of=w.face.eyes extends=w.face.part closed=true core.source="hand-core 1"
@w.face.eyebrows core.type of=w.face.eyebrows extends=w.face.part closed=true core.source="hand-core 1"
@w.face.glasses core.type of=w.face.glasses extends=w.face.part closed=true core.source="hand-core 1"
@w.face.hair_front core.type of=w.face.hair_front extends=w.face.part closed=true core.source="hand-core 1"
@w.face.earrings core.type of=w.face.earrings extends=w.face.part closed=true core.source="hand-core 1"
@w.face.hat core.type of=w.face.hat extends=w.face.part closed=true core.source="hand-core 1"
@w.face.accessories core.type of=w.face.accessories extends=w.face.part closed=true core.source="hand-core 1"

# The kinds and the acts. A face is made, changed (its colours, style, expression), copied, asked about and removed;
# a part is made (added to the face), removed (taken off), changed (variant, colour, size), placed (moved), picked
# and asked about. A face has one part of each kind (a deny: a second hat is refused; to change the hat, change its
# variant). At most 10 faces and 10 parts of each kind.
@w.face.kind.face std.schema.kind of=w.face.face world=w.face acts=make acts=remove acts=change acts=copy acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.hair_back std.schema.kind of=w.face.hair_back world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.shoulders std.schema.kind of=w.face.shoulders world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.clothes std.schema.kind of=w.face.clothes world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.neck std.schema.kind of=w.face.neck world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.ears std.schema.kind of=w.face.ears world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.head std.schema.kind of=w.face.head world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.cheeks std.schema.kind of=w.face.cheeks world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.beard std.schema.kind of=w.face.beard world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.mouth std.schema.kind of=w.face.mouth world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.moustache std.schema.kind of=w.face.moustache world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.nose std.schema.kind of=w.face.nose world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.eyes std.schema.kind of=w.face.eyes world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.eyebrows std.schema.kind of=w.face.eyebrows world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.glasses std.schema.kind of=w.face.glasses world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.hair_front std.schema.kind of=w.face.hair_front world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.earrings std.schema.kind of=w.face.earrings world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.hat std.schema.kind of=w.face.hat world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.kind.accessories std.schema.kind of=w.face.accessories world=w.face acts=make acts=remove acts=change acts=place acts=pick acts=ask core.source="hand-core 1"
@w.face.one.first w.face.part kind=?kind face=?face
@w.face.one.second w.face.part kind=?kind face=?face
@w.face.one.other core.check fn=neq args=$w.face.one.first args=$w.face.one.second
@w.face.one core.deny when=$w.face.one.first when=$w.face.one.second if=$w.face.one.other why="A face has one part of each kind: this face has a ?kind already." core.source="hand-core 1"
@w.face.limit.face std.schema.limit of=w.face.face max=10 core.source="hand-core 1"
@w.face.limit.hair_back std.schema.limit of=w.face.hair_back max=10 core.source="hand-core 1"
@w.face.limit.shoulders std.schema.limit of=w.face.shoulders max=10 core.source="hand-core 1"
