# k.faces/shards/plain-eyes: the variants of the slot `eyes` in the style `plain` (the side on the viewer's left; the other side is its mirror image): features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# eyes: round
@k.faces.plain.eyes.round k.faces.variant slot=eyes name=round style=plain shape=round size=medium feel=open core.source="hand-core 1"
@k.faces.plain.eyes.round.white k.faces.part slot=eyes of=round name=white shape=circle x=32 y=37 w=10 h=10 z=1 colour=white rgb="#FFFFFF" core.source="hand-core 1"
@k.faces.plain.eyes.round.iris k.faces.part slot=eyes of=round name=iris shape=circle x=34.5 y=39.5 w=5 h=5 z=2 colour=blue colour=brown tint=eyes core.source="hand-core 1"
@k.faces.plain.eyes.round.pupil k.faces.part slot=eyes of=round name=pupil shape=circle x=36 y=41 w=2 h=2 z=3 colour=black rgb="#1A1A1A" core.source="hand-core 1"

