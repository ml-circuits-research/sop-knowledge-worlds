# k.faces/shards/plain-head: the variants of the slot `head` in the style `plain`: features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# head: round
@k.faces.plain.head.round k.faces.variant slot=head name=round style=plain shape=round core.source="hand-core 1"
@k.faces.plain.head.round.face k.faces.part slot=head of=round name=face shape=oval x=23 y=17 w=54 h=60 z=1 colour=pink colour=brown tint=skin core.source="hand-core 1"

