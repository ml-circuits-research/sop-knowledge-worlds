@k.faces.micah.slot.head k.faces.slot style=micah name=head x=26 y=12 w=48 h=84 z=0 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.mouth k.faces.slot style=micah name=mouth x=44 y=53 w=23 h=14 z=1 core.source="dicebear-micah 67f54a0"
