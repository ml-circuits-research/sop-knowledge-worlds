@k.faces.micah.slot.eyebrows k.faces.slot style=micah name=eyebrows x=36 y=28 w=31 h=11 z=3 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.hair_front k.faces.slot style=micah name=hair_front x=7 y=0 w=85 h=97 z=4 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.eyes k.faces.slot style=micah name=eyes x=40 y=33 w=25 h=12 z=5 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.glasses k.faces.slot style=micah name=glasses x=28 y=31 w=44 h=20 z=6 optional=true core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.nose k.faces.slot style=micah name=nose x=52 y=41 w=5 h=9 z=7 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.ears k.faces.slot style=micah name=ears x=23 y=43 w=13 h=14 z=8 core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.earrings k.faces.slot style=micah name=earrings x=24 y=51 w=14 h=15 z=9 optional=true core.source="dicebear-micah 67f54a0"
@k.faces.micah.slot.shoulders k.faces.slot style=micah name=shoulders x=10 y=79 w=79 h=21 z=10 core.source="dicebear-micah 67f54a0"
