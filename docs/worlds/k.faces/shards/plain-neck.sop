# k.faces/shards/plain-neck: the variants of the slot `neck` in the style `plain`: features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# neck: medium
@k.faces.plain.neck.medium k.faces.variant slot=neck name=medium style=plain size=medium core.source="hand-core 1"
@k.faces.plain.neck.medium.neck k.faces.part slot=neck of=medium name=neck shape=rectangle x=42 y=70 w=16 h=18 z=1 colour=pink colour=brown tint=skin core.source="hand-core 1"

# neck: thin
@k.faces.plain.neck.thin k.faces.variant slot=neck name=thin style=plain feel=thin feel=narrow core.source="hand-core 1"
@k.faces.plain.neck.thin.neck k.faces.part slot=neck of=thin name=neck shape=rectangle x=45 y=70 w=10 h=18 z=1 colour=pink colour=brown tint=skin core.source="hand-core 1"

# neck: thick
@k.faces.plain.neck.thick k.faces.variant slot=neck name=thick style=plain feel=thick feel=wide core.source="hand-core 1"
