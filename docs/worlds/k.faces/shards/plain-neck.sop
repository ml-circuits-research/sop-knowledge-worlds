@k.faces.plain.neck.tapered.neck k.faces.part slot=neck of=tapered name=neck shape=polygon x=37 y=70 w=26 h=18 z=1 colour=pink colour=brown tint=skin core.source="hand-core 1"
@k.faces.plain.neck.tapered.neck.p1 k.faces.point part=$k.faces.plain.neck.tapered.neck n=1 x=42 y=70 core.source="hand-core 1"
