# k.faces/shards/plain-ears: the variants of the slot `ears` in the style `plain` (the side on the viewer's left; the other side is its mirror image): features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# ears: round
@k.faces.plain.ears.round k.faces.variant slot=ears name=round style=plain shape=round size=medium core.source="hand-core 1"
@k.faces.plain.ears.round.ear k.faces.part slot=ears of=round name=ear shape=circle x=15 y=42 w=13 h=13 z=1 colour=pink colour=brown tint=skin core.source="hand-core 1"
@k.faces.plain.ears.round.fold k.faces.part slot=ears of=round name=fold shape=arc x=18 y=45 w=5 h=7 z=2 colour=brown tint=skin_shade opens=right core.source="hand-core 1"

