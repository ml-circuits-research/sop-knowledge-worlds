# k.faces/shards/plain-eyebrows: the variants of the slot `eyebrows` in the style `plain` (the side on the viewer's left; the other side is its mirror image): features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# eyebrows: straight
@k.faces.plain.eyebrows.straight k.faces.variant slot=eyebrows name=straight style=plain feel=flat feel=thin core.source="hand-core 1"
@k.faces.plain.eyebrows.straight.brow k.faces.part slot=eyebrows of=straight name=brow shape=line x=30 y=31 w=14 h=0 z=1 colour=brown colour=black tint=hair core.source="hand-core 1"
@k.faces.plain.eyebrows.straight.brow.p1 k.faces.point part=$k.faces.plain.eyebrows.straight.brow n=1 x=30 y=31 core.source="hand-core 1"
@k.faces.plain.eyebrows.straight.brow.p2 k.faces.point part=$k.faces.plain.eyebrows.straight.brow n=2 x=44 y=31 core.source="hand-core 1"

