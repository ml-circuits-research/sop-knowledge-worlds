# k.faces/shards/plain-beard: the variants of the slot `beard` in the style `plain`: features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# beard: full
@k.faces.plain.beard.full k.faces.variant slot=beard name=full style=plain length=medium feel=thick kind="full beard" core.source="hand-core 1"
@k.faces.plain.beard.full.beard k.faces.part slot=beard of=full name=beard shape=polygon x=24 y=52 w=52 h=34 z=1 colour=brown colour=black tint=hair core.source="hand-core 1"
