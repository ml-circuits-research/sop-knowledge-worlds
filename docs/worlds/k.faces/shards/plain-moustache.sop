# k.faces/shards/plain-moustache: the variants of the slot `moustache` in the style `plain`: features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# moustache: thin
@k.faces.plain.moustache.thin k.faces.variant slot=moustache name=thin style=plain feel=thin core.source="hand-core 1"
@k.faces.plain.moustache.thin.moustache k.faces.part slot=moustache of=thin name=moustache shape=line x=41 y=57.5 w=18 h=1 z=1 colour=brown colour=black tint=hair core.source="hand-core 1"
@k.faces.plain.moustache.thin.moustache.p1 k.faces.point part=$k.faces.plain.moustache.thin.moustache n=1 x=41 y=58.5 core.source="hand-core 1"
@k.faces.plain.moustache.thin.moustache.p2 k.faces.point part=$k.faces.plain.moustache.thin.moustache n=2 x=50 y=57.5 core.source="hand-core 1"
@k.faces.plain.moustache.thin.moustache.p3 k.faces.point part=$k.faces.plain.moustache.thin.moustache n=3 x=59 y=58.5 core.source="hand-core 1"

