# eyebrows: cutouts dashes
@k.faces.cutouts.eyebrows.dashes k.faces.variant slot=eyebrows name="cutouts dashes" style=cutouts size=small feel=thin feel=flat named=model core.source="dicebear-cutouts 67f54a0"
@k.faces.cutouts.eyebrows.dashes.p1 k.faces.part slot=eyebrows of="cutouts dashes" name=part1 shape=polygon x=33 y=33.7 w=13.3 h=4.6 z=1 colour=black rgb="#26211C" core.source="dicebear-cutouts 67f54a0"
