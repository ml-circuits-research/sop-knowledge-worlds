@k.faces.miniavs.cheeks.default.p1 k.faces.part slot=cheeks of="miniavs default" name=part1 shape=rectangle x=37.5 y=59.4 w=7.8 h=4.7 z=1 colour=pink rgb="#FF859B" core.source="dicebear-miniavs 67f54a0"
