# k.faces/shards/plain-mouth: the variants of the slot `mouth` in the style `plain`: features, and parts with a primitive shape, a box in the frame of the face, a draw order and colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: tools/faces-core.mjs

# mouth: smile
@k.faces.plain.mouth.smile k.faces.variant slot=mouth name=smile style=plain feel=smiling feel=closed core.source="hand-core 1"
@k.faces.plain.mouth.smile.lips k.faces.part slot=mouth of=smile name=lips shape=arc x=41 y=63 w=18 h=6 z=1 colour=red rgb="#B5483F" opens=up core.source="hand-core 1"

