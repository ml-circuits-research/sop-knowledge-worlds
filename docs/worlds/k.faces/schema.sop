# k.faces: faces built from replaceable parts, like a police sketch: slots (the places of a face), variants (one
# drawable shape for a slot, with plain features a person would say), presets (named faces), expressions and colour
# lists. The parts use the conventions of k.objects (primitive shapes, boxes, points as wires, colours), so the
# renderer of k.objects draws them. The frame of a face is 0 to 100 on both axes, x to the right and y downwards.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.faces core.module name=k.faces version=1 exports=slot exports=variant exports=part exports=point exports=colour exports=preset exports=expression core.source="hand-core 1"

# A place of a face in one style: its anchor box in the face frame and its draw order (lower first). The parts of a
# variant lie inside the box of its slot. `mirror=true`: the slot is a pair (eyes, eyebrows, ears, cheeks, earrings);
# its box and its variants are the side on the viewer's left, and the renderer draws the other side mirrored at
# x = 50. `optional=true`: a face may leave the slot empty (no beard, no hat). Styles do not share slots: a style
# drawn elsewhere has its own boxes.
@k.faces.slot core.type of=k.faces.slot shared=true closed=true core.source="hand-core 1"
@k.faces.slot.style core.slot of=k.faces.slot key=style id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.slot.name core.slot of=k.faces.slot key=name id=true required=true kind=atom core.source="hand-core 1"
@k.faces.slot.x core.slot of=k.faces.slot key=x required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.slot.y core.slot of=k.faces.slot key=y required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.slot.w core.slot of=k.faces.slot key=w required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.slot.h core.slot of=k.faces.slot key=h required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.slot.z core.slot of=k.faces.slot key=z required=true kind=integer core.source="hand-core 1"
@k.faces.slot.mirror core.slot of=k.faces.slot key=mirror kind=boolean core.source="hand-core 1"
@k.faces.slot.optional core.slot of=k.faces.slot key=optional kind=boolean core.source="hand-core 1"

# One drawable shape for a slot. The features are plain words: `shape`, `size`, `length`, `feel` (many), `age` (for
# whom it fits, where the drawing shows it; many) and `kind` (what a person would call it: ponytail, goatee, cap).
# `style` keeps the drawings of one hand together: a face does not mix styles unless asked. `named=model`: a
# language model gave the features by looking at an imported drawing.
@k.faces.variant core.type of=k.faces.variant shared=true closed=true core.source="hand-core 1"
@k.faces.variant.slot core.slot of=k.faces.variant key=slot id=true required=true kind=atom core.source="hand-core 1"
@k.faces.variant.name core.slot of=k.faces.variant key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.variant.style core.slot of=k.faces.variant key=style required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.variant.shape core.slot of=k.faces.variant key=shape enum=round enum=oval enum=long enum=square enum=heart core.source="hand-core 1"
@k.faces.variant.size core.slot of=k.faces.variant key=size enum=small enum=medium enum=large core.source="hand-core 1"
@k.faces.variant.length core.slot of=k.faces.variant key=length enum=short enum=medium enum=long core.source="hand-core 1"
@k.faces.variant.feel core.slot of=k.faces.variant key=feel many=true enum=thin enum=thick enum=curly enum=straight enum=wavy enum=bushy enum=arched enum=flat enum=wide enum=narrow enum=open enum=closed enum=smiling enum=sad enum=surprised core.source="hand-core 1"
@k.faces.variant.age core.slot of=k.faces.variant key=age many=true enum=child enum=adult enum=old core.source="hand-core 1"
@k.faces.variant.kind core.slot of=k.faces.variant key=kind kind=atom kind=string core.source="hand-core 1"
@k.faces.variant.named core.slot of=k.faces.variant key=named enum=model core.source="hand-core 1"

# A part of a variant, as a k.objects part: a primitive shape with a box in the face frame, a draw order inside the
# variant and typical colours. `slot` and `of` name the variant. `tint` says which colour of the face fills the part
# (skin, hair, eyes, clothes; `skin_shade`, `hair_shade`, `clothes_shade`: the darker tone of that colour, for lines
# and folds on it); a part without `tint` keeps its own colour (`rgb`, or the colour name).
@k.faces.part core.type of=k.faces.part shared=true closed=true core.source="hand-core 1"
@k.faces.part.slot core.slot of=k.faces.part key=slot id=true required=true kind=atom core.source="hand-core 1"
@k.faces.part.of core.slot of=k.faces.part key=of id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.part.name core.slot of=k.faces.part key=name id=true required=true kind=atom core.source="hand-core 1"
@k.faces.part.kind core.slot of=k.faces.part key=kind kind=atom core.source="hand-core 1"
@k.faces.part.shape core.slot of=k.faces.part key=shape required=true enum=rectangle enum=square enum=circle enum=oval enum=triangle enum=line enum=arc enum=polygon core.source="hand-core 1"
@k.faces.part.x core.slot of=k.faces.part key=x required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.part.y core.slot of=k.faces.part key=y required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.part.w core.slot of=k.faces.part key=w required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.part.h core.slot of=k.faces.part key=h required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.part.z core.slot of=k.faces.part key=z required=true kind=integer core.source="hand-core 1"
@k.faces.part.colour core.slot of=k.faces.part key=colour required=true many=true enum=black enum=white enum=grey enum=red enum=orange enum=yellow enum=green enum=blue enum=purple enum=pink enum=brown core.source="hand-core 1"
@k.faces.part.rgb core.slot of=k.faces.part key=rgb kind=string core.source="hand-core 1"
@k.faces.part.tint core.slot of=k.faces.part key=tint enum=skin enum=skin_shade enum=hair enum=hair_shade enum=eyes enum=clothes enum=clothes_shade core.source="hand-core 1"
@k.faces.part.pointing core.slot of=k.faces.part key=pointing enum=up enum=down enum=left enum=right core.source="hand-core 1"
@k.faces.part.opens core.slot of=k.faces.part key=opens enum=up enum=down enum=left enum=right core.source="hand-core 1"

# A point of a line or polygon part, in the face frame, in drawing order.
@k.faces.point core.type of=k.faces.point shared=true closed=true core.source="hand-core 1"
@k.faces.point.part core.slot of=k.faces.point key=part id=true required=true kind=ref to=k.faces.part core.source="hand-core 1"
@k.faces.point.n core.slot of=k.faces.point key=n id=true required=true kind=integer min=1 core.source="hand-core 1"
@k.faces.point.x core.slot of=k.faces.point key=x required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.faces.point.y core.slot of=k.faces.point key=y required=true kind=number min=0 max=100 core.source="hand-core 1"

# A named colour for skin, hair, eyes or clothes: `rgb` as a string of the form "#RRGGBB", `shade` the darker tone
# used for lines on it. `natural=true`: a colour people have; `natural=false`: for robots and cartoon faces.
@k.faces.colour core.type of=k.faces.colour shared=true closed=true core.source="hand-core 1"
@k.faces.colour.of core.slot of=k.faces.colour key=of id=true required=true enum=skin enum=hair enum=eyes enum=clothes core.source="hand-core 1"
@k.faces.colour.name core.slot of=k.faces.colour key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.colour.rgb core.slot of=k.faces.colour key=rgb required=true kind=string core.source="hand-core 1"
@k.faces.colour.shade core.slot of=k.faces.colour key=shade required=true kind=string core.source="hand-core 1"
@k.faces.colour.natural core.slot of=k.faces.colour key=natural required=true kind=boolean core.source="hand-core 1"

# A named face: the name of one variant for each slot it fills (a slot left out is empty) and its four colours (names
# of k.faces.colour facts).
@k.faces.preset core.type of=k.faces.preset shared=true closed=true core.source="hand-core 1"
@k.faces.preset.name core.slot of=k.faces.preset key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.style core.slot of=k.faces.preset key=style required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.head core.slot of=k.faces.preset key=head required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.ears core.slot of=k.faces.preset key=ears kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.neck core.slot of=k.faces.preset key=neck kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.hair_back core.slot of=k.faces.preset key=hair_back kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.hair_front core.slot of=k.faces.preset key=hair_front kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.eyebrows core.slot of=k.faces.preset key=eyebrows kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.eyes core.slot of=k.faces.preset key=eyes required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.nose core.slot of=k.faces.preset key=nose kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.mouth core.slot of=k.faces.preset key=mouth required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.cheeks core.slot of=k.faces.preset key=cheeks kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.beard core.slot of=k.faces.preset key=beard kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.moustache core.slot of=k.faces.preset key=moustache kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.glasses core.slot of=k.faces.preset key=glasses kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.hat core.slot of=k.faces.preset key=hat kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.earrings core.slot of=k.faces.preset key=earrings kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.shoulders core.slot of=k.faces.preset key=shoulders kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.skin core.slot of=k.faces.preset key=skin required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.hair_colour core.slot of=k.faces.preset key=hair_colour required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.eye_colour core.slot of=k.faces.preset key=eye_colour required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.preset.clothes core.slot of=k.faces.preset key=clothes required=true kind=atom kind=string core.source="hand-core 1"

# An expression: the variants of mouth, eyebrows and eyes a face switches to (a key left out stays as the face has
# it). `one_eye`: the variant for the eye on the viewer's right only (a wink). `mouth_alt`: the second mouth of a
# pair that alternates (talking: open, closed).
@k.faces.expression core.type of=k.faces.expression shared=true closed=true core.source="hand-core 1"
@k.faces.expression.name core.slot of=k.faces.expression key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.style core.slot of=k.faces.expression key=style required=true kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.mouth core.slot of=k.faces.expression key=mouth kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.mouth_alt core.slot of=k.faces.expression key=mouth_alt kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.eyebrows core.slot of=k.faces.expression key=eyebrows kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.eyes core.slot of=k.faces.expression key=eyes kind=atom kind=string core.source="hand-core 1"
@k.faces.expression.one_eye core.slot of=k.faces.expression key=one_eye kind=atom kind=string core.source="hand-core 1"

# Words for the types and keys of this world.
@k.faces.word.face core.word text=face text=faces text=avatar text=avatars means=k.faces.preset core.source="hand-core 1"
@k.faces.word.slot core.word text=slot text=slots means=k.faces.slot core.source="hand-core 1"
@k.faces.word.variant core.word text=variant text=variants means=k.faces.variant core.source="hand-core 1"
@k.faces.word.expression core.word text=expression text=expressions means=k.faces.expression core.source="hand-core 1"
@k.faces.word.colour core.word text=colour text=color text=colours text=colors means=k.faces.colour core.source="hand-core 1"
@k.faces.word.shape core.word text=shape means=k.faces.variant.shape core.source="hand-core 1"
@k.faces.word.size core.word text=size means=k.faces.variant.size core.source="hand-core 1"
@k.faces.word.length core.word text=length means=k.faces.variant.length core.source="hand-core 1"
@k.faces.word.age core.word text=age means=k.faces.variant.age core.source="hand-core 1"
@k.faces.word.skin core.word text=skin means=k.faces.preset.skin core.source="hand-core 1"
