# k.animals: common animals: their class, legs, covering, sound, habitat, diet and food, the name of
# their young and of a group of them, and what they can and cannot do. Facts a child's encyclopedia states; where animals of one name differ, the key is left out.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)
# additions of Round 9 (not breaking): `group`, `named`; the class `myriapod`.
# Round 11 (Q32, breaking for a host that read `size` here): the size class and the usual place of an animal are in
# k.scenes.thing, as for every other thing; `thing` names that fact where its name is not the name of the animal.

@k.animals core.module name=k.animals version=3 imports=k.named exports=animal exports=class core.source="hand-core 1"

# An animal, named by its common English name (the same name in k.objects is its drawing, in k.commonsense its
# everyday facts). `legs` counts walking legs (a bird has 2, a fish 0); `covering` is what covers its body; `sound`
# is the verb for the sound it makes; `habitat` is where it lives; `diet` says whether it eats plants, animals or both
# and `eats` names typical food; `baby` is the name of its young; `can` names ways it moves and other abilities;
# `cannot` names a well-known thing it cannot do (a penguin cannot fly); a missing `can` says nothing;
# `drawing` names the k.objects object that draws it. The size class of the grown animal and its usual place are
# not said here: they are the `size` and `place` of the k.scenes.thing of the same name, or, where that name is
# there the name of another thing (a crane is also a machine), of the k.scenes.thing that `thing` names
# (`"crane bird"`). `group` is the name of a group of them (a herd of cows, a pride of lions).
# `named=model`: the fact was written by a language model, only where sure.
@k.animals.animal core.type of=k.animals.animal extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.animals.animal.name core.slot of=k.animals.animal key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.animals.animal.class core.slot of=k.animals.animal key=class required=true enum=mammal enum=bird enum=fish enum=reptile enum=amphibian enum=insect enum=arachnid enum=crustacean enum=mollusc enum=worm enum=cnidarian enum=echinoderm enum=myriapod core.source="hand-core 1"
@k.animals.animal.legs core.slot of=k.animals.animal key=legs kind=integer min=0 core.source="hand-core 1"
@k.animals.animal.covering core.slot of=k.animals.animal key=covering many=true enum=fur enum=hair enum=wool enum=feathers enum=scales enum=skin enum=shell enum=spines core.source="hand-core 1"
@k.animals.animal.sound core.slot of=k.animals.animal key=sound many=true kind=atom core.source="hand-core 1"
@k.animals.animal.habitat core.slot of=k.animals.animal key=habitat many=true kind=atom kind=string type=k.commonsense.lives by=in core.source="hand-core 1"
@k.animals.animal.diet core.slot of=k.animals.animal key=diet enum=herbivore enum=carnivore enum=omnivore core.source="hand-core 1"
@k.animals.animal.eats core.slot of=k.animals.animal key=eats many=true kind=atom kind=string core.source="hand-core 1"
@k.animals.animal.baby core.slot of=k.animals.animal key=baby kind=atom core.source="hand-core 1"
@k.animals.animal.can core.slot of=k.animals.animal key=can many=true kind=atom type=k.actions.action by=name core.source="hand-core 1"
@k.animals.animal.cannot core.slot of=k.animals.animal key=cannot many=true kind=atom type=k.actions.action by=name core.source="hand-core 1"
@k.animals.animal.drawing core.slot of=k.animals.animal key=drawing kind=atom kind=string type=k.objects.object by=name core.source="hand-core 1"
@k.animals.animal.thing core.slot of=k.animals.animal key=thing kind=atom kind=string type=k.objects.object by=name core.source="hand-core 1"
@k.animals.animal.group core.slot of=k.animals.animal key=group kind=atom core.source="hand-core 1"

# A class of animals and what every animal of the class has: the number of walking legs (an insect has 6, a
# spider and the other arachnids 8, a bird 2, a fish 0) and the covering (feathers, scales). The key is left out
# where animals of the class differ (a snake is a reptile without legs, a whale a mammal without fur).
@k.animals.class core.type of=k.animals.class extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.animals.class.name core.slot of=k.animals.class key=name id=true required=true kind=atom core.source="hand-core 1"
@k.animals.class.legs core.slot of=k.animals.class key=legs kind=integer min=0 core.source="hand-core 1"
@k.animals.class.covering core.slot of=k.animals.class key=covering enum=fur enum=hair enum=wool enum=feathers enum=scales enum=skin enum=shell enum=spines core.source="hand-core 1"

# One fact never has the same verb in `can` and in `cannot`.
@k.animals.both.can k.animals.animal name=?animal can=?verb
@k.animals.both.cannot k.animals.animal name=?animal cannot=?verb
@k.animals.both core.deny when=$k.animals.both.can when=$k.animals.both.cannot why="A ?animal is said both to ?verb and not to ?verb." core.source="hand-core 1"

# Words for the type and keys of this world.
@k.animals.word.animal core.word text=animal text=animals means=k.animals.animal core.source="hand-core 1"
@k.animals.word.class core.word text=class text=kind means=k.animals.animal.class core.source="hand-core 1"
@k.animals.word.legs core.word text=legs text=leg means=k.animals.animal.legs core.source="hand-core 1"
@k.animals.word.covering core.word text=covering text=covered means=k.animals.animal.covering core.source="hand-core 1"
@k.animals.word.sound core.word text=sound text=noise text=says means=k.animals.animal.sound core.source="hand-core 1"
@k.animals.word.habitat core.word text=habitat text=lives text=live means=k.animals.animal.habitat core.source="hand-core 1"
@k.animals.word.diet core.word text=diet means=k.animals.animal.diet core.source="hand-core 1"
@k.animals.word.eats core.word text=eats text=eat text=food means=k.animals.animal.eats core.source="hand-core 1"
@k.animals.word.baby core.word text=baby text=young means=k.animals.animal.baby core.source="hand-core 1"
# Q33: the young of a rabbit is a kit; "bunny" is the everyday word for it (as a child's book says it).
@k.animals.word.baby.kit core.word text=bunny text=bunnies means=kit of=k.animals.animal.baby core.source="hand-core 1"
@k.animals.word.cannot core.word text=cannot text="can not" means=k.animals.animal.cannot core.source="hand-core 1"
@k.animals.word.group core.word text=group text=herd text=flock text=pack means=k.animals.animal.group core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.animals.word.key.animal.baby core.word text=called means=k.animals.animal.baby core.source="hand-core 1"
@k.animals.word.key.animal.can core.word text=can text=able text=do means=k.animals.animal.can core.source="hand-core 1"
@k.animals.word.key.animal.cannot core.word text=unable means=k.animals.animal.cannot core.source="hand-core 1"
@k.animals.word.key.animal.drawing core.word text=drawing means=k.animals.animal.drawing core.source="hand-core 1"
@k.animals.word.key.animal.thing core.word text=thing means=k.animals.animal.thing core.source="hand-core 1"
@k.animals.word.key.class.legs core.word text=legs means=k.animals.class.legs core.source="hand-core 1"
@k.animals.word.key.class.covering core.word text=covering means=k.animals.class.covering core.source="hand-core 1"
