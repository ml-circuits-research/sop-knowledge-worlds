# w.lang.ro/shards/frames: Romanian frames and order (reviewer block "18:20" item 1): 39 frames from Romanian verbs to the acts of
# k.actions with their roles, in w.lang.en's frame vocabulary (each names the English frame it says: `en`), the phrase groups
# (leads, politeness, joined and bound clitics, wishes), lexicons (comparatives, directions) and the order facts a reader of
# them needs (adjective after its noun, genitive possessor, article suffix, clitic placement).
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: tools/lang-ro-frames.mjs

@w.lang.ro.syntax.adjective.after.noun w.lang.ro.syntax name=adjective.after.noun about="an adjective follows the noun it qualifies (o casă roșie); a host reading the noun phrase of a kind takes the first noun as the head and the adjectives after it as its values" core.source="hand-core 1"
@w.lang.ro.syntax.genitive.possessor w.lang.ro.syntax name=genitive.possessor about="the possessor follows its noun in the genitive, without a preposition (culoarea casei: the colour of the house); the frames take the attribute as one word, the thing after it" core.source="hand-core 1"
@w.lang.ro.syntax.article.suffix w.lang.ro.syntax name=article.suffix about="the definite article is a suffix of the noun (casa, copacul), a cell of its class; a determiner part takes only the free determiners (un, o, acest)" core.source="hand-core 1"
@w.lang.ro.syntax.clitic.joined w.lang.ro.syntax name=clitic.joined about="a pronoun object joins an imperative with a hyphen (șterge-l, pune-mi); a reader splits it (w.lang.ro.split) and the frame takes it as a word of clitic.joined, or as the thing when it is the object" core.source="hand-core 1"
@w.lang.ro.syntax.clitic.bound w.lang.ro.syntax name=clitic.bound about="before a finite verb the clitic stands free (îl mut, o șterg); the frames of the indicative take it as a word of clitic.bound" core.source="hand-core 1"
@w.lang.ro.syntax.subjunctive.after.wish w.lang.ro.syntax name=subjunctive.after.wish about="after a wish or an ability (vreau să, poți să) the verb is in the conjunctive (să desenezi): the lead phrase takes the wish, the verb part every form of the lemma" core.source="hand-core 1"
@w.lang.ro.phrase.lead.polite w.lang.ro.phrase name=lead.polite doc="words before a request: politeness, a wish, an ability, a sequence" item="te rog" item="vă rog" item="poți să" item="puteți să" item="ai putea să" item="hai să" item="aș vrea să" item="vreau să" item="acum" item="apoi" item="și" item="deci" item="te rog să" item="încearcă să" item="mai" core.source="hand-core 1"
@w.lang.ro.phrase.skip w.lang.ro.phrase name=skip doc="politeness words a reader skips wherever they stand (\"..., te rog\")" item="te rog" item="vă rog" item="mersi" item="mulțumesc" item="hm" item="ăă" item="pls" core.source="hand-core 1"
@w.lang.ro.phrase.clitic.joined w.lang.ro.phrase name=clitic.joined doc="the clitics joined to an imperative with a hyphen (w.lang.ro.pron clitic=joined): pune-l, scoate-ți, dă-mi" item="l" item="o" item="i" item="le" item="mi" item="ți" item="și" item="ne" item="vă" item="ni" item="vi" item="li" item="m" item="s" item="te" item="ne" core.source="hand-core 1"
@w.lang.ro.phrase.clitic.bound w.lang.ro.phrase name=clitic.bound doc="the clitics before a finite verb (w.lang.ro.pron clitic=bound): îl mut, o șterg" item="îl" item="o" item="îi" item="le" item="îmi" item="îți" item="își" item="ne" item="vă" item="mă" item="te" item="se" core.source="hand-core 1"
@w.lang.ro.phrase.wish w.lang.ro.phrase name=wish doc="a wish that names what to make" item="vreau" item="aș vrea" item="doresc" item="aș dori" item="mi-ar plăcea" item="îmi trebuie" item="dă-mi" core.source="hand-core 1"
@w.lang.ro.lex.cmp.more w.lang.ro.lex name=cmp.more doc="comparatives up: mai + an adjective of size" item="mai mare" item="mai mari" item="mai lung" item="mai lungă" item="mai lungi" item="mai înalt" item="mai înaltă" item="mai înalți" item="mai lat" item="mai lată" item="mai gros" item="mai groasă" item="mai larg" item="mai largă" item="mai multe" item="mai mulți" core.source="hand-core 1"
@w.lang.ro.lex.cmp.less w.lang.ro.lex name=cmp.less doc="comparatives down" item="mai mic" item="mai mică" item="mai mici" item="mai scurt" item="mai scurtă" item="mai scurți" item="mai scurte" item="mai îngust" item="mai îngustă" item="mai subțire" item="mai subțiri" item="mai puține" item="mai puțini" core.source="hand-core 1"
@w.lang.ro.lex.acts.dir w.lang.ro.lex name=acts.dir doc="directions of a move (the English lexicon acts.dir says them in English)" item="la stânga" item="la dreapta" item="în sus" item="în jos" item="sus" item="jos" item="mai aproape" item="mai departe" item="în față" item="în spate" item="la mijloc" item="în centru" item="stânga" item="dreapta" item="mai sus" item="mai jos" core.source="hand-core 1"
