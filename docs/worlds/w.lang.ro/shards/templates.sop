# script: tools/lang-ro-core.mjs

@w.lang.ro.template.make w.lang.ro.template act=make text="am desenat {art@kind} {kind:num=sg,case=nomacc,def=no} {colour@kind}" core.source="hand-core 1"
@w.lang.ro.template.remove w.lang.ro.template act=remove text="am șters {thing:num=sg,case=nomacc,def=yes}" core.source="hand-core 1"
@w.lang.ro.template.change w.lang.ro.template act=change text="{thing:num=sg,case=nomacc,def=yes} este acum {colour@thing}" core.source="hand-core 1"
