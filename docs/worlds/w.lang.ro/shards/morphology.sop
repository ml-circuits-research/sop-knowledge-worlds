# w.lang.ro/shards/morphology: Romanian morphology as rules (std.morph): paradigm classes with inheritance and alternations, the cells of each class (features -> suffix), the vowels, spelling folds and the clitic joiner.
# sources: hand-core 1 (written by hand in this repository)
# license: CC0-1.0
# script: tools/lang-ro-core.mjs

# vowels (for alternations at the last vowel), folds (a word written without diacritics), the clitic joiner
@w.lang.ro.vowel.all w.lang.ro.vowel text="aeiouăâî" core.source="hand-core 1"
@w.lang.ro.fold.u103 w.lang.ro.fold from="ă" to="a" core.source="hand-core 1"
@w.lang.ro.fold.ue2 w.lang.ro.fold from="â" to="a" core.source="hand-core 1"
@w.lang.ro.fold.uee w.lang.ro.fold from="î" to="i" core.source="hand-core 1"
@w.lang.ro.fold.u219 w.lang.ro.fold from="ș" to="s" core.source="hand-core 1"
@w.lang.ro.fold.u21b w.lang.ro.fold from="ț" to="t" core.source="hand-core 1"
@w.lang.ro.fold.u15f w.lang.ro.fold from="ş" to="s" core.source="hand-core 1"
@w.lang.ro.fold.u163 w.lang.ro.fold from="ţ" to="t" core.source="hand-core 1"
@w.lang.ro.fold.u102 w.lang.ro.fold from="Ă" to="A" core.source="hand-core 1"
@w.lang.ro.fold.uc2 w.lang.ro.fold from="Â" to="A" core.source="hand-core 1"
@w.lang.ro.fold.uce w.lang.ro.fold from="Î" to="I" core.source="hand-core 1"
@w.lang.ro.fold.u218 w.lang.ro.fold from="Ș" to="S" core.source="hand-core 1"
@w.lang.ro.fold.u21a w.lang.ro.fold from="Ț" to="T" core.source="hand-core 1"
@w.lang.ro.fold.u15e w.lang.ro.fold from="Ş" to="S" core.source="hand-core 1"
@w.lang.ro.fold.u162 w.lang.ro.fold from="Ţ" to="T" core.source="hand-core 1"
@w.lang.ro.split.1 w.lang.ro.split text="-" core.source="hand-core 1"

# paradigm classes
@w.lang.ro.class.m_cons w.lang.ro.class name=m.cons alt="t>ț@end" alt="d>z@end" alt="s>ș@end" pos=noun about="masculine, ends in a consonant, plural -i (copac, copaci, copacul, copacului, copacii, copacilor)" core.source="hand-core 1"
@w.lang.ro.class.m_e w.lang.ro.class name=m.e drop=e alt="t>ț@end" alt="d>z@end" alt="s>ș@end" pos=noun about="masculine in -e, plural -i (câine, câini, câinele)" core.source="hand-core 1"
@w.lang.ro.class.m_e_oa w.lang.ro.class name=m.e.oa parent=m.e alt="oa>o" alt="t>ț@end" alt="d>z@end" alt="s>ș@end" pos=noun about="as m.e, with oa > o in the plural (soare, sori)" core.source="hand-core 1"
@w.lang.ro.class.n_e w.lang.ro.class name=n.e pos=noun about="neuter, ends in a consonant, plural -e (desen, desene, desenul, desenele)" core.source="hand-core 1"
@w.lang.ro.class.n_e_oa w.lang.ro.class name=n.e.oa parent=n.e alt="o>oa" pos=noun about="as n.e, with o > oa in the plural (picior, picioare; editor, editoare)" core.source="hand-core 1"
@w.lang.ro.class.n_e_a2 w.lang.ro.class name=n.e.ă parent=n.e alt="ă>e@vowel" pos=noun about="as n.e, with ă > e in the plural (măr, mere; număr, numere)" core.source="hand-core 1"
@w.lang.ro.class.n_uri w.lang.ro.class name=n.uri pos=noun about="neuter, ends in a consonant, plural -uri (cerc, cercuri, cercul, cercurile)" core.source="hand-core 1"
@w.lang.ro.class.n_u w.lang.ro.class name=n.u parent=n.uri drop=u pos=noun about="as n.uri, the lemma ends in -u (titlu, titluri, titlul)" core.source="hand-core 1"
@w.lang.ro.class.f_a2 w.lang.ro.class name=f.ă drop=ă pos=noun about="feminine in -ă, plural -e (casă, case, casa, casei, casele)" core.source="hand-core 1"
@w.lang.ro.class.f_a2_e w.lang.ro.class name=f.ă.e parent=f.ă alt="a>e@vowel" pos=noun about="as f.ă, with a > e before -e (pară, pere; masă, mese)" core.source="hand-core 1"
@w.lang.ro.class.f_a2i w.lang.ro.class name=f.ăi parent=f.ă pos=noun about="feminine in -ă, plural -i (mașină, mașini, mașinii)" core.source="hand-core 1"
@w.lang.ro.class.f_a2i_a w.lang.ro.class name=f.ăi.a parent=f.ăi alt="a>ă@vowel" alt="t>ț@end" pos=noun about="as f.ăi, with a > ă and t > ț before -i (barcă, bărci; hartă, hărți)" core.source="hand-core 1"
@w.lang.ro.class.f_e w.lang.ro.class name=f.e drop=e pos=noun about="feminine in -e, plural -i (pâine, pâini, pâinea, pâinii)" core.source="hand-core 1"
@w.lang.ro.class.f_e_alt w.lang.ro.class name=f.e.alt parent=f.e alt="oa>o" alt="a>ă@vowel" alt="t>ț@end" pos=noun about="as f.e, with oa > o, a > ă and t > ț before -i (floare, flori; carte, cărți; noapte, nopți)" core.source="hand-core 1"
@w.lang.ro.class.f_ie w.lang.ro.class name=f.ie parent=f.e pos=noun about="feminine in -ie, plural -ii (linie, linii, linia, liniei)" core.source="hand-core 1"
@w.lang.ro.class.f_ea w.lang.ro.class name=f.ea drop=a pos=noun about="feminine in -ea, plural -le (stea, stele, steaua, stelei)" core.source="hand-core 1"
@w.lang.ro.class.a_1 w.lang.ro.class name=a.1 pos=adjective about="four forms: m -, f -ă, m pl -i (softened), f pl -e (galben, galbenă, galbeni, galbene)" core.source="hand-core 1"
@w.lang.ro.class.a_1i w.lang.ro.class name=a.1i parent=a.1 pos=adjective about="as a.1, feminine plural -i (mic, mică, mici, mici)" core.source="hand-core 1"
@w.lang.ro.class.a_1_oa w.lang.ro.class name=a.1.oa parent=a.1 pos=adjective about="as a.1, with o > oa in the feminine (frumos, frumoasă, frumoși, frumoase)" core.source="hand-core 1"
@w.lang.ro.class.a_e w.lang.ro.class name=a.e drop=e pos=adjective about="two forms: -e, plural -i (mare, mari; verde, verzi)" core.source="hand-core 1"
@w.lang.ro.class.a_u w.lang.ro.class name=a.u drop=u pos=adjective about="m -u, f -ie, plural -ii (roșu, roșie, roșii)" core.source="hand-core 1"
@w.lang.ro.class.a_iu w.lang.ro.class name=a.iu drop=u pos=adjective about="m -iu, f -ie, plural -ii (portocaliu, portocalie, portocalii)" core.source="hand-core 1"
@w.lang.ro.class.a_ru w.lang.ro.class name=a.ru drop=u pos=adjective about="m -u after a consonant, f -ă, m pl -i, f pl -e (albastru, albastră, albaștri, albastre; negru, neagră)" core.source="hand-core 1"
@w.lang.ro.class.a_inv w.lang.ro.class name=a.inv pos=adjective about="one form for every gender and number (mov, roz, maro)" core.source="hand-core 1"
@w.lang.ro.class.det_art w.lang.ro.class name=det.art parent=a.inv pos=adjective about="the indefinite article, agreeing with its noun as an adjective does; every form irregular (un, o, niște; unui, unei, unor)" core.source="hand-core 1"
@w.lang.ro.class.v_a w.lang.ro.class name=v.a drop=a pos=verb about="first conjugation, no suffix (muta: mut, muți, mută; mută!)" core.source="hand-core 1"
@w.lang.ro.class.v_a_a23 w.lang.ro.class name=v.a.ă3 parent=v.a alt="ă>a" pos=verb about="as v.a, with ă > a where the stem is stressed in the 3rd person (arăta: arăt, arată)" core.source="hand-core 1"
@w.lang.ro.class.v_a_a2 w.lang.ro.class name=v.a.ă parent=v.a alt="ă>a" pos=verb about="as v.a, with ă > a where the stem is stressed (adăuga: adaug, adaugi, adaugă)" core.source="hand-core 1"
@w.lang.ro.class.v_a_u w.lang.ro.class name=v.a.u parent=v.a pos=verb about="as v.a, with u > o and u > oa where the stem is stressed (juca: joc, joci, joacă)" core.source="hand-core 1"
@w.lang.ro.class.v_a_oa w.lang.ro.class name=v.a.oa parent=v.a alt="o>oa" pos=verb about="as v.a, with o > oa in the 3rd person (îngroșa: îngroș, îngroașă)" core.source="hand-core 1"
@w.lang.ro.class.v_a_ez w.lang.ro.class name=v.a.ez drop=a pos=verb about="first conjugation with -ez (desena: desenez, desenează; desenează!)" core.source="hand-core 1"
@w.lang.ro.class.v_a_iez w.lang.ro.class name=v.a.iez parent=v.a.ez pos=verb about="as v.a.ez after i (copia: copiez, copiază, copiem)" core.source="hand-core 1"
@w.lang.ro.class.v_ea w.lang.ro.class name=v.ea drop=ea pos=verb about="second conjugation in -ea (a stem stressed in the present)" core.source="hand-core 1"
@w.lang.ro.class.v_ea_u w.lang.ro.class name=v.ea.u parent=v.ea pos=verb about="as v.ea, with u > o and u > oa (putea: pot, poți, poate)" core.source="hand-core 1"
@w.lang.ro.class.v_ea_a2 w.lang.ro.class name=v.ea.ă parent=v.ea alt="ă>a" pos=verb about="as v.ea, with ă > a where the stem is stressed (plăcea: plac, place)" core.source="hand-core 1"
@w.lang.ro.class.v_e w.lang.ro.class name=v.e drop=e pos=verb about="third conjugation in -e, participle -ut (face: fac, faci, face; făcut)" core.source="hand-core 1"
@w.lang.ro.class.v_e_s_d w.lang.ro.class name=v.e.s.d parent=v.e pos=verb about="as v.e, participle d > s (deschide: deschis)" core.source="hand-core 1"
@w.lang.ro.class.v_e_s_g w.lang.ro.class name=v.e.s.g parent=v.e pos=verb about="as v.e, participle g > s (șterge: șters)" core.source="hand-core 1"
@w.lang.ro.class.v_e_n w.lang.ro.class name=v.e.n parent=v.e pos=verb about="as v.e, stem in -n, 2nd person singular n > i (obține: obțin, obții)" core.source="hand-core 1"
@w.lang.ro.class.v_e_s_n w.lang.ro.class name=v.e.s.n parent=v.e.n pos=verb about="as v.e.n, participle n > s (pune: pui, pus)" core.source="hand-core 1"
@w.lang.ro.class.v_e_s_t w.lang.ro.class name=v.e.s.t parent=v.e pos=verb about="as v.e, participle t > s (trimite: trimis; scoate: scos)" core.source="hand-core 1"
@w.lang.ro.class.v_e_s_c w.lang.ro.class name=v.e.s.c parent=v.e pos=verb about="as v.e, participle c > s (întoarce: întors; duce: dus)" core.source="hand-core 1"
@w.lang.ro.class.v_e_iu w.lang.ro.class name=v.e.iu parent=v.e pos=verb about="as v.e, stem in -i, 1st person -u, participle -s (scrie: scriu, scrii, scris)" core.source="hand-core 1"
@w.lang.ro.class.v_i_esc w.lang.ro.class name=v.i.esc drop=i pos=verb about="fourth conjugation with -esc (vorbi: vorbesc, vorbește; vorbește!)" core.source="hand-core 1"
@w.lang.ro.class.v_i_iesc w.lang.ro.class name=v.i.iesc parent=v.i.esc pos=verb about="as v.i.esc after a vowel (înlocui: înlocuiesc, înlocuiește)" core.source="hand-core 1"

# cells
