# k.geo: geography: continents, countries and territories (capital, continent, region, neighbours, population, area,
# centre, bounding box), their largest cities, rivers, mountains, mountain ranges, lakes, deserts, oceans and seas
# with names. A number that is only approximate is a key with the suffix `_about` (the area of a lake, the length
# of a river). The unit of every number is a k.units.measure fact of the world k.units. Places are points
# and boxes only: lat and lon are degrees north and east (negative: south, west); west, south, east, north bound a box.
# sources: natural-earth 5.1.2, countries 5.1.0; the schema itself is hand-core 1
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/import/geo.mjs

@k.geo core.module name=k.geo version=5 imports=k.named exports=continent exports=country exports=city exports=river exports=mountain exports=range exports=lake exports=desert exports=sea exports=group core.source="hand-core 1"

@k.geo.continent core.type of=k.geo.continent extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.geo.continent.name core.slot of=k.geo.continent key=name id=true required=true kind=atom kind=string core.source="hand-core 1"

# A country or territory. `name` is its common short English name (`"United States"`, `Serbia`), `formal` its formal name; `neighbour` names the countries it has a land border with;
# `population` counts people; `area` is in square kilometres.
@k.geo.country core.type of=k.geo.country shared=true closed=true core.source="hand-core 1"
@k.geo.country.name core.slot of=k.geo.country key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.country.code core.slot of=k.geo.country key=code kind=atom core.source="hand-core 1"
# `code2` is the two-letter code of the country (ISO 3166-1 alpha-2: FR) next to the three-letter `code` (FRA);
# `currency` the name of its money; `language` (many) its official languages (from the country list, shard psys2-countries).
@k.geo.country.code2 core.slot of=k.geo.country key=code2 kind=atom core.source="hand-core 1"
@k.geo.country.currency core.slot of=k.geo.country key=currency kind=atom kind=string core.source="hand-core 1"
@k.geo.country.language core.slot of=k.geo.country key=language many=true kind=atom kind=string core.source="hand-core 1"
@k.geo.country.formal core.slot of=k.geo.country key=formal kind=string core.source="hand-core 1"
@k.geo.country.capital core.slot of=k.geo.country key=capital many=true kind=atom kind=string type=k.geo.city by=name core.source="hand-core 1"
@k.geo.country.continent core.slot of=k.geo.country key=continent kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
# `political_continent`: the continent a country is counted in politically, where that is another than its
# geographic `continent` (Cyprus: continent Asia, political_continent Europe). `independent` is not said for a state
# that governs itself without being generally recognised (Taiwan, Kosovo, Somaliland, Northern Cyprus); for those
# `recognition=limited` says so (from Natural Earth), and a host asked whether one is independent says that.
@k.geo.country.political_continent core.slot of=k.geo.country key=political_continent kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.country.region core.slot of=k.geo.country key=region kind=atom kind=string core.source="hand-core 1"
@k.geo.country.neighbour core.slot of=k.geo.country key=neighbour many=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.country.population core.slot of=k.geo.country key=population kind=integer min=0 core.source="hand-core 1"
@k.geo.country.area core.slot of=k.geo.country key=area kind=number min=0 core.source="hand-core 1"
@k.geo.country.landlocked core.slot of=k.geo.country key=landlocked kind=boolean core.source="hand-core 1"
@k.geo.country.independent core.slot of=k.geo.country key=independent kind=boolean core.source="hand-core 1"
@k.geo.country.recognition core.slot of=k.geo.country key=recognition kind=atom enum=limited core.source="hand-core 1"
@k.geo.country.lat core.slot of=k.geo.country key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.country.lon core.slot of=k.geo.country key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.country.west core.slot of=k.geo.country key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.country.south core.slot of=k.geo.country key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.country.east core.slot of=k.geo.country key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.country.north core.slot of=k.geo.country key=north kind=number min=-90 max=90 core.source="hand-core 1"

# A city: one of the largest of its country, or its capital (`capital_of` names the country).
@k.geo.city core.type of=k.geo.city shared=true closed=true core.source="hand-core 1"
@k.geo.city.name core.slot of=k.geo.city key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.city.country core.slot of=k.geo.city key=country id=true required=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.city.capital_of core.slot of=k.geo.city key=capital_of kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.city.population core.slot of=k.geo.city key=population kind=integer min=0 core.source="hand-core 1"
@k.geo.city.lat core.slot of=k.geo.city key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.city.lon core.slot of=k.geo.city key=lon kind=number min=-180 max=180 core.source="hand-core 1"

# A river: the countries it flows through, the continent most of it is in, its middle and its box.
@k.geo.river core.type of=k.geo.river extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.geo.river.name core.slot of=k.geo.river key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.river.continent core.slot of=k.geo.river key=continent id=true required=true kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.river.country core.slot of=k.geo.river key=country many=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.river.lat core.slot of=k.geo.river key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.river.lon core.slot of=k.geo.river key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.river.west core.slot of=k.geo.river key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.river.south core.slot of=k.geo.river key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.river.east core.slot of=k.geo.river key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.river.north core.slot of=k.geo.river key=north kind=number min=-90 max=90 core.source="hand-core 1"

# A mountain: a named summit; `elevation` is its height in metres above the sea.
@k.geo.mountain core.type of=k.geo.mountain shared=true closed=true core.source="hand-core 1"
@k.geo.mountain.name core.slot of=k.geo.mountain key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.mountain.continent core.slot of=k.geo.mountain key=continent id=true required=true kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.mountain.country core.slot of=k.geo.mountain key=country kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.mountain.elevation core.slot of=k.geo.mountain key=elevation kind=integer core.source="hand-core 1"
@k.geo.mountain.lat core.slot of=k.geo.mountain key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.mountain.lon core.slot of=k.geo.mountain key=lon kind=number min=-180 max=180 core.source="hand-core 1"

# A mountain range: a name, a middle and a box.
@k.geo.range core.type of=k.geo.range shared=true closed=true core.source="hand-core 1"
@k.geo.range.name core.slot of=k.geo.range key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.range.continent core.slot of=k.geo.range key=continent id=true required=true kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.range.lat core.slot of=k.geo.range key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.range.lon core.slot of=k.geo.range key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.range.west core.slot of=k.geo.range key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.range.south core.slot of=k.geo.range key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.range.east core.slot of=k.geo.range key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.range.north core.slot of=k.geo.range key=north kind=number min=-90 max=90 core.source="hand-core 1"

# Round 9. A lake: one of the 100 largest natural lakes; `area_about` is the area of its outline in square
# kilometres (approximate: the water level changes); the countries on its shores; its middle and its box.
@k.geo.lake core.type of=k.geo.lake shared=true closed=true core.source="hand-core 1"
@k.geo.lake.name core.slot of=k.geo.lake key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.lake.continent core.slot of=k.geo.lake key=continent kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.lake.country core.slot of=k.geo.lake key=country many=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.lake.area_about core.slot of=k.geo.lake key=area_about kind=number min=0 core.source="hand-core 1"
@k.geo.lake.lat core.slot of=k.geo.lake key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.lake.lon core.slot of=k.geo.lake key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.lake.west core.slot of=k.geo.lake key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.lake.south core.slot of=k.geo.lake key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.lake.east core.slot of=k.geo.lake key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.lake.north core.slot of=k.geo.lake key=north kind=number min=-90 max=90 core.source="hand-core 1"

# A desert: its continent, its middle and its box; `area_about` in square kilometres where a usual figure exists
# (the edge of a desert is not a line). `named=model`: that figure was written by a language model, only where sure.
@k.geo.desert core.type of=k.geo.desert extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.geo.desert.name core.slot of=k.geo.desert key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.desert.continent core.slot of=k.geo.desert key=continent kind=atom kind=string type=k.geo.continent by=name core.source="hand-core 1"
@k.geo.desert.area_about core.slot of=k.geo.desert key=area_about kind=number min=0 core.source="hand-core 1"
@k.geo.desert.lat core.slot of=k.geo.desert key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.desert.lon core.slot of=k.geo.desert key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.desert.west core.slot of=k.geo.desert key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.desert.south core.slot of=k.geo.desert key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.desert.east core.slot of=k.geo.desert key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.desert.north core.slot of=k.geo.desert key=north kind=number min=-90 max=90 core.source="hand-core 1"

# An ocean, a sea or a part of one: `kind` (ocean, sea, gulf, bay, strait, channel), its middle and its box;
# `area_about` in square kilometres where a usual figure exists (`named=model`).
@k.geo.sea core.type of=k.geo.sea extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.geo.sea.name core.slot of=k.geo.sea key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.sea.kind core.slot of=k.geo.sea key=kind required=true enum=ocean enum=sea enum=gulf enum=bay enum=strait enum=channel core.source="hand-core 1"
@k.geo.sea.area_about core.slot of=k.geo.sea key=area_about kind=number min=0 core.source="hand-core 1"
@k.geo.sea.lat core.slot of=k.geo.sea key=lat kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.sea.lon core.slot of=k.geo.sea key=lon kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.sea.west core.slot of=k.geo.sea key=west kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.sea.south core.slot of=k.geo.sea key=south kind=number min=-90 max=90 core.source="hand-core 1"
@k.geo.sea.east core.slot of=k.geo.sea key=east kind=number min=-180 max=180 core.source="hand-core 1"
@k.geo.sea.north core.slot of=k.geo.sea key=north kind=number min=-90 max=90 core.source="hand-core 1"

# Approximate numbers on the older types: the area of a continent in square kilometres and the length of a river
# in kilometres, as usually given (`named=model`: written by a language model, only where sure).
@k.geo.continent.area_about core.slot of=k.geo.continent key=area_about kind=number min=0 core.source="hand-core 1"
@k.geo.river.length_about core.slot of=k.geo.river key=length_about kind=number min=0 core.source="hand-core 1"

# Words for the types and keys of this world.
@k.geo.word.country core.word text=country text=countries text=nation means=k.geo.country core.source="hand-core 1"
@k.geo.word.city core.word text=city text=cities text=town means=k.geo.city core.source="hand-core 1"
@k.geo.word.river core.word text=river text=rivers means=k.geo.river core.source="hand-core 1"
@k.geo.word.mountain core.word text=mountain text=mountains text=peak means=k.geo.mountain core.source="hand-core 1"
@k.geo.word.range core.word text=range text=ranges means=k.geo.range core.source="hand-core 1"
@k.geo.word.continent core.word text=continent text=continents means=k.geo.continent core.source="hand-core 1"
@k.geo.word.capital core.word text=capital text=capitals means=k.geo.country.capital core.source="hand-core 1"
@k.geo.word.neighbour core.word text=neighbour text=neighbours text=neighbor text=neighbors text=border text=borders means=k.geo.country.neighbour core.source="hand-core 1"
@k.geo.word.population core.word text=population text=people text=inhabitants means=k.geo.country.population core.source="hand-core 1"
@k.geo.word.area core.word text=area means=k.geo.country.area core.source="hand-core 1"
@k.geo.word.elevation core.word text=elevation text=height text=high means=k.geo.mountain.elevation core.source="hand-core 1"
@k.geo.word.lake core.word text=lake text=lakes means=k.geo.lake core.source="hand-core 1"
@k.geo.word.desert core.word text=desert text=deserts means=k.geo.desert core.source="hand-core 1"
@k.geo.word.sea core.word text=sea text=seas text=ocean text=oceans text=gulf text=bay means=k.geo.sea core.source="hand-core 1"
@k.geo.word.length core.word text=length text=long means=k.geo.river.length_about core.source="hand-core 1"

# A group of countries by a treaty or by custom (the European Union, NATO, Scandinavia, the Balkans): `member`
# (many) names its countries (values of k.geo.country.name), `as_of` the year the list was written.
@k.geo.group core.type of=k.geo.group shared=true closed=true core.source="hand-core 1"
@k.geo.group.name core.slot of=k.geo.group key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.geo.group.member core.slot of=k.geo.group key=member many=true required=true kind=atom kind=string type=k.geo.country by=name core.source="hand-core 1"
@k.geo.group.as_of core.slot of=k.geo.group key=as_of kind=integer core.source="hand-core 1"
@k.geo.word.group core.word text=group text=union text=alliance text=member text=members means=k.geo.group core.source="hand-core 1"
@k.geo.word.currency core.word text=currency text=money means=k.geo.country.currency core.source="hand-core 1"
@k.geo.word.language core.word text=language text=languages text=speak text=spoken means=k.geo.country.language core.source="hand-core 1"

