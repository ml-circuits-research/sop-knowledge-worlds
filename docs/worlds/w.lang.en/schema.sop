@w.lang.en.role_map.act_role core.slot of=w.lang.en.role_map key=act_role required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.role_map.marker core.slot of=w.lang.en.role_map key=marker enum=yes core.source="hand-core 1"
@w.lang.en.role_map.takes core.slot of=w.lang.en.role_map key=takes enum=words enum=rest enum=number enum=prep enum=lexicon core.source="hand-core 1"
@w.lang.en.role_map.frame core.slot of=w.lang.en.role_map key=frame kind=atom core.source="hand-core 1"
@w.lang.en.role_map.doc core.slot of=w.lang.en.role_map key=doc kind=string core.source="hand-core 1"
# A fixed argument of a frame: "Call yourself Robi" sets the attribute name.
@w.lang.en.fixed core.type of=w.lang.en.fixed shared=true closed=true core.source="hand-core 1"
@w.lang.en.fixed.frame core.slot of=w.lang.en.fixed key=frame id=true required=true kind=atom core.source="hand-core 1"
