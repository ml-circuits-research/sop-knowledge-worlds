@w.lang.en.neg.means core.slot of=w.lang.en.neg key=means enum=negation enum=removal core.source="hand-core 1"
# The words that turn a request into "do not"; the words after "do not" that make it no negated request.
@w.lang.en.neg.imperative core.type of=w.lang.en.neg.imperative shared=true closed=true core.source="psys2 78f45863"
