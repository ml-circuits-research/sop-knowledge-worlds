@w.lang.en.wh.in core.slot of=w.lang.en.wh key=in many=true kind=atom core.source="psys2 78f45863"
# An auxiliary that opens a yes/no question: `support` do or have, `modal` what a modal says.
@w.lang.en.aux core.type of=w.lang.en.aux shared=true closed=true core.source="psys2 78f45863"
