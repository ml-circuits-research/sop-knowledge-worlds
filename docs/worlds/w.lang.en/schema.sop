# w.lang.en: what is known about English grammar, as facts, for any application that reads English. Closed word
# classes (determiners, pronouns, prepositions, small numbers), morphology, clause structure, ellipsis markers, the
# grammar as plain productions over categories with the English constructions they belong to, the argument frames of
# the acts of k.actions, and phrase groups. Open-class words are not here: nouns and adjectives are k.words, verbs
# k.actions, number words and colours k.values. A parser that applies this world is the library's std.grammar
# (soplang-words-lib); a category is read from the facts of the type its `w.lang.en.cat` names (`type=`).
# sources: psys2 78f45863 (PSys2 handover/lang.en, the demo's English as facts; CC0); hand-core 1 (what this
#   repository added: the types of parts, constructions, categories and words, and the slot lines)
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/import/psys2-lang-en.mjs, except shards/hand-*.sop

@w.lang.en core.module name=w.lang.en version=1 exports=det exports=pron exports=anaphor exports=prep exports=prep.time exports=ordinal exports=numeral exports=inflect exports=irregular exports=noun.exception exports=contraction exports=contraction.ending exports=cat exports=word exports=rule exports=construction exports=frame exports=part exports=fixed exports=phrase exports=lex exports=joiner exports=frame_lead exports=correction exports=correction.lead exports=answer exports=wh exports=aux exports=neg exports=neg.imperative exports=neg.imperative.skip exports=imperative.lead exports=ellipsis.lead exports=ellipsis.trail exports=ellipsis.repeat exports=ellipsis.starter exports=ellipsis.param exports=coord.sep exports=coord.param exports=relpron exports=copula exports=partitive exports=other exports=choice exports=role_map core.source="psys2 78f45863"

# ---- closed word classes ----
# A determiner or quantifier. `in` names a view: one of the lists PSys2 kept in its modules (acts, expand, dialogue,
# discourse, routing); the views differ by accident and are kept until an application unifies them.
@w.lang.en.det core.type of=w.lang.en.det shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.det.text core.slot of=w.lang.en.det key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.det.kind core.slot of=w.lang.en.det key=kind required=true enum=article enum=demonstrative enum=possessive enum=quantifier enum=numeral enum=modifier core.source="psys2 78f45863"
@w.lang.en.det.definite core.slot of=w.lang.en.det key=definite enum=yes enum=no core.source="psys2 78f45863"
@w.lang.en.det.number core.slot of=w.lang.en.det key=number enum=sg enum=pl enum=any core.source="psys2 78f45863"
@w.lang.en.det.person core.slot of=w.lang.en.det key=person kind=integer min=1 max=3 core.source="psys2 78f45863"
@w.lang.en.det.gender core.slot of=w.lang.en.det key=gender enum=m enum=f enum=n core.source="psys2 78f45863"
@w.lang.en.det.distance core.slot of=w.lang.en.det key=distance enum=near enum=far core.source="psys2 78f45863"
@w.lang.en.det.value core.slot of=w.lang.en.det key=value kind=integer core.source="psys2 78f45863"
@w.lang.en.det.variant_of core.slot of=w.lang.en.det key=variant_of kind=atom core.source="psys2 78f45863"
@w.lang.en.det.register core.slot of=w.lang.en.det key=register enum=chat core.source="psys2 78f45863"
@w.lang.en.det.meaning core.slot of=w.lang.en.det key=meaning kind=atom core.source="psys2 78f45863"
@w.lang.en.det.note core.slot of=w.lang.en.det key=note kind=string core.source="psys2 78f45863"
@w.lang.en.det.in core.slot of=w.lang.en.det key=in many=true kind=atom core.source="psys2 78f45863"

# A pronoun. `refers`: thing (a thing of the scene or of the dialogue), place, an agent by gender (m, f, any), or
# the user, or the assistant. `case` may repeat (it: subject and object).
@w.lang.en.pron core.type of=w.lang.en.pron shared=true closed=true core.source="psys2 78f45863"
