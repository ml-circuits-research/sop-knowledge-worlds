@w.lang.en.aux.modal core.slot of=w.lang.en.aux key=modal many=true enum=ability enum=politeness enum=future enum=conditional enum=advice core.source="psys2 78f45863"
@w.lang.en.aux.negated core.slot of=w.lang.en.aux key=negated enum=yes core.source="hand-core 1"
