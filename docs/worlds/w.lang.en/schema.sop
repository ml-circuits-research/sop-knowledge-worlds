@w.lang.en.pron.case core.slot of=w.lang.en.pron key=case many=true required=true enum=subject enum=object enum=possessive enum=demonstrative enum=locative core.source="psys2 78f45863"
@w.lang.en.pron.person core.slot of=w.lang.en.pron key=person kind=integer min=1 max=3 core.source="psys2 78f45863"
@w.lang.en.pron.number core.slot of=w.lang.en.pron key=number enum=sg enum=pl core.source="psys2 78f45863"
@w.lang.en.pron.gender core.slot of=w.lang.en.pron key=gender enum=m enum=f enum=n core.source="psys2 78f45863"
@w.lang.en.pron.refers core.slot of=w.lang.en.pron key=refers many=true required=true enum=thing enum=place enum=m enum=f enum=any enum=user enum=assistant core.source="psys2 78f45863"
@w.lang.en.pron.distance core.slot of=w.lang.en.pron key=distance enum=near enum=far core.source="psys2 78f45863"
@w.lang.en.pron.deictic core.slot of=w.lang.en.pron key=deictic kind=atom core.source="psys2 78f45863"
@w.lang.en.pron.in core.slot of=w.lang.en.pron key=in many=true kind=atom core.source="psys2 78f45863"

# An anaphoric noun phrase of a dialogue ("that one", "this animal"): `order` is the order they are tried (longest
# first), `head` the word that is its noun (none for a bare pronoun).
@w.lang.en.anaphor core.type of=w.lang.en.anaphor shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.anaphor.text core.slot of=w.lang.en.anaphor key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.anaphor.order core.slot of=w.lang.en.anaphor key=order required=true kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.anaphor.head core.slot of=w.lang.en.anaphor key=head kind=atom core.source="psys2 78f45863"
@w.lang.en.anaphor.in core.slot of=w.lang.en.anaphor key=in many=true kind=atom core.source="psys2 78f45863"

# A preposition as a relation. `rel` the relation (the relation names of k.layouts where it is a place), `space`
# whether it says a place (static), a goal (direction), a source or a way (path), `role` the roles that are no
# places, `support` and `contain` what the place does, `arity` 2 when it takes two things (between).
@w.lang.en.prep core.type of=w.lang.en.prep shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.prep.text core.slot of=w.lang.en.prep key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.prep.rel core.slot of=w.lang.en.prep key=rel required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.prep.space core.slot of=w.lang.en.prep key=space enum=static enum=direction enum=source enum=path core.source="psys2 78f45863"
@w.lang.en.prep.role core.slot of=w.lang.en.prep key=role many=true enum=accompaniment enum=instrument enum=part enum=possession enum=beneficiary enum=purpose enum=topic enum=role enum=similarity enum=criterion enum=replacement core.source="psys2 78f45863"
@w.lang.en.prep.support core.slot of=w.lang.en.prep key=support enum=yes core.source="psys2 78f45863"
@w.lang.en.prep.contain core.slot of=w.lang.en.prep key=contain enum=yes core.source="psys2 78f45863"
@w.lang.en.prep.arity core.slot of=w.lang.en.prep key=arity kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.prep.note core.slot of=w.lang.en.prep key=note kind=string core.source="psys2 78f45863"
@w.lang.en.prep.in core.slot of=w.lang.en.prep key=in many=true kind=atom core.source="psys2 78f45863"
# The join to k.layouts: `layout` is the relation of k.layouts.relation the preposition says (on, inside, above,
# left_of, behind, beside, around); `inverse=yes` when it says it the other way round (a under b = b above a).
@w.lang.en.prep.layout core.slot of=w.lang.en.prep key=layout enum=left_of enum=above enum=inside enum=around enum=on enum=behind enum=beside core.source="hand-core 1"
@w.lang.en.prep.inverse core.slot of=w.lang.en.prep key=inverse enum=yes core.source="hand-core 1"

# A temporal preposition: `order` the place of the first thing against the second on a line of time (earlier, later,
# within), `span` the end it names (until: the end; since: the start). What orders things in time is k.time's.
@w.lang.en.prep.time core.type of=w.lang.en.prep.time shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.prep.time.text core.slot of=w.lang.en.prep.time key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.prep.time.rel core.slot of=w.lang.en.prep.time key=rel required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.prep.time.order core.slot of=w.lang.en.prep.time key=order required=true enum=earlier enum=later enum=within core.source="psys2 78f45863"
@w.lang.en.prep.time.span core.slot of=w.lang.en.prep.time key=span enum=start enum=end core.source="psys2 78f45863"
@w.lang.en.prep.time.in core.slot of=w.lang.en.prep.time key=in many=true kind=atom core.source="psys2 78f45863"
# The join to k.time: `relation` the fact type that says it (k.time.before, k.time.during), `first_is` and `second_is`
# which of its keys the first and the second thing of the phrase are ("Monday before Friday": Monday is the `earlier`,
# Friday the `later`; "December after November": December the `later`; "January during winter": January the `time`,
# winter the `span`). With `span` (until, since) the second thing is where a span ends or starts, so the same time
# holds too ("open until Friday" includes Friday): a host also accepts the first thing equal to the second.
@w.lang.en.prep.time.relation core.slot of=w.lang.en.prep.time key=relation kind=atom core.source="hand-core 1"
@w.lang.en.prep.time.first_is core.slot of=w.lang.en.prep.time key=first_is enum=earlier enum=later enum=time core.source="hand-core 1"
@w.lang.en.prep.time.second_is core.slot of=w.lang.en.prep.time key=second_is enum=earlier enum=later enum=span core.source="hand-core 1"

# Ordinals and small cardinals a reader needs before the catalog is reachable. k.values.number holds every number
# word; these agree with it (a test). `last` counts from the end (value -1).
@w.lang.en.ordinal core.type of=w.lang.en.ordinal shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.ordinal.text core.slot of=w.lang.en.ordinal key=text id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.ordinal.value core.slot of=w.lang.en.ordinal key=value required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.ordinal.in core.slot of=w.lang.en.ordinal key=in many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.numeral core.type of=w.lang.en.numeral shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.numeral.text core.slot of=w.lang.en.numeral key=text id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.numeral.value core.slot of=w.lang.en.numeral key=value required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.numeral.in core.slot of=w.lang.en.numeral key=in many=true kind=atom core.source="psys2 78f45863"

# ---- morphology ----
# A rule of inflection: `op` singular (from a plural) or plural (from a singular); the first rule of a `set` by
# `order` that matches applies. It matches a word that ends in one of `suffix` (after a consonant when `after`
# says so), not in one of `unless_suffix`, of at least `min_length` letters, which is a noun exception of the kind
# `exception` when that is given, and not a singular that looks plural when `unless_is_singular=yes`. It then drops
# `drop` letters (or the suffix, when `replace` is given) and adds `replace` or `add`.
@w.lang.en.inflect core.type of=w.lang.en.inflect shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.inflect.op core.slot of=w.lang.en.inflect key=op required=true enum=singular enum=plural core.source="psys2 78f45863"
@w.lang.en.inflect.set core.slot of=w.lang.en.inflect key=set enum=act enum=lemma core.source="psys2 78f45863"
@w.lang.en.inflect.order core.slot of=w.lang.en.inflect key=order required=true kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.inflect.suffix core.slot of=w.lang.en.inflect key=suffix many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.after core.slot of=w.lang.en.inflect key=after enum=consonant core.source="hand-core 1"
@w.lang.en.inflect.unless_suffix core.slot of=w.lang.en.inflect key=unless_suffix many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.exception core.slot of=w.lang.en.inflect key=exception enum=us-plural core.source="hand-core 1"
@w.lang.en.inflect.drop core.slot of=w.lang.en.inflect key=drop kind=integer min=0 core.source="psys2 78f45863"
@w.lang.en.inflect.replace core.slot of=w.lang.en.inflect key=replace kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.add core.slot of=w.lang.en.inflect key=add kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.min_length core.slot of=w.lang.en.inflect key=min_length kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.inflect.unless_is_singular core.slot of=w.lang.en.inflect key=unless_is_singular enum=yes core.source="psys2 78f45863"
# An irregular plural (taken before any rule, both ways).
@w.lang.en.irregular core.type of=w.lang.en.irregular shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.irregular.singular core.slot of=w.lang.en.irregular key=singular id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.irregular.plural core.slot of=w.lang.en.irregular key=plural required=true kind=atom kind=string core.source="psys2 78f45863"
# `read_only=yes`: the plural is read (antennae -> antenna), but a writer forms the plural by the rules (antennas).
@w.lang.en.irregular.read_only core.slot of=w.lang.en.irregular key=read_only enum=yes core.source="hand-core 1"
# A noun that the rules would read wrongly: is-plural (kiwis is kiwi + s, not kiwi + is), us-plural-suffix (a word
# that ends in `stem` + es is a -us noun + es: octopuses), us-plural-word (the whole `word`).
@w.lang.en.noun.exception core.type of=w.lang.en.noun.exception shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.noun.exception.kind core.slot of=w.lang.en.noun.exception key=kind required=true enum=is-plural enum=us-plural-suffix enum=us-plural-word core.source="psys2 78f45863"
@w.lang.en.noun.exception.stem core.slot of=w.lang.en.noun.exception key=stem kind=atom core.source="psys2 78f45863"
@w.lang.en.noun.exception.word core.slot of=w.lang.en.noun.exception key=word kind=atom core.source="psys2 78f45863"
# A contraction and what it stands for; an ending that stands for a word after any word ("n't" for not).
@w.lang.en.contraction core.type of=w.lang.en.contraction shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.contraction.text core.slot of=w.lang.en.contraction key=text id=true required=true kind=string core.source="psys2 78f45863"
@w.lang.en.contraction.expands core.slot of=w.lang.en.contraction key=expands required=true kind=string core.source="psys2 78f45863"
@w.lang.en.contraction.ending core.type of=w.lang.en.contraction.ending shared=true closed=true core.source="hand-core 1"
@w.lang.en.contraction.ending.ending core.slot of=w.lang.en.contraction.ending key=ending id=true required=true kind=string core.source="hand-core 1"
@w.lang.en.contraction.ending.word core.slot of=w.lang.en.contraction.ending key=word required=true kind=atom core.source="hand-core 1"

# ---- the grammar ----
# A category. A closed class names the type whose `text` facts are its words (`type`); NUM also takes digits
# (`digits=yes`); a category of a few words names `w.lang.en.word`; the others are built by rules, or come from the
# host's lexicon (N, MOD, NAME: the open classes of k.words and of the worlds in play).
@w.lang.en.cat core.type of=w.lang.en.cat shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.cat.name core.slot of=w.lang.en.cat key=name id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.cat.doc core.slot of=w.lang.en.cat key=doc kind=string core.source="psys2 78f45863"
@w.lang.en.cat.type core.slot of=w.lang.en.cat key=type kind=atom core.source="hand-core 1"
@w.lang.en.cat.digits core.slot of=w.lang.en.cat key=digits enum=yes core.source="hand-core 1"
# A word of a small category that rules name (all, every, each, both are QALL).
@w.lang.en.word core.type of=w.lang.en.word shared=true closed=true core.source="hand-core 1"
@w.lang.en.word.text core.slot of=w.lang.en.word key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.en.word.cat core.slot of=w.lang.en.word key=cat id=true required=true kind=atom core.source="hand-core 1"
# A production: `lhs` is built from the categories `rhs`, in the order the keys are written. Each rhs is one
# category; an optional part is a second production without it, a repeated part a helper category (MODS: MOD, or
# MOD MODS). `head` the category of the part the phrase is about (the first part of that category), `agree` a
# feature its parts share, `construction` the English construction it belongs to; `status=hole` when no reader
# applies it yet.
@w.lang.en.rule core.type of=w.lang.en.rule shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.rule.lhs core.slot of=w.lang.en.rule key=lhs required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.rhs core.slot of=w.lang.en.rule key=rhs many=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.head core.slot of=w.lang.en.rule key=head kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.agree core.slot of=w.lang.en.rule key=agree many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.construction core.slot of=w.lang.en.rule key=construction required=true kind=atom core.source="hand-core 1"
@w.lang.en.rule.status core.slot of=w.lang.en.rule key=status enum=hole core.source="psys2 78f45863"
# An English construction ("the legs of the crocodile", "a white house and a green one"): `about` the category it
# builds, `emit` the roles a reading carries to an act (with `set` and `thing` where it says them), `reading` what
# it means in words when that is more than roles, `asks` what a question asks, `function` the std.grammar function
# that applies it where productions alone cannot (a construction said only in words has no production),
# `status=hole` when no reader applies it yet.
@w.lang.en.construction core.type of=w.lang.en.construction shared=true closed=true core.source="hand-core 1"
@w.lang.en.construction.name core.slot of=w.lang.en.construction key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.construction.about core.slot of=w.lang.en.construction key=about kind=atom core.source="hand-core 1"
@w.lang.en.construction.emit core.slot of=w.lang.en.construction key=emit many=true kind=atom core.source="hand-core 1"
@w.lang.en.construction.set core.slot of=w.lang.en.construction key=set enum=all core.source="hand-core 1"
@w.lang.en.construction.thing core.slot of=w.lang.en.construction key=thing kind=atom core.source="hand-core 1"
@w.lang.en.construction.reading core.slot of=w.lang.en.construction key=reading kind=string core.source="hand-core 1"
@w.lang.en.construction.asks core.slot of=w.lang.en.construction key=asks kind=atom core.source="hand-core 1"
@w.lang.en.construction.function core.slot of=w.lang.en.construction key=function kind=atom core.source="hand-core 1"
@w.lang.en.construction.status core.slot of=w.lang.en.construction key=status enum=hole core.source="hand-core 1"
@w.lang.en.construction.doc core.slot of=w.lang.en.construction key=doc kind=string core.source="hand-core 1"
@w.lang.en.construction.example core.slot of=w.lang.en.construction key=example many=true kind=string core.source="hand-core 1"

# An argument frame: one way of saying an act of k.actions (`act`, `mode`), its parts in order (`w.lang.en.part`),
# the roles it fills (`role`), the fixed arguments it implies (`w.lang.en.fixed`), `priority` (the more specific,
# the higher), `needs` what a world's schema must have for the frame to apply (attrs: attributes; in: things inside
# things; named: names ...), `set` the group of frames it came in.
@w.lang.en.frame core.type of=w.lang.en.frame shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.frame.name core.slot of=w.lang.en.frame key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.frame.act core.slot of=w.lang.en.frame key=act required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.mode core.slot of=w.lang.en.frame key=mode kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.set core.slot of=w.lang.en.frame key=set required=true enum=acts enum=acts.more enum=acts.data core.source="psys2 78f45863"
@w.lang.en.frame.priority core.slot of=w.lang.en.frame key=priority required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.frame.needs core.slot of=w.lang.en.frame key=needs kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.role core.slot of=w.lang.en.frame key=role many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.example core.slot of=w.lang.en.frame key=example kind=string core.source="psys2 78f45863"
# A part of a frame, at place `at`. `is`: lead (an optional polite lead-in, the phrase group `phrase`), det (an
# optional determiner), verb (a verb of the act `act`, from k.actions), word (one of the words `word`, or of the
# phrase groups `phrase`), phrase (one phrase of the groups `phrase`), lexicon (a word of the world's lexicon
# `lexicon`), role (a capture of the role `role`: `takes` words (a noun phrase), rest (the rest of the sentence),
# number, prep (a preposition that is a relation) or lexicon; at most `max_words` words). `optional=yes`: may be left out.
@w.lang.en.part core.type of=w.lang.en.part shared=true closed=true core.source="hand-core 1"
@w.lang.en.part.frame core.slot of=w.lang.en.part key=frame id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.part.at core.slot of=w.lang.en.part key=at id=true required=true kind=integer min=1 core.source="hand-core 1"
@w.lang.en.part.is core.slot of=w.lang.en.part key=is required=true enum=lead enum=det enum=verb enum=word enum=phrase enum=lexicon enum=role core.source="hand-core 1"
@w.lang.en.part.act core.slot of=w.lang.en.part key=act kind=atom kind=string core.source="hand-core 1"
@w.lang.en.part.role core.slot of=w.lang.en.part key=role kind=atom core.source="hand-core 1"
@w.lang.en.part.takes core.slot of=w.lang.en.part key=takes enum=words enum=rest enum=number enum=prep enum=lexicon core.source="hand-core 1"
@w.lang.en.part.lexicon core.slot of=w.lang.en.part key=lexicon kind=atom core.source="hand-core 1"
