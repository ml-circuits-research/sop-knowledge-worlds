# w.lang.en: what is known about English grammar, as facts, for any application that reads English. Closed word
# classes (determiners, pronouns, prepositions, small numbers), morphology, clause structure, ellipsis markers, the
# grammar as plain productions over categories with the English constructions they belong to, the argument frames of
# the acts of k.actions, and phrase groups. Open-class words are not here: nouns and adjectives are k.words, verbs
# k.actions, number words and colours k.values. A parser that applies this world is the library's std.grammar
# (soplang-words-lib); a category is read from the facts of the type its `w.lang.en.cat` names (`type=`).
# sources: psys2 78f45863 (PSys2 handover/lang.en, the demo's English as facts; CC0); psys2 447a5f9a (PSys2
#   src/lang/en.local.mjs: frames and joiners written after the import, in this world's format; CC0); hand-core 1 (what this
#   repository added: the types of parts, constructions, categories and words, and the slot lines)
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/import/psys2-lang-en.mjs, except shards/hand-*.sop

@w.lang.en core.module name=w.lang.en version=3 exports=det exports=pron exports=anaphor exports=prep exports=prep.time exports=ordinal exports=numeral exports=inflect exports=irregular exports=noun.exception exports=contraction exports=contraction.ending exports=cat exports=word exports=rule exports=construction exports=frame exports=part exports=fixed exports=phrase exports=lex exports=joiner exports=joiner.keep exports=frame_lead exports=correction exports=correction.lead exports=answer exports=wh exports=aux exports=neg exports=neg.imperative exports=neg.imperative.skip exports=imperative.lead exports=ellipsis.lead exports=ellipsis.trail exports=ellipsis.repeat exports=ellipsis.starter exports=ellipsis.param exports=coord.sep exports=coord.param exports=relpron exports=copula exports=partitive exports=other exports=choice exports=role_map exports=mode_map exports=template exports=discourse exports=slot exports=onset exports=alternation exports=alternation_family exports=alternation_case exports=variant exports=skip core.source="psys2 78f45863"

# ---- closed word classes ----
# A determiner or quantifier. `in` names a view: one of the lists PSys2 kept in its modules (acts, expand, dialogue,
# discourse, routing); the views differ by accident and are kept until an application unifies them.
@w.lang.en.det core.type of=w.lang.en.det shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.det.text core.slot of=w.lang.en.det key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.det.kind core.slot of=w.lang.en.det key=kind required=true enum=article enum=demonstrative enum=possessive enum=quantifier enum=numeral enum=modifier core.source="psys2 78f45863"
@w.lang.en.det.definite core.slot of=w.lang.en.det key=definite enum=yes enum=no core.source="psys2 78f45863"
@w.lang.en.det.number core.slot of=w.lang.en.det key=number enum=sg enum=pl enum=any core.source="psys2 78f45863"
@w.lang.en.det.person core.slot of=w.lang.en.det key=person kind=integer min=1 max=3 core.source="psys2 78f45863"
@w.lang.en.det.gender core.slot of=w.lang.en.det key=gender enum=m enum=f enum=n core.source="psys2 78f45863"
@w.lang.en.det.distance core.slot of=w.lang.en.det key=distance enum=near enum=far core.source="psys2 78f45863"
@w.lang.en.det.value core.slot of=w.lang.en.det key=value kind=integer core.source="psys2 78f45863"
@w.lang.en.det.variant_of core.slot of=w.lang.en.det key=variant_of kind=atom core.source="psys2 78f45863"
@w.lang.en.det.register core.slot of=w.lang.en.det key=register enum=chat core.source="psys2 78f45863"
@w.lang.en.det.meaning core.slot of=w.lang.en.det key=meaning kind=atom core.source="psys2 78f45863"
@w.lang.en.det.note core.slot of=w.lang.en.det key=note kind=string core.source="psys2 78f45863"
@w.lang.en.det.in core.slot of=w.lang.en.det key=in many=true kind=atom core.source="psys2 78f45863"
# `before`: the sound of the next word that takes this form of the article (a house, an apple; block 17:05, for
# generation): the first letter of the word's spelling, unless a `w.lang.en.onset` fact names its beginning.
@w.lang.en.det.before core.slot of=w.lang.en.det key=before enum=vowel enum=consonant core.source="hand-core 1"

# A pronoun. `refers`: thing (a thing of the scene or of the dialogue), place, an agent by gender (m, f, any), or
# the user, or the assistant. `case` may repeat (it: subject and object).
@w.lang.en.pron core.type of=w.lang.en.pron shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.pron.text core.slot of=w.lang.en.pron key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.pron.case core.slot of=w.lang.en.pron key=case many=true required=true enum=subject enum=object enum=possessive enum=demonstrative enum=locative core.source="psys2 78f45863"
@w.lang.en.pron.person core.slot of=w.lang.en.pron key=person kind=integer min=1 max=3 core.source="psys2 78f45863"
@w.lang.en.pron.number core.slot of=w.lang.en.pron key=number enum=sg enum=pl core.source="psys2 78f45863"
@w.lang.en.pron.gender core.slot of=w.lang.en.pron key=gender enum=m enum=f enum=n core.source="psys2 78f45863"
@w.lang.en.pron.refers core.slot of=w.lang.en.pron key=refers many=true required=true enum=thing enum=place enum=m enum=f enum=any enum=user enum=assistant core.source="psys2 78f45863"
@w.lang.en.pron.distance core.slot of=w.lang.en.pron key=distance enum=near enum=far core.source="psys2 78f45863"
@w.lang.en.pron.deictic core.slot of=w.lang.en.pron key=deictic kind=atom core.source="psys2 78f45863"
@w.lang.en.pron.in core.slot of=w.lang.en.pron key=in many=true kind=atom core.source="psys2 78f45863"

# An anaphoric noun phrase of a dialogue ("that one", "this animal"): `order` is the order they are tried (longest
# first), `head` the word that is its noun (none for a bare pronoun).
@w.lang.en.anaphor core.type of=w.lang.en.anaphor shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.anaphor.text core.slot of=w.lang.en.anaphor key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.anaphor.order core.slot of=w.lang.en.anaphor key=order required=true kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.anaphor.head core.slot of=w.lang.en.anaphor key=head kind=atom core.source="psys2 78f45863"
@w.lang.en.anaphor.in core.slot of=w.lang.en.anaphor key=in many=true kind=atom core.source="psys2 78f45863"

# A preposition as a relation. `rel` the relation (the relation names of k.layouts where it is a place), `space`
# whether it says a place (static), a goal (direction), a source or a way (path), `role` the roles that are no
# places, `support` and `contain` what the place does, `arity` 2 when it takes two things (between).
@w.lang.en.prep core.type of=w.lang.en.prep shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.prep.text core.slot of=w.lang.en.prep key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.prep.rel core.slot of=w.lang.en.prep key=rel required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.prep.space core.slot of=w.lang.en.prep key=space enum=static enum=direction enum=source enum=path core.source="psys2 78f45863"
@w.lang.en.prep.role core.slot of=w.lang.en.prep key=role many=true enum=accompaniment enum=instrument enum=part enum=possession enum=beneficiary enum=purpose enum=topic enum=role enum=similarity enum=criterion enum=replacement core.source="psys2 78f45863"
@w.lang.en.prep.support core.slot of=w.lang.en.prep key=support enum=yes core.source="psys2 78f45863"
@w.lang.en.prep.contain core.slot of=w.lang.en.prep key=contain enum=yes core.source="psys2 78f45863"
@w.lang.en.prep.arity core.slot of=w.lang.en.prep key=arity kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.prep.note core.slot of=w.lang.en.prep key=note kind=string core.source="psys2 78f45863"
@w.lang.en.prep.in core.slot of=w.lang.en.prep key=in many=true kind=atom core.source="psys2 78f45863"
# The join to k.layouts: `layout` is the relation of k.layouts.relation the preposition says (on, inside, above,
# left_of, behind, beside, around); `inverse=yes` when it says it the other way round (a under b = b above a).
@w.lang.en.prep.layout core.slot of=w.lang.en.prep key=layout enum=left_of enum=above enum=inside enum=around enum=on enum=behind enum=beside core.source="hand-core 1"
@w.lang.en.prep.inverse core.slot of=w.lang.en.prep key=inverse enum=yes core.source="hand-core 1"

# A temporal preposition: `order` the place of the first thing against the second on a line of time (earlier, later,
# within), `span` the end it names (until: the end; since: the start). What orders things in time is k.time's.
@w.lang.en.prep.time core.type of=w.lang.en.prep.time shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.prep.time.text core.slot of=w.lang.en.prep.time key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.prep.time.rel core.slot of=w.lang.en.prep.time key=rel required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.prep.time.order core.slot of=w.lang.en.prep.time key=order required=true enum=earlier enum=later enum=within core.source="psys2 78f45863"
@w.lang.en.prep.time.span core.slot of=w.lang.en.prep.time key=span enum=start enum=end core.source="psys2 78f45863"
@w.lang.en.prep.time.in core.slot of=w.lang.en.prep.time key=in many=true kind=atom core.source="psys2 78f45863"
# The join to k.time: `relation` the fact type that says it (k.time.before, k.time.during), `first_is` and `second_is`
# which of its keys the first and the second thing of the phrase are ("Monday before Friday": Monday is the `earlier`,
# Friday the `later`; "December after November": December the `later`; "January during winter": January the `time`,
# winter the `span`). With `span` (until, since) the second thing is where a span ends or starts, so the same time
# holds too ("open until Friday" includes Friday): a host also accepts the first thing equal to the second.
@w.lang.en.prep.time.relation core.slot of=w.lang.en.prep.time key=relation kind=atom core.source="hand-core 1"
@w.lang.en.prep.time.first_is core.slot of=w.lang.en.prep.time key=first_is enum=earlier enum=later enum=time core.source="hand-core 1"
@w.lang.en.prep.time.second_is core.slot of=w.lang.en.prep.time key=second_is enum=earlier enum=later enum=span core.source="hand-core 1"

# Ordinals and small cardinals a reader needs before the catalog is reachable. k.values.number holds every number
# word; these agree with it (a test). `last` counts from the end (value -1).
@w.lang.en.ordinal core.type of=w.lang.en.ordinal shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.ordinal.text core.slot of=w.lang.en.ordinal key=text id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.ordinal.value core.slot of=w.lang.en.ordinal key=value required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.ordinal.in core.slot of=w.lang.en.ordinal key=in many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.numeral core.type of=w.lang.en.numeral shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.numeral.text core.slot of=w.lang.en.numeral key=text id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.numeral.value core.slot of=w.lang.en.numeral key=value required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.numeral.in core.slot of=w.lang.en.numeral key=in many=true kind=atom core.source="psys2 78f45863"

# ---- morphology ----
# A rule of inflection: `op` singular (from a plural) or plural (from a singular); the first rule of a `set` by
# `order` that matches applies. It matches a word that ends in one of `suffix` (after a consonant when `after`
# says so), not in one of `unless_suffix`, of at least `min_length` letters, which is a noun exception of the kind
# `exception` when that is given, and not a singular that looks plural when `unless_is_singular=yes`. It then drops
# `drop` letters (or the suffix, when `replace` is given) and adds `replace` or `add`.
@w.lang.en.inflect core.type of=w.lang.en.inflect shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.inflect.op core.slot of=w.lang.en.inflect key=op required=true enum=singular enum=plural core.source="psys2 78f45863"
@w.lang.en.inflect.set core.slot of=w.lang.en.inflect key=set enum=act enum=lemma core.source="psys2 78f45863"
@w.lang.en.inflect.order core.slot of=w.lang.en.inflect key=order required=true kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.inflect.suffix core.slot of=w.lang.en.inflect key=suffix many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.after core.slot of=w.lang.en.inflect key=after enum=consonant core.source="hand-core 1"
@w.lang.en.inflect.unless_suffix core.slot of=w.lang.en.inflect key=unless_suffix many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.exception core.slot of=w.lang.en.inflect key=exception enum=us-plural core.source="hand-core 1"
@w.lang.en.inflect.drop core.slot of=w.lang.en.inflect key=drop kind=integer min=0 core.source="psys2 78f45863"
@w.lang.en.inflect.replace core.slot of=w.lang.en.inflect key=replace kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.add core.slot of=w.lang.en.inflect key=add kind=atom core.source="psys2 78f45863"
@w.lang.en.inflect.min_length core.slot of=w.lang.en.inflect key=min_length kind=integer min=1 core.source="psys2 78f45863"
@w.lang.en.inflect.unless_is_singular core.slot of=w.lang.en.inflect key=unless_is_singular enum=yes core.source="psys2 78f45863"
# An irregular plural (taken before any rule, both ways).
@w.lang.en.irregular core.type of=w.lang.en.irregular shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.irregular.singular core.slot of=w.lang.en.irregular key=singular id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.irregular.plural core.slot of=w.lang.en.irregular key=plural required=true kind=atom kind=string core.source="psys2 78f45863"
# `read_only=yes`: the plural is read (antennae -> antenna), but a writer forms the plural by the rules (antennas).
@w.lang.en.irregular.read_only core.slot of=w.lang.en.irregular key=read_only enum=yes core.source="hand-core 1"
# A noun that the rules would read wrongly: is-plural (kiwis is kiwi + s, not kiwi + is), us-plural-suffix (a word
# that ends in `stem` + es is a -us noun + es: octopuses), us-plural-word (the whole `word`).
@w.lang.en.noun.exception core.type of=w.lang.en.noun.exception shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.noun.exception.kind core.slot of=w.lang.en.noun.exception key=kind required=true enum=is-plural enum=us-plural-suffix enum=us-plural-word core.source="psys2 78f45863"
@w.lang.en.noun.exception.stem core.slot of=w.lang.en.noun.exception key=stem kind=atom core.source="psys2 78f45863"
@w.lang.en.noun.exception.word core.slot of=w.lang.en.noun.exception key=word kind=atom core.source="psys2 78f45863"
# A contraction and what it stands for; an ending that stands for a word after any word ("n't" for not).
@w.lang.en.contraction core.type of=w.lang.en.contraction shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.contraction.text core.slot of=w.lang.en.contraction key=text id=true required=true kind=string core.source="psys2 78f45863"
@w.lang.en.contraction.expands core.slot of=w.lang.en.contraction key=expands required=true kind=string core.source="psys2 78f45863"
@w.lang.en.contraction.ending core.type of=w.lang.en.contraction.ending shared=true closed=true core.source="hand-core 1"
@w.lang.en.contraction.ending.ending core.slot of=w.lang.en.contraction.ending key=ending id=true required=true kind=string core.source="hand-core 1"
@w.lang.en.contraction.ending.word core.slot of=w.lang.en.contraction.ending key=word required=true kind=atom core.source="hand-core 1"
@w.lang.en.contraction.ending.documentation core.slot of=w.lang.en.contraction.ending key=documentation enum=yes core.source="hand-core 1"

# ---- the grammar ----
# A category. A closed class names the type whose `text` facts are its words (`type`); NUM also takes digits
# (`digits=yes`); a category of a few words names `w.lang.en.word`; the others are built by rules, or come from the
# host's lexicon (N, MOD, NAME: the open classes of k.words and of the worlds in play).
@w.lang.en.cat core.type of=w.lang.en.cat shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.cat.name core.slot of=w.lang.en.cat key=name id=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.cat.doc core.slot of=w.lang.en.cat key=doc kind=string core.source="psys2 78f45863"
@w.lang.en.cat.type core.slot of=w.lang.en.cat key=type kind=atom core.source="hand-core 1"
@w.lang.en.cat.digits core.slot of=w.lang.en.cat key=digits enum=yes core.source="hand-core 1"
# `from_type` and `from_key`: the words of the category are the values of the key `from_key` of the facts of
# `from_type`, a type of another world (a join by value: the verbs of k.actions, the attributes of k.attributes, the
# positions of k.values); a host fills the category from the catalog, as it fills N from k.words.
@w.lang.en.cat.from_type core.slot of=w.lang.en.cat key=from_type kind=atom core.source="hand-core 1"
@w.lang.en.cat.from_key core.slot of=w.lang.en.cat key=from_key kind=atom core.source="hand-core 1"
# A word of a small category that rules name (all, every, each, both are QALL).
@w.lang.en.word core.type of=w.lang.en.word shared=true closed=true core.source="hand-core 1"
@w.lang.en.word.text core.slot of=w.lang.en.word key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.en.word.cat core.slot of=w.lang.en.word key=cat id=true required=true kind=atom core.source="hand-core 1"
# A production: `lhs` is built from the categories `rhs`, in the order the keys are written. Each rhs is one
# category; an optional part is a second production without it, a repeated part a helper category (MODS: MOD, or
# MOD MODS). `head` the category of the part the phrase is about (the first part of that category), `agree` a
# feature its parts share, `construction` the English construction it belongs to; `status=hole` when no reader
# applies it yet.
@w.lang.en.rule core.type of=w.lang.en.rule shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.rule.lhs core.slot of=w.lang.en.rule key=lhs required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.rhs core.slot of=w.lang.en.rule key=rhs many=true required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.head core.slot of=w.lang.en.rule key=head kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.agree core.slot of=w.lang.en.rule key=agree many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.rule.construction core.slot of=w.lang.en.rule key=construction required=true kind=atom core.source="hand-core 1"
@w.lang.en.rule.status core.slot of=w.lang.en.rule key=status enum=hole core.source="psys2 78f45863"
# `priority`: where two productions read the same words, the one with the higher priority wins before the smaller
# parse does (block 06:55 item 1; the library's Q33, "order is data"); a rule without one has none.
@w.lang.en.rule.priority core.slot of=w.lang.en.rule key=priority kind=integer min=1 core.source="hand-core 1"
# An English construction ("the legs of the crocodile", "a white house and a green one"): `about` the category it
# builds, `emit` the roles a reading carries to an act (with `set` and `thing` where it says them), `reading` what
# it means in words when that is more than roles, `asks` what a question asks, `function` the std.grammar function
# that applies it where productions alone cannot (a construction said only in words has no production),
# `status=hole` when no reader applies it yet.
@w.lang.en.construction core.type of=w.lang.en.construction shared=true closed=true core.source="hand-core 1"
@w.lang.en.construction.name core.slot of=w.lang.en.construction key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.construction.about core.slot of=w.lang.en.construction key=about kind=atom core.source="hand-core 1"
@w.lang.en.construction.emit core.slot of=w.lang.en.construction key=emit many=true kind=atom core.source="hand-core 1"
@w.lang.en.construction.set core.slot of=w.lang.en.construction key=set enum=all core.source="hand-core 1"
@w.lang.en.construction.thing core.slot of=w.lang.en.construction key=thing kind=atom core.source="hand-core 1"
@w.lang.en.construction.reading core.slot of=w.lang.en.construction key=reading kind=string core.source="hand-core 1"
@w.lang.en.construction.asks core.slot of=w.lang.en.construction key=asks kind=atom core.source="hand-core 1"
@w.lang.en.construction.function core.slot of=w.lang.en.construction key=function kind=atom core.source="hand-core 1"
@w.lang.en.construction.status core.slot of=w.lang.en.construction key=status enum=hole core.source="hand-core 1"
@w.lang.en.construction.doc core.slot of=w.lang.en.construction key=doc kind=string core.source="hand-core 1"
# `documentation=yes`: the source wrote it to document how its own reader works (questions, joiners, corrections,
# negation, imperatives), not as data it reads; its productions are complete, and a parser may read them.
@w.lang.en.construction.documentation core.slot of=w.lang.en.construction key=documentation enum=yes core.source="hand-core 1"
@w.lang.en.construction.example core.slot of=w.lang.en.construction key=example many=true kind=string core.source="hand-core 1"

# An argument frame: one way of saying an act of k.actions (`act`, `mode`), its parts in order (`w.lang.en.part`),
# the roles it fills (`role`), the fixed arguments it implies (`w.lang.en.fixed`), `priority` (the more specific,
# the higher), `needs` what a world's schema must have for the frame to apply (attrs: attributes; in: things inside
# things; named: names ...), `set` the group of frames it came in.
@w.lang.en.frame core.type of=w.lang.en.frame shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.frame.name core.slot of=w.lang.en.frame key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.frame.act core.slot of=w.lang.en.frame key=act required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.mode core.slot of=w.lang.en.frame key=mode kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.set core.slot of=w.lang.en.frame key=set required=true enum=acts enum=acts.more enum=acts.data enum=acts.text enum=acts.facts enum=acts.media core.source="psys2 78f45863"
@w.lang.en.frame.priority core.slot of=w.lang.en.frame key=priority required=true kind=integer core.source="psys2 78f45863"
@w.lang.en.frame.needs core.slot of=w.lang.en.frame key=needs kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.role core.slot of=w.lang.en.frame key=role many=true kind=atom core.source="psys2 78f45863"
@w.lang.en.frame.example core.slot of=w.lang.en.frame key=example kind=string core.source="psys2 78f45863"
# `after`: the frame of the same set this one comes right after, where the order of the frames matters to a reader
# that tries them in order. The frames of the act `own` hand a sentence to the reader of a world of its own ("Make a
# diagram shaped like a house"): they name no act of k.actions.
@w.lang.en.frame.after core.slot of=w.lang.en.frame key=after kind=atom core.source="psys2 447a5f9a"
# A part of a frame, at place `at`. `is`: lead (an optional polite lead-in, the phrase group `phrase`), det (an
# optional determiner), verb (a verb of the act `act`, from k.actions), word (one of the words `word`, or of the
# phrase groups `phrase`), phrase (one phrase of the groups `phrase`), lexicon (a word of the world's lexicon
# `lexicon`), role (a capture of the role `role`: `takes` words (a noun phrase), rest (the rest of the sentence),
# number, prep (a preposition that is a relation) or lexicon; at most `max_words` words). `optional=yes`: may be left out.
# `quotes=yes` on a role that takes the rest: the free text keeps the quotes and the closing punctuation around it
# ("Hello there." said the fox). `listed=yes` on a word part: its words were written as a set of alternatives, even
# when there is one ("[have]"), so that a host can write the pattern again as the source wrote it.
@w.lang.en.part core.type of=w.lang.en.part shared=true closed=true core.source="hand-core 1"
@w.lang.en.part.frame core.slot of=w.lang.en.part key=frame id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.part.at core.slot of=w.lang.en.part key=at id=true required=true kind=integer min=1 core.source="hand-core 1"
@w.lang.en.part.is core.slot of=w.lang.en.part key=is required=true enum=lead enum=det enum=verb enum=word enum=phrase enum=lexicon enum=role core.source="hand-core 1"
@w.lang.en.part.act core.slot of=w.lang.en.part key=act kind=atom kind=string core.source="hand-core 1"
@w.lang.en.part.role core.slot of=w.lang.en.part key=role kind=atom core.source="hand-core 1"
@w.lang.en.part.takes core.slot of=w.lang.en.part key=takes enum=words enum=rest enum=number enum=prep enum=lexicon core.source="hand-core 1"
@w.lang.en.part.lexicon core.slot of=w.lang.en.part key=lexicon kind=atom core.source="hand-core 1"
@w.lang.en.part.max_words core.slot of=w.lang.en.part key=max_words kind=integer min=1 core.source="hand-core 1"
@w.lang.en.part.word core.slot of=w.lang.en.part key=word many=true kind=string core.source="hand-core 1"
@w.lang.en.part.phrase core.slot of=w.lang.en.part key=phrase many=true kind=atom core.source="hand-core 1"
@w.lang.en.part.optional core.slot of=w.lang.en.part key=optional enum=yes core.source="hand-core 1"
@w.lang.en.part.quotes core.slot of=w.lang.en.part key=quotes enum=yes core.source="hand-core 1"
@w.lang.en.part.listed core.slot of=w.lang.en.part key=listed enum=yes core.source="hand-core 1"
# The join from the roles of the frames to the roles of the acts of k.actions: in a frame of `act`, the role `role`
# is the k.actions role `act_role`; `marker=yes` when it captures the preposition that marks that role (the rel of
# "at table 1" marks the place). A map with `frame` holds for that frame only; one with `takes` for the parts that
# take that (a rel that takes a preposition marks the place, one that takes a direction word is the direction).
# A role of a frame with no map is the k.actions role of the same name.
@w.lang.en.role_map core.type of=w.lang.en.role_map shared=true closed=true core.source="hand-core 1"
@w.lang.en.role_map.name core.slot of=w.lang.en.role_map key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.role_map.act core.slot of=w.lang.en.role_map key=act required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.role_map.role core.slot of=w.lang.en.role_map key=role required=true kind=atom core.source="hand-core 1"
@w.lang.en.role_map.act_role core.slot of=w.lang.en.role_map key=act_role required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.role_map.marker core.slot of=w.lang.en.role_map key=marker enum=yes core.source="hand-core 1"
@w.lang.en.role_map.takes core.slot of=w.lang.en.role_map key=takes enum=words enum=rest enum=number enum=prep enum=lexicon core.source="hand-core 1"
@w.lang.en.role_map.frame core.slot of=w.lang.en.role_map key=frame kind=atom core.source="hand-core 1"
@w.lang.en.role_map.doc core.slot of=w.lang.en.role_map key=doc kind=string core.source="hand-core 1"
# The join from the act and mode of a frame to the act of k.actions where the two differ: PSys2 read "take apart" as
# the act group in the mode apart, and "deselect everything" as pick in the mode none. A frame with no mode_map is the
# k.actions act of its `act`.
@w.lang.en.mode_map core.type of=w.lang.en.mode_map shared=true closed=true core.source="hand-core 1"
@w.lang.en.mode_map.act core.slot of=w.lang.en.mode_map key=act id=true required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.mode_map.mode core.slot of=w.lang.en.mode_map key=mode id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.mode_map.means core.slot of=w.lang.en.mode_map key=means required=true kind=atom kind=string core.source="hand-core 1"
# A fixed argument of a frame: "Call yourself Robi" sets the attribute name.
@w.lang.en.fixed core.type of=w.lang.en.fixed shared=true closed=true core.source="hand-core 1"
@w.lang.en.fixed.frame core.slot of=w.lang.en.fixed key=frame id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.fixed.role core.slot of=w.lang.en.fixed key=role id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.fixed.value core.slot of=w.lang.en.fixed key=value required=true kind=string core.source="hand-core 1"
# A phrase group ("politeness and fillers"): its phrases are `item`. A small lexicon that frames name: `item`.
@w.lang.en.phrase core.type of=w.lang.en.phrase shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.phrase.name core.slot of=w.lang.en.phrase key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.phrase.group core.slot of=w.lang.en.phrase key=group required=true kind=string core.source="psys2 78f45863"
@w.lang.en.phrase.doc core.slot of=w.lang.en.phrase key=doc kind=string core.source="psys2 78f45863"
@w.lang.en.phrase.item core.slot of=w.lang.en.phrase key=item many=true required=true kind=string core.source="psys2 78f45863"
@w.lang.en.lex core.type of=w.lang.en.lex shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.lex.name core.slot of=w.lang.en.lex key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.lex.doc core.slot of=w.lang.en.lex key=doc kind=string core.source="psys2 78f45863"
@w.lang.en.lex.item core.slot of=w.lang.en.lex key=item many=true required=true kind=string core.source="psys2 78f45863"

# ---- generation ----
# A generation template of an act (block 14:15 item 1, 17:05): one imperative sentence (a question for ask) per act
# and argument shape, the realisation side of a frame. `text` is in the library's template notation (std.morph
# `realise`): `{role}` a role of the act in k.actions, filled as given; `{role:num=pl}` in the plural; the article
# `a` takes its form from the next word (`w.lang.en.det before=`). What fills a role: `kind` the name of a kind
# (house), `thing`, `source`, `target`, `recipient` a thing of the live world as a host refers to it, with its
# determiner (the house, table 1, Ann), `place` a relation and a thing (next to the tree), `value`, `amount`,
# `direction`, `number`, `name`, `topic` and `attribute` a word. `role` (many) lists the roles in the text; `shape`
# names the argument shape (the roles in k.actions order, then the mode, then a fixed attribute, joined by dots;
# `none` without roles), unique per act, so that `templateFor(act, shape)` finds it; `mode` the frame's mode where the
# template fixes it; `attribute` the attribute a value is of where the template fixes it (called: name). `frame`
# (many) is the frame it realises (one per lexicon its value may come from: bigger, smaller): read back by
# w.lang.en's frames it gives the same act, mode and roles (a test, for every template with sample fillers); `needs`
# is that frame's `needs` (the template is for worlds that meet it). A number 1 takes the shape without the number.
@w.lang.en.template core.type of=w.lang.en.template shared=true closed=true core.source="hand-core 1"
@w.lang.en.template.name core.slot of=w.lang.en.template key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.template.act core.slot of=w.lang.en.template key=act required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.template.shape core.slot of=w.lang.en.template key=shape required=true kind=atom core.source="hand-core 1"
@w.lang.en.template.mode core.slot of=w.lang.en.template key=mode kind=atom core.source="hand-core 1"
@w.lang.en.template.attribute core.slot of=w.lang.en.template key=attribute kind=atom core.source="hand-core 1"
@w.lang.en.template.role core.slot of=w.lang.en.template key=role many=true kind=atom core.source="hand-core 1"
@w.lang.en.template.frame core.slot of=w.lang.en.template key=frame many=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.template.needs core.slot of=w.lang.en.template key=needs kind=atom core.source="hand-core 1"
@w.lang.en.template.text core.slot of=w.lang.en.template key=text required=true kind=string core.source="hand-core 1"
@w.lang.en.template.example core.slot of=w.lang.en.template key=example kind=string core.source="hand-core 1"
# A discourse template (blocks 14:45 item 2, 15:00 item 4, 17:05): one sentence that makes a rhetorical move
# (`move`, a `k.genres.move name`) in a register (`register`, a `k.genres.register name`: scientific, presentation,
# essay, narrative, report), for the library's std.compose. Several templates of one move and register are
# alternatives (a composer picks among them). `text` is in the library's template notation (`{slot}`,
# `{slot:num=pl}`; the article `a` takes its form from the next word); `slot` (many) lists its slots, each a
# `w.lang.en.slot`. The words outside the slots follow the register of k.genres: its persons (I, we, you), no direct
# question where it has none (an indirect one instead), no contraction where it has none, the past in a narrative.
@w.lang.en.discourse core.type of=w.lang.en.discourse shared=true closed=true core.source="hand-core 1"
@w.lang.en.discourse.name core.slot of=w.lang.en.discourse key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.discourse.move core.slot of=w.lang.en.discourse key=move required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.discourse.register core.slot of=w.lang.en.discourse key=register required=true enum=scientific enum=presentation enum=essay enum=narrative enum=report core.source="hand-core 1"
@w.lang.en.discourse.slot core.slot of=w.lang.en.discourse key=slot many=true kind=atom core.source="hand-core 1"
@w.lang.en.discourse.text core.slot of=w.lang.en.discourse key=text required=true kind=string core.source="hand-core 1"
# A slot of the discourse templates: `about` says what fills it (a noun phrase with its determiner, a clause without
# its stop, a verb phrase in the base form...); `element` the element of k.story it is, for the slots of a story.
@w.lang.en.slot core.type of=w.lang.en.slot shared=true closed=true core.source="hand-core 1"
@w.lang.en.slot.name core.slot of=w.lang.en.slot key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.slot.about core.slot of=w.lang.en.slot key=about required=true kind=string core.source="hand-core 1"
@w.lang.en.slot.element core.slot of=w.lang.en.slot key=element kind=atom kind=string core.source="hand-core 1"
# The sound a word begins with where its first letter misleads (an hour, a unicorn, a European): a word that begins
# with `begins` (the longest that fits) begins with `sound`. Read for the article (a, an) in generation.
@w.lang.en.onset core.type of=w.lang.en.onset shared=true closed=true core.source="hand-core 1"
@w.lang.en.onset.begins core.slot of=w.lang.en.onset key=begins id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.onset.sound core.slot of=w.lang.en.onset key=sound required=true enum=vowel enum=consonant core.source="hand-core 1"

# ---- alternations (reviewer 21:55; the library's questions.md Q54 item 2: sopworld 0.75 normalise) ----
# A rule over a whole sentence that brings a variant back to the canonical form a frame is written in (passive, wh in
# situ, question vs command, request wrappers, dative shift, ellipsis), in the library's format: `from` and `to` are
# its patterns (words, `{x}` a span of one word or more, shortest first; `{x:base}` in `to` the base form of the
# span's first word); `mode` what the wrapper says about the sentence (request, question, ellipsis). No `[a|b]`: each
# alternative is a fact of its own. `n` is the order the rules are tried in (the first that matches the whole
# sentence, to a fixpoint). `family` is the alternation family (the up edge of a construction, for the cousins).
@w.lang.en.alternation core.type of=w.lang.en.alternation shared=true closed=true core.source="hand-core 1"
@w.lang.en.alternation.name core.slot of=w.lang.en.alternation key=name id=true required=true kind=atom core.source="hand-core 1"
@w.lang.en.alternation.n core.slot of=w.lang.en.alternation key=n required=true kind=integer min=1 core.source="hand-core 1"
@w.lang.en.alternation.family core.slot of=w.lang.en.alternation key=family required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.alternation.from core.slot of=w.lang.en.alternation key=from required=true kind=string core.source="hand-core 1"
@w.lang.en.alternation.to core.slot of=w.lang.en.alternation key=to required=true kind=string core.source="hand-core 1"
@w.lang.en.alternation.mode core.slot of=w.lang.en.alternation key=mode enum=request enum=question enum=ellipsis core.source="hand-core 1"
# A family of alternations and the family above it (a layered graph up to "alternation").
@w.lang.en.alternation_family core.type of=w.lang.en.alternation_family shared=true closed=true core.source="hand-core 1"
@w.lang.en.alternation_family.name core.slot of=w.lang.en.alternation_family key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@w.lang.en.alternation_family.about core.slot of=w.lang.en.alternation_family key=about required=true kind=string core.source="hand-core 1"
@w.lang.en.alternation_family.parent core.slot of=w.lang.en.alternation_family key=parent kind=atom kind=string core.source="hand-core 1"
# A test sentence: a variant, its canonical form, the alternations applied in order, the mode.
@w.lang.en.alternation_case core.type of=w.lang.en.alternation_case shared=true closed=true core.source="hand-core 1"
@w.lang.en.alternation_case.text core.slot of=w.lang.en.alternation_case key=text id=true required=true kind=string core.source="hand-core 1"
@w.lang.en.alternation_case.canonical core.slot of=w.lang.en.alternation_case key=canonical required=true kind=string core.source="hand-core 1"
@w.lang.en.alternation_case.applied core.slot of=w.lang.en.alternation_case key=applied many=true kind=atom core.source="hand-core 1"
@w.lang.en.alternation_case.mode core.slot of=w.lang.en.alternation_case key=mode enum=request enum=question enum=ellipsis core.source="hand-core 1"
@w.lang.en.word.alternation core.word text=alternation text=alternations text=variant text=paraphrase means=w.lang.en.alternation core.source="hand-core 1"

# ---- clause structure ----
# What joins two clauses: `cut` whether a splitter cuts there without other evidence, `card_cut` whether it cuts when
# an act word or a question word follows.
@w.lang.en.joiner core.type of=w.lang.en.joiner shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.joiner.text core.slot of=w.lang.en.joiner key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.joiner.kind core.slot of=w.lang.en.joiner key=kind required=true kind=atom core.source="psys2 78f45863"
@w.lang.en.joiner.cut core.slot of=w.lang.en.joiner key=cut enum=yes enum=no core.source="psys2 78f45863"
@w.lang.en.joiner.card_cut core.slot of=w.lang.en.joiner key=card_cut enum=yes enum=no core.source="psys2 78f45863"
@w.lang.en.joiner.note core.slot of=w.lang.en.joiner key=note kind=string core.source="psys2 78f45863"
# Words after "and" that continue the noun phrase before it ("Highlight Romania and its neighbours"): a splitter does
# not cut a clause there, and "its" points back at the noun before "and".
@w.lang.en.joiner.keep core.type of=w.lang.en.joiner.keep shared=true closed=true core.source="psys2 447a5f9a"
@w.lang.en.joiner.keep.text core.slot of=w.lang.en.joiner.keep key=text id=true required=true kind=atom kind=string core.source="psys2 447a5f9a"
# Words before a comma that open a standing rule ("From now on, squares are grey"): that comma ends no clause.
@w.lang.en.frame_lead core.type of=w.lang.en.frame_lead shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.frame_lead.text core.slot of=w.lang.en.frame_lead key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
# A self-correction marker ("blue, no, green"): `comma` whether it needs a comma before it.
@w.lang.en.correction core.type of=w.lang.en.correction shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.correction.text core.slot of=w.lang.en.correction key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
@w.lang.en.correction.comma core.slot of=w.lang.en.correction key=comma required=true enum=yes enum=no core.source="psys2 78f45863"
# Words of an abandoned clause that make it only a lead ("wait, I meant yes").
@w.lang.en.correction.lead core.type of=w.lang.en.correction.lead shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.correction.lead.text core.slot of=w.lang.en.correction.lead key=text many=true required=true kind=atom kind=string core.source="psys2 78f45863"
# Bare answers to a yes/no question.
@w.lang.en.answer core.type of=w.lang.en.answer shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.answer.polarity core.slot of=w.lang.en.answer key=polarity id=true required=true enum=yes enum=no enum=unsure core.source="psys2 78f45863"
@w.lang.en.answer.text core.slot of=w.lang.en.answer key=text many=true required=true kind=atom kind=string core.source="psys2 78f45863"
# A question word: `asks` what it asks for, `of` plural or mass (how many, how much), `case` object (whom).
@w.lang.en.wh core.type of=w.lang.en.wh shared=true closed=true core.source="psys2 78f45863"
@w.lang.en.wh.text core.slot of=w.lang.en.wh key=text id=true required=true kind=atom kind=string core.source="psys2 78f45863"
