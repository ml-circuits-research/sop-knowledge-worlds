@w.lang.en.ellipsis.param.verb-prefix w.lang.en.ellipsis.param name=verb-prefix-max value=2 doc="a verb ellipsis copies 1 or 2 words of the anchor clause (draw, put on); never a number, and a 2-word prefix never ends in a determiner" core.source="psys2 a019aa1e"
@w.lang.en.ellipsis.param.one-mods w.lang.en.ellipsis.param name=one-modifiers-max value=3 doc="'and two big green ones': at most 3 modifiers before one/ones" core.source="psys2 a019aa1e"
@w.lang.en.ellipsis.param.one-length w.lang.en.ellipsis.param name=one-clause-words min=2 max=5 doc="an elliptic noun phrase has 2 to 5 words; its anchor at least 2" core.source="psys2 a019aa1e"
@w.lang.en.ellipsis.param.anchor-tail w.lang.en.ellipsis.param name=anchor-noun-tail-max value=2 doc="the noun tail of the anchor noun phrase is 1 or 2 words (chess board)" core.source="psys2 a019aa1e"
@w.lang.en.ellipsis.param.shared-heads w.lang.en.ellipsis.param name=shared-argument-parts min=2 max=5 doc="a shared trailing argument or leading verb phrase: 2 to 5 coordinated heads of at most 3 words, suffix 1 or 2 words" core.source="psys2 a019aa1e"
@w.lang.en.ellipsis.param.repetition w.lang.en.ellipsis.param name=repetition min=2 max=10 doc="a clause ending in 'twice' or 'N times' is that clause N times (expand.mjs repetition)" core.source="psys2 a019aa1e"
