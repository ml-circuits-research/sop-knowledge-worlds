# the verbs and phrases that say a key, read by acts.state.verb and acts.state.phrase
@w.lang.en.lex.attribute.verb w.lang.en.lex name=attribute.verb doc="the verbs that say a key of the catalog: {thing} <verb> {value}" item="borders" item="can" item="can come from" item="cannot" item="comes before" item="comes from" item="covers" item="eats" item="gives" item="grows on" item="has" item="has equal sides" item="has no rings" item="has rings" item="has the member" item="holds" item="lives in" item="orbits" item="says" item="uses" item="wears" item="works at" core.source="hand-core 1"
@w.lang.en.lex.attribute.phrase w.lang.en.lex name=attribute.phrase doc="the phrases after is that say a key of the catalog: {thing} is <phrase> {value}" item="a weekend day" item="also called" item="eaten" item="found in" item="found on" item="in" item="inside" item="made of" item="not a weekend day" item="part of" item="the capital of" item="the part that" item="used for" item="worn for" item="worn in pairs" item="worn on" core.source="hand-core 1"

# the frames that read a statement of a fact as the act change (set) with thing, attribute and value
@w.lang.en.frame.acts.state.of w.lang.en.frame name=acts.state.of act=change mode=set set=acts.state priority=8 needs=state role=attribute role=thing role=value example="The capital of Chad is N'Djamena." core.source="hand-core 1"
