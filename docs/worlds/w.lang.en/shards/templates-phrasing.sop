# w.lang.en/shards/templates-phrasing: how each attribute of the catalog is said (block 00:05 item 2): a template per form of
# k.attributes.narration (relation, measure, text, count, kind, state) and one per key English says with a verb or phrase
# of its own ("{thing} eats {value}."), in the library's template notation; the frames of the set acts.state that read
# them back as the act change of k.actions (thing, attribute, value), and the lexicons of the verbs and phrases that say
# a key (derived from the templates). Checked in tests/w.lang.en.phrasing.test.mjs on a fact of every narrated key.
# sources: hand-core 1 (written in this repository)
# license: CC0-1.0
# script: tools/lang-en-phrasing.mjs

@w.lang.en.phrasing.form.relation w.lang.en.phrasing name=form.relation form=relation role=thing role=value frame=acts.state.of text="the {key} of {thing} is {value}." core.source="hand-core 1"
@w.lang.en.phrasing.form.measure w.lang.en.phrasing name=form.measure form=measure role=thing role=value frame=acts.state.of text="the {key} of {thing} is {value}." core.source="hand-core 1"
@w.lang.en.phrasing.form.text w.lang.en.phrasing name=form.text form=text role=thing role=value frame=acts.state.of text="the {key} of {thing} is {value}." core.source="hand-core 1"
@w.lang.en.phrasing.form.count w.lang.en.phrasing name=form.count form=count role=thing role=value frame=acts.state.count text="{thing} has {value} {key}." core.source="hand-core 1"
