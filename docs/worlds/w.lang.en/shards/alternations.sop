# w.lang.en/shards/alternations: 368 alternations in 16 families (request wrappers, question vs command, embedded questions, wh in situ, passive, dative shift, ellipsis), each a rule from a variant to the canonical form a frame is written in, in the library's format (questions.md Q54 there: w.lang.en.alternation name= from= to= mode=), applied in the order told (n); and 35 test sentences.
# sources: hand-core 1 (hand-written in this repository: tools/lang-en-alternations.mjs)
# license: CC0-1.0
# script: tools/lang-en-alternations.mjs

# Families of alternations, with the family above (the up edges of a construction, for the library's cousins).
@w.lang.en.alternation_family.alternation w.lang.en.alternation_family name=alternation about="one meaning said in another form of words; the form a frame is written in is the canonical one" core.source="hand-core 1"
@w.lang.en.alternation_family.request_wrapper w.lang.en.alternation_family name="request wrapper" about="words around a command that make it polite, ask whether it can be done or say that it is wanted; the command is the same" parent=alternation core.source="hand-core 1"
@w.lang.en.alternation_family.polite_word w.lang.en.alternation_family name="polite word" about="please, kindly" parent="request wrapper" core.source="hand-core 1"
@w.lang.en.alternation_family.ability_question w.lang.en.alternation_family name="ability question" about="could you, can you, would you, will you" parent="request wrapper" core.source="hand-core 1"
@w.lang.en.alternation_family.desire w.lang.en.alternation_family name=desire about="I want you to, I would like you to, I want to" parent="request wrapper" core.source="hand-core 1"
@w.lang.en.alternation_family.suggestion w.lang.en.alternation_family name=suggestion about="let's, let us, go ahead and" parent="request wrapper" core.source="hand-core 1"
@w.lang.en.alternation_family.sequence_lead w.lang.en.alternation_family name="sequence lead" about="now, then, next: the order of commands, not their meaning" parent="request wrapper" core.source="hand-core 1"
@w.lang.en.alternation_family.question_form w.lang.en.alternation_family name="question form" about="a question asked in another order of words, or as a command to tell" parent=alternation core.source="hand-core 1"
@w.lang.en.alternation_family.question_vs_command w.lang.en.alternation_family name="question vs command" about="a question put as a command or a statement: tell me where, do you know what, I wonder who" parent="question form" core.source="hand-core 1"
@w.lang.en.alternation_family.embedded_question w.lang.en.alternation_family name="embedded question" about="the order of words of a question inside a sentence (where the cat is), back to the order of a question (where is the cat)" parent="question form" core.source="hand-core 1"
@w.lang.en.alternation_family.wh_in_situ w.lang.en.alternation_family name="wh in situ" about="the question word left in the place of what is asked (a cow makes what sound), back to the front (what sound does a cow make)" parent="question form" core.source="hand-core 1"
@w.lang.en.alternation_family.voice w.lang.en.alternation_family name=voice about="the doer and the thing done to change places" parent=alternation core.source="hand-core 1"
@w.lang.en.alternation_family.passive w.lang.en.alternation_family name=passive about="the thing done to first, the doer after by (the house was painted by the girl)" parent=voice core.source="hand-core 1"
@w.lang.en.alternation_family.argument_order w.lang.en.alternation_family name="argument order" about="the roles of an act in another order" parent=alternation core.source="hand-core 1"
@w.lang.en.alternation_family.dative_shift w.lang.en.alternation_family name="dative shift" about="the one who gets a thing first, without to or for (give me the ball), back to after it (give the ball to me)" parent="argument order" core.source="hand-core 1"
@w.lang.en.alternation_family.context w.lang.en.alternation_family name=context about="a sentence that leaves out what the one before said" parent=alternation core.source="hand-core 1"
@w.lang.en.alternation_family.ellipsis w.lang.en.alternation_family name=ellipsis about="and, also, too, the same for, what about: the rest of the act is the one before" parent=context core.source="hand-core 1"

