# ---- the small closed classes of the noun-phrase readings ----
@w.lang.en.coord.sep.comma w.lang.en.coord.sep text="," in=things in=resolve core.source="psys2 78f45863"
@w.lang.en.coord.sep.and w.lang.en.coord.sep text="and" after_comma=things in=things in=resolve core.source="psys2 78f45863"
@w.lang.en.coord.sep.amp w.lang.en.coord.sep text="&" in=things core.source="psys2 78f45863"
@w.lang.en.coord.param.min-words w.lang.en.coord.param name=min-words value=3 doc="a role text of fewer than 3 words is not tried as a coordination of noun phrases" core.source="psys2 78f45863"
@w.lang.en.coord.param.numeral-part w.lang.en.coord.param name=numeral-part-start digits=yes doc="digits start a part like a determiner does" core.source="psys2 78f45863"
@w.lang.en.coord.param.bare-part-pattern w.lang.en.coord.param name=bare-ordinal-part digits=yes word=first word=second word=third word=fourth word=last doc="a part that is only a number or one of these ordinals takes the kind of the part before it" core.source="psys2 78f45863"
@w.lang.en.relpron.that w.lang.en.relpron text="that" core.source="psys2 78f45863"
@w.lang.en.relpron.which w.lang.en.relpron text="which" core.source="psys2 78f45863"
@w.lang.en.relpron.who w.lang.en.relpron text="who" core.source="psys2 78f45863"
@w.lang.en.copula.is w.lang.en.copula text="is" number=sg core.source="psys2 78f45863"
@w.lang.en.copula.are w.lang.en.copula text="are" number=pl core.source="psys2 78f45863"
@w.lang.en.partitive.some w.lang.en.partitive text="some" mode=ask core.source="psys2 78f45863"
@w.lang.en.partitive.any w.lang.en.partitive text="any" mode=ask core.source="psys2 78f45863"
@w.lang.en.partitive.many w.lang.en.partitive text="many" mode=ask core.source="psys2 78f45863"
@w.lang.en.partitive.several w.lang.en.partitive text="several" mode=ask core.source="psys2 78f45863"
@w.lang.en.partitive.few w.lang.en.partitive text="a few" mode=ask core.source="psys2 78f45863"
@w.lang.en.partitive.all w.lang.en.partitive text="all" mode=all core.source="psys2 78f45863"
@w.lang.en.partitive.both w.lang.en.partitive text="both" mode=all core.source="psys2 78f45863"
@w.lang.en.partitive.each w.lang.en.partitive text="each" mode=all core.source="psys2 78f45863"
@w.lang.en.partitive.every w.lang.en.partitive text="every" mode=all core.source="psys2 78f45863"
@w.lang.en.partitive.bare-of w.lang.en.partitive text="of" mode=bare doc="'of the tables' alone: the pattern's determiner took the quantifier ('some', 'any', 'a few' are determiners of the act forms), so only 'of the tables' reaches the reading; it is a part of a set, which part is asked" core.source="psys2 78f45863"
@w.lang.en.partitive.count w.lang.en.partitive doc="a number word or digits before 'of' is a count: when it covers the whole set the set, else the system asks which" mode=count core.source="psys2 78f45863"
@w.lang.en.other.the-other w.lang.en.other text="the other" plural=no core.source="psys2 78f45863"
@w.lang.en.other.the-others w.lang.en.other text="the others" plural=yes core.source="psys2 78f45863"
@w.lang.en.other.another w.lang.en.other text="another" plural=no core.source="psys2 78f45863"
@w.lang.en.other.bare-other w.lang.en.other text="other" plural=no doc="the same without its determiner: a role capture after the pattern's own 'the' (determiner words are read by the forms, so 'the other table' reaches the reading as 'other table')" core.source="psys2 78f45863"
@w.lang.en.other.bare-others w.lang.en.other text="others" plural=yes core.source="psys2 78f45863"
@w.lang.en.choice.or w.lang.en.choice text="or" core.source="psys2 78f45863"
