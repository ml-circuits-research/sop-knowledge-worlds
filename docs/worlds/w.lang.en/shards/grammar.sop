# w.lang.en/shards/grammar: the grammar as plain productions over categories (noun phrases, coordination, ellipsis, anaphora, questions), the English constructions they belong to, and the words of the categories that are words
# sources: psys2 78f45863 (PSys2 handover/lang.en and worlds/*/lexicon.sop: the English grammar of the demo, the project's own data)
# license: CC0-1.0
# script: tools/import/psys2-lang-en.mjs

# ---- constructions and their productions ----
# np.det-n: in PSys2, acts resolveOne; every world's {thing:words}
@w.lang.en.construction.np.det-n w.lang.en.construction name=np.det-n about=NP emit=thing example="the big red house" core.source="psys2 78f45863"
@w.lang.en.rule.np.det-n.1 w.lang.en.rule lhs=NP rhs=NOUNS construction=np.det-n head=N agree=number core.source="psys2 78f45863"
@w.lang.en.rule.np.det-n.2 w.lang.en.rule lhs=NP rhs=MODS rhs=NOUNS construction=np.det-n head=N agree=number core.source="psys2 78f45863"
@w.lang.en.rule.np.det-n.3 w.lang.en.rule lhs=NP rhs=DET rhs=NOUNS construction=np.det-n head=N agree=number core.source="psys2 78f45863"
@w.lang.en.rule.np.det-n.4 w.lang.en.rule lhs=NP rhs=DET rhs=MODS rhs=NOUNS construction=np.det-n head=N agree=number core.source="psys2 78f45863"
# np.count-n: in PSys2, acts FORMS make.n
@w.lang.en.construction.np.count-n w.lang.en.construction name=np.count-n about=NP emit=amount emit=thing example="3 red tables" core.source="psys2 78f45863"
@w.lang.en.rule.np.count-n.1 w.lang.en.rule lhs=NP rhs=NUM rhs=N construction=np.count-n head=N agree=number core.source="psys2 78f45863"
@w.lang.en.rule.np.count-n.2 w.lang.en.rule lhs=NP rhs=NUM rhs=MODS rhs=N construction=np.count-n head=N agree=number core.source="psys2 78f45863"
# np.numbered: in PSys2, acts resolveOne (numbered kinds)
@w.lang.en.construction.np.numbered w.lang.en.construction name=np.numbered about=NP emit=thing emit=n example="table 2" core.source="psys2 78f45863"
@w.lang.en.rule.np.numbered w.lang.en.rule lhs=NP rhs=N rhs=NUM construction=np.numbered head=N core.source="psys2 78f45863"
# np.named: in PSys2, acts resolveOne (named kinds)
@w.lang.en.construction.np.named w.lang.en.construction name=np.named about=NP emit=thing emit=name example="guest Ann" core.source="psys2 78f45863"
@w.lang.en.rule.np.named w.lang.en.rule lhs=NP rhs=N rhs=NAME construction=np.named head=N core.source="psys2 78f45863"
# np.ordinal: in PSys2, acts resolveOne; ORDINAL_RE of discourse
@w.lang.en.construction.np.ordinal w.lang.en.construction name=np.ordinal about=NP emit=thing emit=ord example="the third table" example="the last circle" core.source="psys2 78f45863"
@w.lang.en.rule.np.ordinal.1 w.lang.en.rule lhs=NP rhs=ORD rhs=N construction=np.ordinal head=N core.source="psys2 78f45863"
@w.lang.en.rule.np.ordinal.2 w.lang.en.rule lhs=NP rhs=DET rhs=ORD rhs=N construction=np.ordinal head=N core.source="psys2 78f45863"
# np.all: in PSys2, acts resolveOne (all)
@w.lang.en.construction.np.all w.lang.en.construction name=np.all about=NP emit=thing emit=set set=all example="all the tables" example="each guest" example="both eyes" core.source="psys2 78f45863"
@w.lang.en.rule.np.all.1 w.lang.en.rule lhs=NP rhs=QALL rhs=N construction=np.all head=N core.source="psys2 78f45863"
@w.lang.en.rule.np.all.2 w.lang.en.rule lhs=NP rhs=QALL rhs=DET rhs=N construction=np.all head=N core.source="psys2 78f45863"
# np.everything: in PSys2, acts resolveOne
@w.lang.en.construction.np.everything w.lang.en.construction name=np.everything about=NP emit=set set=all example="everything" core.source="psys2 78f45863"
@w.lang.en.rule.np.everything w.lang.en.rule lhs=NP rhs=EVERYTHING construction=np.everything core.source="psys2 78f45863"
# np.possessive-of: in PSys2, act hooks (parts as kinds), Talk partsof frames
@w.lang.en.construction.np.possessive-of w.lang.en.construction name=np.possessive-of about=NP emit=part-of example="the legs of the crocodile" core.source="psys2 78f45863"
@w.lang.en.rule.np.possessive-of w.lang.en.rule lhs=NP rhs=NP rhs=OFNP construction=np.possessive-of head=NP core.source="psys2 78f45863"
# np.possessive-s: in PSys2, formalizer index.mjs splits 's into its own token
@w.lang.en.construction.np.possessive-s w.lang.en.construction name=np.possessive-s about=NP emit=part-of example="the house's door" core.source="psys2 78f45863"
@w.lang.en.rule.np.possessive-s w.lang.en.rule lhs=NP rhs=NP rhs=POSS rhs=N construction=np.possessive-s head=N core.source="psys2 78f45863"
# np.pp: in PSys2, acts FORMS ({thing} REL {place})
@w.lang.en.construction.np.pp w.lang.en.construction name=np.pp about=NP emit=thing emit=rel emit=place example="the star next to the house" core.source="psys2 78f45863"
@w.lang.en.rule.np.pp w.lang.en.rule lhs=NP rhs=NP rhs=PP construction=np.pp head=NP core.source="psys2 78f45863"
@w.lang.en.construction.pp.time w.lang.en.construction name=pp.time about=PP reading="time relation: before / after / during / until / since, as an order of two things on a line of time" status=hole doc="the words and their order are facts (prepositions.sop in=time) and en.timeRelation reads them; no world consumes the relation yet: a world needs an order of its things in time (kids.time, k.time; plan.timeline has views, not an order), so 'is Monday before Friday' is still read as a distance (hole, cases h21-h25 of training/eval/lang-holes.jsonl)" example="before lunch" example="after Tuesday" example="during the summer" core.source="psys2 78f45863"
@w.lang.en.rule.pp.time w.lang.en.rule lhs=PP rhs=TPREP rhs=NP construction=pp.time status=hole core.source="psys2 78f45863"
# pp: in PSys2, acts REL_WORDS; prepositions.sop
@w.lang.en.construction.pp w.lang.en.construction name=pp about=PP emit=rel emit=place example="next to the house" core.source="psys2 78f45863"
@w.lang.en.rule.pp w.lang.en.rule lhs=PP rhs=PREP rhs=NP construction=pp head=PREP core.source="psys2 78f45863"
# np.pron: in PSys2, acts resolveOne (focus), dialogue PRONOUNS
@w.lang.en.construction.np.pron w.lang.en.construction name=np.pron about=NP emit=anaphor example="it" example="them" core.source="psys2 78f45863"
@w.lang.en.rule.np.pron w.lang.en.rule lhs=NP rhs=PRON construction=np.pron core.source="psys2 78f45863"
# np.dem-one: in PSys2, discourse pronoun (that one)
@w.lang.en.construction.np.dem-one w.lang.en.construction name=np.dem-one about=NP emit=anaphor example="that one" core.source="psys2 78f45863"
@w.lang.en.rule.np.dem-one w.lang.en.rule lhs=NP rhs=DEM rhs=ONE construction=np.dem-one core.source="psys2 78f45863"
# np.quant-of: in PSys2, slice 2 (en.nounPhrase; acts resolve, art.draw resolveText)
@w.lang.en.construction.np.quant-of w.lang.en.construction name=np.quant-of about=NP reading="partial-set: ask which; a count that covers the whole set is the set" example="some of the tables" example="two of the houses" core.source="psys2 78f45863"
@w.lang.en.rule.np.quant-of.1 w.lang.en.rule lhs=NP rhs=PARTITIVE rhs=OF rhs=NP construction=np.quant-of core.source="psys2 78f45863"
@w.lang.en.rule.np.quant-of.2 w.lang.en.rule lhs=NP rhs=NUM rhs=OF rhs=NP construction=np.quant-of core.source="psys2 78f45863"
@w.lang.en.construction.np.all-of w.lang.en.construction name=np.all-of about=NP emit=set set=all example="all of the tables" core.source="psys2 78f45863"
# np.relative: in PSys2, slice 2 (en.nounPhrase); 'that has / that I made' (a verb other than be) stays a hole
@w.lang.en.construction.np.relative w.lang.en.construction name=np.relative about=NP reading="NP with the modifiers before its noun" example="the table that is red" example="the tables which are blue" core.source="psys2 78f45863"
@w.lang.en.rule.np.relative w.lang.en.rule lhs=NP rhs=NP rhs=RELPRON rhs=COPULA rhs=MODS construction=np.relative core.source="psys2 78f45863"
# coord.np: in PSys2, acts splitThings / resolve
@w.lang.en.construction.coord.np w.lang.en.construction name=coord.np about=NP emit=set example="a sun, a cloud and a man" core.source="psys2 78f45863"
@w.lang.en.rule.coord.np w.lang.en.rule lhs=NP rhs=NP rhs=NPTAIL construction=coord.np head=NP core.source="psys2 78f45863"
# coord.part-start: in PSys2, acts splitThings NUMBER_START
@w.lang.en.construction.coord.part-start w.lang.en.construction name=coord.part-start about=NP function=grammar.split doc="every part after the first starts with a determiner or a number (a, an, the, another, some, my, our, your, one..ten, digits); a part that does not ('red and blue house') joins back into the part before it: the 'and' joins modifiers, not nouns" core.source="psys2 78f45863"
# coord.head-bound: in PSys2, acts splitThings PREP_CUT
@w.lang.en.construction.coord.head-bound w.lang.en.construction name=coord.head-bound about=NP function=grammar.split doc="the head of a coordinated role stops at its first preposition (shards/prepositions.sop in=np.boundary): 'a sun, a cloud and a man next to the house' shares 'next to the house' among the parts" core.source="psys2 78f45863"
# coord.number-distribute: in PSys2, acts resolve ('tables 1 and 2': a bare number or ordinal takes the kind of the part before it)
@w.lang.en.construction.coord.number-distribute w.lang.en.construction name=coord.number-distribute about=NP emit=set emit=thing thing=N example="tables 1 and 2" core.source="psys2 78f45863"
@w.lang.en.rule.coord.number-distribute w.lang.en.rule lhs=NP rhs=N rhs=NUM rhs=NUMTAIL construction=coord.number-distribute core.source="psys2 78f45863"
# coord.shared-suffix: in PSys2, expand.mjs sharedArgument
@w.lang.en.construction.coord.shared-suffix w.lang.en.construction name=coord.shared-suffix about=S reading="one clause per head: prefix head suffix" function=grammar.shared example="make your eyes and body blue" core.source="psys2 78f45863"
# coord.clause: in PSys2, index.mjs splitClauses, cardCuts (shards/clauses.sop joiners)
@w.lang.en.construction.coord.clause w.lang.en.construction name=coord.clause about=S emit=steps function=grammar.clauses example="draw a house, then make it red" core.source="psys2 78f45863"
@w.lang.en.rule.coord.clause w.lang.en.rule lhs=S rhs=S rhs=STAIL construction=coord.clause core.source="psys2 78f45863"
# coord.adj: in PSys2, matcher: the pattern lexicon slots
@w.lang.en.construction.coord.adj w.lang.en.construction name=coord.adj about=MOD emit=modifiers example="red and blue house" core.source="psys2 78f45863"
@w.lang.en.rule.coord.adj w.lang.en.rule lhs=MOD rhs=MOD rhs=CONJMOD construction=coord.adj core.source="psys2 78f45863"
# coord.or: in PSys2, slice 2 (en.nounPhrase.choice; a part without a noun takes the last word of the last part: 'the red or the blue house')
@w.lang.en.construction.coord.or w.lang.en.construction name=coord.or about=NP reading="choice: the system asks which (never both, never the last)" example="table 1 or table 2" example="the red or the blue house" core.source="psys2 78f45863"
@w.lang.en.rule.coord.or w.lang.en.rule lhs=NP rhs=NP rhs=ORNP construction=coord.or core.source="psys2 78f45863"
# coord.except: in PSys2, phrase lang.except (shards/phrases.sop); kids.shop
@w.lang.en.construction.coord.except w.lang.en.construction name=coord.except about=NP emit=set-minus example="everything except the tree" core.source="psys2 78f45863"
@w.lang.en.rule.coord.except w.lang.en.rule lhs=NP rhs=NP rhs=EXCEPTNP construction=coord.except core.source="psys2 78f45863"
# ellipsis.one: in PSys2, expand.mjs oneAnaphora
@w.lang.en.construction.ellipsis.one w.lang.en.construction name=ellipsis.one about=S reading="the anchor clause with its noun and the new modifiers" function=grammar.elide example="a green house and a yellow one" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.one.1 w.lang.en.rule lhs=S rhs=CONJ rhs=MODS rhs=ONE construction=ellipsis.one core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.one.2 w.lang.en.rule lhs=S rhs=CONJ rhs=DET rhs=MODS rhs=ONE construction=ellipsis.one core.source="psys2 78f45863"
# ellipsis.one-count: in PSys2, expand.mjs oneAnaphora
@w.lang.en.construction.ellipsis.one-count w.lang.en.construction name=ellipsis.one-count about=S reading="the anchor clause with the count and the new modifiers" function=grammar.elide example="and two big ones" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.one-count.1 w.lang.en.rule lhs=S rhs=CONJ rhs=NUM rhs=ONES construction=ellipsis.one-count core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.one-count.2 w.lang.en.rule lhs=S rhs=CONJ rhs=NUM rhs=MODS rhs=ONES construction=ellipsis.one-count core.source="psys2 78f45863"
# ellipsis.one-bare: in PSys2, expand.mjs oneAnaphora
@w.lang.en.construction.ellipsis.one-bare w.lang.en.construction name=ellipsis.one-bare about=S reading="anchor with modifiers" function=grammar.elide example="and one yellow" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.one-bare w.lang.en.rule lhs=S rhs=CONJ rhs=ONE1 rhs=MODS construction=ellipsis.one-bare core.source="psys2 78f45863"
# ellipsis.one-class: in PSys2, expand.mjs oneAnaphora sameClass
@w.lang.en.construction.ellipsis.one-class w.lang.en.construction name=ellipsis.one-class about=S function=grammar.elide doc="anchor modifiers of the same class as a new one are replaced, of another class are kept: 'a big green house and a yellow one' is a big yellow house; the class of a word is the smallest lexicon that holds it" core.source="psys2 78f45863"
# ellipsis.verb: in PSys2, expand.mjs ellipsisPrefixes
@w.lang.en.construction.ellipsis.verb w.lang.en.construction name=ellipsis.verb about=S reading="the first 1-2 words of the anchor clause, then this clause" function=grammar.elide example="move it left and the tree right" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.verb.1 w.lang.en.rule lhs=S rhs=CONJ rhs=NP construction=ellipsis.verb core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.verb.2 w.lang.en.rule lhs=S rhs=CONJ rhs=NP rhs=PP construction=ellipsis.verb core.source="psys2 78f45863"
# ellipsis.fragment: in PSys2, discourse.mjs splitFragment, ellipsis (shards/ellipsis.sop)
@w.lang.en.construction.ellipsis.fragment w.lang.en.construction name=ellipsis.fragment about=S reading="the previous frame with one slot replaced" function=grammar.fragment example="and from Berlin?" example="the same for the tree" example="the eyes too" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.1 w.lang.en.rule lhs=S rhs=NP construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.2 w.lang.en.rule lhs=S rhs=NP rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.3 w.lang.en.rule lhs=S rhs=PP construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.4 w.lang.en.rule lhs=S rhs=PP rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.5 w.lang.en.rule lhs=S rhs=MOD construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.6 w.lang.en.rule lhs=S rhs=MOD rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.7 w.lang.en.rule lhs=S rhs=LEAD rhs=NP construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.8 w.lang.en.rule lhs=S rhs=LEAD rhs=NP rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.9 w.lang.en.rule lhs=S rhs=LEAD rhs=PP construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.10 w.lang.en.rule lhs=S rhs=LEAD rhs=PP rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.11 w.lang.en.rule lhs=S rhs=LEAD rhs=MOD construction=ellipsis.fragment core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.fragment.12 w.lang.en.rule lhs=S rhs=LEAD rhs=MOD rhs=TRAIL construction=ellipsis.fragment core.source="psys2 78f45863"
# ellipsis.repeat: in PSys2, discourse.mjs REPEATS
@w.lang.en.construction.ellipsis.repeat w.lang.en.construction name=ellipsis.repeat about=S reading="the previous request again" function=grammar.fragment example="again" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.repeat w.lang.en.rule lhs=S rhs=REPEAT construction=ellipsis.repeat core.source="psys2 78f45863"
# ellipsis.number: in PSys2, discourse.mjs _candidates (slot class number)
@w.lang.en.construction.ellipsis.number w.lang.en.construction name=ellipsis.number about=S reading="the previous request with the number replaced" function=grammar.fragment example="and 5?" core.source="psys2 78f45863"
@w.lang.en.rule.ellipsis.number w.lang.en.rule lhs=S rhs=NUM construction=ellipsis.number core.source="psys2 78f45863"
# ellipsis.answer: in PSys2, discourse.mjs fill
@w.lang.en.construction.ellipsis.answer w.lang.en.construction name=ellipsis.answer about=S reading="the missing role of the pending question" function=grammar.fragment example="(asked: which colour?) blue" core.source="psys2 78f45863"
# anaphora.focus: in PSys2, acts focusOf / resolveOne; session.dialogue
@w.lang.en.construction.anaphora.focus w.lang.en.construction name=anaphora.focus about=NP function=grammar.refer doc="a pronoun with no antecedent in the sentence means the dialogue focus (the thing last talked about, in any world); the reply says which it took ('I took it to mean the red star')" core.source="psys2 78f45863"
# anaphora.slot: in PSys2, discourse.mjs pronoun
@w.lang.en.construction.anaphora.slot w.lang.en.construction name=anaphora.slot about=S function=grammar.refer doc="an unread sentence with a pronoun: the pronoun is replaced by the noun phrase of a typed slot of a recent frame, newest first (with its determiner, 'a duck' for 'it'), and the sentence must then be read completely; a referent the sentence already says is no referent" core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.slot w.lang.en.rule lhs=S rhs=PRON construction=anaphora.slot core.source="psys2 78f45863"
# anaphora.back-to: in PSys2, discourse.mjs _backTo
@w.lang.en.construction.anaphora.back-to w.lang.en.construction name=anaphora.back-to about=S reading="the pronoun of S means NP" function=grammar.refer example="back to the spider, how many legs does it have?" core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.back-to w.lang.en.rule lhs=S rhs=BACKTO rhs=NP rhs=S construction=anaphora.back-to core.source="psys2 78f45863"
# anaphora.agent: in PSys2, formalizer session.mjs resolvePronoun
@w.lang.en.construction.anaphora.agent w.lang.en.construction name=anaphora.agent about=NP function=grammar.agent doc="he / she / they / him / her / them mean the agent last mentioned with that gender (any for they); I / me / my the user; you / your the assistant" core.source="psys2 78f45863"
# anaphora.deictic: in PSys2, discourse.mjs pronoun; acts PRONOUN there
@w.lang.en.construction.anaphora.deictic w.lang.en.construction name=anaphora.deictic about=NP function=grammar.refer doc="here, there, this, that point at the scene or the previous answer ('what day comes after that': that is the value just given)" core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.deictic w.lang.en.rule lhs=NP rhs=DEIXIS construction=anaphora.deictic core.source="psys2 78f45863"
# anaphora.other: in PSys2, slice 2 (en.nounPhrase.other; acts resolve; art.draw had its own)
@w.lang.en.construction.anaphora.other w.lang.en.construction name=anaphora.other about=NP reading="the things of that kind that are not the dialogue focus" example="the other table" example="the other one" core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.other.1 w.lang.en.rule lhs=NP rhs=OTHER construction=anaphora.other core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.other.2 w.lang.en.rule lhs=NP rhs=OTHER rhs=ONE1 construction=anaphora.other core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.other.3 w.lang.en.rule lhs=NP rhs=OTHER rhs=N construction=anaphora.other core.source="psys2 78f45863"
@w.lang.en.rule.anaphora.other.4 w.lang.en.rule lhs=NP rhs=OTHER rhs=N rhs=ONE1 construction=anaphora.other core.source="psys2 78f45863"
@w.lang.en.construction.joiner.run w.lang.en.construction name=joiner.run function=grammar.clauses doc="a run of joiners counts as one (', and then'); the first token after the run opens the next clause" core.source="psys2 78f45863"
@w.lang.en.construction.correction.rule w.lang.en.construction name=correction.rule function=grammar.clauses doc="the words after the marker replace the part of the abandoned clause they correct: the whole clause when the correction restarts the command; the last number when it is a number; up to / from the shared word otherwise. A bare answer list ('yes, no, maybe') is never a correction." core.source="psys2 78f45863"
@w.lang.en.construction.q.wh-aux-np w.lang.en.construction name=q.wh-aux-np about=Q asks=place example="Where is the cat?" core.source="psys2 78f45863"
@w.lang.en.rule.q.wh-aux-np w.lang.en.rule lhs=Q rhs=WH rhs=AUX rhs=NP construction=q.wh-aux-np core.source="psys2 78f45863"
@w.lang.en.construction.q.wh-np-aux w.lang.en.construction name=q.wh-np-aux about=Q asks=attribute example="What colour is table 2?" core.source="psys2 78f45863"
@w.lang.en.rule.q.wh-np-aux w.lang.en.rule lhs=Q rhs=WH rhs=NP rhs=AUXNP construction=q.wh-np-aux core.source="psys2 78f45863"
@w.lang.en.construction.q.howmany w.lang.en.construction name=q.howmany about=Q asks=count example="How many tables are there?" core.source="psys2 78f45863"
@w.lang.en.rule.q.howmany.1 w.lang.en.rule lhs=Q rhs=HOWMANY rhs=N construction=q.howmany core.source="psys2 78f45863"
@w.lang.en.rule.q.howmany.2 w.lang.en.rule lhs=Q rhs=HOWMANY rhs=N rhs=THERE construction=q.howmany core.source="psys2 78f45863"
@w.lang.en.rule.q.howmany.3 w.lang.en.rule lhs=Q rhs=HOWMANY rhs=N rhs=AUX construction=q.howmany core.source="psys2 78f45863"
@w.lang.en.rule.q.howmany.4 w.lang.en.rule lhs=Q rhs=HOWMANY rhs=N rhs=AUX rhs=THERE construction=q.howmany core.source="psys2 78f45863"
@w.lang.en.construction.q.howmany-have w.lang.en.construction name=q.howmany-have about=Q asks=count example="How many legs does a spider have?" core.source="psys2 78f45863"
@w.lang.en.rule.q.howmany-have w.lang.en.rule lhs=Q rhs=HOWMANY rhs=N rhs=AUX rhs=NP rhs=HAVE construction=q.howmany-have core.source="psys2 78f45863"
