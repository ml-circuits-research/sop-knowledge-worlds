# ---- categories ----
@w.lang.en.cat.AUX w.lang.en.cat name=AUX doc="an auxiliary" type=w.lang.en.aux core.source="psys2 78f45863"
@w.lang.en.cat.AUXNEG w.lang.en.cat name=AUXNEG doc="a negated auxiliary (isn't, don't)" core.source="psys2 78f45863"
@w.lang.en.cat.AUXNP w.lang.en.cat name=AUXNP doc="the rest of a production that names a category twice: AUX NP" core.source="psys2 78f45863"
@w.lang.en.cat.BACKTO w.lang.en.cat name=BACKTO doc="the words back to" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.CONJ w.lang.en.cat name=CONJ doc="a coordinator: and, & or a comma in a list" type=w.lang.en.coord.sep core.source="psys2 78f45863"
@w.lang.en.cat.CONJMOD w.lang.en.cat name=CONJMOD doc="the rest of a production that names a category twice: CONJ MOD" core.source="psys2 78f45863"
@w.lang.en.cat.COPULA w.lang.en.cat name=COPULA doc="a form of be" type=w.lang.en.copula core.source="psys2 78f45863"
@w.lang.en.cat.DEIXIS w.lang.en.cat name=DEIXIS doc="a word that points at the scene or the last answer: here, there, this, that" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.DEM w.lang.en.cat name=DEM doc="a demonstrative before one: this, that, these, those" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.DET w.lang.en.cat name=DET doc="a determiner or quantifier (shards/determiners.sop)" type=w.lang.en.det core.source="psys2 78f45863"
@w.lang.en.cat.EVERYTHING w.lang.en.cat name=EVERYTHING doc="the word everything" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.EXCEPT w.lang.en.cat name=EXCEPT doc="a word that takes things out of a set: except, but, apart from" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.EXCEPTNP w.lang.en.cat name=EXCEPTNP doc="the rest of a production that names a category twice: EXCEPT NP" core.source="psys2 78f45863"
@w.lang.en.cat.HAVE w.lang.en.cat name=HAVE doc="the word have" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.HOWMANY w.lang.en.cat name=HOWMANY doc="the words how many" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.JOINER w.lang.en.cat name=JOINER doc="a word that joins two clauses" type=w.lang.en.joiner core.source="psys2 78f45863"
@w.lang.en.cat.LEAD w.lang.en.cat name=LEAD doc="a fragment lead marker" type=w.lang.en.ellipsis.lead core.source="psys2 78f45863"
@w.lang.en.cat.MOD w.lang.en.cat name=MOD doc="a modifier before the noun: colour, size, shape, quantity word; its class is the lexicon that holds it" core.source="psys2 78f45863"
@w.lang.en.cat.MODS w.lang.en.cat name=MODS doc="one or more modifiers (MOD, MOD MODS)" core.source="psys2 78f45863"
@w.lang.en.cat.N w.lang.en.cat name=N doc="a noun (open class: k.words, a world's kinds); a tail of 1 or 2 nouns is one head (chess board)" core.source="psys2 78f45863"
@w.lang.en.cat.NAME w.lang.en.cat name=NAME doc="a proper name (agents, named things: guest Ann)" core.source="psys2 78f45863"
@w.lang.en.cat.NOUNS w.lang.en.cat name=NOUNS doc="one or two nouns read as one head (N, N NOUNS): chess board" core.source="psys2 78f45863"
@w.lang.en.cat.NP w.lang.en.cat name=NP doc="a noun phrase: names one or many things, or points at them" core.source="psys2 78f45863"
@w.lang.en.cat.NPTAIL w.lang.en.cat name=NPTAIL doc="NPTAIL" core.source="psys2 78f45863"
@w.lang.en.cat.NUM w.lang.en.cat name=NUM doc="a number: digits or a number word (k.values.number)" type=w.lang.en.numeral digits=yes core.source="psys2 78f45863"
@w.lang.en.cat.NUMTAIL w.lang.en.cat name=NUMTAIL doc="a coordinated number after the first (CONJ NUM, CONJ NUM NUMTAIL)" core.source="psys2 78f45863"
@w.lang.en.cat.OF w.lang.en.cat name=OF doc="the word of" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.OFNP w.lang.en.cat name=OFNP doc="the rest of a production that names a category twice: OF NP" core.source="psys2 78f45863"
@w.lang.en.cat.ONE w.lang.en.cat name=ONE doc="one or ones standing for a noun" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.ONE1 w.lang.en.cat name=ONE1 doc="the word one" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.ONES w.lang.en.cat name=ONES doc="the word ones" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.OR w.lang.en.cat name=OR doc="the word or" type=w.lang.en.choice core.source="psys2 78f45863"
@w.lang.en.cat.ORD w.lang.en.cat name=ORD doc="an ordinal: first ... tenth, last (shards/numbers.sop)" type=w.lang.en.ordinal core.source="psys2 78f45863"
@w.lang.en.cat.ORNP w.lang.en.cat name=ORNP doc="the rest of a production that names a category twice: OR NP" core.source="psys2 78f45863"
@w.lang.en.cat.OTHER w.lang.en.cat name=OTHER doc="the other, the others, another" type=w.lang.en.other core.source="psys2 78f45863"
@w.lang.en.cat.PARTITIVE w.lang.en.cat name=PARTITIVE doc="a word before \"of\" that takes a part of a set" type=w.lang.en.partitive core.source="psys2 78f45863"
@w.lang.en.cat.POSS w.lang.en.cat name=POSS doc="the possessive 's (a token of its own)" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.PP w.lang.en.cat name=PP doc="a prepositional phrase: PREP NP" core.source="psys2 78f45863"
@w.lang.en.cat.PREP w.lang.en.cat name=PREP doc="a preposition, a relation (shards/prepositions.sop)" type=w.lang.en.prep core.source="psys2 78f45863"
@w.lang.en.cat.PRON w.lang.en.cat name=PRON doc="a pronoun (shards/pronouns.sop)" type=w.lang.en.pron core.source="psys2 78f45863"
@w.lang.en.cat.Q w.lang.en.cat name=Q doc="a question" core.source="psys2 78f45863"
@w.lang.en.cat.QALL w.lang.en.cat name=QALL doc="a quantifier over the whole set: all, every, each, both" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.RELPRON w.lang.en.cat name=RELPRON doc="a relative pronoun" type=w.lang.en.relpron core.source="psys2 78f45863"
@w.lang.en.cat.REPEAT w.lang.en.cat name=REPEAT doc="a whole-sentence repeat" type=w.lang.en.ellipsis.repeat core.source="psys2 78f45863"
@w.lang.en.cat.S w.lang.en.cat name=S doc="a clause: a request, a question or a statement" core.source="psys2 78f45863"
@w.lang.en.cat.STAIL w.lang.en.cat name=STAIL doc="a clause after a joiner, once or more (JOINER S, JOINER S STAIL)" core.source="psys2 78f45863"
@w.lang.en.cat.THE w.lang.en.cat name=THE doc="the word the" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.THERE w.lang.en.cat name=THERE doc="the word there" type=w.lang.en.word core.source="psys2 78f45863"
@w.lang.en.cat.TPREP w.lang.en.cat name=TPREP doc="a temporal preposition (prep.time)" type=w.lang.en.prep.time core.source="psys2 78f45863"
@w.lang.en.cat.TRAIL w.lang.en.cat name=TRAIL doc="a fragment trail marker" type=w.lang.en.ellipsis.trail core.source="psys2 78f45863"
@w.lang.en.cat.VP w.lang.en.cat name=VP doc="a verb and its arguments; the verb is k.actions" core.source="psys2 78f45863"
@w.lang.en.cat.WH w.lang.en.cat name=WH doc="a question word" type=w.lang.en.wh core.source="psys2 78f45863"
@w.lang.en.cat.WHY w.lang.en.cat name=WHY doc="the word why" type=w.lang.en.word core.source="psys2 78f45863"

