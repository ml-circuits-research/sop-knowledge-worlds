@w.lang.en.construction.q.wh-of w.lang.en.construction name=q.wh-of about=Q asks=attribute example="What is the colour of table 2?" core.source="psys2 78f45863"
@w.lang.en.rule.q.wh-of w.lang.en.rule lhs=Q rhs=WH rhs=AUX rhs=THE rhs=N rhs=OF rhs=NP construction=q.wh-of core.source="psys2 78f45863"
