# w.lang.en/shards/words-k.parts: the English words of k.parts (its types, keys and values), owned by the language world
# (Q78, reviewer 16:10; KR3): they were the core.word facts of its schema; tools/build-catalog.mjs reads them as its own words.
# sources: hand-core 1 (written in this repository; the block at the end by tools/key-words.mjs)
# license: CC0-1.0
# script: none (hand-written); the block of word wires for keys: tools/key-words.mjs

# Words for the types and keys of this world.
@w.lang.en.word.k.parts.whole core.word text=part text=parts text="made up of" text=consists means=k.parts.whole core.source="hand-core 1"
@w.lang.en.word.k.parts.has core.word text=has text=have text=with means=k.parts.whole.has core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@w.lang.en.word.k.parts.key.whole.gloss core.word text=gloss means=k.parts.whole.gloss core.source="hand-core 1"
@w.lang.en.word.k.parts.key.whole.has core.word text=built text=inside means=k.parts.whole.has core.source="hand-core 1"
@w.lang.en.word.k.parts.key.whole.plain core.word text=plain text=has text=have means=k.parts.whole.plain core.source="hand-core 1"
@w.lang.en.word.k.parts.key.inherited core.word text=part text=parts means=k.parts.inherited core.source="hand-core 1"
@w.lang.en.word.k.parts.key.inherited.from core.word text=from means=k.parts.inherited.from core.source="hand-core 1"
@w.lang.en.word.k.parts.key.inherited.steps core.word text=steps means=k.parts.inherited.steps core.source="hand-core 1"
@w.lang.en.word.k.parts.key.inherited.has core.word text=has text=have text=with means=k.parts.inherited.has core.source="hand-core 1"
@w.lang.en.word.k.parts.key.inherited.plain core.word text=plain means=k.parts.inherited.plain core.source="hand-core 1"
@w.lang.en.word.k.parts.key.usual core.word text=part text=parts means=k.parts.usual core.source="hand-core 1"
@w.lang.en.word.k.parts.key.usual.has core.word text=has text=have text=with text=built text=inside means=k.parts.usual.has core.source="hand-core 1"
@w.lang.en.word.k.parts.key.usual.named core.word text=named means=k.parts.usual.named core.source="hand-core 1"
@w.lang.en.word.k.parts.key.called.part core.word text=part means=k.parts.called.part core.source="hand-core 1"
@w.lang.en.word.k.parts.key.called.also core.word text=also means=k.parts.called.also core.source="hand-core 1"
