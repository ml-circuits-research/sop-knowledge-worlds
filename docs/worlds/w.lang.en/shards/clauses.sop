# script: tools/import/psys2-lang-en.mjs

@w.lang.en.joiner.comma w.lang.en.joiner text="," kind=list-or-clause cut=yes card_cut=yes note="a comma after a frame lead does not cut" core.source="psys2 a019aa1e"
@w.lang.en.joiner.semicolon w.lang.en.joiner text=";" kind=clause cut=no card_cut=yes core.source="psys2 a019aa1e"
@w.lang.en.joiner.and w.lang.en.joiner text="and" kind=coordination cut=yes card_cut=yes note="'and then' / 'and also' count as one joiner" core.source="psys2 a019aa1e"
@w.lang.en.joiner.then w.lang.en.joiner text="then" kind=sequence cut=yes card_cut=yes note="explicit order: the clauses are kept as separate steps" core.source="psys2 a019aa1e"
@w.lang.en.joiner.also w.lang.en.joiner text="also" kind=addition cut=yes card_cut=yes note="joins like then (model ablation 2026-11-13, on by default)" core.source="psys2 a019aa1e"
@w.lang.en.joiner.but w.lang.en.joiner text="but" kind=contrast cut=yes card_cut=yes core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.1 w.lang.en.frame_lead text="from now on" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.2 w.lang.en.frame_lead text="from here on" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.3 w.lang.en.frame_lead text="from then on" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.4 w.lang.en.frame_lead text="from today on" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.5 w.lang.en.frame_lead text="by default" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.6 w.lang.en.frame_lead text="in future" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.7 w.lang.en.frame_lead text="in the future" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.8 w.lang.en.frame_lead text="as a rule" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.9 w.lang.en.frame_lead text="for now" core.source="psys2 a019aa1e"
@w.lang.en.frame_lead.10 w.lang.en.frame_lead text="always" core.source="psys2 a019aa1e"
