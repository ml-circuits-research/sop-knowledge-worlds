@w.lang.en.aux.do w.lang.en.aux text=do tense=present support=do in=question-start in=question-tail core.source="psys2 a019aa1e"
@w.lang.en.aux.did w.lang.en.aux text=did tense=past support=do in=question-start core.source="psys2 a019aa1e"
