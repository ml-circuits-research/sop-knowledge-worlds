@w.lang.en.neg.words w.lang.en.neg text=not text=no text=never text=without text=nothing text=none text=nobody text=nowhere text=neither text=nor text=cannot core.source="psys2 a019aa1e"
@w.lang.en.neg.contracted w.lang.en.neg ending="n't" text=dont text=doesnt text=didnt text=isnt text=arent text=wasnt text=werent text=cant text=couldnt text=wont text=wouldnt text=shouldnt text=hasnt text=havent text=hadnt text=aint doc="every n't contraction (don't, isn't, can't, won't) is a negation; the same words written without the apostrophe are listed as `text` (an ending \"nt\" would also match want or plant)" core.source="psys2 a019aa1e"
@w.lang.en.neg.imperative.1 w.lang.en.neg.imperative text="do not" text=dont text="don't" text="please do not" text="do not ever" text="do not just" doc="the words that turn a request into 'do not': the rest is what must not be done; the system says it will not and changes nothing" core.source="psys2 a019aa1e"
@w.lang.en.neg.imperative.skip._ w.lang.en.neg.imperative.skip text=know text=worry text=mind text=forget text=think text=care text=bother text=say text=sure text=like text=want text=need text=have text=let doc="not a negated request: 'do not know', 'never mind', 'don't forget to save' (that one is a positive request), 'I do not want ...' has a subject" core.source="psys2 a019aa1e"
@w.lang.en.imperative.lead._ w.lang.en.imperative.lead text=please text=can text=you text=could text=would text=will text=lets text=let text=us text=now text=then text=also text=and doc="words dropped from the front before the verb is read" core.source="psys2 a019aa1e"
