@w.lang.en.class.verb_double_n w.lang.en.class name=verb.double.n parent=verb.double alt="n>nn@end" pos=verb about="n doubled (plan, planned)" core.source="hand-core 1"
@w.lang.en.class.verb_double_p w.lang.en.class name=verb.double.p parent=verb.double alt="p>pp@end" pos=verb about="p doubled (stop, stopped)" core.source="hand-core 1"
