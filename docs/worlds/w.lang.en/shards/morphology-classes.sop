@w.lang.en.class.adj_double w.lang.en.class name=adj.double parent=adj.er pos=adjective about="the last consonant doubled before -er and -est (one class per letter below)" core.source="hand-core 1"
@w.lang.en.class.adj_double_b w.lang.en.class name=adj.double.b parent=adj.double alt="b>bb@end" pos=adjective about="b doubled (drab, drabber)" core.source="hand-core 1"
@w.lang.en.class.adj_double_d w.lang.en.class name=adj.double.d parent=adj.double alt="d>dd@end" pos=adjective about="d doubled (sad, sadder)" core.source="hand-core 1"
@w.lang.en.class.adj_double_g w.lang.en.class name=adj.double.g parent=adj.double alt="g>gg@end" pos=adjective about="g doubled (big, bigger)" core.source="hand-core 1"
