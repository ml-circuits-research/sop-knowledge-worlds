# w.lang.en/shards/morphology-classes: English regular inflection in std.morph notation: 40 paradigm classes (nouns, verbs, adjectives) and their 51 cells, read with morphOf(world, { types: { cls: 'w.lang.en.class', ending: 'w.lang.en.ending', irregular: 'w.lang.en.irregular_form' } }); and 46 ordered suffix rules (op third, past, ing, comparative, superlative) for inflectBy, the guess for a word no dictionary has
# sources: hand-core 1 (written in this repository)
# license: CC0-1.0
# script: tools/lang-en-morph.mjs

# paradigm classes
@w.lang.en.class.noun_s w.lang.en.class name=noun.s pos=noun about="plural -s (cat, cats)" core.source="hand-core 1"
@w.lang.en.class.noun_es w.lang.en.class name=noun.es parent=noun.s pos=noun about="plural -es: after s, x, z, ch, sh, and some -o (box, boxes; potato, potatoes)" core.source="hand-core 1"
@w.lang.en.class.noun_ies w.lang.en.class name=noun.ies drop=y pos=noun about="a consonant and y: plural -ies (berry, berries)" core.source="hand-core 1"
@w.lang.en.class.noun_ves w.lang.en.class name=noun.ves drop=f pos=noun about="f > ves (leaf, leaves; wolf, wolves)" core.source="hand-core 1"
@w.lang.en.class.noun_fe w.lang.en.class name=noun.fe drop=fe pos=noun about="fe > ves (knife, knives; life, lives)" core.source="hand-core 1"
@w.lang.en.class.noun_same w.lang.en.class name=noun.same pos=noun about="a noun of plural form, the same in both numbers (clothes, arms, physics)" core.source="hand-core 1"
@w.lang.en.class.verb_s w.lang.en.class name=verb.s pos=verb about="-s, -ed, -ing (walk, walks, walked, walking)" core.source="hand-core 1"
@w.lang.en.class.verb_es w.lang.en.class name=verb.es parent=verb.s pos=verb about="-es after s, x, z, ch, sh and o (push, pushes; go, goes)" core.source="hand-core 1"
@w.lang.en.class.verb_e w.lang.en.class name=verb.e drop=e pos=verb about="a silent e dropped before -ed and -ing (make, makes, making; bake, baked)" core.source="hand-core 1"
@w.lang.en.class.verb_ee w.lang.en.class name=verb.ee parent=verb.s pos=verb about="ee, ye, oe keep the e before -ing and take -d (agree, agreed, agreeing; dye, dyeing)" core.source="hand-core 1"
@w.lang.en.class.verb_ie w.lang.en.class name=verb.ie drop=ie pos=verb about="ie > y before -ing (die, dies, died, dying)" core.source="hand-core 1"
@w.lang.en.class.verb_ies w.lang.en.class name=verb.ies drop=y pos=verb about="a consonant and y: -ies, -ied, -ying (carry, carries, carried, carrying)" core.source="hand-core 1"
@w.lang.en.class.verb_double w.lang.en.class name=verb.double parent=verb.s pos=verb about="the last consonant doubled before -ed and -ing (one class per letter below)" core.source="hand-core 1"
@w.lang.en.class.verb_double_b w.lang.en.class name=verb.double.b parent=verb.double alt="b>bb@end" pos=verb about="b doubled (rob, robbed)" core.source="hand-core 1"
