# script: none (hand-maintained after the first generation)

# drawing
@w.request.key.drawing.composition.source w.request.key tab=drawing family=composition name=composition.source head=class value=random value=conversation about="where a composed drawing's content comes from, at random or from the conversation (\"from the conversation\")" core.source="hand-core 1"
@w.request.key.drawing.composition.variant w.request.key tab=drawing family=composition name=composition.variant head=class value=another value=similar value=simpler value=richer about="how a new composition differs from the last one (\"a simpler variant\")" core.source="hand-core 1"
@w.request.key.drawing.composition.with w.request.key tab=drawing family=composition name=composition.with head=span about="the things a composition must include (\"include a dog and a kite\")" core.source="hand-core 1"
@w.request.key.drawing.drawn.align w.request.key tab=drawing family=drawn name=drawn.align head=class value=start value=middle value=end about="where the words of a text object sit on its centre (\"align the title to the end\")" means=w.drawing.object.align core.source="hand-core 1"
@w.request.key.drawing.drawn.anchor w.request.key tab=drawing family=drawn name=drawn.anchor head="fill+span" about="the other thing a relation is drawn or measured from (\"the kite near the tree\")" core.source="hand-core 1"
@w.request.key.drawing.drawn.at w.request.key tab=drawing family=drawn name=drawn.at head=class value=corner value=top value=bottom value=left value=right value=center value=top_left value=top_right value=bottom_left value=bottom_right value=middle value=background value=foreground about="the region of the page a thing is placed in (\"the top left corner\")" core.source="hand-core 1"
@w.request.key.drawing.drawn.behind w.request.key tab=drawing family=drawn name=drawn.behind head="fill+span" about="the thing in front that partly hides this one (\"the girl behind the tent\")" core.source="hand-core 1"
@w.request.key.drawing.drawn.cause w.request.key tab=drawing family=drawn name=drawn.cause head="fill+span" about="the thing an expression is about (\"happy because of the cake\")" core.source="hand-core 1"
