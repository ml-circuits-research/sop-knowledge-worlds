@w.request.key.diagram.chart.aggregate w.request.key tab=diagram family=chart name=chart.aggregate head=class value=count value=sum value=avg value=min value=max value=median about="how the values of each category are combined (\"the sum of sales\")" means=w.diagram.group.aggregate core.source="hand-core 1"
@w.request.key.diagram.chart.at w.request.key tab=diagram family=chart name=chart.at head=class value=left value=right value=top value=bottom value=center value=top_left value=top_right value=bottom_left value=bottom_right about="the region of the page a chart is placed in (\"at the top right\")" core.source="hand-core 1"
@w.request.key.diagram.chart.axisScale w.request.key tab=diagram family=chart name=chart.axisScale head=class value=linear value=log about="whether a chart's value axis is linear or logarithmic (\"a log axis\")" means=w.diagram.group.axis_scale core.source="hand-core 1"
@w.request.key.diagram.chart.axisSide w.request.key tab=diagram family=chart name=chart.axisSide head=class value=left value=right about="the side of the chart the value axis stands on (\"values on the right\")" means=w.diagram.group.y_axis core.source="hand-core 1"
@w.request.key.diagram.chart.barGap w.request.key tab=diagram family=chart name=chart.barGap head=span about="the gap left between the bars of a chart (\"a narrow gap between bars\")" core.source="hand-core 1"
@w.request.key.diagram.chart.barHeight w.request.key tab=diagram family=chart name=chart.barHeight head=span about="the height of the bars of a bar chart (\"taller bars\")" core.source="hand-core 1"
@w.request.key.diagram.chart.barWidth w.request.key tab=diagram family=chart name=chart.barWidth head=span about="the share of a category's room a bar takes (\"wide bars\")" means=w.diagram.group.bar_width core.source="hand-core 1"
@w.request.key.diagram.chart.below w.request.key tab=diagram family=chart name=chart.below head=number about="the thing a chart is placed below (\"below the title\")" core.source="hand-core 1"
@w.request.key.diagram.chart.bins w.request.key tab=diagram family=chart name=chart.bins head=number about="how many bins a histogram is divided into (\"ten bins\")" core.source="hand-core 1"
@w.request.key.diagram.chart.category w.request.key tab=diagram family=chart name=chart.category head=span about="the category a chart value stands for (\"the value for March\")" means=w.chart.point.category core.source="hand-core 1"
@w.request.key.diagram.chart.chart w.request.key tab=diagram family=chart name=chart.chart head=span about="the chart a series belongs to (\"add the series to chart c1\")" means=w.diagram.series.group core.source="hand-core 1"
@w.request.key.diagram.chart.colour w.request.key tab=diagram family=chart name=chart.colour head=candidate about="the colour a chart's marks are drawn in (\"paint the chart teal\")" means=w.diagram.group.colour core.source="hand-core 1"
@w.request.key.diagram.chart.datasets w.request.key tab=diagram family=chart name=chart.datasets head=span about="the data sets a chart is drawn from (\"from the sales table\")" core.source="hand-core 1"
@w.request.key.diagram.chart.dimension w.request.key tab=diagram family=chart name=chart.dimension head=span about="the dimension a chart is broken down by (\"sales by month\")" means=w.diagram.group.dimension core.source="hand-core 1"
@w.request.key.diagram.chart.effect w.request.key tab=diagram family=chart name=chart.effect head=class value=shadow value=gradient value=glow value=rounded value=animation value=transparent value="3d" value=outline about="the visual effect a chart is shown with (\"a shadow round the chart\")" core.source="hand-core 1"
@w.request.key.diagram.chart.errorBars w.request.key tab=diagram family=chart name=chart.errorBars head=class value=show value=hide about="whether a chart shows error bars (\"show the error bars\")" means=w.diagram.group.error_bars core.source="hand-core 1"
@w.request.key.diagram.chart.errorCap w.request.key tab=diagram family=chart name=chart.errorCap head=span about="the width of the caps on a chart's error bars (\"wider caps\")" means=w.diagram.group.error_cap core.source="hand-core 1"
@w.request.key.diagram.chart.errors w.request.key tab=diagram family=chart name=chart.errors head=span about="the error values drawn as error bars on a chart (\"errors of two either way\")" core.source="hand-core 1"
@w.request.key.diagram.chart.fontSize w.request.key tab=diagram family=chart name=chart.fontSize head=span about="the size of a chart's text (\"larger chart text\")" means=w.diagram.group.font_size core.source="hand-core 1"
@w.request.key.diagram.chart.grid w.request.key tab=diagram family=chart name=chart.grid head=class value=show value=hide about="whether a chart shows gridlines (\"show the grid\")" means=w.diagram.group.gridlines core.source="hand-core 1"
@w.request.key.diagram.chart.gridStyle w.request.key tab=diagram family=chart name=chart.gridStyle head=class value=solid value=dashed value=dotted about="the style of a chart's gridlines (\"dashed gridlines\")" means=w.diagram.group.grid_style core.source="hand-core 1"
@w.request.key.diagram.chart.gridlines w.request.key tab=diagram family=chart name=chart.gridlines head=class value=on value=off about="whether gridlines are drawn on a chart (\"turn the gridlines off\")" means=w.diagram.group.gridlines core.source="hand-core 1"
@w.request.key.diagram.chart.height w.request.key tab=diagram family=chart name=chart.height head=number about="the height of a chart's plot in pixels (\"a taller chart\")" means=w.diagram.group.height core.source="hand-core 1"
@w.request.key.diagram.chart.horizontal w.request.key tab=diagram family=chart name=chart.horizontal head=class value=on value=off about="whether a chart's bars lie horizontally (\"horizontal bars\")" means=w.diagram.group.orientation core.source="hand-core 1"
@w.request.key.diagram.chart.id w.request.key tab=diagram family=chart name=chart.id head=candidate about="the code of the chart a request selects (\"change chart c1\")" means=w.diagram.group.code core.source="hand-core 1"
@w.request.key.diagram.chart.ids w.request.key tab=diagram family=chart name=chart.ids head=candidate about="the codes of the charts a request selects (\"remove both charts\")" core.source="hand-core 1"
@w.request.key.diagram.chart.invert w.request.key tab=diagram family=chart name=chart.invert head=class value=x value=y value=none about="which axis of a chart is drawn the other way (\"values from the top\")" means=w.diagram.group.invert core.source="hand-core 1"
@w.request.key.diagram.chart.label w.request.key tab=diagram family=chart name=chart.label head=span about="the label or title of a chart (\"label it Sales\")" means=w.diagram.group.label core.source="hand-core 1"
@w.request.key.diagram.chart.labels w.request.key tab=diagram family=chart name=chart.labels head=span about="the labels of the bars, slices or points of a chart (\"label the slices\")" core.source="hand-core 1"
@w.request.key.diagram.chart.layout w.request.key tab=diagram family=chart name=chart.layout head=class value=bar value=line value=area value=pie value=doughnut value=scatter value=radar value=treemap about="how a chart's marks are laid out (\"draw it as a pie\")" means=w.diagram.group.layout core.source="hand-core 1"
@w.request.key.diagram.chart.legend w.request.key tab=diagram family=chart name=chart.legend head=class value=show value=hide value=top value=bottom value=left value=right about="where a chart's legend stands or whether it is shown (\"legend at the bottom\")" means=w.diagram.group.legend core.source="hand-core 1"
@w.request.key.diagram.chart.lineStyle w.request.key tab=diagram family=chart name=chart.lineStyle head=class value=solid value=dashed value=dotted value=dash_dot about="the style of a line chart's line (\"a dashed line\")" means=w.diagram.group.line_style core.source="hand-core 1"
@w.request.key.diagram.chart.lineWidth w.request.key tab=diagram family=chart name=chart.lineWidth head=span about="the width of a line chart's line (\"a thicker line\")" means=w.diagram.group.line_width core.source="hand-core 1"
@w.request.key.diagram.chart.markerEdge w.request.key tab=diagram family=chart name=chart.markerEdge head=span about="the width of the outline round a line chart's points (\"thicker point edges\")" means=w.diagram.group.marker_edge core.source="hand-core 1"
@w.request.key.diagram.chart.markerSize w.request.key tab=diagram family=chart name=chart.markerSize head=span about="the size of a line chart's points (\"bigger points\")" means=w.diagram.group.marker_size core.source="hand-core 1"
@w.request.key.diagram.chart.max w.request.key tab=diagram family=chart name=chart.max head=number about="the top of a chart's value axis (\"up to 100\")" means=w.diagram.group.y_max core.source="hand-core 1"
@w.request.key.diagram.chart.measure w.request.key tab=diagram family=chart name=chart.measure head=span about="what a chart's values measure (\"sales\")" means=w.diagram.group.measure core.source="hand-core 1"
@w.request.key.diagram.chart.min w.request.key tab=diagram family=chart name=chart.min head=number about="the bottom of a chart's value axis (\"start at 0\")" means=w.diagram.group.y_min core.source="hand-core 1"
@w.request.key.diagram.chart.only w.request.key tab=diagram family=chart name=chart.only head=span about="the single category or series a chart is limited to (\"only the March values\")" core.source="hand-core 1"
@w.request.key.diagram.chart.order w.request.key tab=diagram family=chart name=chart.order head=class value=ascending value=descending value=label about="the order a chart's categories are shown in (\"largest first\")" core.source="hand-core 1"
@w.request.key.diagram.chart.orientation w.request.key tab=diagram family=chart name=chart.orientation head=class value=vertical value=horizontal about="whether a chart stands vertically or lies horizontally (\"a horizontal bar chart\")" means=w.diagram.group.orientation core.source="hand-core 1"
@w.request.key.diagram.chart.palette w.request.key tab=diagram family=chart name=chart.palette head=candidate about="the colour palette a chart's marks are drawn in (\"a pastel palette\")" core.source="hand-core 1"
@w.request.key.diagram.chart.pieRadius w.request.key tab=diagram family=chart name=chart.pieRadius head=span about="the radius of a pie or doughnut chart (\"a smaller pie\")" means=w.diagram.group.pie_radius core.source="hand-core 1"
@w.request.key.diagram.chart.precision w.request.key tab=diagram family=chart name=chart.precision head=class value="0" value="1" value="2" value="3" value="4" about="how many decimals a chart's numbers show (\"two decimals\")" means=w.diagram.group.precision core.source="hand-core 1"
@w.request.key.diagram.chart.series w.request.key tab=diagram family=chart name=chart.series head=span about="the names of the series in a chart (\"sales and costs\")" core.source="hand-core 1"
@w.request.key.diagram.chart.share w.request.key tab=diagram family=chart name=chart.share head=class value=value value=label about="whether shares of a total determine the plotted values or are printed on the marks" core.source="hand-core 1"
@w.request.key.diagram.chart.share.base w.request.key tab=diagram family=chart name=chart.share.base head=span about="the stated total used as the denominator of a chart share" core.source="hand-core 1"
