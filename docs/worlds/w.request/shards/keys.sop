@w.request.key.drawing.drawn.colour w.request.key tab=drawing family=drawn name=drawn.colour head="candidate+step" about="the colour of a drawn thing, with a step for darker or lighter (\"a slightly darker blue\")" means=w.drawing.object.colour core.source="hand-core 1"
@w.request.key.drawing.drawn.count w.request.key tab=drawing family=drawn name=drawn.count head=number about="how many of a thing to add (\"add three clouds\")" core.source="hand-core 1"
