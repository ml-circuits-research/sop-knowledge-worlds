@w.request.key.diagram.chart.show_values w.request.key tab=diagram family=chart name=chart.show_values head=class value=show value=hide about="whether a chart shows the values on its marks (\"hide the values\")" means=w.diagram.group.value_labels core.source="hand-core 1"
@w.request.key.diagram.chart.sort w.request.key tab=diagram family=chart name=chart.sort head=class value=desc value=asc value=alpha value=given about="how a chart's values are sorted (\"largest first\")" core.source="hand-core 1"
@w.request.key.diagram.chart.source w.request.key tab=diagram family=chart name=chart.source head="class+span" value=calendar value=document value=list value=prices value=holdings value=typed about="where a chart's data comes from (\"from the calendar\")" core.source="hand-core 1"
@w.request.key.diagram.chart.stacked w.request.key tab=diagram family=chart name=chart.stacked head=class value=on value=off about="whether a chart's series are stacked (\"stacked bars\")" means=w.diagram.group.stacking core.source="hand-core 1"
@w.request.key.diagram.chart.stacking w.request.key tab=diagram family=chart name=chart.stacking head=class value=none value=stacked value=percent about="how a chart's series sit together (\"as percentages\")" means=w.diagram.group.stacking core.source="hand-core 1"
@w.request.key.diagram.chart.subtract w.request.key tab=diagram family=chart name=chart.subtract head=number about="how much to subtract from a chart value (\"subtract two\")" core.source="hand-core 1"
@w.request.key.diagram.chart.test w.request.key tab=diagram family=chart name=chart.test head=class value=below value=above about="whether a chart highlight marks values above or below a threshold (\"highlight values above ten\")" core.source="hand-core 1"
@w.request.key.diagram.chart.tickFormat w.request.key tab=diagram family=chart name=chart.tickFormat head=class value=plain value=magnitude value=power about="how a chart writes its axis numbers (\"as 1.2k\")" means=w.diagram.group.tick_format core.source="hand-core 1"
@w.request.key.diagram.chart.ties w.request.key tab=diagram family=chart name=chart.ties head=class value=include value=exclude about="whether categories tied at a chart ranking cutoff are included beyond the requested count" core.source="hand-core 1"
@w.request.key.diagram.chart.title w.request.key tab=diagram family=chart name=chart.title head=span about="the title a chart shows (\"title it Sales by month\")" means=w.diagram.group.label core.source="hand-core 1"
