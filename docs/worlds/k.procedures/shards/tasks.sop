# set a table
@k.procedures.method.set_a_table k.procedures.method name="set a table" about="A table set for a number of people (four if none is said): the table if there is none, a chair for each around it, and a plate and a cup for each on its top." act=make rank=2 example="set a table for four" example="lay the table for two" core.source="hand-core 1"
