# write a scientific article about a topic
@k.procedures.method.write_a_scientific_article_about_a_topic k.procedures.method name="write a scientific article about a topic" about="A scientific article (the genre \"scientific article\" of k.genres, IMRaD) about a topic: choose two to five results, statements about the topic on different keys, sampled by k.interest (numbers with units first); the methods are the types of the catalog those statements come from; then make the document and one chapter per required part (abstract, introduction, methods, results, discussion)." act=make world=w.document example="write a scientific article about penguins" example="a paper about Peru" core.source="hand-core 1"
@k.procedures.goal.write_a_scientific_article_about_a_topic.kind k.procedures.goal method="write a scientific article about a topic" role=kind value="scientific article" core.source="hand-core 1"
@k.procedures.goal.write_a_scientific_article_about_a_topic.value k.procedures.goal method="write a scientific article about a topic" role=value needed=true core.source="hand-core 1"
