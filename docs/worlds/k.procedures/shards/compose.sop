# write an essay about a topic
@k.procedures.method.write_an_essay_about_a_topic k.procedures.method name="write an essay about a topic" about="An essay (the genre \"essay\" of k.genres) about a topic: choose two to four arguments, statements about the topic on different keys, and a counterargument on another key, sampled by k.interest (arguments that surprise, a counterargument that is what a reader assumes); then make the document, the introduction, counterargument and conclusion chapters and one chapter per argument." act=make world=w.document example="write an essay about penguins" core.source="hand-core 1"
@k.procedures.goal.write_an_essay_about_a_topic.kind k.procedures.goal method="write an essay about a topic" role=kind value=essay core.source="hand-core 1"
