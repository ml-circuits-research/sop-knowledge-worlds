# script: tools/procedures-core.mjs

# compose a scene
@k.procedures.method.compose_a_scene k.procedures.method name="compose a scene" about="Draw a scene of k.scenes: its ground first, then every thing the scene has, as many as it usually has, where it usually is; a thing that rests on another (a duck on the pond) after the things it rests on." act=make example="draw a farm" example="a beach" core.source="hand-core 1"
