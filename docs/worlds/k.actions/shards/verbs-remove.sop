@k.actions.verb.remove.throw_out k.actions.verb text="throw out" act=remove sense=2 gloss="throw or cast away" object=thing separable=true named=model core.source="wordnet 3.1"
@k.actions.verb.remove.destroy k.actions.verb text=destroy act=remove sense=1 gloss="do away with, cause the destruction or undoing of" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.remove.do_away_with k.actions.verb text="do away with" act=remove sense=1 gloss="terminate, end, or take out" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.remove.scrap k.actions.verb text=scrap act=remove sense=1 gloss="dispose of (something useless or old)" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.remove.cancel k.actions.verb text=cancel act=remove sense=4 gloss="remove or make invisible" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.remove.cut_out k.actions.verb text="cut out" act=remove sense=1 gloss="delete or remove" object=thing separable=true named=model core.source="wordnet 3.1"
