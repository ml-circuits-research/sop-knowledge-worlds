# k.actions/shards/families: act families: the 16 acts grouped by what they do (15 families in three layers: creation and destruction under existence, joining and separating under structure, change of a value, change of place, question, view, history, keeping) and by the role they need (3 families), each membership with its reason; the up edges of acts for the library's cousins.
# sources: hand-core 1 (hand-written in this repository: tools/acts-core.mjs; the "takes" families are read off the roles)
# license: CC0-1.0
# script: tools/acts-core.mjs

# Families: what they do (dimension does) and what they need (dimension takes), with the families above them.
@k.actions.family.change_of_the_world k.actions.family name="change of the world" dimension=does about="acts after which the things that are there are not the same: other things, other values, other places, other wholes" core.source="hand-core 1"
@k.actions.family.no_change_of_things k.actions.family name="no change of things" dimension=does about="acts after which the things are as before: only an answer is given or what is picked differs" core.source="hand-core 1"
@k.actions.family.the_work_itself k.actions.family name="the work itself" dimension=does about="acts on the steps done or on the work as a whole, not on one thing in it" core.source="hand-core 1"
@k.actions.family.existence k.actions.family name=existence dimension=does about="acts that make a thing be there or not be there (creation and destruction)" parent="change of the world" core.source="hand-core 1"
@k.actions.family.structure k.actions.family name=structure dimension=does about="acts that change which things belong together (grouping): joined, grouped, or apart" parent="change of the world" core.source="hand-core 1"
@k.actions.family.creation k.actions.family name=creation dimension=does about="a new thing is there after it" parent=existence core.source="hand-core 1"
@k.actions.family.destruction k.actions.family name=destruction dimension=does about="a thing is no longer there after it" parent=existence core.source="hand-core 1"
@k.actions.family.change_of_a_value k.actions.family name="change of a value" dimension=does about="a thing has another value of one of its attributes after it" parent="change of the world" core.source="hand-core 1"
@k.actions.family.change_of_place k.actions.family name="change of place" dimension=does about="a thing is somewhere else after it" parent="change of the world" core.source="hand-core 1"
@k.actions.family.joining k.actions.family name=joining dimension=does about="things are together after it, as one group, in an order, or with a line between them" parent=structure core.source="hand-core 1"
@k.actions.family.separating k.actions.family name=separating dimension=does about="a thing is in parts, or apart from another, after it" parent=structure core.source="hand-core 1"
@k.actions.family.question k.actions.family name=question dimension=does about="nothing changes; something about the things is told back" parent="no change of things" core.source="hand-core 1"
@k.actions.family.view k.actions.family name=view dimension=does about="only what is picked changes: the things the next acts are about" parent="no change of things" core.source="hand-core 1"
@k.actions.family.history k.actions.family name=history dimension=does about="the things come back as they were at an earlier or a later step" parent="the work itself" core.source="hand-core 1"
@k.actions.family.keeping k.actions.family name=keeping dimension=does about="the work goes out of the application or comes back into it (kept, brought back, given to someone)" parent="the work itself" core.source="hand-core 1"
@k.actions.family.acts_by_what_they_need k.actions.family name="acts by what they need" dimension=takes about="acts grouped by the one role they cannot do without" core.source="hand-core 1"
@k.actions.family.acts_on_a_kind k.actions.family name="acts on a kind" dimension=takes about="the needed role holds a kind" parent="acts by what they need" core.source="hand-core 1"
@k.actions.family.acts_on_a_thing k.actions.family name="acts on a thing" dimension=takes about="the needed role holds a thing" parent="acts by what they need" core.source="hand-core 1"
@k.actions.family.acts_that_need_no_filler k.actions.family name="acts that need no filler" dimension=takes about="no role is needed: the act has a meaning with nothing named" parent="acts by what they need" core.source="hand-core 1"

# Members: an act is in a family, and why.
@k.actions.member.make.creation k.actions.member act=make family=creation why="it brings a new thing into being" core.source="hand-core 1"
@k.actions.member.copy.creation k.actions.member act=copy family=creation why="it makes another thing, the same as one that is there" core.source="hand-core 1"
@k.actions.member.remove.destruction k.actions.member act=remove family=destruction why="it takes a thing away so that it is no longer there" core.source="hand-core 1"
@k.actions.member.change.change_of_a_value k.actions.member act=change family="change of a value" why="it gives a thing another value of one of its attributes (or puts another thing in its place)" core.source="hand-core 1"
@k.actions.member.place.change_of_place k.actions.member act=place family="change of place" why="it puts a thing somewhere, or moves it to another place" core.source="hand-core 1"
@k.actions.member.send.change_of_place k.actions.member act=send family="change of place" why="the thing goes to someone else or out of the application" core.source="hand-core 1"
@k.actions.member.send.keeping k.actions.member act=send family=keeping why="the work, or a thing of it, leaves the application" core.source="hand-core 1"
@k.actions.member.connect.joining k.actions.member act=connect family=joining why="two things stay together, or a line runs between them" core.source="hand-core 1"
@k.actions.member.group.joining k.actions.member act=group family=joining why="several things become one group, or are put in an order" core.source="hand-core 1"
@k.actions.member.take_apart.separating k.actions.member act="take apart" family=separating why="a thing becomes its parts, or one thing is separated from another" core.source="hand-core 1"
@k.actions.member.ask.question k.actions.member act=ask family=question why="it wants to know something about the things that are there and changes nothing" core.source="hand-core 1"
@k.actions.member.pick.view k.actions.member act=pick family=view why="one or some things are picked, to act on them next" core.source="hand-core 1"
@k.actions.member.deselect.view k.actions.member act=deselect family=view why="a thing is no longer picked" core.source="hand-core 1"
@k.actions.member.undo.history k.actions.member act=undo family=history why="what was done last is taken back" core.source="hand-core 1"
@k.actions.member.redo.history k.actions.member act=redo family=history why="what undo took back is done again" core.source="hand-core 1"
@k.actions.member.save.keeping k.actions.member act=save family=keeping why="the work is kept so that it can be brought back later" core.source="hand-core 1"
@k.actions.member.load.keeping k.actions.member act=load family=keeping why="work that was kept is brought back" core.source="hand-core 1"
@k.actions.member.make.acts_on_a_kind k.actions.member act=make family="acts on a kind" why="its needed role kind holds a kind" core.source="hand-core 1"
@k.actions.member.remove.acts_on_a_thing k.actions.member act=remove family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.change.acts_on_a_thing k.actions.member act=change family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.place.acts_on_a_thing k.actions.member act=place family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.connect.acts_on_a_thing k.actions.member act=connect family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.group.acts_on_a_thing k.actions.member act=group family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.take_apart.acts_on_a_thing k.actions.member act="take apart" family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.pick.acts_on_a_thing k.actions.member act=pick family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.ask.acts_that_need_no_filler k.actions.member act=ask family="acts that need no filler" why="none of its roles is needed" core.source="hand-core 1"
@k.actions.member.copy.acts_on_a_thing k.actions.member act=copy family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.send.acts_on_a_thing k.actions.member act=send family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.undo.acts_that_need_no_filler k.actions.member act=undo family="acts that need no filler" why="none of its roles is needed" core.source="hand-core 1"
@k.actions.member.save.acts_that_need_no_filler k.actions.member act=save family="acts that need no filler" why="none of its roles is needed" core.source="hand-core 1"
@k.actions.member.load.acts_on_a_thing k.actions.member act=load family="acts on a thing" why="its needed role thing holds a thing" core.source="hand-core 1"
@k.actions.member.redo.acts_that_need_no_filler k.actions.member act=redo family="acts that need no filler" why="none of its roles is needed" core.source="hand-core 1"
@k.actions.member.deselect.acts_that_need_no_filler k.actions.member act=deselect family="acts that need no filler" why="none of its roles is needed" core.source="hand-core 1"
