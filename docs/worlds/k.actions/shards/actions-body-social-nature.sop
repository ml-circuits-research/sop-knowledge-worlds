# k.actions/shards/actions-body-social-nature: 46 actions of the body; with others; what weather, plants and things do: who or what does it, to what, with what, where, what comes of it, the opposite and what undoes it, an example; the other forms of the verbs; and 120 verbs and phrases that mean nearly the same.
# sources: hand-core 1 (hand-written in this repository: tools/actions-data.mjs)
# license: CC0-1.0
# script: tools/actions-core.mjs

@k.actions.action.eat k.actions.action name=eat group=body who=person who=animal object=apple object=bread object=grass object=soup object=cake tool=spoon tool=fork tool=mouth where=kitchen where=restaurant where=picnic result="not being hungry; the food being gone" example="A rabbit eats a carrot." core.source="hand-core 1"
@k.actions.action.drink k.actions.action name=drink group=body who=person who=animal object=water object=milk object=juice object=tea tool=cup tool=glass tool=bottle tool=straw where=kitchen where=cafe result="not being thirsty" example="A cat drinks milk." core.source="hand-core 1"
@k.actions.action.bite k.actions.action name=bite group=body who=person who=dog who=mosquito who=shark object=apple object=bone object=sandwich tool=tooth result="a piece off, or tooth marks" example="She bites into an apple." core.source="hand-core 1"
@k.actions.action.chew k.actions.action name=chew group=body who=person who=cow who=dog object=food object=grass object=bone object=gum tool=tooth result="food made small for swallowing" example="A cow chews grass." core.source="hand-core 1"
@k.actions.action.sleep k.actions.action name=sleep group=body who=person who=animal tool=bed tool=pillow tool=blanket where=bedroom where=night where=nursery result="being rested" opposite=wake undone_by=wake example="A bear sleeps through the winter." core.source="hand-core 1"
@k.actions.action.wake k.actions.action name=wake group=body who=person who=animal tool="alarm clock" where=bedroom result="not sleeping any more" opposite=sleep example="She wakes when the alarm clock rings." core.source="hand-core 1"
@k.actions.action.sit k.actions.action name=sit group=body who=person who=dog who=cat who=bird tool=chair tool=bench tool=sofa where=classroom where="living room" where=park result="resting on a seat or on the ground" opposite=stand undone_by=stand example="Grandmother sits in the rocking chair." core.source="hand-core 1"
@k.actions.action.stand k.actions.action name=stand group=body who=person who=animal who=tree who=house tool=foot tool=leg result="being upright on the feet" opposite=sit undone_by=sit example="A heron stands on one leg." core.source="hand-core 1"
@k.actions.action.lie k.actions.action name=lie group=body who=person who=animal tool=bed tool=sofa tool=blanket where=bedroom where=beach result="resting flat" undone_by=stand example="The dog lies in front of the fire." core.source="hand-core 1"
@k.actions.action.breathe k.actions.action name=breathe group=body who=person who=animal object=air tool=nose tool=mouth tool=lung result="air going in and out; staying alive" example="Whales come up to breathe." core.source="hand-core 1"
@k.actions.action.yawn k.actions.action name=yawn group=body who=person who=cat who=dog who=lion tool=mouth where=bedroom where=night result="showing that one is tired" example="The tired child yawns." core.source="hand-core 1"
@k.actions.action.sneeze k.actions.action name=sneeze group=body who=person who=cat who=dog tool=nose tool=handkerchief result="air bursting out of the nose" example="Dust makes him sneeze." core.source="hand-core 1"
@k.actions.action.wear k.actions.action name=wear group=body who=person object=hat object=coat object=shoes object=glasses object=dress result="having the thing on the body" example="A firefighter wears a helmet." core.source="hand-core 1"
@k.actions.action.put_on k.actions.action name="put on" group=body who=person object=hat object=coat object=shoes object=glasses object=sock tool=hand where=bedroom result="the thing being on the body" opposite="take off" undone_by="take off" example="He puts on his coat." core.source="hand-core 1"
@k.actions.action.take_off k.actions.action name="take off" group=body who=person object=hat object=coat object=shoes object=glasses object=sock tool=hand where=bedroom result="the thing no longer being on the body" opposite="put on" undone_by="put on" example="She takes off her shoes at the door." core.source="hand-core 1"
@k.actions.action.help k.actions.action name=help group=social who=person who=dog object=friend object=neighbour object=child object="old person" tool=hand result="something being easier for another" example="She helps her grandmother to carry the bags." core.source="hand-core 1"
@k.actions.action.play k.actions.action name=play group=social who=person who=child who=kitten who=puppy object=game object=ball object=guitar object=piano object=hide-and-seek tool=ball tool=toy tool=doll where=playground where=park where=nursery where=beach result="having fun; music, when it is an instrument" opposite=work example="Children play in the playground." core.source="hand-core 1"
@k.actions.action.work k.actions.action name=work group=social who=person who=ant who=bee who=machine tool=computer where=office where=farm where=workshop where="construction site" result="something done or made" opposite=play example="A farmer works in the field." core.source="hand-core 1"
@k.actions.action.share k.actions.action name=share group=social who=person object=cake object=toy object=sweets object=umbrella tool=hand where=picnic where=nursery result="each having a part" example="The children share the cake." core.source="hand-core 1"
@k.actions.action.hug k.actions.action name=hug group=social who=person object=friend object=mother object="teddy bear" object=tree tool=arm result="showing love; feeling close" example="A child hugs her teddy bear." core.source="hand-core 1"
@k.actions.action.kiss k.actions.action name=kiss group=social who=person object=baby object=cheek object=mother object=frog tool=mouth result="showing love" example="Mother kisses the baby goodnight." core.source="hand-core 1"
@k.actions.action.wave k.actions.action name=wave group=social who=person who=flag who=branch object=hand object=flag object=goodbye tool=hand where="railway station" where=harbour result="a greeting or a goodbye seen from far" example="He waves goodbye from the train." core.source="hand-core 1"
@k.actions.action.visit k.actions.action name=visit group=social who=person object=grandmother object=friend object=museum object=zoo where=museum where=zoo where=hospital result="being with someone or somewhere for a while" example="They visit their grandmother on Sunday." core.source="hand-core 1"
@k.actions.action.wait k.actions.action name=wait group=social who=person who=dog object=bus object=turn object=friend object=train where="railway station" where="city street" where=hospital result="being there when it comes" example="People wait for the bus." core.source="hand-core 1"
@k.actions.action.meet k.actions.action name=meet group=social who=person object=friend object=neighbour object=teacher where=park where=cafe where="city street" result="being together; knowing each other" example="Two friends meet in the park." core.source="hand-core 1"
@k.actions.action.fight k.actions.action name=fight group=social who=person who=cat who=dog who=knight object=dragon object=enemy object=fire tool=sword tool=shield result="one winning, or both hurt" example="The knight fights a dragon." core.source="hand-core 1"
@k.actions.action.feed k.actions.action name=feed group=social who=person who=bird object=baby object=cat object=hen object=duck object=fish tool=bottle tool=spoon tool=bowl tool=hay where=farm where=zoo where=park result="another not being hungry" example="The farmer feeds the hens." core.source="hand-core 1"
@k.actions.action.buy k.actions.action name=buy group=social who=person object=bread object=ticket object=toy object=shoes tool=money tool="shopping bags" tool="shopping cart" where=supermarket where=market result="having the thing, and less money" opposite=sell example="She buys bread at the market." core.source="hand-core 1"
@k.actions.action.sell k.actions.action name=sell group=social who=person who=shopkeeper object=bread object=flowers object=tickets object=fruit tool="balance scale" tool=money where=supermarket where=market result="having money, and the thing gone" opposite=buy example="The baker sells bread." core.source="hand-core 1"
@k.actions.action.pay k.actions.action name=pay group=social who=person object=bill object=ticket object=shopkeeper tool=money tool=coin where=supermarket where=restaurant where=cafe result="the other having the money" example="He pays for the tickets." core.source="hand-core 1"
@k.actions.action.win k.actions.action name=win group=social who=person who=team who=horse object=game object=race object=prize object=cup where="football pitch" where=fairground result="being first or best" example="Her team wins the game." core.source="hand-core 1"
@k.actions.action.send k.actions.action name=send group=social who=person object=letter object=parcel object=message object=postcard tool=envelope tool=postbox tool=phone result="the thing being on its way to another" opposite=receive example="She sends a postcard to her friend." core.source="hand-core 1"
@k.actions.action.receive k.actions.action name=receive group=social who=person object=letter object=present object=parcel object=prize tool=hand where=Christmas where="birthday party" result="having what another sent or gave" opposite=send example="He receives a parcel from his aunt." core.source="hand-core 1"
@k.actions.action.thank k.actions.action name=thank group=social who=person object=friend object=mother object=helper tool=voice result="the other knowing that one is glad of the help" example="She thanks the firefighter." core.source="hand-core 1"
@k.actions.action.rain k.actions.action name=rain group=nature who=cloud who=sky where="rainy day" where=jungle result="the ground being wet; puddles" example="It rains from grey clouds." core.source="hand-core 1"
@k.actions.action.snow k.actions.action name=snow group=nature who=cloud who=sky where=winter where=arctic where=mountains result="the ground being white" example="It snows in winter." core.source="hand-core 1"
@k.actions.action.shine k.actions.action name=shine group=nature who=sun who=moon who=star who=lamp who=torch where=night where=beach result="light on things" example="The sun shines on the beach." core.source="hand-core 1"
@k.actions.action.glow k.actions.action name=glow group=nature who=firefly who=fire who=lamp who=moon who=ember where=night where=campsite result="a soft light" example="The embers of the campfire glow." core.source="hand-core 1"
@k.actions.action.blow k.actions.action name=blow group=nature who=wind who=person object=leaves object=candle object=balloon object=whistle object=kite tool=mouth where=autumn where="birthday party" result="air moving, and light things with it" example="The wind blows the leaves away." core.source="hand-core 1"
@k.actions.action.flow k.actions.action name=flow group=nature who=river who=water who=lava where=river where=mountains result="water moving along" example="The river flows to the sea." core.source="hand-core 1"
@k.actions.action.grow k.actions.action name=grow group=nature who=plant who=tree who=child who=animal who=hair where=garden where=field where=forest where=spring result="being bigger or taller" opposite=shrink example="A sunflower grows tall in the summer." core.source="hand-core 1"
@k.actions.action.shrink k.actions.action name=shrink group=nature who=sweater who=puddle who=balloon who=ice result="being smaller" opposite=grow example="The puddle shrinks in the sun." core.source="hand-core 1"
@k.actions.action.bloom k.actions.action name=bloom group=nature who=flower who=tree where=garden where=meadow where=spring where=orchard result="open flowers" opposite=wilt example="The apple trees bloom in spring." core.source="hand-core 1"
@k.actions.action.wilt k.actions.action name=wilt group=nature who=flower who=plant who=leaf result="hanging down, dry" opposite=bloom undone_by=water example="The flowers wilt without water." core.source="hand-core 1"
@k.actions.action.hatch k.actions.action name=hatch group=nature who=chick who=bird who=turtle who=crocodile object=egg where=farm where=spring result="a young animal out of its egg" example="A chick hatches from the egg." core.source="hand-core 1"
@k.actions.action.ring k.actions.action name=ring group=nature who=bell who=phone who="alarm clock" where=classroom result="a clear sound" example="The school bell rings." core.source="hand-core 1"

