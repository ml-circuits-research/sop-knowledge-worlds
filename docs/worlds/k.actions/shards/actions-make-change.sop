# k.actions/shards/actions-make-change: 45 actions of making; changing a thing: who or what does it, to what, with what, where, what comes of it, the opposite and what undoes it, an example; the other forms of the verbs; and 107 verbs and phrases that mean nearly the same.
# sources: hand-core 1 (hand-written in this repository: tools/actions-data.mjs)
# license: CC0-1.0
# script: tools/actions-core.mjs

@k.actions.action.make k.actions.action name=make group=make who=person who=bird who=bee object=cake object=toy object=nest object=noise tool=hand where=workshop where=kitchen result="a new thing" opposite=destroy undone_by=destroy example="A bird makes a nest from twigs." core.source="hand-core 1"
@k.actions.action.build k.actions.action name=build group=make who=person who=bird who=beaver object=house object=tower object=bridge object=sandcastle object=nest tool=brick tool=hammer tool=crane where="construction site" where=beach result="a new building or thing that stands" opposite="knock down" undone_by="knock down" example="Builders build a house from bricks." core.source="hand-core 1"
@k.actions.action.knock_down k.actions.action name="knock down" group=change who=person who=bulldozer who=wind object=tower object=wall object=house object=sandcastle tool=hammer tool=bulldozer where="construction site" result="the thing lying in pieces" opposite=build undone_by=build example="The child knocks down the tower of blocks." core.source="hand-core 1"
@k.actions.action.destroy k.actions.action name=destroy group=change who=person who=fire who=storm object=house object=toy object=nest tool=hammer tool=fire result="the thing no longer being there or usable" opposite=make example="The storm destroys the old barn." core.source="hand-core 1"
@k.actions.action.draw k.actions.action name=draw group=make who=person object=picture object=house object=line object=face tool=pencil tool=crayon tool=paper where=classroom where=nursery result="a picture" opposite=erase undone_by=erase example="A child draws a house with a pencil." core.source="hand-core 1"
@k.actions.action.erase k.actions.action name=erase group=change who=person object=line object=word object=picture object=mistake tool=eraser where=classroom result="the marks being gone" opposite=draw example="She erases the wrong line." core.source="hand-core 1"
@k.actions.action.paint k.actions.action name=paint group=make who=person object=picture object=wall object=fence object=face tool="paint brush" tool=paint where=museum where=classroom result="colour on the thing" example="A painter paints a picture with a brush." core.source="hand-core 1"
@k.actions.action.write k.actions.action name=write group=make who=person object=letter object=word object=name object=story tool=pen tool=pencil tool=paper where=classroom where=office result="words that can be read" undone_by=erase example="She writes a letter with a pen." core.source="hand-core 1"
@k.actions.action.cook k.actions.action name=cook group=make who=person object=soup object=egg object=rice object=dinner tool=saucepan tool=cooker tool="wooden spoon" where=kitchen where=restaurant where=campsite result="food ready to eat" example="A cook cooks soup in a saucepan." core.source="hand-core 1"
@k.actions.action.bake k.actions.action name=bake group=make who=person object=bread object=cake object=biscuit object=pizza tool=oven tool=dough tool=flour where=kitchen result="baked food" example="A baker bakes bread in the oven." core.source="hand-core 1"
@k.actions.action.mix k.actions.action name=mix group=make who=person object=flour object=paint object=salad object=colour tool=spoon tool=bowl where=kitchen result="one thing out of several" example="She mixes flour and eggs in a bowl." core.source="hand-core 1"
@k.actions.action.sew k.actions.action name=sew group=make who=person object=button object=dress object=shirt object=patch tool="sewing needle" tool=thread tool="sewing machine" result="cloth joined by thread" example="Grandmother sews a button on the shirt." core.source="hand-core 1"
@k.actions.action.knit k.actions.action name=knit group=make who=person object=scarf object=sweater object=sock tool=yarn result="a piece of clothing from yarn" example="Grandmother knits a scarf." core.source="hand-core 1"
@k.actions.action.plant k.actions.action name=plant group=make who=person object=tree object=flower object=seed object=potato tool=spade tool="watering can" where=garden where=field where=orchard result="a plant in the ground that can grow" undone_by=dig example="A gardener plants a tree." core.source="hand-core 1"
@k.actions.action.dig k.actions.action name=dig group=make who=person who=dog who=mole who=rabbit object=hole object=garden object=sand object=tunnel tool=spade tool=shovel tool=paw where=garden where=beach where="construction site" result="a hole in the ground" undone_by=fill example="A dog digs a hole in the garden." core.source="hand-core 1"
@k.actions.action.fold k.actions.action name=fold group=make who=person object=paper object=towel object=shirt object=letter tool=hand result="the thing lying double, smaller" opposite=unfold undone_by=unfold example="He folds the paper into a boat." core.source="hand-core 1"
@k.actions.action.unfold k.actions.action name=unfold group=change who=person object=map object=paper object=towel object=napkin tool=hand result="the thing lying flat and open" opposite=fold undone_by=fold example="She unfolds the map." core.source="hand-core 1"
@k.actions.action.glue k.actions.action name=glue group=make who=person object=paper object=picture object=wood object="broken cup" tool=glue where=classroom where=workshop result="two things stuck together" example="She glues the picture into the book." core.source="hand-core 1"
@k.actions.action.join k.actions.action name=join group=make who=person object=pieces object=dots object=hands object=pipes tool=glue tool=rope tool=nail result="several things being one" opposite=separate undone_by=separate example="He joins the dots with a line." core.source="hand-core 1"
@k.actions.action.separate k.actions.action name=separate group=change who=person object=pieces object=eggs object=colours tool=hand result="things being apart" opposite=join undone_by=join example="She separates the red beads from the blue ones." core.source="hand-core 1"
@k.actions.action.cut k.actions.action name=cut group=change who=person object=bread object=paper object=hair object=wood object=cake tool="kitchen knife" tool=scissors tool=saw where=kitchen where=workshop result="two or more pieces" example="A person cuts bread with a knife." core.source="hand-core 1"
@k.actions.action.break k.actions.action name=break group=change who=person who=wind who=ball object=cup object=window object=branch object=toy object=egg result="the thing in pieces or not working" opposite=mend undone_by=mend example="The ball breaks the window." core.source="hand-core 1"
@k.actions.action.mend k.actions.action name=mend group=change who=person object=toy object=bicycle object=sock object=fence object=car tool=hammer tool=glue tool="sewing needle" tool=wrench tool=screwdriver where=workshop result="the thing whole or working again" opposite=break example="A mechanic mends the car." core.source="hand-core 1"
@k.actions.action.tear k.actions.action name=tear group=change who=person who=dog object=paper object=cloth object=trousers tool=hand result="the thing ripped apart" undone_by=mend example="He tears the paper in two." core.source="hand-core 1"
@k.actions.action.bend k.actions.action name=bend group=change who=person who=wind object=wire object=branch object=knee object=straw tool=hand result="the thing no longer straight" opposite=straighten undone_by=straighten example="The wind bends the trees." core.source="hand-core 1"
@k.actions.action.straighten k.actions.action name=straighten group=change who=person object=wire object=picture object=back object=tie tool=hand result="the thing being straight" opposite=bend undone_by=bend example="She straightens the picture on the wall." core.source="hand-core 1"
@k.actions.action.melt k.actions.action name=melt group=change who=sun who=fire who=heat object=ice object=snow object=butter object=chocolate object=snowman where=spring result="a liquid" opposite=freeze undone_by=freeze example="The sun melts the snowman." core.source="hand-core 1"
@k.actions.action.freeze k.actions.action name=freeze group=change who=cold who=frost who=freezer object=water object=pond object=lake object=food tool=freezer where=winter where=arctic result="ice, something hard and cold" opposite=melt undone_by=melt example="The cold freezes the pond." core.source="hand-core 1"
@k.actions.action.burn k.actions.action name=burn group=change who=fire who=candle who=sun object=wood object=paper object=candle object=toast tool=match tool=fire where=campsite result="ash and smoke; heat and light" example="Wood burns in the campfire." core.source="hand-core 1"
@k.actions.action.wash k.actions.action name=wash group=change who=person who=cat who=raccoon object=hands object=face object=clothes object=car object=dishes tool=water tool=soap tool=sponge tool="washing machine" where=bathroom where=kitchen result="the thing being clean and wet" example="She washes her hands with soap." core.source="hand-core 1"
@k.actions.action.dirty k.actions.action name=dirty group=change who=person who=dog who=mud object=clothes object=floor object=hands object=shoes tool=mud result="the thing not being clean" opposite=clean undone_by=clean example="The dog dirties the floor with its paws." core.source="hand-core 1"
@k.actions.action.clean k.actions.action name=clean group=change who=person object=room object=window object=floor object=teeth object=shoes tool=broom tool=mop tool=sponge tool=bucket tool="vacuum cleaner" where=kitchen where=bathroom result="the thing without dirt" opposite=dirty example="A cleaner cleans the floor with a mop." core.source="hand-core 1"
@k.actions.action.dry k.actions.action name=dry group=change who=person who=sun who=wind object=hair object=hands object=clothes object=dishes tool=towel tool=hairdryer where=bathroom result="the thing not being wet" opposite=wet undone_by=wet example="He dries his hands with a towel." core.source="hand-core 1"
@k.actions.action.wet k.actions.action name=wet group=change who=rain who=person who=wave object=hair object=clothes object=sand object=sponge tool=water tool=hose result="the thing having water on it" opposite=dry undone_by=dry example="The rain wets the washing on the line." core.source="hand-core 1"
@k.actions.action.wipe k.actions.action name=wipe group=change who=person object=table object=nose object=blackboard object=window tool="dish cloth" tool=sponge tool=handkerchief where=kitchen where=classroom result="the surface clean or dry" example="The waiter wipes the table with a cloth." core.source="hand-core 1"
@k.actions.action.sweep k.actions.action name=sweep group=change who=person object=floor object=leaves object=path object=chimney tool=broom where=kitchen where=autumn result="the dirt in one heap, the floor clean" example="She sweeps the leaves with a broom." core.source="hand-core 1"
@k.actions.action.brush k.actions.action name=brush group=change who=person object=teeth object=hair object=horse object=shoes tool=toothbrush tool=hairbrush tool="scrubbing brush" where=bathroom result="the thing clean or smooth" example="A child brushes his teeth." core.source="hand-core 1"
@k.actions.action.comb k.actions.action name=comb group=change who=person object=hair object=beard object=wool tool=comb where=bathroom result="hair lying in order" example="The hairdresser combs her hair." core.source="hand-core 1"
@k.actions.action.peel k.actions.action name=peel group=change who=person who=monkey object=banana object=orange object=potato object=apple tool="kitchen knife" tool=hand where=kitchen result="the thing without its skin" example="A monkey peels a banana." core.source="hand-core 1"
@k.actions.action.sharpen k.actions.action name=sharpen group=change who=person object=pencil object=knife object=axe tool="pencil sharpener" where=classroom where=workshop result="the thing having a sharp point or edge" example="She sharpens her pencil." core.source="hand-core 1"
@k.actions.action.light k.actions.action name=light group=change who=person object=candle object=fire object=lamp object=match tool=match tool=lighter where=campsite where="birthday party" result="a flame or a light that is on" opposite="put out" undone_by="put out" example="He lights the candles on the cake." core.source="hand-core 1"
@k.actions.action.put_out k.actions.action name="put out" group=change who=person who=firefighter who=rain object=fire object=candle object=light tool=water tool="fire extinguisher" tool="fire hose" result="no flame, no light" opposite=light undone_by=light example="Firefighters put out the fire with water." core.source="hand-core 1"
@k.actions.action.water k.actions.action name=water group=change who=person who=rain object=flower object=plant object=garden object=lawn tool="watering can" tool=hose where=garden result="the plant having water to grow" example="A gardener waters the flowers." core.source="hand-core 1"
@k.actions.action.cover k.actions.action name=cover group=change who=person who=snow who=cloud object=bed object=pot object=table object=baby object=ground tool=blanket tool=lid tool="table cloth" result="the thing hidden or kept warm under another" opposite=uncover undone_by=uncover example="Snow covers the ground in winter." core.source="hand-core 1"
@k.actions.action.uncover k.actions.action name=uncover group=change who=person who=wind object=pot object=bed object=statue tool=hand result="the thing being seen again" opposite=cover undone_by=cover example="She uncovers the pot and steam comes out." core.source="hand-core 1"

