# k.actions/shards/actions-hands: 29 actions of handling a thing: who or what does it, to what, with what, where, what comes of it, the opposite and what undoes it, an example; the other forms of the verbs; and 67 verbs and phrases that mean nearly the same.
# sources: hand-core 1 (hand-written in this repository: tools/actions-data.mjs)
# license: CC0-1.0
# script: tools/actions-core.mjs

@k.actions.action.hold k.actions.action name=hold group=hands who=person who=monkey object=cup object=hand object=book object=balloon tool=hand result="the thing staying in the hand" opposite=drop example="A child holds a balloon." core.source="hand-core 1"
@k.actions.action.carry k.actions.action name=carry group=hands who=person who=ant who=truck object=bag object=box object=baby object=bucket tool=bag tool=basket tool=backpack result="the thing being somewhere else" example="A postman carries a parcel." core.source="hand-core 1"
@k.actions.action.lift k.actions.action name=lift group=hands who=person who=crane who=elephant object=box object=stone object=child tool=crane tool=hand where="construction site" result="the thing being higher up" opposite=lower example="A crane lifts a heavy load." core.source="hand-core 1"
@k.actions.action.lower k.actions.action name=lower group=hands who=person who=crane object=flag object=bucket object=load tool=rope tool=crane result="the thing being further down" opposite=lift example="They lower the bucket into the well." core.source="hand-core 1"
@k.actions.action.push k.actions.action name=push group=hands who=person who=bulldozer object=door object=wheelbarrow object=swing object=button tool=hand result="the thing moving away" opposite=pull example="A gardener pushes a wheelbarrow." core.source="hand-core 1"
@k.actions.action.pull k.actions.action name=pull group=hands who=person who=horse who=tractor object=rope object=door object=sled object=wagon tool=rope tool=hand result="the thing coming nearer" opposite=push example="A horse pulls a wagon." core.source="hand-core 1"
@k.actions.action.throw k.actions.action name=throw group=hands who=person object=ball object=stone object=snowball tool=hand where=playground where=beach result="the thing flying through the air" opposite=catch example="A boy throws a ball." core.source="hand-core 1"
@k.actions.action.catch k.actions.action name=catch group=hands who=person who=dog who=cat who=frog object=ball object=fish object=mouse object=fly tool=hand tool=net tool="fishing pole" result="having the thing" opposite=throw undone_by=drop example="A dog catches the ball." core.source="hand-core 1"
@k.actions.action.drop k.actions.action name=drop group=hands who=person who=bird object=ball object=cup object=key result="the thing falling down" opposite=hold undone_by="pick up" example="He drops the cup and it breaks." core.source="hand-core 1"
@k.actions.action.pick_up k.actions.action name="pick up" group=hands who=person object=ball object=toy object=book object=baby tool=hand result="the thing being in the hand" undone_by=put example="She picks up the toys from the floor." core.source="hand-core 1"
@k.actions.action.put k.actions.action name=put group=hands who=person object=cup object=book object=toy object=plate tool=hand result="the thing being in its new place" undone_by=take example="She puts the cup on the table." core.source="hand-core 1"
@k.actions.action.take k.actions.action name=take group=hands who=person who=animal object=book object=apple object=toy tool=hand result="having the thing" opposite=give undone_by=put example="He takes an apple from the bowl." core.source="hand-core 1"
@k.actions.action.give k.actions.action name=give group=hands who=person object=present object=flower object=book object=food tool=hand where="birthday party" where=Christmas result="another having the thing" opposite=take undone_by=take example="A child gives a present to a friend." core.source="hand-core 1"
@k.actions.action.open k.actions.action name=open group=hands who=person object=door object=window object=box object=book object=bottle object=umbrella tool=key tool=hand result="the thing being open" opposite=close undone_by=close example="She opens the door with a key." core.source="hand-core 1"
@k.actions.action.close k.actions.action name=close group=hands who=person object=door object=window object=box object=book object=eyes tool=hand result="the thing being closed" opposite=open undone_by=open example="He closes the window." core.source="hand-core 1"
@k.actions.action.shake k.actions.action name=shake group=hands who=person who=dog who=wind object=bottle object=hand object=tree object=rattle tool=hand result="the thing moving quickly to and fro" example="The baby shakes a rattle." core.source="hand-core 1"
@k.actions.action.hit k.actions.action name=hit group=hands who=person object=ball object=nail object=drum tool=hammer tool=bat tool=stick result="a blow on the thing" example="A carpenter hits a nail with a hammer." core.source="hand-core 1"
@k.actions.action.kick k.actions.action name=kick group=hands who=person who=horse object=ball tool=foot where="football pitch" where=playground result="the thing flying away" example="A footballer kicks the ball." core.source="hand-core 1"
@k.actions.action.touch k.actions.action name=touch group=hands who=person who=animal object=cat object=water object=wall tool=hand tool=finger result="feeling the thing" example="She touches the soft fur of the cat." core.source="hand-core 1"
@k.actions.action.press k.actions.action name=press group=hands who=person object=button object=doorbell object=key tool=finger result="the thing being pushed in" example="He presses the doorbell." core.source="hand-core 1"
@k.actions.action.squeeze k.actions.action name=squeeze group=hands who=person object=lemon object=sponge object=tube object=hand tool=hand where=kitchen result="the thing being smaller and what is inside coming out" example="She squeezes a lemon." core.source="hand-core 1"
@k.actions.action.tie k.actions.action name=tie group=hands who=person object=shoelace object=rope object=ribbon object=boat tool=rope tool=string result="a knot that holds" opposite=untie undone_by=untie example="A sailor ties the boat to the pier with a rope." core.source="hand-core 1"
@k.actions.action.untie k.actions.action name=untie group=hands who=person object=shoelace object=rope object=knot tool=hand result="the thing being loose" opposite=tie undone_by=tie example="He unties his shoelaces." core.source="hand-core 1"
@k.actions.action.hang k.actions.action name=hang group=hands who=person object=coat object=picture object=washing object=lamp tool=hook tool=nail tool=rope result="the thing held from above" example="She hangs the coat on a hook." core.source="hand-core 1"
@k.actions.action.pour k.actions.action name=pour group=hands who=person object=water object=milk object=tea object=juice tool=jug tool=bottle tool="watering can" where=kitchen where=restaurant result="the liquid being in another thing" example="He pours milk into a glass." core.source="hand-core 1"
@k.actions.action.fill k.actions.action name=fill group=hands who=person who=rain object=cup object=bucket object=glass object=bath tool=tap tool=jug tool=bottle result="the thing being full" opposite=empty undone_by=empty example="She fills the bucket with water." core.source="hand-core 1"
@k.actions.action.empty k.actions.action name=empty group=hands who=person object=bucket object=bin object=bag object=glass tool=hand result="the thing having nothing in it" opposite=fill undone_by=fill example="He empties the bin." core.source="hand-core 1"
@k.actions.action.wrap k.actions.action name=wrap group=hands who=person object=present object=sandwich object=baby tool=paper tool=ribbon tool=blanket where=Christmas where="birthday party" result="the thing covered all round" opposite=unwrap undone_by=unwrap example="She wraps a present in paper." core.source="hand-core 1"
@k.actions.action.unwrap k.actions.action name=unwrap group=hands who=person object=present object=sweet object=sandwich tool=hand where=Christmas where="birthday party" result="the thing with its cover off" opposite=wrap undone_by=wrap example="The child unwraps a present." core.source="hand-core 1"

