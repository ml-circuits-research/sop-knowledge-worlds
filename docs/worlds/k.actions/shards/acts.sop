@k.actions.role.save.name k.actions.role act=save name=name holds=name about="the name it is kept under" marker=as marker=under core.source="hand-core 1"
@k.actions.role.save.place k.actions.role act=save name=place holds=place about="where it is kept" marker=to marker=in marker=on core.source="hand-core 1"
