# k.actions/shards/acts: the 16 acts (make, remove, change, place, connect, group, take apart, pick, ask, copy, send, undo, save, load, redo, deselect), and the roles each act takes with the prepositions that usually mark them.
# sources: hand-core 1 (hand-written in this repository: tools/acts-core.mjs)
# license: CC0-1.0
# script: tools/acts-core.mjs

@k.actions.act.make k.actions.act name=make about="bring a new thing into being" opposite=remove role=kind role=number role=place role=value role=part role=material core.source="hand-core 1"
@k.actions.act.remove k.actions.act name=remove about="take a thing away so that it is no longer there" opposite=make role=thing role=source core.source="hand-core 1"
@k.actions.act.change k.actions.act name=change about="give a thing another value of one of its attributes, or put another thing in its place" role=thing role=attribute role=value role="old value" role=amount role=replacement core.source="hand-core 1"
@k.actions.act.place k.actions.act name=place about="put a thing somewhere, or move it to another place" role=thing role=place role=direction role=source role=amount core.source="hand-core 1"
@k.actions.act.connect k.actions.act name=connect about="join two things so that they stay together or a line runs between them" opposite="take apart" role=thing role=target role=tool core.source="hand-core 1"
@k.actions.act.group k.actions.act name=group about="put several things together as one group, or in an order" opposite="take apart" role=thing role=target role=group role=criterion core.source="hand-core 1"
@k.actions.act.take_apart k.actions.act name="take apart" about="separate a thing into its parts, or one thing from another" opposite=connect role=thing role=parts role=source role=tool core.source="hand-core 1"
@k.actions.act.pick k.actions.act name=pick about="choose one or some things out of several, to act on them next" opposite=deselect role=thing role=source role=other core.source="hand-core 1"
@k.actions.act.ask k.actions.act name=ask about="want to know something about the things that are there" role=topic role=thing role=place role=other core.source="hand-core 1"
@k.actions.act.copy k.actions.act name=copy about="make another thing that is the same as one that is there" role=thing role=number role=place core.source="hand-core 1"
@k.actions.act.send k.actions.act name=send about="let someone else have the thing, or put it out of the application" role=thing role=recipient role=means role=format core.source="hand-core 1"
@k.actions.act.undo k.actions.act name=undo about="take back what was done last, so that things are as before" opposite=redo role=thing role=number role=state core.source="hand-core 1"
@k.actions.act.save k.actions.act name=save about="keep the work so that it can be brought back later" opposite=load role=thing role=name role=place role=format core.source="hand-core 1"
@k.actions.act.load k.actions.act name=load about="bring back work that was kept" opposite=save role=thing role=source core.source="hand-core 1"
@k.actions.act.redo k.actions.act name=redo about="do again what was taken back by undo" opposite=undo role=thing role=number core.source="hand-core 1"
@k.actions.act.deselect k.actions.act name=deselect about="leave off picking a thing, so that it is no longer picked; with no thing, nothing is picked" opposite=pick role=thing core.source="hand-core 1"

# Roles: what an act can be told, what kind of filler each takes, and the words that mark it.
@k.actions.role.make.kind k.actions.role act=make name=kind holds=kind needed=true about="what kind of thing to make" core.source="hand-core 1"
@k.actions.role.make.number k.actions.role act=make name=number holds=number about="how many to make" core.source="hand-core 1"
@k.actions.role.make.place k.actions.role act=make name=place holds=place about="where the new thing goes" marker=on marker=in marker=at marker=onto marker=into marker=to marker=under marker=above marker=below marker=over marker=behind marker=beside marker=near marker=between marker=inside marker=outside marker=around marker="next to" marker="close to" marker="in front of" marker="on top of" marker="to the left of" marker="to the right of" marker="in the middle of" core.source="hand-core 1"
@k.actions.role.make.value k.actions.role act=make name=value holds=value about="a value the new thing has, such as its colour" marker=in core.source="hand-core 1"
@k.actions.role.make.part k.actions.role act=make name=part holds=thing about="a part the new thing has" marker=with core.source="hand-core 1"
@k.actions.role.make.material k.actions.role act=make name=material holds=thing about="what it is made from" marker=from marker="out of" marker=of core.source="hand-core 1"
@k.actions.role.remove.thing k.actions.role act=remove name=thing holds=thing needed=true about="what to remove" core.source="hand-core 1"
@k.actions.role.remove.source k.actions.role act=remove name=source holds=thing about="what it is removed from" marker=from marker="out of" marker=off core.source="hand-core 1"
@k.actions.role.change.thing k.actions.role act=change name=thing holds=thing needed=true about="what to change" marker=of core.source="hand-core 1"
@k.actions.role.change.attribute k.actions.role act=change name=attribute holds=attribute about="which attribute changes" core.source="hand-core 1"
@k.actions.role.change.value k.actions.role act=change name=value holds=value about="the new value" marker=to marker=into core.source="hand-core 1"
@k.actions.role.change.old_value k.actions.role act=change name="old value" holds=value about="the value before" marker=from core.source="hand-core 1"
@k.actions.role.change.amount k.actions.role act=change name=amount holds=amount about="by how much" marker=by core.source="hand-core 1"
@k.actions.role.change.replacement k.actions.role act=change name=replacement holds=thing about="the thing that takes its place" marker=with marker=by marker=for core.source="hand-core 1"
@k.actions.role.place.thing k.actions.role act=place name=thing holds=thing needed=true about="what to place" core.source="hand-core 1"
@k.actions.role.place.place k.actions.role act=place name=place holds=place about="where it goes" marker=on marker=in marker=at marker=onto marker=into marker=to marker=under marker=above marker=below marker=over marker=behind marker=beside marker=near marker=between marker=inside marker=outside marker=around marker="next to" marker="close to" marker="in front of" marker="on top of" marker="to the left of" marker="to the right of" marker="in the middle of" core.source="hand-core 1"
@k.actions.role.place.direction k.actions.role act=place name=direction holds=direction about="which way it moves" marker=towards core.source="hand-core 1"
@k.actions.role.place.source k.actions.role act=place name=source holds=place about="where it was" marker=from marker=off marker="out of" core.source="hand-core 1"
@k.actions.role.place.amount k.actions.role act=place name=amount holds=amount about="how far" marker=by core.source="hand-core 1"
@k.actions.role.connect.thing k.actions.role act=connect name=thing holds=thing needed=true about="the first thing" core.source="hand-core 1"
@k.actions.role.connect.target k.actions.role act=connect name=target holds=thing about="the thing it is joined to" marker=to marker=with marker=and marker=onto core.source="hand-core 1"
@k.actions.role.connect.tool k.actions.role act=connect name=tool holds=thing about="what joins them" marker=by marker=using marker="by means of" core.source="hand-core 1"
@k.actions.role.group.thing k.actions.role act=group name=thing holds=thing needed=true about="the things to group" core.source="hand-core 1"
@k.actions.role.group.target k.actions.role act=group name=target holds=thing about="what they are grouped with" marker=with marker=and core.source="hand-core 1"
@k.actions.role.group.group k.actions.role act=group name=group holds=group about="the group or groups they go into" marker=into marker=in marker=as core.source="hand-core 1"
@k.actions.role.group.criterion k.actions.role act=group name=criterion holds=attribute about="what decides the group or the order" marker=by marker="according to" core.source="hand-core 1"
@k.actions.role.take_apart.thing k.actions.role act="take apart" name=thing holds=thing needed=true about="what to take apart" core.source="hand-core 1"
@k.actions.role.take_apart.parts k.actions.role act="take apart" name=parts holds=group about="the pieces it becomes" marker=into marker=in core.source="hand-core 1"
@k.actions.role.take_apart.source k.actions.role act="take apart" name=source holds=thing about="what it is separated from" marker=from marker=off core.source="hand-core 1"
@k.actions.role.take_apart.tool k.actions.role act="take apart" name=tool holds=thing about="what it is separated with" marker=with marker=using core.source="hand-core 1"
@k.actions.role.pick.thing k.actions.role act=pick name=thing holds=thing needed=true about="what is picked" core.source="hand-core 1"
@k.actions.role.pick.source k.actions.role act=pick name=source holds=group about="what it is picked from" marker=from marker="out of" marker=among core.source="hand-core 1"
@k.actions.role.pick.other k.actions.role act=pick name=other holds=thing about="what is not picked" marker=over marker="instead of" marker="rather than" core.source="hand-core 1"
@k.actions.role.ask.topic k.actions.role act=ask name=topic holds=topic about="what the question is about" marker=about core.source="hand-core 1"
@k.actions.role.ask.thing k.actions.role act=ask name=thing holds=thing about="the thing asked for" marker=for core.source="hand-core 1"
@k.actions.role.ask.place k.actions.role act=ask name=place holds=place about="where to look" marker=on marker=in marker=at marker=onto marker=into marker=to marker=under marker=above marker=below marker=over marker=behind marker=beside marker=near marker=between marker=inside marker=outside marker=around marker="next to" marker="close to" marker="in front of" marker="on top of" marker="to the left of" marker="to the right of" marker="in the middle of" marker=by core.source="hand-core 1"
@k.actions.role.ask.other k.actions.role act=ask name=other holds=thing about="a second thing, for a comparison" marker=with marker=to marker=and core.source="hand-core 1"
@k.actions.role.copy.thing k.actions.role act=copy name=thing holds=thing needed=true about="what to copy" core.source="hand-core 1"
@k.actions.role.copy.number k.actions.role act=copy name=number holds=number about="how many copies" core.source="hand-core 1"
@k.actions.role.copy.place k.actions.role act=copy name=place holds=place about="where the copy goes" marker=on marker=in marker=at marker=onto marker=into marker=to marker=under marker=above marker=below marker=over marker=behind marker=beside marker=near marker=between marker=inside marker=outside marker=around marker="next to" marker="close to" marker="in front of" marker="on top of" marker="to the left of" marker="to the right of" marker="in the middle of" core.source="hand-core 1"
