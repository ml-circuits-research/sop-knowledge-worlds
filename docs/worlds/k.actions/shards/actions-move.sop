# k.actions/shards/actions-move: 30 actions of moving oneself: who or what does it, to what, with what, where, what comes of it, the opposite and what undoes it, an example; the other forms of the verbs; and 57 verbs and phrases that mean nearly the same.
# sources: hand-core 1 (hand-written in this repository: tools/actions-data.mjs)
# license: CC0-1.0
# script: tools/actions-core.mjs

@k.actions.action.walk k.actions.action name=walk group=move who=person who=animal where=park where="city street" where=forest result="being somewhere else" example="A person walks through the park." core.source="hand-core 1"
@k.actions.action.run k.actions.action name=run group=move who=person who=animal where=park where=playground where="football pitch" result="being somewhere else fast" example="A dog runs across the field." core.source="hand-core 1"
@k.actions.action.jump k.actions.action name=jump group=move who=person who=animal tool=trampoline tool="skipping rope" where=playground result="being in the air for a moment" example="A frog jumps into the pond." core.source="hand-core 1"
@k.actions.action.climb k.actions.action name=climb group=move who=person who=animal object=tree object=ladder object=mountain object=stairs tool=ladder tool=rope where=mountains where=playground where=forest result="being higher up" example="A monkey climbs a tree." core.source="hand-core 1"
@k.actions.action.swim k.actions.action name=swim group=move who=person who=fish who=animal where="swimming pool" where=lake where=river where=beach result="moving through water" example="A fish swims in the sea." core.source="hand-core 1"
@k.actions.action.fly k.actions.action name=fly group=move who=bird who=insect who=plane who=kite who=balloon tool=wing where=night where=airport where=space result="moving through the air" example="Birds and planes fly." core.source="hand-core 1"
@k.actions.action.crawl k.actions.action name=crawl group=move who=baby who=insect who=snake result="moving close to the ground" example="A baby crawls across the floor." core.source="hand-core 1"
@k.actions.action.fall k.actions.action name=fall group=move who=person who=leaf who=rain who=apple result="being lower down, on the ground" opposite=rise example="Leaves fall from the tree in autumn." core.source="hand-core 1"
@k.actions.action.rise k.actions.action name=rise group=move who=sun who=balloon who=smoke result="being higher up" opposite=fall example="The sun rises in the morning." core.source="hand-core 1"
@k.actions.action.slide k.actions.action name=slide group=move who=person who=penguin tool=slide tool=sled where=playground where=winter result="moving down smoothly" example="A child slides down the slide." core.source="hand-core 1"
@k.actions.action.roll k.actions.action name=roll group=move who=ball who=wheel who=stone result="turning over and over while moving" example="The ball rolls down the hill." core.source="hand-core 1"
@k.actions.action.ride k.actions.action name=ride group=move who=person object=bicycle object=horse object=scooter tool=bicycle tool=horse tool=saddle where=park where="city street" where=farm result="being carried along" example="A girl rides a bicycle." core.source="hand-core 1"
@k.actions.action.drive k.actions.action name=drive group=move who=person object=car object=bus object=truck object=tractor tool=car where="city street" where=village result="the vehicle moving where the driver wants" example="A bus driver drives a bus." core.source="hand-core 1"
@k.actions.action.sail k.actions.action name=sail group=move who=person who=boat who=ship object=sailboat object=ship tool=sailboat where=harbour where=lake where=beach result="moving over water by the wind" example="A sailor sails a boat." core.source="hand-core 1"
@k.actions.action.row k.actions.action name=row group=move who=person object="rowing boat" tool="rowing boat" where=lake where=river result="the boat moving" example="Two people row a boat across the lake." core.source="hand-core 1"
@k.actions.action.dive k.actions.action name=dive group=move who=person who=duck who=whale where="swimming pool" where=underwater result="being under water" example="A swimmer dives into the pool." core.source="hand-core 1"
@k.actions.action.float k.actions.action name=float group=move who=boat who=duck who=leaf who=balloon who=cloud where=lake where=river where=pond result="staying on top of the water or in the air" opposite=sink example="A leaf floats on the water." core.source="hand-core 1"
@k.actions.action.sink k.actions.action name=sink group=move who=stone who=ship where=underwater result="being at the bottom" opposite=float example="A stone sinks in water." core.source="hand-core 1"
@k.actions.action.dance k.actions.action name=dance group=move who=person tool="ballet shoes" where=theatre where="birthday party" result="moving to music" example="People dance at a party." core.source="hand-core 1"
@k.actions.action.hop k.actions.action name=hop group=move who=rabbit who=frog who=bird who=child result="moving by small jumps" example="A rabbit hops across the meadow." core.source="hand-core 1"
@k.actions.action.march k.actions.action name=march group=move who=soldier who=ant result="walking in step" example="Soldiers march in a row." core.source="hand-core 1"
@k.actions.action.turn k.actions.action name=turn group=move who=person who=wheel who=car result="facing another way" example="The car turns left." core.source="hand-core 1"
@k.actions.action.stop k.actions.action name=stop group=move who=person who=car who=train who=rain tool="traffic light" where="city street" where="railway station" result="not moving any more" opposite=go example="The bus stops at the bus stop." core.source="hand-core 1"
@k.actions.action.go k.actions.action name=go group=move who=person who=animal who=car result="being somewhere else" opposite=stop example="Children go to school." core.source="hand-core 1"
@k.actions.action.come k.actions.action name=come group=move who=person who=animal result="being here" opposite=leave example="Grandmother comes to visit." core.source="hand-core 1"
@k.actions.action.leave k.actions.action name=leave group=move who=person who=train who=ship object=house object=room object=town where="railway station" where=harbour where=airport result="not being there any more" opposite=come example="The train leaves the station." core.source="hand-core 1"
@k.actions.action.enter k.actions.action name=enter group=move who=person who=animal object=house object=room object=cave tool=door result="being inside" example="A person enters the house through the door." core.source="hand-core 1"
@k.actions.action.follow k.actions.action name=follow group=move who=person who=dog who=duckling object=person object=path object=animal result="being behind another" opposite=lead example="The ducklings follow their mother." core.source="hand-core 1"
@k.actions.action.lead k.actions.action name=lead group=move who=person who=guide who="mother duck" object=person object=animal object=horse tool=leash tool=rope result="others coming along behind" opposite=follow example="A girl leads a horse by the rope." core.source="hand-core 1"
@k.actions.action.chase k.actions.action name=chase group=move who=cat who=dog who="police officer" object=mouse object=cat object=ball object=thief result="catching or losing what runs away" example="The cat chases a mouse." core.source="hand-core 1"

