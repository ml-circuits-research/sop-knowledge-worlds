# k.actions/shards/actions-mind-talk: 37 actions of the senses; the mind; speech, sounds and signs: who or what does it, to what, with what, where, what comes of it, the opposite and what undoes it, an example; the other forms of the verbs; and 91 verbs and phrases that mean nearly the same.
# sources: hand-core 1 (hand-written in this repository: tools/actions-data.mjs)
# license: CC0-1.0
# script: tools/actions-core.mjs

@k.actions.action.see k.actions.action name=see group=sense who=person who=animal object=bird object=light object=friend object=colour tool=eye tool=glasses tool=telescope result="knowing what is there" example="An owl sees well in the dark." core.source="hand-core 1"
@k.actions.action.look k.actions.action name=look group=sense who=person who=animal object=picture object=sky object=book object=map tool=eye tool="magnifying glass" result="the eyes turned to the thing" example="The children look at the stars." core.source="hand-core 1"
@k.actions.action.watch k.actions.action name=watch group=sense who=person who=cat object=film object=bird object=game object=television tool=eye tool=television tool=binoculars where=theatre where="living room" result="seeing what happens" example="The cat watches the birds." core.source="hand-core 1"
@k.actions.action.hear k.actions.action name=hear group=sense who=person who=animal object=music object=voice object=bell object=thunder tool=ear result="knowing a sound" example="A dog hears a noise far away." core.source="hand-core 1"
@k.actions.action.listen k.actions.action name=listen group=sense who=person who=animal object=music object=story object=teacher object=birdsong tool=ear tool=radio tool=headphone where=classroom where=theatre result="attending to a sound" example="The children listen to a story." core.source="hand-core 1"
@k.actions.action.smell k.actions.action name=smell group=sense who=person who=dog object=flower object=food object=smoke tool=nose where=garden where=kitchen result="knowing a scent" example="A dog smells the bone." core.source="hand-core 1"
@k.actions.action.taste k.actions.action name=taste group=sense who=person object=soup object=cake object="ice cream" tool=tongue tool=spoon where=kitchen where=restaurant result="knowing a flavour" example="The cook tastes the soup." core.source="hand-core 1"
@k.actions.action.think k.actions.action name=think group=mind who=person object=answer object=idea object=problem tool=head tool=brain result="an idea or an answer" example="She thinks about the answer." core.source="hand-core 1"
@k.actions.action.know k.actions.action name=know group=mind who=person object=answer object=name object=way object=song result="being able to tell" undone_by=forget example="He knows the way home." core.source="hand-core 1"
@k.actions.action.learn k.actions.action name=learn group=mind who=person who=animal object=letters object=song object=trick object=language tool=book where=classroom where=library result="knowing or being able to do something new" undone_by=forget example="Children learn to read at school." core.source="hand-core 1"
@k.actions.action.teach k.actions.action name=teach group=mind who=person who=teacher who=mother object=child object=class object=trick object=song tool=blackboard tool=book where=classroom result="another knowing something new" example="A teacher teaches the class to count." core.source="hand-core 1"
@k.actions.action.remember k.actions.action name=remember group=mind who=person who=elephant object=name object=birthday object=way object=story result="still knowing" opposite=forget undone_by=forget example="She remembers her friend's birthday." core.source="hand-core 1"
@k.actions.action.forget k.actions.action name=forget group=mind who=person object=name object=key object=homework object=umbrella result="no longer knowing or having with one" opposite=remember undone_by=remember example="He forgets his umbrella on the bus." core.source="hand-core 1"
@k.actions.action.read k.actions.action name=read group=mind who=person object=book object=letter object=sign object=newspaper object=map tool=book tool=glasses where=library where=classroom where=bedroom result="knowing what is written" example="Grandfather reads the newspaper." core.source="hand-core 1"
@k.actions.action.count k.actions.action name=count group=mind who=person object=sheep object=apples object=coins object=steps tool=finger tool=abacus where=classroom result="knowing how many" example="The farmer counts his sheep." core.source="hand-core 1"
@k.actions.action.measure k.actions.action name=measure group=mind who=person object=table object=height object=room object=cloth tool=ruler tool="tape measure" where=workshop where=classroom result="knowing how long, high or wide" example="A carpenter measures the board with a ruler." core.source="hand-core 1"
@k.actions.action.weigh k.actions.action name=weigh group=mind who=person object=apples object=flour object=baby object=parcel tool="balance scale" tool=scales where=supermarket where=market where=kitchen result="knowing how heavy" example="The shopkeeper weighs the apples." core.source="hand-core 1"
@k.actions.action.find k.actions.action name=find group=mind who=person who=dog object=key object=treasure object=way object=shell tool=map tool=torch result="having or knowing where the thing is" opposite=lose undone_by=lose example="The pirates find the treasure with a map." core.source="hand-core 1"
@k.actions.action.lose k.actions.action name=lose group=mind who=person object=key object=glove object=way object=game object=tooth result="not having the thing or not knowing where it is" opposite=find undone_by=find example="She loses a glove in the snow." core.source="hand-core 1"
@k.actions.action.hide k.actions.action name=hide group=mind who=person who=animal object=toy object=treasure object=present object=bone tool=blanket tool=box result="the thing not being seen" opposite=show undone_by=show example="A squirrel hides nuts for the winter." core.source="hand-core 1"
@k.actions.action.show k.actions.action name=show group=mind who=person object=picture object=way object=toy object=trick tool=finger tool=map result="another seeing the thing" opposite=hide undone_by=hide example="She shows her drawing to the class." core.source="hand-core 1"
@k.actions.action.search k.actions.action name=search group=mind who=person who=dog object=key object=treasure object=clue object=way tool=torch tool="magnifying glass" tool=map result="finding the thing, or not" example="The detective searches for clues." core.source="hand-core 1"
@k.actions.action.choose k.actions.action name=choose group=mind who=person object=book object=colour object=cake object=toy object=team tool=finger where=supermarket where=library result="one thing taken out of several" example="He chooses a book from the shelf." core.source="hand-core 1"
@k.actions.action.say k.actions.action name=say group=talk who=person object=word object=name object=hello object="thank you" tool=mouth tool=voice result="words that another hears" example="She says hello to her neighbour." core.source="hand-core 1"
@k.actions.action.talk k.actions.action name=talk group=talk who=person who=parrot tool=mouth tool=phone result="another hearing what one thinks" example="Two friends talk on the phone." core.source="hand-core 1"
@k.actions.action.ask k.actions.action name=ask group=talk who=person object=question object=way object=name object=time tool=voice where=classroom result="a question that waits for an answer" opposite=answer example="A child asks the teacher a question." core.source="hand-core 1"
@k.actions.action.answer k.actions.action name=answer group=talk who=person object=question object=letter object=phone object=door tool=voice where=classroom result="the one who asked knowing more" opposite=ask example="The teacher answers the question." core.source="hand-core 1"
@k.actions.action.tell k.actions.action name=tell group=talk who=person object=story object=joke object=secret object=truth tool=voice where=bedroom where=campsite result="another knowing it" example="Grandfather tells a story." core.source="hand-core 1"
@k.actions.action.shout k.actions.action name=shout group=talk who=person object=name object=help object=warning tool=voice where=playground where="football pitch" result="being heard far away" opposite=whisper example="He shouts for help." core.source="hand-core 1"
@k.actions.action.whisper k.actions.action name=whisper group=talk who=person object=secret object=word tool=voice where=library where=theatre result="being heard only close by" opposite=shout example="She whispers a secret into his ear." core.source="hand-core 1"
@k.actions.action.sing k.actions.action name=sing group=talk who=person who=bird object=song object=lullaby object=carol tool=voice tool=microphone where=theatre where=Christmas where="birthday party" result="a tune made with the voice" example="Birds sing in the morning." core.source="hand-core 1"
@k.actions.action.call k.actions.action name=call group=talk who=person object=friend object=dog object=doctor object=name tool=voice tool=phone result="another hearing and coming or answering" example="She calls the dog and it comes." core.source="hand-core 1"
@k.actions.action.laugh k.actions.action name=laugh group=talk who=person where=circus where="birthday party" result="showing that something is funny" opposite=cry example="The children laugh at the clown." core.source="hand-core 1"
@k.actions.action.cry k.actions.action name=cry group=talk who=person who=baby result="tears; showing sadness or pain" opposite=laugh example="The baby cries when it is hungry." core.source="hand-core 1"
@k.actions.action.smile k.actions.action name=smile group=talk who=person tool=mouth result="showing that one is glad or friendly" opposite=frown example="She smiles at her friend." core.source="hand-core 1"
@k.actions.action.frown k.actions.action name=frown group=talk who=person tool=eyebrow tool=mouth result="showing that one is cross or does not understand" opposite=smile example="He frowns at the hard sum." core.source="hand-core 1"
@k.actions.action.bark k.actions.action name=bark group=talk who=dog who=fox who=seal result="a short loud sound" example="The dog barks at the postman." core.source="hand-core 1"

