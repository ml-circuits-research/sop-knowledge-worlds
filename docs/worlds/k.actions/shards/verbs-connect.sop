@k.actions.verb.connect.connect k.actions.verb text=connect act=connect sense=1 gloss="connect, fasten, or put together two or more pieces" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.link k.actions.verb text=link act=connect sense=2 gloss="connect, fasten, or put together two or more pieces" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.link_up k.actions.verb text="link up" act=connect sense=2 gloss="connect, fasten, or put together two or more pieces" object=thing separable=true named=model core.source="wordnet 3.1"
