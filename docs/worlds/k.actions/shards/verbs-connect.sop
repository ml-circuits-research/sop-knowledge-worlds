@k.actions.verb.connect.couple k.actions.verb text=couple act=connect sense=2 gloss="link together" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.hook_up k.actions.verb text="hook up" act=connect sense=1 gloss="connect or link" object=thing separable=true named=model core.source="wordnet 3.1"
@k.actions.verb.connect.bridge k.actions.verb text=bridge act=connect sense=1 gloss="connect or reduce the distance between" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.relate k.actions.verb text=relate act=connect sense=1 gloss="make a logical or causal connection" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.tie k.actions.verb text=tie act=connect sense=1 sense=4 gloss="fasten or secure with a rope, string, or cord" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.bind k.actions.verb text=bind act=connect sense=3 gloss="make fast; tie or secure, with or as if with a rope" object=thing named=model core.source="wordnet 3.1"
@k.actions.verb.connect.glue k.actions.verb text=glue act=connect sense=1 gloss="join or attach with or as if with glue" object=thing named=model core.source="wordnet 3.1"
