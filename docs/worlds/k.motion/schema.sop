# k.motion: how a drawn face moves over time when nobody draws it frame by frame: it blinks, glances aside, shows
# what came of a reply (done, refused, not understood ...), moves its mouth while a reply is said, and eases back to
# its own face. Facts only, read by the library's std.motion (format: questions.md Q46): events and their fields,
# layers with priorities, rules (on an event or repeated), their conditions, steps with onset, hold and ease-back
# durations as ranges, what each step sets, and the mouth: classes of mouth shapes (visemes) joined to k.faces mouth
# variants, and one general rule from written text to those classes. Names of k.faces (slots, variants,
# expressions) are values here; no coordinate is.
# Durations are milliseconds (k.units.measure); a range is a pair of keys `<name>_min` and `<name>_max`.
# sources: hand-core 1 (the schema and the rules, hand-written in this repository; the ranges come from published
# measurements named in WORLD.md)
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/motion-core.mjs

@k.motion core.module name=k.motion version=1 exports=event exports=field exports=layer exports=rule exports=when exports=step exports=set exports=viseme exports=splitter exports=letters core.source="hand-core 1"

# Something a host tells the face: `reply` (a reply begins; its fields say how it came out and what is said) and
# `spoken` (made by a rule that says a text, when the last unit is said).
@k.motion.event core.type of=k.motion.event shared=true closed=true core.source="hand-core 1"
@k.motion.event.name core.slot of=k.motion.event key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.event.about core.slot of=k.motion.event key=about required=true kind=string core.source="hand-core 1"

# A field an event carries: `value` (many) the values it may take (none said: any text).
@k.motion.field core.type of=k.motion.field shared=true closed=true core.source="hand-core 1"
@k.motion.field.event core.slot of=k.motion.field key=event id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.field.name core.slot of=k.motion.field key=name id=true required=true kind=atom core.source="hand-core 1"
@k.motion.field.value core.slot of=k.motion.field key=value many=true kind=atom kind=string core.source="hand-core 1"
@k.motion.field.about core.slot of=k.motion.field key=about required=true kind=string core.source="hand-core 1"

# A layer of the face's state: the keys its rules may set (`key`, many: keys of k.faces.expression) and its
# `priority`: where two layers set one key at once, the higher wins; below every layer is the face itself (its
# preset or the user's choice), which a key shows again when no layer sets it.
@k.motion.layer core.type of=k.motion.layer shared=true closed=true core.source="hand-core 1"
@k.motion.layer.name core.slot of=k.motion.layer key=name id=true required=true kind=atom core.source="hand-core 1"
@k.motion.layer.priority core.slot of=k.motion.layer key=priority required=true kind=integer min=1 max=9 core.source="hand-core 1"
@k.motion.layer.key core.slot of=k.motion.layer key=key many=true required=true enum=mouth enum=eyebrows enum=eyes enum=one_eye core.source="hand-core 1"
@k.motion.layer.about core.slot of=k.motion.layer key=about required=true kind=string core.source="hand-core 1"

# A rule: its steps run in `layer` when the event `on` comes (and its conditions hold), or, without `on`, again and
# again, each time after a pause between `repeat_min` and `repeat_max`. `chance` (0 to 1; none said: 1) that it
# runs when it may. `during` (many): it runs only while a rule of that layer runs; `not_during` (many): only while
# none does. `until` (many): the event that cancels it (its steps ease back at once). `emits`: the event it makes
# when its steps are done (a rule that says a text emits `spoken`).
@k.motion.rule core.type of=k.motion.rule shared=true closed=true core.source="hand-core 1"
@k.motion.rule.name core.slot of=k.motion.rule key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.rule.about core.slot of=k.motion.rule key=about required=true kind=string core.source="hand-core 1"
@k.motion.rule.layer core.slot of=k.motion.rule key=layer required=true kind=atom core.source="hand-core 1"
@k.motion.rule.on core.slot of=k.motion.rule key=on kind=atom kind=string core.source="hand-core 1"
@k.motion.rule.repeat_min core.slot of=k.motion.rule key=repeat_min kind=integer min=0 core.source="hand-core 1"
@k.motion.rule.repeat_max core.slot of=k.motion.rule key=repeat_max kind=integer min=0 core.source="hand-core 1"
@k.motion.rule.chance core.slot of=k.motion.rule key=chance kind=number min=0 max=1 core.source="hand-core 1"
@k.motion.rule.during core.slot of=k.motion.rule key=during many=true kind=atom core.source="hand-core 1"
@k.motion.rule.not_during core.slot of=k.motion.rule key=not_during many=true kind=atom core.source="hand-core 1"
@k.motion.rule.until core.slot of=k.motion.rule key=until many=true kind=atom kind=string core.source="hand-core 1"
@k.motion.rule.emits core.slot of=k.motion.rule key=emits kind=atom kind=string core.source="hand-core 1"

# A condition of a rule: `of=event` reads a field of the event that starts it, `of=state` a key of the face as it
# is shown when the rule would start. The value is one of `value` (many); `feature` compares that feature of the
# k.faces variant shown (shape, size, feel ...) instead of its name; `not=true` turns the condition round.
@k.motion.when core.type of=k.motion.when shared=true closed=true core.source="hand-core 1"
@k.motion.when.rule core.slot of=k.motion.when key=rule id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.when.key core.slot of=k.motion.when key=key id=true required=true kind=atom core.source="hand-core 1"
@k.motion.when.of core.slot of=k.motion.when key=of required=true enum=event enum=state core.source="hand-core 1"
@k.motion.when.value core.slot of=k.motion.when key=value many=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.when.feature core.slot of=k.motion.when key=feature enum=shape enum=size enum=length enum=feel enum=age enum=kind core.source="hand-core 1"
@k.motion.when.not core.slot of=k.motion.when key=not kind=boolean core.source="hand-core 1"

# A step of a rule, in the order of `n`: it starts when the step before it has eased back (or together with step
# `with`). What it sets changes over `onset`, stays for `hold`, and goes back to what is below it over `back` (each a
# range in milliseconds). `hold_until`: the hold lasts until that event comes, and then for the hold range. A step
# with `per` says a stream instead: the units of that field of the event (split by the `splitter`), one after the
# other, each setting `key` to the mouth of its class for the duration of its letters.
@k.motion.step core.type of=k.motion.step shared=true closed=true core.source="hand-core 1"
@k.motion.step.rule core.slot of=k.motion.step key=rule id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.step.n core.slot of=k.motion.step key=n id=true required=true kind=integer min=1 core.source="hand-core 1"
@k.motion.step.about core.slot of=k.motion.step key=about required=true kind=string core.source="hand-core 1"
@k.motion.step.with core.slot of=k.motion.step key=with kind=integer min=1 core.source="hand-core 1"
@k.motion.step.onset_min core.slot of=k.motion.step key=onset_min kind=integer min=0 core.source="hand-core 1"
@k.motion.step.onset_max core.slot of=k.motion.step key=onset_max kind=integer min=0 core.source="hand-core 1"
@k.motion.step.hold_min core.slot of=k.motion.step key=hold_min kind=integer min=0 core.source="hand-core 1"
@k.motion.step.hold_max core.slot of=k.motion.step key=hold_max kind=integer min=0 core.source="hand-core 1"
@k.motion.step.hold_until core.slot of=k.motion.step key=hold_until kind=atom kind=string core.source="hand-core 1"
@k.motion.step.back_min core.slot of=k.motion.step key=back_min kind=integer min=0 core.source="hand-core 1"
@k.motion.step.back_max core.slot of=k.motion.step key=back_max kind=integer min=0 core.source="hand-core 1"
@k.motion.step.per core.slot of=k.motion.step key=per kind=atom core.source="hand-core 1"
@k.motion.step.splitter core.slot of=k.motion.step key=splitter kind=atom kind=string core.source="hand-core 1"
@k.motion.step.key core.slot of=k.motion.step key=key enum=mouth enum=eyebrows enum=eyes enum=one_eye core.source="hand-core 1"

# What a step sets: `key` (a key of k.faces.expression: mouth, eyebrows, eyes, one_eye) to `value`, the name of a
# k.faces variant of that slot (one_eye: of eyes) in the style `plain`. `via`: a variant a host that only switches
# (does not blend) shows during the onset and the ease back (a blink passes through half-closed eyes).
@k.motion.set core.type of=k.motion.set shared=true closed=true core.source="hand-core 1"
@k.motion.set.rule core.slot of=k.motion.set key=rule id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.set.step core.slot of=k.motion.set key=step id=true required=true kind=integer min=1 core.source="hand-core 1"
@k.motion.set.key core.slot of=k.motion.set key=key id=true required=true enum=mouth enum=eyebrows enum=eyes enum=one_eye core.source="hand-core 1"
@k.motion.set.value core.slot of=k.motion.set key=value required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.set.via core.slot of=k.motion.set key=via kind=atom kind=string core.source="hand-core 1"

# A class of mouth shapes (a viseme), the same for every language, and the k.faces mouth variant that shows it in
# one style.
@k.motion.viseme core.type of=k.motion.viseme shared=true closed=true core.source="hand-core 1"
@k.motion.viseme.style core.slot of=k.motion.viseme key=style id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.viseme.class core.slot of=k.motion.viseme key=class id=true required=true enum=rest enum=open enum=mid enum=rounded enum=closed enum=lip-teeth enum=tongue core.source="hand-core 1"
@k.motion.viseme.mouth core.slot of=k.motion.viseme key=mouth required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.viseme.about core.slot of=k.motion.viseme key=about required=true kind=string core.source="hand-core 1"

# A rule that splits a written text into units, one per character: `fold=true` a letter with a mark counts as the
# letter without it; `ignore_case=true` a capital counts as its small letter; `default` the group of a letter that
# no group lists.
@k.motion.splitter core.type of=k.motion.splitter shared=true closed=true core.source="hand-core 1"
@k.motion.splitter.name core.slot of=k.motion.splitter key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.splitter.about core.slot of=k.motion.splitter key=about required=true kind=string core.source="hand-core 1"
@k.motion.splitter.fold core.slot of=k.motion.splitter key=fold kind=boolean core.source="hand-core 1"
@k.motion.splitter.ignore_case core.slot of=k.motion.splitter key=ignore_case kind=boolean core.source="hand-core 1"
@k.motion.splitter.default core.slot of=k.motion.splitter key=default required=true kind=atom kind=string core.source="hand-core 1"

# A group of characters of a splitter: the class of mouth they show and how long one of them lasts (a range in
# milliseconds). `letter` (many) lists them; `kind` names a whole kind instead: space (any white space), digit,
# symbol (any other character that is neither a letter nor a digit nor listed).
@k.motion.letters core.type of=k.motion.letters shared=true closed=true core.source="hand-core 1"
@k.motion.letters.splitter core.slot of=k.motion.letters key=splitter id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.letters.name core.slot of=k.motion.letters key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.motion.letters.class core.slot of=k.motion.letters key=class required=true enum=rest enum=open enum=mid enum=rounded enum=closed enum=lip-teeth enum=tongue core.source="hand-core 1"
@k.motion.letters.letter core.slot of=k.motion.letters key=letter many=true kind=string core.source="hand-core 1"
@k.motion.letters.kind core.slot of=k.motion.letters key=kind enum=space enum=digit enum=symbol core.source="hand-core 1"
@k.motion.letters.min core.slot of=k.motion.letters key=min required=true kind=integer min=0 core.source="hand-core 1"
@k.motion.letters.max core.slot of=k.motion.letters key=max required=true kind=integer min=0 core.source="hand-core 1"

# Words for the types of this world.
@k.motion.word.motion core.word text=motion text=animation text=animate text=move text=moves means=k.motion.rule core.source="hand-core 1"
@k.motion.word.blink core.word text=blink text=blinks text=blinking means=k.motion.rule core.source="hand-core 1"
@k.motion.word.viseme core.word text=viseme text=visemes text="mouth shape" text="mouth shapes" text="lip sync" means=k.motion.viseme core.source="hand-core 1"
@k.motion.word.layer core.word text=layer text=layers text=priority means=k.motion.layer core.source="hand-core 1"
@k.motion.word.event core.word text=event text=events means=k.motion.event core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.motion.word.key.event.about core.word text=about means=k.motion.event.about core.source="hand-core 1"
@k.motion.word.key.field.name core.word text=name means=k.motion.field.name core.source="hand-core 1"
@k.motion.word.key.field.value core.word text=value means=k.motion.field.value core.source="hand-core 1"
@k.motion.word.key.field.about core.word text=about means=k.motion.field.about core.source="hand-core 1"
@k.motion.word.key.layer.priority core.word text=priority means=k.motion.layer.priority core.source="hand-core 1"
@k.motion.word.key.layer.key core.word text=key means=k.motion.layer.key core.source="hand-core 1"
@k.motion.word.key.layer.about core.word text=about means=k.motion.layer.about core.source="hand-core 1"
@k.motion.word.key.rule.about core.word text=about means=k.motion.rule.about core.source="hand-core 1"
@k.motion.word.key.rule.layer core.word text=layer means=k.motion.rule.layer core.source="hand-core 1"
@k.motion.word.key.rule.on core.word text=on means=k.motion.rule.on core.source="hand-core 1"
@k.motion.word.key.rule.repeat_min core.word text="repeat min" means=k.motion.rule.repeat_min core.source="hand-core 1"
@k.motion.word.key.rule.repeat_max core.word text="repeat max" means=k.motion.rule.repeat_max core.source="hand-core 1"
@k.motion.word.key.rule.chance core.word text=chance means=k.motion.rule.chance core.source="hand-core 1"
@k.motion.word.key.rule.during core.word text=during means=k.motion.rule.during core.source="hand-core 1"
@k.motion.word.key.rule.not_during core.word text="not during" means=k.motion.rule.not_during core.source="hand-core 1"
@k.motion.word.key.rule.until core.word text=until means=k.motion.rule.until core.source="hand-core 1"
@k.motion.word.key.rule.emits core.word text=emits means=k.motion.rule.emits core.source="hand-core 1"
@k.motion.word.key.when.key core.word text=key means=k.motion.when.key core.source="hand-core 1"
@k.motion.word.key.when.of core.word text=of means=k.motion.when.of core.source="hand-core 1"
@k.motion.word.key.when.value core.word text=value means=k.motion.when.value core.source="hand-core 1"
@k.motion.word.key.when.feature core.word text=feature means=k.motion.when.feature core.source="hand-core 1"
@k.motion.word.key.when.not core.word text=not means=k.motion.when.not core.source="hand-core 1"
@k.motion.word.key.step.n core.word text=n means=k.motion.step.n core.source="hand-core 1"
@k.motion.word.key.step.about core.word text=about means=k.motion.step.about core.source="hand-core 1"
@k.motion.word.key.step.with core.word text=with means=k.motion.step.with core.source="hand-core 1"
@k.motion.word.key.step.onset_min core.word text="onset min" means=k.motion.step.onset_min core.source="hand-core 1"
@k.motion.word.key.step.onset_max core.word text="onset max" means=k.motion.step.onset_max core.source="hand-core 1"
@k.motion.word.key.step.hold_min core.word text="hold min" means=k.motion.step.hold_min core.source="hand-core 1"
@k.motion.word.key.step.hold_max core.word text="hold max" means=k.motion.step.hold_max core.source="hand-core 1"
@k.motion.word.key.step.hold_until core.word text="hold until" means=k.motion.step.hold_until core.source="hand-core 1"
@k.motion.word.key.step.back_min core.word text="back min" means=k.motion.step.back_min core.source="hand-core 1"
@k.motion.word.key.step.back_max core.word text="back max" means=k.motion.step.back_max core.source="hand-core 1"
@k.motion.word.key.step.per core.word text=per means=k.motion.step.per core.source="hand-core 1"
@k.motion.word.key.step.splitter core.word text=splitter means=k.motion.step.splitter core.source="hand-core 1"
@k.motion.word.key.step.key core.word text=key means=k.motion.step.key core.source="hand-core 1"
@k.motion.word.key.set.step core.word text=step means=k.motion.set.step core.source="hand-core 1"
@k.motion.word.key.set.key core.word text=key means=k.motion.set.key core.source="hand-core 1"
@k.motion.word.key.set.value core.word text=value means=k.motion.set.value core.source="hand-core 1"
@k.motion.word.key.set.via core.word text=via means=k.motion.set.via core.source="hand-core 1"
@k.motion.word.key.viseme.class core.word text=class means=k.motion.viseme.class core.source="hand-core 1"
@k.motion.word.key.viseme.mouth core.word text=mouth means=k.motion.viseme.mouth core.source="hand-core 1"
@k.motion.word.key.viseme.about core.word text=about means=k.motion.viseme.about core.source="hand-core 1"
@k.motion.word.key.splitter.about core.word text=about means=k.motion.splitter.about core.source="hand-core 1"
@k.motion.word.key.splitter.fold core.word text=fold means=k.motion.splitter.fold core.source="hand-core 1"
@k.motion.word.key.splitter.ignore_case core.word text="ignore case" means=k.motion.splitter.ignore_case core.source="hand-core 1"
@k.motion.word.key.splitter.default core.word text=default means=k.motion.splitter.default core.source="hand-core 1"
@k.motion.word.key.letters.name core.word text=name means=k.motion.letters.name core.source="hand-core 1"
@k.motion.word.key.letters.class core.word text=class means=k.motion.letters.class core.source="hand-core 1"
@k.motion.word.key.letters.letter core.word text=letter means=k.motion.letters.letter core.source="hand-core 1"
@k.motion.word.key.letters.kind core.word text=kind means=k.motion.letters.kind core.source="hand-core 1"
@k.motion.word.key.letters.min core.word text=min means=k.motion.letters.min core.source="hand-core 1"
