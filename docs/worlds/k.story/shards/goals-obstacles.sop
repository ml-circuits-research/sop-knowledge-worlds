# k.story/shards/goals-obstacles: 4 kinds of goals (each reached by an act of k.actions) and 16 obstacles (a thing of k.scenes as it blocks one kind of goal, the acts that get past it with their tools, the acts tried in vain).
# sources: hand-core 1 (hand-written in this repository: tools/story-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/story-core.mjs

# Goals.
@k.story.goal.reach_a_place k.story.goal name="reach a place" act=go target=place place_kind=outdoors propp="spatial transference (XV); departure (XI)" about="Get to another place (an outdoor scene of k.scenes, not the setting)." source=propp1968 source=steinGlenn1979 own="Places to reach are the outdoor scenes." core.source="hand-core 1"
@k.story.goal.find_a_thing k.story.goal name="find a thing" act=find target=thing propp="lack (VIIIa) and its liquidation (XIX)" about="Find a thing that is lost or hidden (an object of the act find)." source=propp1968 source=steinGlenn1979 core.source="hand-core 1"
@k.story.goal.rescue_someone k.story.goal name="rescue someone" act=help target=being propp="villainy by abduction (VIII) and rescue (XXII)" about="Help someone who is in trouble (an object of the act help)." source=propp1968 own="Rescue as the act help of k.actions (k.actions has no act rescue)." core.source="hand-core 1"
@k.story.goal.visit_someone k.story.goal name="visit someone" act=visit target=being propp="departure (XI) with a task" about="Go to see someone (an object of the act visit), as in a tale of a visit to a grandmother." source=propp1968 own="A visit as a goal is this repository's choice (Propp's hero departs on a task)." core.source="hand-core 1"

# Obstacles.
@k.story.obstacle.river.reach_a_place k.story.obstacle thing=river blocks="reach a place" how=between overcome_by=row overcome_by=sail overcome_by=build means="rowing boat" means=sailboat means=hammer tried_by=jump tried_by=wait tried_by=shout about="A river lies between the protagonist and the place: it is rowed or sailed across, or bridged." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.river.visit_someone k.story.obstacle thing=river blocks="visit someone" how=between overcome_by=row overcome_by=sail overcome_by=build means="rowing boat" means=sailboat means=hammer tried_by=jump tried_by=wait tried_by=shout about="A river lies between the protagonist and the one to visit." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.river.find_a_thing k.story.obstacle thing=river blocks="find a thing" how=between overcome_by=row overcome_by=sail overcome_by=build means="rowing boat" means=sailboat means=hammer tried_by=jump tried_by=wait tried_by=shout about="The thing is on the other side of a river." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.sea.reach_a_place k.story.obstacle thing=sea blocks="reach a place" how=between overcome_by=sail means=sailboat tried_by=swim tried_by=wait tried_by=shout about="The sea lies between the protagonist and the place: it is sailed across." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.sea.find_a_thing k.story.obstacle thing=sea blocks="find a thing" how=between overcome_by=sail means=sailboat tried_by=swim tried_by=wait tried_by=shout about="The thing is across the sea (a treasure on an island)." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.mountain.reach_a_place k.story.obstacle thing=mountain blocks="reach a place" how=between overcome_by=climb means=rope means=ladder tried_by=walk tried_by=jump tried_by=wait about="A mountain lies between the protagonist and the place: it is climbed with a rope or a ladder." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.mountain.find_a_thing k.story.obstacle thing=mountain blocks="find a thing" how=holds overcome_by=climb means=rope means=ladder tried_by=walk tried_by=jump tried_by=shout about="The thing is up on the mountain." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.tree.rescue_someone k.story.obstacle thing=tree blocks="rescue someone" how=holds overcome_by=climb means=ladder means=rope tried_by=jump tried_by=shout tried_by=wait about="The one to rescue is up in a tree: it is climbed with a ladder or a rope." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.tree.find_a_thing k.story.obstacle thing=tree blocks="find a thing" how=holds overcome_by=climb means=ladder means=rope tried_by=jump tried_by=shout tried_by=wait about="The thing is caught up in a tree." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.tree.reach_a_place k.story.obstacle thing=tree blocks="reach a place" how=across overcome_by=cut means=saw tried_by=push tried_by=pull tried_by=jump about="A fallen tree lies across the way: it is cut with a saw." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.tree.visit_someone k.story.obstacle thing=tree blocks="visit someone" how=across overcome_by=cut means=saw tried_by=push tried_by=pull tried_by=jump about="A fallen tree lies across the way to the one to visit." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.dragon.rescue_someone k.story.obstacle thing=dragon blocks="rescue someone" how=guards overcome_by=fight means=sword means=shield tried_by=shout tried_by=hide tried_by=run about="A dragon guards the one to rescue: it is fought with a sword and a shield." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.dragon.find_a_thing k.story.obstacle thing=dragon blocks="find a thing" how=guards overcome_by=fight means=sword means=shield tried_by=shout tried_by=hide tried_by=run about="A dragon guards the thing." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.fence.reach_a_place k.story.obstacle thing=fence blocks="reach a place" how=across overcome_by=climb means=ladder tried_by=push tried_by=pull tried_by=jump about="A fence stands across the way: it is climbed with a ladder." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.wall.reach_a_place k.story.obstacle thing=wall blocks="reach a place" how=across overcome_by=climb means=ladder means=rope tried_by=push tried_by=jump tried_by=shout about="A wall stands across the way: it is climbed with a ladder or a rope." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
@k.story.obstacle.wall.rescue_someone k.story.obstacle thing=wall blocks="rescue someone" how=between overcome_by=climb means=ladder means=rope tried_by=shout tried_by=push tried_by=jump about="The one to rescue is behind a wall." own="Which acts of k.actions get past it, with which of their tools, and which acts are tried and fail." core.source="hand-core 1"
