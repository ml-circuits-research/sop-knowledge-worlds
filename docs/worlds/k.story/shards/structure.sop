# k.story/shards/structure: the 11 elements of a story in the order they are told, and the 21 constraints between them (17 hard, 4 soft).
# sources: hand-core 1 (hand-written in this repository: tools/story-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/story-core.mjs

# Elements.
@k.story.element.setting k.story.element name=setting n=1 min=1 max=1 part=orientation move="set the scene" fills=k.scenes.scene propp="initial situation" grammar="setting (Rumelhart; Mandler and Johnson; Stein and Glenn; Thorndyke)" arc="exposition" about="Where the story happens: a scene of k.scenes, with the things it has (one of them is the obstacle)." source=propp1968 source=mandlerJohnson1977 source=steinGlenn1979 source=labovWaletzky1967 source=freytag1863 core.source="hand-core 1"
@k.story.element.protagonist k.story.element name=protagonist n=2 min=1 max=1 part=orientation move="introduce character" fills=k.people.kind fills=k.people.role fills=k.animals.animal propp="the hero" grammar="protagonist, introduced in the setting (Stein and Glenn)" arc="exposition" about="Who the story is about: a person, a person of a role or an animal, who wants something and lacks what it takes." source=propp1968 source=steinGlenn1979 source=labovWaletzky1967 core.source="hand-core 1"
@k.story.element.goal k.story.element name=goal n=3 min=1 max=1 part=orientation move="state goal" fills=k.story.goal propp="lack (VIIIa) or villainy (VIII)" grammar="goal: internal response (Stein and Glenn), theme (Thorndyke)" arc="exposition" about="What the protagonist wants or must do: a kind of goal of k.story, reached by an act of k.actions." source=propp1968 source=steinGlenn1979 source=thorndyke1977 source=rumelhart1975 core.source="hand-core 1"
@k.story.element.target k.story.element name=target n=4 min=1 max=1 part=orientation move="state goal" fills=k.scenes.scene fills=k.objects.object fills=k.people.kind fills=k.people.role fills=k.animals.animal propp="the sought-for person or object" grammar="the object of the goal" arc="exposition" about="What the goal is about: the place to reach, the thing to find, the one to rescue or visit." source=propp1968 core.source="hand-core 1"
@k.story.element.obstacle k.story.element name=obstacle n=5 min=1 max=1 part=complication move=complicate fills=k.story.obstacle propp="struggle (XVI) or difficult task (XXV)" grammar="initiating event; the complication of the episode" arc="rising action" about="What stands in the way of the goal: a thing of the setting as it blocks that kind of goal." source=propp1968 source=labovWaletzky1967 source=freytag1863 source=steinGlenn1979 core.source="hand-core 1"
@k.story.element.attempt k.story.element name=attempt n=6 min=0 max=3 part=complication move=attempt fills=k.actions.action propp="the hero's reaction to the test (XIII)" grammar="attempt and outcome (Mandler and Johnson; Stein and Glenn)" arc="rising action" about="A try that fails: an act the protagonist can do that does not get past the obstacle. At most three, each a different act; a story may have none." source=mandlerJohnson1977 source=steinGlenn1979 source=olrik1909 own="At most three attempts, after Olrik's law of three; each a different act. Optional: 23 of the 33 public-domain tales with a plot in sources/story-check have failed attempts (never more than three)." core.source="hand-core 1"
@k.story.element.helper k.story.element name=helper n=7 min=0 max=1 part=complication move="introduce character" fills=k.people.role propp="the donor (XII) or the helper" grammar="a new character of the development" arc="rising action" about="Who has what is missing: a person of a role who holds or uses the means. Brought in before the turning point. A story may have none (the protagonist then gets past the obstacle alone or fails)." source=propp1968 own="Optional: a helper in 13 of the 33 public-domain tales with a plot in sources/story-check (12 of the 15 Grimm tales, 1 of the 19 Aesop fables); where there is one, it has what is missing in 12 of 13. The procedure \"write a story\" writes the helper tale." core.source="hand-core 1"
@k.story.element.means k.story.element name=means n=8 min=0 max=1 part=climax move="turning point" fills=k.objects.object propp="the magical agent (XIV)" grammar="the enabling condition of the outcome (Rumelhart)" arc="climax" about="What is missing: the thing that lets the overcoming act be done (a tool of that act in k.actions). The helper has it; the protagonist lacks it." source=propp1968 source=rumelhart1975 core.source="hand-core 1"
@k.story.element.turning_point k.story.element name="turning point" n=9 min=0 max=1 part=climax move="turning point" fills=k.actions.action propp="provision or receipt of the magical agent (XIV)" grammar="the outcome that changes the goal path" arc="climax" about="The moment the story turns: the helper gives the protagonist the means (the act give of k.actions)." source=propp1968 source=freytag1863 source=field1979 source=aristotle core.source="hand-core 1"
@k.story.element.resolution k.story.element name=resolution n=10 min=0 max=1 part=resolution move=resolve fills=k.actions.action propp="victory (XVIII), liquidation of the lack (XIX)" grammar="outcome (Mandler and Johnson), resolution (Thorndyke)" arc="falling action" about="The obstacle overcome: the protagonist does an act that gets past it, with the means set up earlier. A story may end without one (a fable that warns)." source=propp1968 source=mandlerJohnson1977 source=thorndyke1977 source=labovWaletzky1967 source=chekhov1889 source=trabasso1985 own="Optional: 19 of the 33 public-domain tales with a plot in sources/story-check overcome the obstacle; 13 of those 19 with something set up earlier." core.source="hand-core 1"
@k.story.element.ending k.story.element name=ending n=11 min=1 max=1 part=ending move=end fills=k.story.goal propp="return (XX); the wedding or reward (XXXI)" grammar="ending (Mandler and Johnson); reaction (Stein and Glenn)" arc="outcome" about="The goal reached: the protagonist at the target, with what it has found or saved; what it felt or learnt." source=propp1968 source=mandlerJohnson1977 source=steinGlenn1979 source=labovWaletzky1967 core.source="hand-core 1"

# Constraints.
@k.story.constraint.protagonist_can_reach_the_goal k.story.constraint name="protagonist can reach the goal" element=protagonist relation=can other=goal strength=hard about="The protagonist is one of the who of the goal's act in k.actions (a girl is a person; a dog is a dog), so it can have that goal." source=steinGlenn1979 source=rumelhart1975 own="The goal's act and its `who` in k.actions stand for \"a protagonist of a kind that can have the goal\"." core.source="hand-core 1"
@k.story.constraint.target_fits_the_goal k.story.constraint name="target fits the goal" element=target relation=fits other=goal strength=hard about="The target is one of the objects of the goal's act (find a key; visit a grandmother), or, for a place, a scene of the goal's kind other than the setting." source=propp1968 own="The objects of the act in k.actions stand for what the goal can be about." core.source="hand-core 1"
@k.story.constraint.target_differs_from_the_setting k.story.constraint name="target differs from the setting" element=target relation=differs other=setting strength=hard about="A place to reach is another place than where the story starts." source=propp1968 core.source="hand-core 1"
@k.story.constraint.obstacle_blocks_the_goal k.story.constraint name="obstacle blocks the goal" element=obstacle relation=blocks other=goal strength=hard about="The obstacle is a k.story.obstacle fact for that kind of goal." source=propp1968 source=labovWaletzky1967 source=steinGlenn1979 source=trabasso1985 core.source="hand-core 1"
@k.story.constraint.setting_has_the_obstacle k.story.constraint name="setting has the obstacle" element=obstacle relation=in other=setting strength=hard about="The obstacle's thing is one of the things the setting has in k.scenes (a river scene has a river; a castle a dragon)." source=labovWaletzky1967 source=trabasso1985 own="k.scenes.has stands for what is in a setting." core.source="hand-core 1"
@k.story.constraint.means_overcomes_the_obstacle k.story.constraint name="means overcomes the obstacle" element=means relation=overcomes other=obstacle strength=hard about="The means is one of the obstacle's means: a tool of one of the acts that get past it." source=rumelhart1975 source=trabasso1985 core.source="hand-core 1"
@k.story.constraint.protagonist_lacks_the_means k.story.constraint name="protagonist lacks the means" element=protagonist relation=lacks other=means strength=hard about="The protagonist neither holds nor uses the means (a person of a role says what it holds and uses; a person or an animal of no role has nothing), so it cannot get past the obstacle alone." source=propp1968 own="k.people.role holds and uses stand for what a character has." core.source="hand-core 1"
@k.story.constraint.helper_has_the_means k.story.constraint name="helper has the means" element=helper relation=has other=means strength=hard about="The helper holds or uses the means (a sailor uses a sailboat; a firefighter a ladder; a knight holds a sword)." source=propp1968 core.source="hand-core 1"
@k.story.constraint.helper_differs_from_the_protagonist k.story.constraint name="helper differs from the protagonist" element=helper relation=differs other=protagonist strength=hard about="The helper is another character." source=propp1968 core.source="hand-core 1"
@k.story.constraint.target_differs_from_the_characters k.story.constraint name="target differs from the characters" element=target relation=differs other=protagonist strength=hard about="The one to rescue or visit is neither the protagonist nor the helper." source=propp1968 core.source="hand-core 1"
@k.story.constraint.protagonist_can_make_the_attempts k.story.constraint name="protagonist can make the attempts" element=protagonist relation=can other=attempt strength=hard about="Each attempt is an act whose who includes the protagonist." source=steinGlenn1979 core.source="hand-core 1"
@k.story.constraint.attempts_fail k.story.constraint name="attempts fail" element=attempt relation=fails other=obstacle strength=hard about="Each attempt is one of the obstacle's tried_by acts, a different one each time; none of them gets past it." source=mandlerJohnson1977 source=steinGlenn1979 source=olrik1909 core.source="hand-core 1"
@k.story.constraint.helper_comes_before_the_turning_point k.story.constraint name="helper comes before the turning point" element=helper relation=before other="turning point" strength=hard about="The helper, and with it the means, is brought in before the turning point uses it (set-up before pay-off)." source=chekhov1889 source=propp1968 source=field1979 core.source="hand-core 1"
@k.story.constraint.turning_point_gives_the_means k.story.constraint name="turning point gives the means" element="turning point" relation=gives other=means strength=hard about="At the turning point the helper gives the protagonist the means (the act give)." source=propp1968 source=aristotle core.source="hand-core 1"
@k.story.constraint.protagonist_can_overcome_with_the_means k.story.constraint name="protagonist can overcome with the means" element=protagonist relation=can other=resolution strength=hard about="The resolution's act is one the protagonist can do (its who)." source=steinGlenn1979 core.source="hand-core 1"
@k.story.constraint.resolution_uses_the_means k.story.constraint name="resolution uses the means" element=resolution relation=uses other=means strength=hard about="The resolution is an act of the obstacle's overcome_by that has the means as its tool: what was set up earlier is what solves the problem." source=chekhov1889 source=trabasso1985 source=propp1968 core.source="hand-core 1"
@k.story.constraint.means_comes_before_the_resolution k.story.constraint name="means comes before the resolution" element=means relation=before other=resolution strength=hard about="The means is told before the resolution uses it." source=chekhov1889 core.source="hand-core 1"
@k.story.constraint.ending_reaches_the_goal k.story.constraint name="ending reaches the goal" element=ending relation=reaches other=goal strength=soft about="Preferred: the ending tells the goal reached: the protagonist at the target, with it, or with the one saved." source=mandlerJohnson1977 source=labovWaletzky1967 source=propp1968 own="Soft: the goal is reached in 17 of the 33 public-domain tales with a plot in sources/story-check (the fables end in failure); a composer prefers it." core.source="hand-core 1"
@k.story.constraint.protagonist_belongs_in_the_setting k.story.constraint name="protagonist belongs in the setting" element=protagonist relation=belongs other=setting strength=soft about="Preferred: the protagonist works at the setting (k.people.role works_at) or is a thing the setting has (a fox in the forest)." source=labovWaletzky1967 own="Soft: a person of no role belongs anywhere; a composer weights the others." core.source="hand-core 1"
@k.story.constraint.helper_belongs_in_the_setting k.story.constraint name="helper belongs in the setting" element=helper relation=belongs other=setting strength=soft about="Preferred: the helper works at the setting or is a thing the setting has (a knight at the castle; a sailor at the harbour)." source=labovWaletzky1967 own="Soft." core.source="hand-core 1"
@k.story.constraint.target_in_the_setting k.story.constraint name="target in the setting" element=target relation=in other=setting strength=soft about="Preferred, for a thing or a being: the setting has it (a treasure chest on the island)." source=chekhov1889 own="Soft." core.source="hand-core 1"
