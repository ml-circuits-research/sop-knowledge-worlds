# k.story/shards/sources: the 12 published works the story structure rests on: reference, year, DOI where sure, and what this world takes from each.
# sources: hand-core 1 (hand-written in this repository: tools/story-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/story-core.mjs

@k.story.source.aristotle k.story.source name=aristotle cite="Aristotle (c. 335 BCE). Poetics, chapters 7 and 10-11. Translated by S. H. Butcher (1895) as The Poetics of Aristotle. London: Macmillan." year=-335 finding="A plot is a whole with a beginning, a middle and an end, its events joined by necessity or probability; the best plots turn by a reversal (peripeteia) that follows from what came before." core.source="hand-core 1"
@k.story.source.propp1968 k.story.source name=propp1968 cite="Propp, V. (1968). Morphology of the Folktale (2nd ed., L. Scott, Trans.; L. A. Wagner, Ed.). Austin: University of Texas Press. (Original work published 1928.)" year=1968 finding="Wonder tales are built of at most 31 functions in a fixed order (a lack or a villainy, the departure, the donor who tests the hero and provides a magical agent, the struggle, the liquidation of the lack, the return) carried by seven kinds of characters (hero, villain, donor, helper, sought-for person, dispatcher, false hero)." core.source="hand-core 1"
@k.story.source.rumelhart1975 k.story.source name=rumelhart1975 cite="Rumelhart, D. E. (1975). Notes on a schema for stories. In D. G. Bobrow & A. Collins (Eds.), Representation and Understanding: Studies in Cognitive Science (pp. 211-236). New York: Academic Press." year=1975 finding="A story is a setting and an episode; an episode is an event and the reaction to it, the reaction an internal response (a goal) and the overt attempts to reach it, joined by causal and enabling links." core.source="hand-core 1"
@k.story.source.mandlerJohnson1977 k.story.source name=mandlerJohnson1977 cite="Mandler, J. M., & Johnson, N. S. (1977). Remembrance of things parsed: Story structure and recall. Cognitive Psychology, 9(1), 111-151." year=1977 doi="10.1016/0010-0285(77)90006-8" finding="A story is a setting and episodes; an episode is a beginning, a development (a reaction, a goal path of attempt and outcome) and an ending; stories in this structure are recalled best." core.source="hand-core 1"
@k.story.source.steinGlenn1979 k.story.source name=steinGlenn1979 cite="Stein, N. L., & Glenn, C. G. (1979). An analysis of story comprehension in elementary school children. In R. O. Freedle (Ed.), New Directions in Discourse Processing (pp. 53-120). Norwood, NJ: Ablex." year=1979 finding="An episode is an initiating event, an internal response (the protagonist's goal), an attempt, a consequence and a reaction, after a setting that introduces the protagonist." core.source="hand-core 1"
@k.story.source.thorndyke1977 k.story.source name=thorndyke1977 cite="Thorndyke, P. W. (1977). Cognitive structures in comprehension and memory of narrative discourse. Cognitive Psychology, 9(1), 77-110." year=1977 finding="A story is a setting, a theme (the goal), a plot of episodes (subgoal, attempts, outcome) and a resolution; texts that keep this structure are understood and recalled better." core.source="hand-core 1"
@k.story.source.trabasso1985 k.story.source name=trabasso1985 cite="Trabasso, T., & van den Broek, P. (1985). Causal thinking and the representation of narrative events. Journal of Memory and Language, 24(5), 612-630." year=1985 finding="Events of a story that lie on its causal chain from the goal to the outcome are recalled and judged important; events with no causal links are dead ends." core.source="hand-core 1"
@k.story.source.freytag1863 k.story.source name=freytag1863 cite="Freytag, G. (1863). Die Technik des Dramas. Leipzig: S. Hirzel. Translated by E. J. MacEwan (1895) as Technique of the Drama. Chicago: S. C. Griggs." year=1863 finding="A drama rises and falls in five parts: introduction (exposition), rising action, climax, falling action (return), and catastrophe (the outcome)." core.source="hand-core 1"
@k.story.source.field1979 k.story.source name=field1979 cite="Field, S. (1979). Screenplay: The Foundations of Screenwriting. New York: Dell." year=1979 finding="A story is told in three acts (set-up, confrontation, resolution) divided by plot points that turn the action in a new direction." core.source="hand-core 1"
@k.story.source.labovWaletzky1967 k.story.source name=labovWaletzky1967 cite="Labov, W., & Waletzky, J. (1967). Narrative analysis: Oral versions of personal experience. In J. Helm (Ed.), Essays on the Verbal and Visual Arts (pp. 12-44). Seattle: University of Washington Press." year=1967 finding="A narrative has an orientation (who, where, when), a complication, an evaluation, a resolution and a coda that returns to the present." core.source="hand-core 1"
@k.story.source.olrik1909 k.story.source name=olrik1909 cite="Olrik, A. (1909). Epische Gesetze der Volksdichtung. Zeitschrift fur deutsches Altertum und deutsche Literatur, 51, 1-12. Translated as Epic laws of folk narrative, in A. Dundes (Ed.) (1965), The Study of Folklore (pp. 129-141). Englewood Cliffs, NJ: Prentice-Hall." year=1909 finding="Folk narrative follows epic laws: the law of three (three tries, three brothers, the last succeeding), two to a scene, contrast, and a single strand of action." core.source="hand-core 1"
@k.story.source.chekhov1889 k.story.source name=chekhov1889 cite="Chekhov, A. P. (1889). Letter to A. S. Lazarev (Gruzinsky), 1 November 1889. In Letters of Anton Chekhov (1973, M. H. Heim & S. Karlinsky, Trans.). New York: Harper & Row." year=1889 finding="Nothing should be put on the stage that is not used: a gun shown in the first act must be fired later (set-up and pay-off)." core.source="hand-core 1"
