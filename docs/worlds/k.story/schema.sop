@k.story.word.key.constraint.element core.word text=element means=k.story.constraint.element core.source="hand-core 1"
@k.story.word.key.constraint.relation core.word text=relation means=k.story.constraint.relation core.source="hand-core 1"
@k.story.word.key.constraint.other core.word text=other means=k.story.constraint.other core.source="hand-core 1"
@k.story.word.key.constraint.strength core.word text=strength means=k.story.constraint.strength core.source="hand-core 1"
