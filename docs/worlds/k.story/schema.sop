@k.story.word.key.element.own core.word text=own means=k.story.element.own core.source="hand-core 1"
@k.story.word.key.goal.act core.word text=act means=k.story.goal.act core.source="hand-core 1"
@k.story.word.key.goal.target core.word text=target means=k.story.goal.target core.source="hand-core 1"
@k.story.word.key.goal.place_kind core.word text="place kind" means=k.story.goal.place_kind core.source="hand-core 1"
@k.story.word.key.goal.propp core.word text=propp means=k.story.goal.propp core.source="hand-core 1"
@k.story.word.key.goal.about core.word text=about means=k.story.goal.about core.source="hand-core 1"
