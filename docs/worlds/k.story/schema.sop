@k.story.word.key.element.max core.word text=max means=k.story.element.max core.source="hand-core 1"
@k.story.word.key.element.part core.word text=part means=k.story.element.part core.source="hand-core 1"
@k.story.word.key.element.move core.word text=move means=k.story.element.move core.source="hand-core 1"
@k.story.word.key.element.fills core.word text=fills means=k.story.element.fills core.source="hand-core 1"
@k.story.word.key.element.propp core.word text=propp means=k.story.element.propp core.source="hand-core 1"
@k.story.word.key.element.grammar core.word text=grammar means=k.story.element.grammar core.source="hand-core 1"
@k.story.word.key.element.arc core.word text=arc means=k.story.element.arc core.source="hand-core 1"
@k.story.word.key.element.about core.word text=about means=k.story.element.about core.source="hand-core 1"
