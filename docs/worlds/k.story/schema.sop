@k.story.word.key.obstacle.blocks core.word text=blocks means=k.story.obstacle.blocks core.source="hand-core 1"
@k.story.word.key.obstacle.how core.word text=how means=k.story.obstacle.how core.source="hand-core 1"
@k.story.word.key.obstacle.overcome_by core.word text="overcome by" means=k.story.obstacle.overcome_by core.source="hand-core 1"
@k.story.word.key.obstacle.means core.word text=means means=k.story.obstacle.means core.source="hand-core 1"
@k.story.word.key.obstacle.tried_by core.word text="tried by" means=k.story.obstacle.tried_by core.source="hand-core 1"
