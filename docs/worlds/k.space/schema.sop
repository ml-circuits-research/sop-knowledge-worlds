@k.space.word.key.body.day_hours_about core.word text="day hours" means=k.space.body.day_hours_about core.source="hand-core 1"
@k.space.word.key.body.orbit_days_about core.word text="orbit days" means=k.space.body.orbit_days_about core.source="hand-core 1"
@k.space.word.key.body.temperature_about core.word text=temperature text=hot text=cold text=warm means=k.space.body.temperature_about core.source="hand-core 1"
@k.space.word.key.body.age_years_about core.word text="age years" text=old means=k.space.body.age_years_about core.source="hand-core 1"
@k.space.word.key.body.light_years_about core.word text="light years" means=k.space.body.light_years_about core.source="hand-core 1"
@k.space.word.key.kind core.word text=kind means=k.space.kind core.source="hand-core 1"
@k.space.word.key.kind.made_of core.word text="made of" text=made means=k.space.kind.made_of core.source="hand-core 1"
@k.space.word.key.kind.orbits core.word text=orbits means=k.space.kind.orbits core.source="hand-core 1"
@k.space.word.key.kind.has core.word text=has means=k.space.kind.has core.source="hand-core 1"
@k.space.word.key.kind.does core.word text=does means=k.space.kind.does core.source="hand-core 1"
@k.space.word.key.kind.drawing core.word text=drawing means=k.space.kind.drawing core.source="hand-core 1"
