@k.words.ox.noun.1 k.words.sense word=ox pos=noun n=1 gloss="an adult castrated bull of the genus Bos; especially Bos taurus" is_a=cattle core.source="wordnet 3.1"
@k.words.ox.noun.2 k.words.sense word=ox pos=noun n=2 gloss="any of various wild bovines especially of the genera Bos or closely related Bibos" synonym="wild ox" is_a=bovine core.source="wordnet 3.1"
@k.words.ox.forms core.word text=oxen means=ox of=k.words.sense.word core.source="wordnet 3.1"
@k.words.oxford.noun.1 k.words.sense word=Oxford pos=noun n=1 gloss="a city in southern England to the northwest of London; site of Oxford University" instance_of=city part_of=England core.source="wordnet 3.1"
@k.words.oxford.noun.2 k.words.sense word=Oxford pos=noun n=2 gloss="a university town in northern Mississippi; home of William Faulkner" instance_of=town part_of=Georgia core.source="wordnet 3.1"
@k.words.oxford.noun.3 k.words.sense word=Oxford pos=noun n=3 gloss="a university in England" synonym="Oxford University" instance_of=university part_of=Oxford core.source="wordnet 3.1"
@k.words.oxford.spelling.Oxford core.word text=oxford means=Oxford of=k.words.sense.word core.source="wordnet 3.1"
@k.words.oxygen.noun.1 k.words.sense word=oxygen pos=noun n=1 gloss="a nonmetallic bivalent element that is normally a colorless odorless tasteless nonflammable diatomic gas; constitutes 21 percent of the atmosphere by volume; the most abundant element in the earth's crust" synonym=O synonym="atomic number 8" is_a="chemical element" is_a=gas core.source="wordnet 3.1"
