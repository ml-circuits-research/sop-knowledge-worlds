@k.words.aa.noun.1 k.words.sense word=aa pos=noun n=1 gloss="a dry form of lava resembling clinkers" is_a=lava core.source="wordnet 3.1"
@k.words.aa.noun.2 k.words.sense word=AA pos=noun n=2 gloss="an international organization that provides a support group for persons trying to overcome alcoholism" synonym="Alcoholics Anonymous" is_a="nongovernmental organization" core.source="wordnet 3.1"
@k.words.aa.noun.3 k.words.sense word=AA pos=noun n=3 gloss="an associate degree in arts" synonym="Associate in Arts" is_a="associate degree" core.source="wordnet 3.1"
@k.words.aa.spelling.AA core.word text=aa means=AA of=k.words.sense.word core.source="wordnet 3.1"
@k.words.aah.verb.1 k.words.sense word=aah pos=verb n=1 gloss="express admiration and pleasure by uttering `ooh' or `aah'" synonym=ooh is_a=exclaim kind_of=exclaim kind_of=express core.source="wordnet 3.1"
@k.words.aaron.noun.1 k.words.sense word=Aaron pos=noun n=1 gloss="United States professional baseball player who hit more home runs than Babe Ruth (born in 1934)" synonym="Henry Louis Aaron" synonym="Hank Aaron" instance_of=ballplayer core.source="wordnet 3.1"
@k.words.aaron.noun.2 k.words.sense word=Aaron pos=noun n=2 gloss="(Old Testament) elder brother of Moses and first high priest of the Israelites; created the golden calf" instance_of=priest core.source="wordnet 3.1"
