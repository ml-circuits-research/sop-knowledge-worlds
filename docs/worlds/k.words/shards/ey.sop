# k.words/shards/ey: noun and verb senses of the words from "eye" to "eyewitness" (first letters "ey").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.eye.noun.1 k.words.sense word=eye pos=noun n=1 gloss="the organ of sight" synonym=oculus synonym=optic is_a="sense organ" part_of="visual system" part_of=face core.source="wordnet 3.1"
@k.words.eye.noun.2 k.words.sense word=eye pos=noun n=2 gloss="good discernment (either visually or as if visually)" is_a=sagacity core.source="wordnet 3.1"
@k.words.eye.noun.3 k.words.sense word=eye pos=noun n=3 gloss="attention to what is seen" is_a=attention core.source="wordnet 3.1"
@k.words.eye.verb.1 k.words.sense word=eye pos=verb n=1 gloss="look at" synonym=eyeball is_a=look core.source="wordnet 3.1"
@k.words.eyeball.noun.1 k.words.sense word=eyeball pos=noun n=1 gloss="the ball-shaped capsule containing the vertebrate eye" synonym=orb is_a=capsule part_of=eye core.source="wordnet 3.1"
@k.words.eyeball.verb.1 k.words.sense word=eyeball pos=verb n=1 gloss="look at" synonym=eye is_a=look core.source="wordnet 3.1"
@k.words.eyebrow.noun.1 k.words.sense word=eyebrow pos=noun n=1 gloss="the arch of hair above each eye" synonym=brow synonym=supercilium is_a=hair part_of=face core.source="wordnet 3.1"
@k.words.eyes.noun.1 k.words.sense word=eyes pos=noun n=1 gloss="opinion or judgment" is_a=opinion core.source="wordnet 3.1"
@k.words.eyesight.noun.1 k.words.sense word=eyesight pos=noun n=1 gloss="normal use of the faculty of vision" synonym=seeing synonym=sightedness is_a=sight core.source="wordnet 3.1"
@k.words.eyewitness.noun.1 k.words.sense word=eyewitness pos=noun n=1 gloss="a spectator who can describe what happened" is_a=spectator core.source="wordnet 3.1"
@k.words.eyewitness.verb.1 k.words.sense word=eyewitness pos=verb n=1 gloss="be present at an event and see it with one's own eyes" is_a=witness core.source="wordnet 3.1"
