# k.words/shards/tv: noun and verb senses of the words from "tv" to "tv" (first letters "tv").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.tv.noun.1 k.words.sense word=TV pos=noun n=1 gloss="broadcasting visual images of stationary or moving objects" synonym=television synonym=telecasting synonym=video is_a=broadcasting core.source="wordnet 3.1"
@k.words.tv.noun.2 k.words.sense word=tv pos=noun n=2 gloss="an electronic device that receives television signals and displays them on a screen" synonym="television receiver" synonym=television synonym="television set" synonym="tv set" synonym="idiot box" synonym="boob tube" synonym=telly synonym="goggle box" is_a=receiver part_of=television core.source="wordnet 3.1"
@k.words.tv.spelling.TV core.word text=tv means=TV of=k.words.sense.word core.source="wordnet 3.1"
