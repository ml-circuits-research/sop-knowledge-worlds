# k.words/shards/m: noun and verb senses of the words from "m" to "m" (first letters "m").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.m.noun.1 k.words.sense word=m pos=noun n=1 gloss="the basic unit of length adopted under the Systeme International d'Unites (approximately 1.094 yards)" synonym=meter synonym=metre is_a="metric linear unit" part_of=decameter core.source="wordnet 3.1"
@k.words.m.noun.2 k.words.sense word=M pos=noun n=2 gloss="concentration measured by the number of moles of solute per liter of solution" synonym=molarity synonym="molar concentration" is_a=concentration core.source="wordnet 3.1"
@k.words.m.noun.3 k.words.sense word=M pos=noun n=3 gloss="the cardinal number that is the product of 10 and 100" synonym=thousand synonym="one thousand" synonym=1000 synonym=K synonym=chiliad synonym=G synonym=grand synonym=thou synonym=yard is_a="large integer" core.source="wordnet 3.1"
@k.words.m.spelling.M core.word text=m means=M of=k.words.sense.word core.source="wordnet 3.1"
