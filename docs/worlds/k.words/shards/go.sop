@k.words.gossip.verb.2 k.words.sense word=gossip pos=verb n=2 gloss="talk socially without exchanging too much information" synonym="chew the fat" synonym="shoot the breeze" synonym=chat synonym=confabulate synonym=confab synonym=chitchat synonym=chit-chat synonym=chatter synonym=chaffer synonym=natter synonym=jaw synonym=claver synonym=visit is_a=converse core.source="wordnet 3.1"
@k.words.gossiping.noun.1 k.words.sense word=gossiping pos=noun n=1 gloss="a conversation that spreads personal information about other people" synonym=gossipmongering is_a=conversation core.source="wordnet 3.1"
@k.words.gothic.noun.1 k.words.sense word=Gothic pos=noun n=1 gloss="extinct East Germanic language of the ancient Goths; the only surviving record being fragments of a 4th-century translation of the Bible by Bishop Ulfilas" is_a="East Germanic" core.source="wordnet 3.1"
@k.words.gothic.noun.2 k.words.sense word=Gothic pos=noun n=2 gloss="a heavy typeface in use from 15th to 18th centuries" synonym="black letter" is_a=font core.source="wordnet 3.1"
@k.words.gothic.noun.3 k.words.sense word=Gothic pos=noun n=3 gloss="a style of architecture developed in northern France that spread throughout Europe between the 12th and 16th centuries; characterized by slender vertical piers and counterbalancing buttresses and by vaulting and pointed arches" synonym="Gothic architecture" is_a="architectural style" core.source="wordnet 3.1"
@k.words.gothic.spelling.Gothic core.word text=gothic means=Gothic of=k.words.sense.word core.source="wordnet 3.1"
@k.words.gourmet.noun.1 k.words.sense word=gourmet pos=noun n=1 gloss="a person devoted to refined sensuous enjoyment (especially good food and drink)" synonym=epicure synonym=gastronome synonym="bon vivant" synonym=epicurean synonym=foodie is_a=sensualist core.source="wordnet 3.1"
@k.words.govern.verb.1 k.words.sense word=govern pos=verb n=1 gloss="bring into conformity with rules or principles or usage; impose regulations" synonym=regulate synonym=regularize synonym=regularise synonym=order is_a=decide core.source="wordnet 3.1"
@k.words.govern.verb.2 k.words.sense word=govern pos=verb n=2 gloss="direct or strongly influence the behavior of" is_a=control core.source="wordnet 3.1"
@k.words.govern.verb.3 k.words.sense word=govern pos=verb n=3 gloss="exercise authority over; as of nations" synonym=rule is_a=control core.source="wordnet 3.1"
@k.words.governed.noun.1 k.words.sense word=governed pos=noun n=1 gloss="the body of people who are citizens of a particular government" is_a=citizenry core.source="wordnet 3.1"
@k.words.governess.noun.1 k.words.sense word=governess pos=noun n=1 gloss="a woman entrusted with the care and supervision of a child (especially in a private home)" is_a=teacher core.source="wordnet 3.1"
@k.words.government.noun.1 k.words.sense word=government pos=noun n=1 gloss="the organization that is the governing authority of a political unit" synonym=authorities synonym=regime is_a=polity core.source="wordnet 3.1"
@k.words.government.noun.2 k.words.sense word=government pos=noun n=2 gloss="the act of governing; exercising authority" synonym=governing synonym=governance synonym="government activity" synonym=administration is_a="social control" core.source="wordnet 3.1"
@k.words.government.noun.3 k.words.sense word=government pos=noun n=3 gloss="(government) the system or form by which a community or other political unit is governed" is_a=system core.source="wordnet 3.1"
@k.words.governor.noun.1 k.words.sense word=governor pos=noun n=1 gloss="the head of a state government" is_a=politician core.source="wordnet 3.1"
@k.words.governor.noun.2 k.words.sense word=governor pos=noun n=2 gloss="a control that maintains a steady speed in a machine (as by controlling the supply of fuel)" synonym=regulator is_a=control core.source="wordnet 3.1"
@k.words.gown.noun.1 k.words.sense word=gown pos=noun n=1 gloss="a woman's dress, usually with a close-fitting bodice and a long flared skirt, often worn on formal occasions" is_a=dress core.source="wordnet 3.1"
@k.words.gown.noun.2 k.words.sense word=gown pos=noun n=2 gloss="the members of a university as distinguished from the other residents of the town in which the university is located" is_a=university core.source="wordnet 3.1"
@k.words.gown.noun.3 k.words.sense word=gown pos=noun n=3 gloss="lingerie consisting of a loose dress designed to be worn in bed by women" synonym=nightgown synonym=nightie synonym=night-robe synonym=nightdress is_a=lingerie is_a=nightwear core.source="wordnet 3.1"
@k.words.gown.verb.1 k.words.sense word=gown pos=verb n=1 gloss="dress in a gown" is_a=dress core.source="wordnet 3.1"
