# k.words/shards/h: noun and verb senses of the words from "h" to "h" (first letters "h").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.h.noun.1 k.words.sense word=H pos=noun n=1 gloss="a nonmetallic univalent element that is normally a colorless and odorless highly flammable diatomic gas; the simplest and lightest and most abundant element in the universe" synonym=hydrogen synonym="atomic number 1" is_a="chemical element" is_a=gas core.source="wordnet 3.1"
@k.words.h.noun.2 k.words.sense word=H pos=noun n=2 gloss="a unit of inductance in which an induced electromotive force of one volt is produced when the current is varied at the rate of one ampere per second" synonym=henry is_a="inductance unit" core.source="wordnet 3.1"
@k.words.h.noun.3 k.words.sense word=h pos=noun n=3 gloss="the constant of proportionality relating the energy of a photon to its frequency; approximately 6.626 x 10^-34 joule-second" synonym="Planck's constant" is_a="factor of proportionality" core.source="wordnet 3.1"
@k.words.h.spelling.H core.word text=h means=H of=k.words.sense.word core.source="wordnet 3.1"
