@k.words.ghetto.noun.1 k.words.sense word=ghetto pos=noun n=1 gloss="formerly the restricted quarter of many European cities in which Jews were required to live" is_a=quarter core.source="wordnet 3.1"
@k.words.ghetto.noun.2 k.words.sense word=ghetto pos=noun n=2 gloss="any segregated mode of living or working that results from bias or stereotyping" is_a=life core.source="wordnet 3.1"
@k.words.ghetto.noun.3 k.words.sense word=ghetto pos=noun n=3 gloss="a poor densely populated city district occupied by a minority ethnic group linked together by economic hardship and social restrictions" is_a="city district" core.source="wordnet 3.1"
@k.words.ghetto.forms core.word text=ghettoes means=ghetto of=k.words.sense.word core.source="wordnet 3.1"
@k.words.ghost.noun.1 k.words.sense word=ghost pos=noun n=1 gloss="a mental representation of some haunting experience" synonym=shade synonym=spook synonym=wraith synonym=specter synonym=spectre is_a=apparition core.source="wordnet 3.1"
@k.words.ghost.noun.2 k.words.sense word=ghost pos=noun n=2 gloss="a writer who gives the credit of authorship to someone else" synonym=ghostwriter is_a=writer core.source="wordnet 3.1"
@k.words.ghost.noun.3 k.words.sense word=ghost pos=noun n=3 gloss="the visible disembodied soul of a dead person" is_a=soul core.source="wordnet 3.1"
@k.words.ghost.verb.1 k.words.sense word=ghost pos=verb n=1 gloss="move like a ghost" is_a=travel core.source="wordnet 3.1"
@k.words.ghost.verb.2 k.words.sense word=ghost pos=verb n=2 gloss="haunt like a ghost; pursue" synonym=haunt synonym=obsess is_a=preoccupy core.source="wordnet 3.1"
@k.words.ghost.verb.3 k.words.sense word=ghost pos=verb n=3 gloss="write for someone else" synonym=ghostwrite is_a=author core.source="wordnet 3.1"
