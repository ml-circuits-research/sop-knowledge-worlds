@k.words.fm.noun.1 k.words.sense word=FM pos=noun n=1 gloss="modulation of the frequency of the (radio) carrier wave" synonym="frequency modulation" is_a=modulation core.source="wordnet 3.1"
@k.words.fm.noun.2 k.words.sense word=Fm pos=noun n=2 gloss="a radioactive transuranic metallic element produced by bombarding plutonium with neutrons" synonym=fermium synonym="atomic number 100" is_a="metallic element" core.source="wordnet 3.1"
@k.words.fm.spelling.FM core.word text=fm means=FM of=k.words.sense.word core.source="wordnet 3.1"
@k.words.fm.spelling.Fm core.word text=fm means=Fm of=k.words.sense.word core.source="wordnet 3.1"
