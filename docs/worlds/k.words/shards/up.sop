@k.words.upset.noun.2 k.words.sense word=upset pos=noun n=2 gloss="the act of disturbing the mind or body" synonym=derangement synonym=overthrow is_a=disturbance core.source="wordnet 3.1"
@k.words.upset.noun.3 k.words.sense word=upset pos=noun n=3 gloss="a physical condition in which there is a disturbance of normal functioning" synonym=disorder is_a="physical condition" core.source="wordnet 3.1"
