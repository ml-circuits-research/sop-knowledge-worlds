@k.words.update.verb.1 k.words.sense word=update pos=verb n=1 gloss="modernize or bring up to date" is_a=modify core.source="wordnet 3.1"
@k.words.update.verb.2 k.words.sense word=update pos=verb n=2 gloss="bring up to date; supply with recent information" is_a=inform core.source="wordnet 3.1"
@k.words.update.verb.3 k.words.sense word=update pos=verb n=3 gloss="bring to the latest state of technology or supply with the latest data" is_a=modify core.source="wordnet 3.1"
@k.words.upgrade.noun.1 k.words.sense word=upgrade pos=noun n=1 gloss="an upward slope or grade (as in a road)" synonym=ascent synonym=acclivity synonym=rise synonym=raise synonym=climb is_a=slope core.source="wordnet 3.1"
@k.words.upgrade.noun.2 k.words.sense word=upgrade pos=noun n=2 gloss="software that provides better performance than an earlier version did" is_a=software core.source="wordnet 3.1"
@k.words.upgrade.noun.3 k.words.sense word=upgrade pos=noun n=3 gloss="a reservation that is improved" is_a=reservation core.source="wordnet 3.1"
@k.words.upgrade.verb.1 k.words.sense word=upgrade pos=verb n=1 gloss="rate higher; raise in value or esteem" is_a=rate core.source="wordnet 3.1"
@k.words.upgrade.verb.2 k.words.sense word=upgrade pos=verb n=2 gloss="to improve what was old or outdated" is_a=better core.source="wordnet 3.1"
@k.words.upgrade.verb.3 k.words.sense word=upgrade pos=verb n=3 gloss="give a promotion to or assign to a higher position" synonym=promote synonym=advance synonym="kick upstairs" synonym=raise synonym=elevate is_a=delegate core.source="wordnet 3.1"
@k.words.uphill.noun.1 k.words.sense word=uphill pos=noun n=1 gloss="the upward slope of a hill" is_a=ascent core.source="wordnet 3.1"
