@k.words.upside.noun.1 k.words.sense word=upside pos=noun n=1 gloss="the highest or uppermost side of anything" synonym=top synonym="top side" synonym="upper side" is_a=side core.source="wordnet 3.1"
@k.words.upstairs.noun.1 k.words.sense word=upstairs pos=noun n=1 gloss="the part of a building above the ground floor" is_a=part part_of=building core.source="wordnet 3.1"
@k.words.uptown.noun.1 k.words.sense word=uptown pos=noun n=1 gloss="a residential part of town away from the central commercial district" is_a="residential district" part_of=city core.source="wordnet 3.1"
