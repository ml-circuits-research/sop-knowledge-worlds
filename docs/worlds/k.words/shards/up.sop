@k.words.up.verb.1 k.words.sense word=up pos=verb n=1 gloss="raise" is_a=increase core.source="wordnet 3.1"
@k.words.up.forms core.word text=upped text=upping means=up of=k.words.sense.word core.source="wordnet 3.1"
@k.words.upbeat.noun.1 k.words.sense word=upbeat pos=noun n=1 gloss="a contented state of being happy and healthy and prosperous" synonym=wellbeing synonym=well-being synonym=welfare synonym=eudaemonia synonym=eudaimonia is_a=prosperity core.source="wordnet 3.1"
@k.words.upbeat.noun.2 k.words.sense word=upbeat pos=noun n=2 gloss="an unaccented beat (especially the last beat of a measure)" synonym=offbeat is_a=rhythm core.source="wordnet 3.1"
@k.words.upbringing.noun.1 k.words.sense word=upbringing pos=noun n=1 gloss="properties acquired during a person's formative years" is_a=inheritance core.source="wordnet 3.1"
@k.words.upbringing.noun.2 k.words.sense word=upbringing pos=noun n=2 gloss="helping someone grow up to be an accepted member of the community" synonym=breeding synonym="bringing up" synonym=fostering synonym=fosterage synonym=nurture synonym=raising synonym=rearing is_a=socialization core.source="wordnet 3.1"
@k.words.update.noun.1 k.words.sense word=update pos=noun n=1 gloss="information or data that updates" is_a=information core.source="wordnet 3.1"
