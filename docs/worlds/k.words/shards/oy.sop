@k.words.oyster.noun.1 k.words.sense word=oyster pos=noun n=1 gloss="marine mollusks having a rough irregular shell; found on the sea bed mostly in coastal waters" is_a=bivalve core.source="wordnet 3.1"
@k.words.oyster.noun.2 k.words.sense word=oyster pos=noun n=2 gloss="edible body of any of numerous oysters" synonym=huitre is_a=shellfish part_of=oyster core.source="wordnet 3.1"
@k.words.oyster.noun.3 k.words.sense word=oyster pos=noun n=3 gloss="a small muscle on each side of the back of a fowl" is_a=helping part_of=bird core.source="wordnet 3.1"
@k.words.oyster.verb.1 k.words.sense word=oyster pos=verb n=1 gloss="gather oysters, dig oysters" is_a=gather core.source="wordnet 3.1"
