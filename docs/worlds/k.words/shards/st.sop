@k.words.stutter.noun.1 k.words.sense word=stutter pos=noun n=1 gloss="a speech disorder involving hesitations and involuntary repetitions of certain sounds" synonym=stammer is_a="speech disorder" core.source="wordnet 3.1"
@k.words.stutter.verb.1 k.words.sense word=stutter pos=verb n=1 gloss="speak haltingly" synonym=bumble synonym=stammer synonym=falter is_a=talk core.source="wordnet 3.1"
@k.words.style.noun.1 k.words.sense word=style pos=noun n=1 gloss="how something is done or how it happens" synonym=manner synonym=mode synonym=way synonym=fashion is_a=property core.source="wordnet 3.1"
@k.words.style.noun.2 k.words.sense word=style pos=noun n=2 gloss="a way of expressing something (in language or art or music etc.) that is characteristic of a particular person or group of people or period" synonym="expressive style" is_a=communication core.source="wordnet 3.1"
@k.words.style.noun.3 k.words.sense word=style pos=noun n=3 gloss="a particular kind (as to appearance)" is_a=kind core.source="wordnet 3.1"
@k.words.style.verb.1 k.words.sense word=style pos=verb n=1 gloss="designate by an identifying term" synonym=title is_a=name core.source="wordnet 3.1"
@k.words.style.verb.2 k.words.sense word=style pos=verb n=2 gloss="make consistent with a certain fashion or style" is_a=make core.source="wordnet 3.1"
@k.words.style.verb.3 k.words.sense word=style pos=verb n=3 gloss="make consistent with certain rules of style" is_a=write core.source="wordnet 3.1"
@k.words.stylist.noun.1 k.words.sense word=stylist pos=noun n=1 gloss="an artist who is a master of a particular style" is_a=artist core.source="wordnet 3.1"
@k.words.stylist.noun.2 k.words.sense word=stylist pos=noun n=2 gloss="someone who cuts or beautifies hair" synonym=hairdresser synonym=hairstylist synonym=styler is_a=craftsman core.source="wordnet 3.1"
