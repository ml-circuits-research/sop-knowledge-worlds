@k.words.ji.noun.1 k.words.sense word=JI pos=noun n=1 gloss="a clandestine group of southeast Asian terrorists organized in 1993 and trained by al-Qaeda; supports militant Muslims in Indonesia and the Philippines and has cells in Singapore and Malaysia and Indonesia" synonym="Jemaah Islamiyah" synonym="Islamic Group" synonym="Islamic Community" synonym="Malaysian Mujahidin Group" synonym="Malaysia Militant Group" instance_of="terrorist organization" core.source="wordnet 3.1"
@k.words.ji.spelling.JI core.word text=ji means=JI of=k.words.sense.word core.source="wordnet 3.1"
@k.words.jiffy.noun.1 k.words.sense word=jiffy pos=noun n=1 gloss="a very short time (as the time it takes the eye to blink or the heart to beat)" synonym="blink of an eye" synonym=flash synonym=heartbeat synonym=instant synonym="split second" synonym=trice synonym=twinkling synonym=wink synonym="New York minute" is_a=moment core.source="wordnet 3.1"
@k.words.jig.noun.1 k.words.sense word=jig pos=noun n=1 gloss="music in three-four time for dancing a jig" synonym=gigue is_a="dance music" core.source="wordnet 3.1"
@k.words.jig.noun.2 k.words.sense word=jig pos=noun n=2 gloss="a fisherman's lure with one or more hooks that is jerked up and down in the water" is_a="fisherman's lure" core.source="wordnet 3.1"
@k.words.jig.noun.3 k.words.sense word=jig pos=noun n=3 gloss="a device that holds a piece of machine work and guides the tools operating on it" is_a=device core.source="wordnet 3.1"
@k.words.jig.verb.1 k.words.sense word=jig pos=verb n=1 gloss="dance a quick dance with leaping and kicking motions" is_a=dance core.source="wordnet 3.1"
@k.words.jig.forms core.word text=jigged text=jigging means=jig of=k.words.sense.word core.source="wordnet 3.1"
@k.words.jigsaw.noun.1 k.words.sense word=jigsaw pos=noun n=1 gloss="a portable power saw with a reciprocating blade; can be used with a variety of blades depending on the application and kind of cut; generally have a plate that rides on the surface that is being cut" synonym="saber saw" synonym="reciprocating saw" is_a="power saw" core.source="wordnet 3.1"
@k.words.jigsaw.noun.2 k.words.sense word=jigsaw pos=noun n=2 gloss="fine-toothed power saw with a narrow blade; used to cut curved outlines" synonym="scroll saw" synonym=fretsaw is_a="power saw" core.source="wordnet 3.1"
@k.words.jihad.noun.1 k.words.sense word=jihad pos=noun n=1 gloss="a holy struggle or striving by a Muslim for a moral or spiritual or political goal" synonym=jehad is_a=striving core.source="wordnet 3.1"
@k.words.jimmy.noun.1 k.words.sense word=jimmy pos=noun n=1 gloss="a short crowbar" synonym=jemmy is_a=crowbar core.source="wordnet 3.1"
@k.words.jimmy.verb.1 k.words.sense word=jimmy pos=verb n=1 gloss="to move or force, especially in an effort to get something open" synonym=pry synonym=prise synonym=prize synonym=lever is_a=open core.source="wordnet 3.1"
@k.words.jimmy.forms core.word text=jimmied means=jimmy of=k.words.sense.word core.source="wordnet 3.1"
@k.words.jingle.noun.1 k.words.sense word=jingle pos=noun n=1 gloss="a metallic sound" synonym=jangle is_a=sound core.source="wordnet 3.1"
@k.words.jingle.noun.2 k.words.sense word=jingle pos=noun n=2 gloss="a comic verse of irregular measure" synonym=doggerel synonym="doggerel verse" is_a=verse core.source="wordnet 3.1"
@k.words.jingle.verb.1 k.words.sense word=jingle pos=verb n=1 gloss="make a sound typical of metallic objects" synonym=jingle-jangle synonym=jangle is_a="make noise" core.source="wordnet 3.1"
@k.words.jinx.noun.1 k.words.sense word=jinx pos=noun n=1 gloss="a person believed to bring bad luck to those around him" synonym=jonah is_a=unfortunate core.source="wordnet 3.1"
@k.words.jinx.noun.2 k.words.sense word=jinx pos=noun n=2 gloss="an evil spell" synonym=hex synonym=curse synonym=whammy is_a=spell core.source="wordnet 3.1"
@k.words.jinx.verb.1 k.words.sense word=jinx pos=verb n=1 gloss="cast a spell over someone or something; put a hex on someone or something" synonym=hex synonym=bewitch synonym=glamour synonym=witch synonym=enchant is_a=charm core.source="wordnet 3.1"
@k.words.jinx.verb.2 k.words.sense word=jinx pos=verb n=2 gloss="foredoom to failure" is_a=predestine core.source="wordnet 3.1"
@k.words.jive.noun.1 k.words.sense word=jive pos=noun n=1 gloss="a style of jazz played by big bands popular in the 1930s; flowing rhythms but less complex than later styles of jazz" synonym=swing synonym="swing music" is_a=jazz core.source="wordnet 3.1"
@k.words.jive.verb.1 k.words.sense word=jive pos=verb n=1 gloss="dance to jive music; dance the jive" is_a=dance core.source="wordnet 3.1"
