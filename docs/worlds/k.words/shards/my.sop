# k.words/shards/my: noun and verb senses of the words from "myrtle" to "mythology" (first letters "my").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.myrtle.noun.1 k.words.sense word=myrtle pos=noun n=1 gloss="widely cultivated as a groundcover for its dark green shiny leaves and usually blue-violet flowers" synonym="Vinca minor" is_a=periwinkle core.source="wordnet 3.1"
@k.words.myrtle.noun.2 k.words.sense word=myrtle pos=noun n=2 gloss="any evergreen shrub or tree of the genus Myrtus" is_a="angiospermous tree" core.source="wordnet 3.1"
@k.words.mystery.noun.1 k.words.sense word=mystery pos=noun n=1 gloss="something that baffles understanding and cannot be explained" synonym=enigma synonym=secret synonym="closed book" is_a=perplexity core.source="wordnet 3.1"
@k.words.mystery.noun.2 k.words.sense word=mystery pos=noun n=2 gloss="a story about a crime (usually murder) presented as a novel or play or movie" synonym="mystery story" synonym=whodunit is_a=story core.source="wordnet 3.1"
@k.words.mystic.noun.1 k.words.sense word=mystic pos=noun n=1 gloss="someone who believes in the existence of realities beyond human comprehension" synonym="religious mystic" is_a=believer core.source="wordnet 3.1"
@k.words.myth.noun.1 k.words.sense word=myth pos=noun n=1 gloss="a traditional story accepted as history; serves to explain the world view of a people" is_a=story core.source="wordnet 3.1"
@k.words.mythology.noun.1 k.words.sense word=mythology pos=noun n=1 gloss="myths collectively; the body of stories associated with a culture or institution or person" is_a=collection core.source="wordnet 3.1"
@k.words.mythology.noun.2 k.words.sense word=mythology pos=noun n=2 gloss="the study of myths" is_a="social anthropology" core.source="wordnet 3.1"
