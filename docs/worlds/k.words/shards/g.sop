# script: tools/import/wordnet.mjs

@k.words.g.noun.1 k.words.sense word=g pos=noun n=1 gloss="a metric unit of weight equal to one thousandth of a kilogram" synonym=gram synonym=gramme synonym=gm is_a="metric weight unit" part_of=dekagram core.source="wordnet 3.1"
@k.words.g.noun.2 k.words.sense word=G pos=noun n=2 gloss="a purine base found in DNA and RNA; pairs with cytosine" synonym=guanine is_a=purine core.source="wordnet 3.1"
@k.words.g.noun.3 k.words.sense word=G pos=noun n=3 gloss="one of the four nucleotides used in building DNA; all four nucleotides have a common phosphate group and a sugar (ribose)" synonym="deoxyguanosine monophosphate" is_a=nucleotide core.source="wordnet 3.1"
@k.words.g.spelling.G core.word text=g means=G of=k.words.sense.word core.source="wordnet 3.1"
