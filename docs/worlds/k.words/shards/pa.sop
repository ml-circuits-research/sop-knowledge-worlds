@k.words.payroll.noun.1 k.words.sense word=payroll pos=noun n=1 gloss="a list of employees and their salaries" synonym=paysheet is_a=register core.source="wordnet 3.1"
@k.words.payroll.noun.2 k.words.sense word=payroll pos=noun n=2 gloss="the total amount of money paid in wages" synonym=paysheet is_a=sum core.source="wordnet 3.1"
@k.words.payroll.noun.3 k.words.sense word=payroll pos=noun n=3 gloss="the department that determines the amounts of wage or salary due to each employee" synonym="payroll department" is_a=department core.source="wordnet 3.1"
