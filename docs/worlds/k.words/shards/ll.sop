@k.words.llama.noun.1 k.words.sense word=llama pos=noun n=1 gloss="wild or domesticated South American cud-chewing animal related to camels but smaller and lacking a hump" is_a="even-toed ungulate" core.source="wordnet 3.1"
@k.words.lloyd.noun.1 k.words.sense word=Lloyd pos=noun n=1 gloss="United States comic actor in silent films; he used physical danger as a source of comedy (1893-1971)" synonym="Harold Lloyd" synonym="Harold Clayton Lloyd" instance_of=actor core.source="wordnet 3.1"
