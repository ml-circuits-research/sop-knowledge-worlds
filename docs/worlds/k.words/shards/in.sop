@k.words.intrude.verb.3 k.words.sense word=intrude pos=verb n=3 gloss="search or inquire in a meddlesome way" synonym="horn in" synonym=pry synonym=nose synonym=poke is_a=search core.source="wordnet 3.1"
@k.words.intruder.noun.1 k.words.sense word=intruder pos=noun n=1 gloss="someone who intrudes on the privacy or property of another without permission" synonym=interloper synonym=trespasser is_a=entrant is_a="unwelcome person" core.source="wordnet 3.1"
@k.words.intrusion.noun.1 k.words.sense word=intrusion pos=noun n=1 gloss="any entry into an area not previously occupied" synonym=invasion synonym=encroachment is_a=entrance core.source="wordnet 3.1"
@k.words.intrusion.noun.2 k.words.sense word=intrusion pos=noun n=2 gloss="entrance by force or without permission or welcome" is_a=entrance core.source="wordnet 3.1"
@k.words.intrusion.noun.3 k.words.sense word=intrusion pos=noun n=3 gloss="the forcing of molten rock into fissures or between strata of an earlier rock formation" is_a="geological process" core.source="wordnet 3.1"
@k.words.intuition.noun.1 k.words.sense word=intuition pos=noun n=1 gloss="instinctive knowing (without the use of rational processes)" is_a="basic cognitive process" core.source="wordnet 3.1"
@k.words.intuition.noun.2 k.words.sense word=intuition pos=noun n=2 gloss="an impression that something might be the case" synonym=hunch synonym=suspicion is_a=impression core.source="wordnet 3.1"
@k.words.invade.verb.1 k.words.sense word=invade pos=verb n=1 gloss="march aggressively into another's territory by military force for the purposes of conquest and occupation" synonym=occupy is_a=attack core.source="wordnet 3.1"
@k.words.invade.verb.2 k.words.sense word=invade pos=verb n=2 gloss="to intrude upon, infringe, encroach on, violate" synonym="intrude on" synonym="obtrude upon" synonym="encroach upon" is_a=enter core.source="wordnet 3.1"
@k.words.invade.verb.3 k.words.sense word=invade pos=verb n=3 gloss="occupy in large numbers or live on a host" synonym=overrun synonym=infest is_a=inhabit core.source="wordnet 3.1"
@k.words.invalid.noun.1 k.words.sense word=invalid pos=noun n=1 gloss="someone who is incapacitated by a chronic illness or injury" synonym=shut-in is_a="sick person" core.source="wordnet 3.1"
@k.words.invalid.verb.1 k.words.sense word=invalid pos=verb n=1 gloss="force to retire, remove from active duty, as of firemen" is_a=remove core.source="wordnet 3.1"
@k.words.invalid.verb.2 k.words.sense word=invalid pos=verb n=2 gloss="injure permanently" synonym=disable synonym=incapacitate synonym=handicap is_a=injure core.source="wordnet 3.1"
@k.words.invasion.noun.1 k.words.sense word=invasion pos=noun n=1 gloss="the act of invading; the act of an army that invades for conquest or plunder" is_a=penetration core.source="wordnet 3.1"
@k.words.invasion.noun.2 k.words.sense word=invasion pos=noun n=2 gloss="any entry into an area not previously occupied" synonym=encroachment synonym=intrusion is_a=entrance core.source="wordnet 3.1"
@k.words.invasion.noun.3 k.words.sense word=invasion pos=noun n=3 gloss="(pathology) the spread of pathogenic microorganisms or malignant cells to new sites in the body" is_a=spread core.source="wordnet 3.1"
@k.words.invent.verb.1 k.words.sense word=invent pos=verb n=1 gloss="come up with (an idea, plan, explanation, theory, or principle) after a mental effort" synonym=contrive synonym=devise synonym=excogitate synonym=formulate synonym=forge is_a="create by mental act" core.source="wordnet 3.1"
@k.words.invent.verb.2 k.words.sense word=invent pos=verb n=2 gloss="concoct something artificial or untrue" synonym=fabricate synonym=manufacture synonym="cook up" synonym="make up" is_a="think up" core.source="wordnet 3.1"
@k.words.invention.noun.1 k.words.sense word=invention pos=noun n=1 gloss="the creation of something in the mind" synonym=innovation synonym=excogitation synonym=conception synonym=design is_a=creativity core.source="wordnet 3.1"
@k.words.invention.noun.2 k.words.sense word=invention pos=noun n=2 gloss="a creation (a new device or process) resulting from study and experimentation" synonym=innovation is_a=creation core.source="wordnet 3.1"
@k.words.invention.noun.3 k.words.sense word=invention pos=noun n=3 gloss="the act of inventing" is_a="creating by mental acts" core.source="wordnet 3.1"
@k.words.inventor.noun.1 k.words.sense word=inventor pos=noun n=1 gloss="someone who is the first to think of or make something" synonym=discoverer synonym=artificer is_a=creator core.source="wordnet 3.1"
@k.words.inventory.noun.1 k.words.sense word=inventory pos=noun n=1 gloss="a detailed list of all the items in stock" synonym="stock list" is_a=list core.source="wordnet 3.1"
@k.words.inventory.noun.2 k.words.sense word=inventory pos=noun n=2 gloss="the merchandise that a shop has on hand" synonym=stock is_a=merchandise core.source="wordnet 3.1"
@k.words.inventory.noun.3 k.words.sense word=inventory pos=noun n=3 gloss="(accounting) the value of a firm's current assets including raw materials and work in progress and finished goods" is_a=register core.source="wordnet 3.1"
@k.words.inventory.verb.1 k.words.sense word=inventory pos=verb n=1 gloss="make or include in an itemized record or report" synonym="take stock" synonym=stock-take is_a=list core.source="wordnet 3.1"
@k.words.invest.verb.1 k.words.sense word=invest pos=verb n=1 gloss="make an investment" synonym=put synonym=commit synonym=place is_a=spend opposite=divest core.source="wordnet 3.1"
@k.words.invest.verb.2 k.words.sense word=invest pos=verb n=2 gloss="give qualities or abilities to" synonym=endow synonym=indue synonym=gift synonym=empower synonym=endue is_a=enable core.source="wordnet 3.1"
@k.words.invest.verb.3 k.words.sense word=invest pos=verb n=3 gloss="furnish with power or authority; of kings or emperors" synonym=clothe synonym=adorn is_a=equip core.source="wordnet 3.1"
@k.words.investigate.verb.1 k.words.sense word=investigate pos=verb n=1 gloss="investigate scientifically" synonym="look into" is_a=analyze core.source="wordnet 3.1"
@k.words.investigate.verb.2 k.words.sense word=investigate pos=verb n=2 gloss="conduct an inquiry or investigation of" synonym=inquire synonym=enquire is_a=probe core.source="wordnet 3.1"
@k.words.investigating.noun.1 k.words.sense word=investigating pos=noun n=1 gloss="the work of inquiring into something thoroughly and systematically" synonym=investigation is_a=work core.source="wordnet 3.1"
@k.words.investigation.noun.1 k.words.sense word=investigation pos=noun n=1 gloss="an inquiry into unfamiliar or questionable activities" synonym=probe is_a=inquiry kind_of=inquiry kind_of="problem solving" kind_of=thinking kind_of="higher cognitive process" kind_of=process kind_of=cognition kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.investigation.noun.2 k.words.sense word=investigation pos=noun n=2 gloss="the work of inquiring into something thoroughly and systematically" synonym=investigating is_a=work kind_of=work kind_of=activity kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.investigator.noun.1 k.words.sense word=investigator pos=noun n=1 gloss="a scientist who devotes himself to doing research" synonym="research worker" synonym=researcher is_a=scientist core.source="wordnet 3.1"
@k.words.investigator.noun.2 k.words.sense word=investigator pos=noun n=2 gloss="someone who investigates" is_a=expert core.source="wordnet 3.1"
@k.words.investigator.noun.3 k.words.sense word=investigator pos=noun n=3 gloss="a police officer who investigates crimes" synonym=detective synonym=tec synonym="police detective" is_a=policeman core.source="wordnet 3.1"
@k.words.investing.noun.1 k.words.sense word=investing pos=noun n=1 gloss="the act of investing; laying out money or capital in an enterprise with the expectation of profit" synonym=investment is_a=finance core.source="wordnet 3.1"
@k.words.investment.noun.1 k.words.sense word=investment pos=noun n=1 gloss="the act of investing; laying out money or capital in an enterprise with the expectation of profit" synonym=investing is_a=finance core.source="wordnet 3.1"
@k.words.investment.noun.2 k.words.sense word=investment pos=noun n=2 gloss="money that is invested with an expectation of profit" synonym="investment funds" is_a=assets core.source="wordnet 3.1"
@k.words.investment.noun.3 k.words.sense word=investment pos=noun n=3 gloss="the commitment of something other than money (time, energy, or effort) to a project with the expectation of some worthwhile result" is_a=committedness core.source="wordnet 3.1"
@k.words.investor.noun.1 k.words.sense word=investor pos=noun n=1 gloss="someone who commits capital in order to gain financial returns" is_a=capitalist core.source="wordnet 3.1"
@k.words.invitation.noun.1 k.words.sense word=invitation pos=noun n=1 gloss="a request (spoken or written) to participate or be present or take part in something" is_a=request is_a=letter core.source="wordnet 3.1"
@k.words.invitation.noun.2 k.words.sense word=invitation pos=noun n=2 gloss="a tempting allurement" is_a=allure core.source="wordnet 3.1"
@k.words.invite.noun.1 k.words.sense word=invite pos=noun n=1 gloss="a colloquial expression for invitation" is_a=invitation kind_of=invitation kind_of=request kind_of="speech act" kind_of=act kind_of=event kind_of="psychological feature" kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.invite.verb.1 k.words.sense word=invite pos=verb n=1 gloss="increase the likelihood of" synonym="ask for" is_a=arouse kind_of=arouse kind_of=make core.source="wordnet 3.1"
@k.words.invite.verb.2 k.words.sense word=invite pos=verb n=2 gloss="invite someone to one's house" synonym="ask over" synonym="ask round" is_a=request kind_of=request kind_of=communicate kind_of=convey kind_of=transfer kind_of=move core.source="wordnet 3.1"
@k.words.invite.verb.3 k.words.sense word=invite pos=verb n=3 gloss="give rise to a desire by being attractive or inviting" synonym=tempt is_a=stimulate kind_of=stimulate kind_of=arouse kind_of=make core.source="wordnet 3.1"
@k.words.invoice.noun.1 k.words.sense word=invoice pos=noun n=1 gloss="an itemized statement of money owed for goods shipped or services rendered" synonym=bill synonym=account is_a=statement core.source="wordnet 3.1"
@k.words.invoice.verb.1 k.words.sense word=invoice pos=verb n=1 gloss="send an bill to" is_a=charge core.source="wordnet 3.1"
@k.words.invoke.verb.1 k.words.sense word=invoke pos=verb n=1 gloss="summon into action or bring into existence, often as if by magic" synonym=raise synonym=conjure synonym="conjure up" synonym=evoke synonym=stir synonym="call down" synonym=arouse synonym="bring up" synonym="put forward" synonym="call forth" is_a="call up" core.source="wordnet 3.1"
@k.words.invoke.verb.2 k.words.sense word=invoke pos=verb n=2 gloss="cite as an authority; resort to" synonym=appeal is_a=mention core.source="wordnet 3.1"
@k.words.invoke.verb.3 k.words.sense word=invoke pos=verb n=3 gloss="request earnestly (something from somebody); ask for aid or protection" synonym=appeal is_a=request core.source="wordnet 3.1"
@k.words.involve.verb.1 k.words.sense word=involve pos=verb n=1 gloss="connect closely and often incriminatingly" synonym=affect synonym=regard is_a=refer core.source="wordnet 3.1"
@k.words.involve.verb.2 k.words.sense word=involve pos=verb n=2 gloss="engage as a participant" is_a=admit core.source="wordnet 3.1"
@k.words.involve.verb.3 k.words.sense word=involve pos=verb n=3 gloss="have as a necessary feature" synonym=imply is_a=have core.source="wordnet 3.1"
@k.words.involved.adjective.1 k.words.sense word=involved pos=adjective n=1 gloss="connected by participation or association or use" opposite=uninvolved core.source="wordnet 3.1"
@k.words.involved.adjective.2 k.words.sense word=involved pos=adjective n=2 gloss="entangled or hindered as if e.g. in mire" synonym=mired near_opposite=unencumbered core.source="wordnet 3.1"
@k.words.involved.adjective.3 k.words.sense word=involved pos=adjective n=3 gloss="emotionally involved" near_opposite=unattached core.source="wordnet 3.1"
@k.words.involvement.noun.1 k.words.sense word=involvement pos=noun n=1 gloss="the act of sharing in the activities of a group" synonym=engagement synonym=participation synonym=involution is_a="group action" opposite=non-involvement core.source="wordnet 3.1"
@k.words.involvement.noun.2 k.words.sense word=involvement pos=noun n=2 gloss="a connection of inclusion or containment" is_a=connection core.source="wordnet 3.1"
@k.words.involvement.noun.3 k.words.sense word=involvement pos=noun n=3 gloss="a sense of concern with and curiosity about someone or something" synonym=interest is_a=curiosity core.source="wordnet 3.1"
