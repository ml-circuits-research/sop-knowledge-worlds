# k.words/shards/v: noun and verb senses of the words from "v" to "v" (first letters "v").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.v.noun.1 k.words.sense word=V pos=noun n=1 gloss="a unit of potential equal to the potential difference between two points on a conductor carrying a current of 1 ampere when the power dissipated between the two points is 1 watt; equivalent to the potential difference across a resistance of 1 ohm when 1 ampere of current flows through it" synonym=volt is_a="potential unit" part_of=kilovolt core.source="wordnet 3.1"
@k.words.v.noun.2 k.words.sense word=V pos=noun n=2 gloss="a soft silvery white toxic metallic element used in steel alloys; it occurs in several complex minerals including carnotite and vanadinite" synonym=vanadium synonym="atomic number 23" is_a="metallic element" core.source="wordnet 3.1"
@k.words.v.noun.3 k.words.sense word=V pos=noun n=3 gloss="the cardinal number that is the sum of four and one" synonym=five synonym=5 synonym=cinque synonym=quint synonym=quintet synonym=fivesome synonym=quintuplet synonym=pentad synonym=fin synonym=Phoebe synonym="Little Phoebe" is_a=digit core.source="wordnet 3.1"
@k.words.v.spelling.V core.word text=v means=V of=k.words.sense.word core.source="wordnet 3.1"
