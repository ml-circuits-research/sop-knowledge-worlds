@k.words.ultrasound.noun.1 k.words.sense word=ultrasound pos=noun n=1 gloss="very high frequency sound; used in ultrasonography" is_a=sound core.source="wordnet 3.1"
@k.words.ultrasound.noun.2 k.words.sense word=ultrasound pos=noun n=2 gloss="using the reflections of high-frequency sound waves to construct an image of a body organ (a sonogram); commonly used to observe fetal growth or study bodily organs" synonym=sonography synonym=ultrasonography synonym=echography is_a=imaging is_a="prenatal diagnosis" core.source="wordnet 3.1"
