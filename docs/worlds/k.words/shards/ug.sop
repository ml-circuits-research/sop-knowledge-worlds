# k.words/shards/ug: senses of the words from "ugly" to "ugly" (first letters "ug").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.ugly.adjective.1 k.words.sense word=ugly pos=adjective n=1 supersense=adj.all gloss="displeasing to the senses" opposite=beautiful core.source="wordnet 3.1"
@k.words.ugly.adjective.2 k.words.sense word=ugly pos=adjective n=2 supersense=adj.all gloss="inclined to anger or bad feelings with overtones of menace" synonym=surly near_opposite=good-natured core.source="wordnet 3.1"
@k.words.ugly.adjective.3 k.words.sense word=ugly pos=adjective n=3 supersense=adj.all gloss="morally reprehensible" synonym=despicable synonym=vile synonym=slimy synonym=unworthy synonym=worthless synonym=wretched near_opposite=good core.source="wordnet 3.1"
@k.words.ugly.forms core.word text=uglier text=ugliest means=ugly of=k.words.sense.word core.source="wordnet 3.1"
