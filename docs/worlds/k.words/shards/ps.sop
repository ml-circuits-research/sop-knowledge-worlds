@k.words.psychiatrist.noun.1 k.words.sense word=psychiatrist pos=noun n=1 gloss="a physician who specializes in psychiatry" synonym=head-shrinker synonym=shrink is_a=specialist core.source="wordnet 3.1"
@k.words.psychiatry.noun.1 k.words.sense word=psychiatry pos=noun n=1 gloss="the branch of medicine dealing with the diagnosis and treatment of mental disorders" synonym=psychopathology synonym="psychological medicine" is_a=medicine core.source="wordnet 3.1"
@k.words.psychic.noun.1 k.words.sense word=psychic pos=noun n=1 gloss="a person apparently sensitive to things beyond the natural range of perception" is_a=occultist core.source="wordnet 3.1"
@k.words.psycho.noun.1 k.words.sense word=psycho pos=noun n=1 gloss="a person afflicted with psychosis" synonym=psychotic synonym="psychotic person" is_a="sick person" core.source="wordnet 3.1"
@k.words.psychologist.noun.1 k.words.sense word=psychologist pos=noun n=1 gloss="a scientist trained in psychology" is_a=scientist core.source="wordnet 3.1"
@k.words.psychology.noun.1 k.words.sense word=psychology pos=noun n=1 gloss="the science of mental life" synonym="psychological science" is_a=science core.source="wordnet 3.1"
@k.words.psychopath.noun.1 k.words.sense word=psychopath pos=noun n=1 gloss="someone with a sociopathic personality; a person with an antisocial personality disorder (`psychopath' was once widely used but has now been superseded by `sociopath')" synonym=sociopath is_a=neurotic core.source="wordnet 3.1"
@k.words.psychosis.noun.1 k.words.sense word=psychosis pos=noun n=1 gloss="any severe mental disorder in which contact with reality is lost or highly distorted" is_a="mental illness" core.source="wordnet 3.1"
