@k.words.psyche.noun.1 k.words.sense word=psyche pos=noun n=1 gloss="that which is responsible for one's thoughts, feelings, and conscious brain functions; the seat of the faculty of reason" synonym=mind synonym=head synonym=brain synonym=nous is_a=cognition core.source="wordnet 3.1"
@k.words.psyche.noun.2 k.words.sense word=psyche pos=noun n=2 gloss="the immaterial part of a person; the actuating cause of an individual life" synonym=soul is_a=spirit core.source="wordnet 3.1"
@k.words.psyche.noun.3 k.words.sense word=Psyche pos=noun n=3 gloss="(Greek mythology) a beautiful princess loved by Cupid who visited her at night and told her she must not try to see him; became the personification of the soul" instance_of="mythical being" core.source="wordnet 3.1"
