@k.words.b.noun.1 k.words.sense word=B pos=noun n=1 gloss="aerobic rod-shaped spore-producing bacterium; often occurring in chainlike formations; found primarily in soil" synonym=bacillus is_a=eubacteria core.source="wordnet 3.1"
@k.words.b.noun.2 k.words.sense word=B pos=noun n=2 gloss="originally thought to be a single vitamin but now separated into several B vitamins" synonym="B-complex vitamin" synonym="B complex" synonym="vitamin B complex" synonym="vitamin B" synonym="B vitamin" is_a="water-soluble vitamin" core.source="wordnet 3.1"
@k.words.b.noun.3 k.words.sense word=B pos=noun n=3 gloss="a trivalent metalloid element; occurs both in a hard black crystal and in the form of a yellow or brown powder" synonym=boron synonym="atomic number 5" is_a="chemical element" core.source="wordnet 3.1"
@k.words.b.spelling.B core.word text=b means=B of=k.words.sense.word core.source="wordnet 3.1"
