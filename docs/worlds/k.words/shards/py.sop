# k.words/shards/py: noun and verb senses of the words from "pyramid" to "python" (first letters "py").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.pyramid.noun.1 k.words.sense word=pyramid pos=noun n=1 gloss="a polyhedron having a polygonal base and triangular sides with a common vertex" is_a=polyhedron core.source="wordnet 3.1"
@k.words.pyramid.noun.2 k.words.sense word=pyramid pos=noun n=2 gloss="(stock market) a series of transactions in which the speculator increases his holdings by using the rising market value of those holdings as margin for further purchases" is_a=speculation core.source="wordnet 3.1"
@k.words.pyramid.noun.3 k.words.sense word=Pyramid pos=noun n=3 gloss="a massive monument with a square base and four triangular sides; begun by Cheops around 2700 BC as royal tombs in ancient Egypt" synonym="Great Pyramid" synonym="Pyramids of Egypt" instance_of=memorial core.source="wordnet 3.1"
@k.words.pyramid.verb.1 k.words.sense word=pyramid pos=verb n=1 gloss="enlarge one's holdings on an exchange on a continued rise by using paper profits as margin to buy additional amounts" is_a=profit core.source="wordnet 3.1"
@k.words.pyramid.verb.2 k.words.sense word=pyramid pos=verb n=2 gloss="use or deal in (as of stock or commercial transaction) in a pyramid deal" is_a=deal core.source="wordnet 3.1"
@k.words.pyramid.verb.3 k.words.sense word=pyramid pos=verb n=3 gloss="arrange or build up as if on the base of a pyramid" is_a=arrange core.source="wordnet 3.1"
@k.words.pyramid.spelling.Pyramid core.word text=pyramid means=Pyramid of=k.words.sense.word core.source="wordnet 3.1"
@k.words.python.noun.1 k.words.sense word=python pos=noun n=1 gloss="large Old World boas" is_a=boa core.source="wordnet 3.1"
@k.words.python.noun.2 k.words.sense word=python pos=noun n=2 gloss="a soothsaying spirit or a person who is possessed by such a spirit" is_a=spirit core.source="wordnet 3.1"
@k.words.python.noun.3 k.words.sense word=Python pos=noun n=3 gloss="(Greek mythology) dragon killed by Apollo at Delphi" instance_of="mythical monster" core.source="wordnet 3.1"
@k.words.python.spelling.Python core.word text=python means=Python of=k.words.sense.word core.source="wordnet 3.1"
