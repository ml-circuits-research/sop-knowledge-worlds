@k.words.bypass.noun.1 k.words.sense word=bypass pos=noun n=1 gloss="a highway that encircles an urban area so that traffic does not have to pass through the center" synonym=beltway synonym="ring road" synonym=ringway is_a=highway core.source="wordnet 3.1"
@k.words.bypass.noun.2 k.words.sense word=bypass pos=noun n=2 gloss="a surgically created shunt (usually around a damaged part)" is_a=shunt core.source="wordnet 3.1"
@k.words.bypass.noun.3 k.words.sense word=bypass pos=noun n=3 gloss="a conductor having low resistance in parallel with another device to divert a fraction of the current" synonym=shunt synonym="electrical shunt" is_a=conductor part_of=circuit core.source="wordnet 3.1"
@k.words.bypass.verb.1 k.words.sense word=bypass pos=verb n=1 gloss="avoid something unpleasant or laborious" synonym=short-circuit synonym="go around" synonym="get around" is_a=avoid core.source="wordnet 3.1"
@k.words.bypass.forms core.word text=bypast means=bypass of=k.words.sense.word core.source="wordnet 3.1"
