@k.words.owe.verb.1 k.words.sense word=owe pos=verb n=1 gloss="be obliged to pay or repay" core.source="wordnet 3.1"
@k.words.owe.verb.2 k.words.sense word=owe pos=verb n=2 gloss="be indebted to, in an abstract or intellectual sense" is_a="repose on" core.source="wordnet 3.1"
