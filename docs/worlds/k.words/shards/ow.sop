@k.words.owens.spelling.Owens core.word text=owens means=Owens of=k.words.sense.word core.source="wordnet 3.1"
@k.words.owl.noun.1 k.words.sense word=owl pos=noun n=1 gloss="nocturnal bird of prey with hawk-like beak and claws and large head with front-facing eyes" synonym="bird of Minerva" synonym="bird of night" synonym=hooter is_a="bird of prey" core.source="wordnet 3.1"
@k.words.own.verb.1 k.words.sense word=own pos=verb n=1 gloss="have ownership or possession of" synonym=have synonym=possess core.source="wordnet 3.1"
@k.words.owner.noun.1 k.words.sense word=owner pos=noun n=1 gloss="(law) someone who owns (is legal possessor of) a business" synonym=proprietor is_a=businessman core.source="wordnet 3.1"
@k.words.owner.noun.2 k.words.sense word=owner pos=noun n=2 gloss="a person who owns something" synonym=possessor is_a=person core.source="wordnet 3.1"
@k.words.ownership.noun.1 k.words.sense word=ownership pos=noun n=1 gloss="the relation of an owner to the thing possessed; possession with the right to transfer possession to others" is_a=relation core.source="wordnet 3.1"
@k.words.ownership.noun.2 k.words.sense word=ownership pos=noun n=2 gloss="the act of having and controlling property" synonym=possession is_a=control core.source="wordnet 3.1"
@k.words.ownership.noun.3 k.words.sense word=ownership pos=noun n=3 gloss="the state or fact of being an owner" is_a=state core.source="wordnet 3.1"
