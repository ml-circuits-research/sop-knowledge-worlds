@k.words.owen.noun.1 k.words.sense word=Owen pos=noun n=1 gloss="Welsh industrialist and social reformer who founded cooperative communities (1771-1858)" synonym="Robert Owen" instance_of=industrialist instance_of=reformer core.source="wordnet 3.1"
@k.words.owen.noun.2 k.words.sense word=Owen pos=noun n=2 gloss="English comparative anatomist and paleontologist who was an opponent of Darwinism (1804-1892)" synonym="Sir Richard Owen" instance_of=paleontologist instance_of="comparative anatomist" core.source="wordnet 3.1"
@k.words.owen.spelling.Owen core.word text=owen means=Owen of=k.words.sense.word core.source="wordnet 3.1"
