@k.words.rhodes.noun.1 k.words.sense word=Rhodes pos=noun n=1 gloss="British colonial financier and statesman in South Africa; made a fortune in gold and diamond mining; helped colonize the territory now known as Zimbabwe; he endowed annual fellowships for British Commonwealth and United States students to study at Oxford University (1853-1902)" synonym="Cecil Rhodes" synonym="Cecil J. Rhodes" synonym="Cecil John Rhodes" instance_of=financier instance_of=colonizer core.source="wordnet 3.1"
@k.words.rhodes.noun.2 k.words.sense word=Rhodes pos=noun n=2 gloss="a Greek island in the southeast Aegean Sea 10 miles off the Turkish coast; the largest of the Dodecanese; it was colonized before 1000 BC by Dorians from Argos; site of the Colossus of Rhodes" synonym=Rodhos instance_of="Aegean island" part_of=Dodecanese part_of=Greece core.source="wordnet 3.1"
