@k.words.gnome.noun.1 k.words.sense word=gnome pos=noun n=1 gloss="a legendary creature resembling a tiny old man; lives in the depths of the earth and guards buried treasure" synonym=dwarf is_a=fairy core.source="wordnet 3.1"
@k.words.gnome.noun.2 k.words.sense word=gnome pos=noun n=2 gloss="a short pithy saying expressing a general truth" is_a=maxim core.source="wordnet 3.1"
