@k.words.hysteria.noun.1 k.words.sense word=hysteria pos=noun n=1 supersense=noun.state gloss="state of violent mental agitation" synonym=craze synonym=delirium synonym=frenzy synonym=fury is_a=mania core.source="wordnet 3.1"
@k.words.hysteria.noun.2 k.words.sense word=hysteria pos=noun n=2 supersense=noun.feeling gloss="excessive or uncontrollable fear" is_a=fear core.source="wordnet 3.1"
