@k.words.hydrant.noun.1 k.words.sense word=hydrant pos=noun n=1 supersense=noun.artifact gloss="a faucet for drawing water from a pipe or cask" synonym="water faucet" synonym="water tap" synonym=tap is_a=faucet is_a="plumbing fixture" kind_of=faucet kind_of=regulator kind_of=control kind_of=mechanism kind_of=device kind_of=instrumentality kind_of=artifact kind_of=whole kind_of=object kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
