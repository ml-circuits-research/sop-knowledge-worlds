# k.words/shards/d: noun and verb senses of the words from "d" to "d" (first letters "d").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.d.noun.1 k.words.sense word=D pos=noun n=1 gloss="a fat-soluble vitamin that prevents rickets" synonym="vitamin D" synonym=calciferol synonym=viosterol synonym=ergocalciferol synonym=cholecalciferol is_a="fat-soluble vitamin" core.source="wordnet 3.1"
@k.words.d.noun.2 k.words.sense word=D pos=noun n=2 gloss="the cardinal number that is the product of one hundred and five" synonym="five hundred" synonym=500 is_a="large integer" core.source="wordnet 3.1"
@k.words.d.noun.3 k.words.sense word=D pos=noun n=3 gloss="the 4th letter of the Roman alphabet" synonym=d is_a=letter core.source="wordnet 3.1"
@k.words.d.spelling.D core.word text=d means=D of=k.words.sense.word core.source="wordnet 3.1"
