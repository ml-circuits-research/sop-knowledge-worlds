@k.words.alter.verb.1 k.words.sense word=alter pos=verb n=1 gloss="cause to change; make different; cause a transformation" synonym=change synonym=modify core.source="wordnet 3.1"
@k.words.alter.verb.2 k.words.sense word=alter pos=verb n=2 gloss="become different in some particular way, without permanently losing one's or its former characteristics or essence" synonym=change synonym=vary core.source="wordnet 3.1"
@k.words.alter.verb.3 k.words.sense word=alter pos=verb n=3 gloss="make an alteration to" is_a=change core.source="wordnet 3.1"
@k.words.altercation.noun.1 k.words.sense word=altercation pos=noun n=1 gloss="noisy quarrel" synonym=affray synonym=fracas is_a=quarrel core.source="wordnet 3.1"
@k.words.alternate.noun.1 k.words.sense word=alternate pos=noun n=1 gloss="someone who takes the place of another person" synonym=surrogate synonym=replacement is_a=stand-in core.source="wordnet 3.1"
@k.words.alternate.verb.1 k.words.sense word=alternate pos=verb n=1 gloss="go back and forth; swing back and forth between two states or conditions" synonym=jump is_a=change core.source="wordnet 3.1"
@k.words.alternate.verb.2 k.words.sense word=alternate pos=verb n=2 gloss="exchange people temporarily to fulfill certain jobs and functions" is_a=exchange core.source="wordnet 3.1"
@k.words.alternate.verb.3 k.words.sense word=alternate pos=verb n=3 gloss="be an understudy or alternate for a role" synonym=understudy is_a=memorize core.source="wordnet 3.1"
@k.words.alternative.noun.1 k.words.sense word=alternative pos=noun n=1 gloss="one of a number of things from which only one can be chosen" synonym=option synonym=choice is_a="decision making" core.source="wordnet 3.1"
@k.words.altitude.noun.1 k.words.sense word=altitude pos=noun n=1 gloss="elevation especially above sea level or above the earth's surface" synonym=height is_a=elevation core.source="wordnet 3.1"
@k.words.altitude.noun.2 k.words.sense word=altitude pos=noun n=2 gloss="the perpendicular distance from the base of a geometric figure to the opposite vertex (or side if parallel)" is_a=distance core.source="wordnet 3.1"
@k.words.altitude.noun.3 k.words.sense word=altitude pos=noun n=3 gloss="angular distance above the horizon (especially of a celestial object)" synonym=elevation synonym=EL synonym=ALT is_a="angular position" core.source="wordnet 3.1"
@k.words.altogether.noun.1 k.words.sense word=altogether pos=noun n=1 gloss="informal terms for nakedness" synonym=raw synonym="birthday suit" is_a=nakedness core.source="wordnet 3.1"
