@k.words.ottoman.noun.1 k.words.sense word=Ottoman pos=noun n=1 gloss="a Turk (especially a Turk who is a member of the tribe of Osman I)" synonym="Ottoman Turk" synonym=Osmanli is_a=Turk core.source="wordnet 3.1"
@k.words.ottoman.noun.2 k.words.sense word=Ottoman pos=noun n=2 gloss="the Turkish dynasty that ruled the Ottoman Empire from the 13th century to its dissolution after World War I" synonym="Ottoman dynasty" is_a=dynasty core.source="wordnet 3.1"
