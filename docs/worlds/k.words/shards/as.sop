@k.words.assumption.noun.3 k.words.sense word=assumption pos=noun n=3 gloss="the act of taking possession of or power over something" synonym="laying claim" is_a=acquisition core.source="wordnet 3.1"
@k.words.assurance.noun.1 k.words.sense word=assurance pos=noun n=1 gloss="freedom from doubt; belief in yourself and your abilities" synonym=self-assurance synonym=confidence synonym=self-confidence synonym=authority synonym=sureness is_a=certainty core.source="wordnet 3.1"
@k.words.assurance.noun.2 k.words.sense word=assurance pos=noun n=2 gloss="a binding commitment to do or give or refrain from something" synonym=pledge is_a=commitment core.source="wordnet 3.1"
@k.words.assurance.noun.3 k.words.sense word=assurance pos=noun n=3 gloss="a statement intended to inspire confidence" is_a=statement core.source="wordnet 3.1"
@k.words.assure.verb.1 k.words.sense word=assure pos=verb n=1 gloss="make certain of" synonym=guarantee synonym=ensure synonym=insure synonym=secure core.source="wordnet 3.1"
@k.words.assure.verb.2 k.words.sense word=assure pos=verb n=2 gloss="inform positively and with certainty and confidence" synonym=tell is_a=affirm kind_of=affirm kind_of=declare kind_of=state kind_of=express core.source="wordnet 3.1"
@k.words.assure.verb.3 k.words.sense word=assure pos=verb n=3 gloss="assure somebody of the truth of something with the intention of giving the listener confidence" is_a=persuade kind_of=persuade kind_of=induce core.source="wordnet 3.1"
@k.words.asteroid.noun.1 k.words.sense word=asteroid pos=noun n=1 gloss="any of numerous small celestial bodies composed of rock and metal that move around the sun (mainly between the orbits of Mars and Jupiter)" is_a="minor planet" kind_of="minor planet" kind_of="celestial body" kind_of="natural object" kind_of=whole kind_of=object kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.asteroid.adjective.1 k.words.sense word=asteroid pos=adjective n=1 gloss="shaped like a star" synonym=star-shaped near_opposite=rounded core.source="wordnet 3.1"
@k.words.asthma.noun.1 k.words.sense word=asthma pos=noun n=1 gloss="respiratory disorder characterized by wheezing; usually of allergic origin" synonym="asthma attack" synonym="bronchial asthma" is_a="respiratory disease" core.source="wordnet 3.1"
@k.words.astronaut.noun.1 k.words.sense word=astronaut pos=noun n=1 gloss="a person trained to travel in a spacecraft" synonym=spaceman synonym=cosmonaut is_a=traveler core.source="wordnet 3.1"
@k.words.astronomer.noun.1 k.words.sense word=astronomer pos=noun n=1 gloss="a physicist who studies astronomy" synonym=uranologist synonym=stargazer is_a=physicist core.source="wordnet 3.1"
@k.words.astronomy.noun.1 k.words.sense word=astronomy pos=noun n=1 gloss="the branch of physics that studies celestial bodies and the universe as a whole" synonym=uranology is_a=physics core.source="wordnet 3.1"
@k.words.asylum.noun.1 k.words.sense word=asylum pos=noun n=1 gloss="a shelter from danger or hardship" synonym=refuge synonym=sanctuary is_a=shelter core.source="wordnet 3.1"
@k.words.asylum.noun.2 k.words.sense word=asylum pos=noun n=2 gloss="a hospital for mentally incompetent or unbalanced person" synonym="mental hospital" synonym="psychiatric hospital" synonym="mental institution" synonym=institution synonym="mental home" synonym="insane asylum" is_a=hospital core.source="wordnet 3.1"
