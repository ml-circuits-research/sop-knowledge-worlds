@k.words.opposition.noun.2 k.words.sense word=opposition pos=noun n=2 gloss="the relation between opposed entities" synonym=oppositeness is_a=relation core.source="wordnet 3.1"
@k.words.opposition.noun.3 k.words.sense word=opposition pos=noun n=3 gloss="the act of hostile groups opposing each other" synonym=confrontation is_a=resistance core.source="wordnet 3.1"
