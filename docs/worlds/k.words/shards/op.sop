@k.words.opinion.noun.2 k.words.sense word=opinion pos=noun n=2 gloss="a message expressing a belief about something; the expression of a belief that is held with confidence but not substantiated by positive knowledge or proof" synonym=view is_a=message core.source="wordnet 3.1"
@k.words.opinion.noun.3 k.words.sense word=opinion pos=noun n=3 gloss="a belief or sentiment shared by most people; the voice of the people" synonym="public opinion" synonym="popular opinion" synonym="vox populi" is_a=belief core.source="wordnet 3.1"
@k.words.opium.noun.1 k.words.sense word=opium pos=noun n=1 gloss="an addictive narcotic extracted from seed capsules of the opium poppy" is_a=narcotic is_a="controlled substance" core.source="wordnet 3.1"
@k.words.opponent.noun.1 k.words.sense word=opponent pos=noun n=1 gloss="a contestant that you are matched against" synonym=opposition synonym=opposite is_a=contestant core.source="wordnet 3.1"
@k.words.opponent.noun.2 k.words.sense word=opponent pos=noun n=2 gloss="someone who offers opposition" synonym=adversary synonym=antagonist synonym=opposer synonym=resister is_a=person core.source="wordnet 3.1"
