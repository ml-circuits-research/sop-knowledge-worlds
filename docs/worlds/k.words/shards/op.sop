@k.words.operative.noun.1 k.words.sense word=operative pos=noun n=1 gloss="a person secretly employed in espionage for a government" synonym="secret agent" synonym="intelligence officer" synonym="intelligence agent" is_a=agent core.source="wordnet 3.1"
@k.words.operative.noun.2 k.words.sense word=operative pos=noun n=2 gloss="someone who can be employed as a detective to collect information" synonym="private detective" synonym=PI synonym="private eye" synonym="private investigator" synonym=shamus synonym=sherlock is_a=detective core.source="wordnet 3.1"
