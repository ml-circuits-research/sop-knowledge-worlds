@k.words.oppose.verb.3 k.words.sense word=oppose pos=verb n=3 gloss="contrast with equal weight or force" synonym=counterbalance is_a=contrast core.source="wordnet 3.1"
@k.words.opposite.noun.1 k.words.sense word=opposite pos=noun n=1 gloss="a word that expresses a meaning opposed to the meaning of another word, in which case the two words are antonyms of each other" synonym=antonym synonym="opposite word" is_a=word core.source="wordnet 3.1"
@k.words.opposite.noun.2 k.words.sense word=opposite pos=noun n=2 gloss="a relation of direct opposition" synonym=reverse synonym=contrary is_a=opposition core.source="wordnet 3.1"
@k.words.opposite.noun.3 k.words.sense word=opposite pos=noun n=3 gloss="a contestant that you are matched against" synonym=opposition synonym=opponent is_a=contestant core.source="wordnet 3.1"
