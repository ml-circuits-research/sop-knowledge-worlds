# script: tools/import/wordnet.mjs

@k.words.q.noun.1 k.words.sense word=Q pos=noun n=1 gloss="the 17th letter of the Roman alphabet" synonym=q is_a=letter core.source="wordnet 3.1"
@k.words.q.spelling.Q core.word text=q means=Q of=k.words.sense.word core.source="wordnet 3.1"
