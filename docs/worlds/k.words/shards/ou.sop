@k.words.ounce.noun.1 k.words.sense word=ounce pos=noun n=1 gloss="a unit of apothecary weight equal to 480 grains or one twelfth of a troy pound" synonym="troy ounce" synonym="apothecaries' ounce" is_a="apothecaries' unit" is_a="troy unit" part_of="troy pound" core.source="wordnet 3.1"
@k.words.ounce.noun.2 k.words.sense word=ounce pos=noun n=2 gloss="a unit of weight equal to one sixteenth of a pound or 16 drams or 28.349 grams" synonym=oz. is_a="avoirdupois unit" part_of=pound core.source="wordnet 3.1"
@k.words.ounce.noun.3 k.words.sense word=ounce pos=noun n=3 gloss="large feline of upland central Asia having long thick whitish fur" synonym="snow leopard" synonym="Panthera uncia" is_a="big cat" core.source="wordnet 3.1"
