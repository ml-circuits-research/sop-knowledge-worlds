# k.words/shards/ig: noun and verb senses of the words from "ignite" to "ignore" (first letters "ig").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.ignite.verb.1 k.words.sense word=ignite pos=verb n=1 gloss="cause to start burning; subject to fire or great heat" synonym=light is_a=burn core.source="wordnet 3.1"
@k.words.ignite.verb.2 k.words.sense word=ignite pos=verb n=2 gloss="start to burn or burst into flames" synonym=erupt synonym="catch fire" synonym="take fire" synonym=combust synonym=conflagrate is_a="change state" core.source="wordnet 3.1"
@k.words.ignite.verb.3 k.words.sense word=ignite pos=verb n=3 gloss="arouse or excite feelings and passions" synonym=inflame synonym="stir up" synonym=wake synonym=heat synonym="fire up" is_a=arouse core.source="wordnet 3.1"
@k.words.ignition.noun.1 k.words.sense word=ignition pos=noun n=1 gloss="the process of initiating combustion or catching fire" is_a=fire core.source="wordnet 3.1"
@k.words.ignition.noun.2 k.words.sense word=ignition pos=noun n=2 gloss="the mechanism that ignites the fuel in an internal-combustion engine" synonym="ignition system" is_a=mechanism part_of="electrical system" core.source="wordnet 3.1"
@k.words.ignition.noun.3 k.words.sense word=ignition pos=noun n=3 gloss="the act of setting something on fire" synonym=firing synonym=lighting synonym=kindling synonym=inflammation is_a=burning core.source="wordnet 3.1"
@k.words.ignorance.noun.1 k.words.sense word=ignorance pos=noun n=1 gloss="the lack of knowledge or education" is_a=content core.source="wordnet 3.1"
@k.words.ignore.verb.1 k.words.sense word=ignore pos=verb n=1 gloss="refuse to acknowledge" synonym=disregard synonym=snub synonym=cut is_a=treat core.source="wordnet 3.1"
@k.words.ignore.verb.2 k.words.sense word=ignore pos=verb n=2 gloss="bar from attention or consideration" synonym=dismiss synonym=disregard synonym="brush aside" synonym="brush off" synonym=discount synonym="push aside" is_a=reject core.source="wordnet 3.1"
@k.words.ignore.verb.3 k.words.sense word=ignore pos=verb n=3 gloss="fail to notice" core.source="wordnet 3.1"
