@k.words.e.noun.1 k.words.sense word=E pos=noun n=1 gloss="a fat-soluble vitamin that is essential for normal reproduction; an important antioxidant that neutralizes free radicals in the body" synonym="vitamin E" synonym=tocopherol is_a="fat-soluble vitamin" is_a=antioxidant core.source="wordnet 3.1"
@k.words.e.noun.2 k.words.sense word=E pos=noun n=2 gloss="a radioactive transuranic element produced by bombarding plutonium with neutrons" synonym=einsteinium synonym=Es synonym="atomic number 99" is_a="metallic element" core.source="wordnet 3.1"
@k.words.e.noun.3 k.words.sense word=E pos=noun n=3 gloss="the cardinal compass point that is at 90 degrees" synonym=east synonym="due east" synonym=eastward is_a="cardinal compass point" core.source="wordnet 3.1"
@k.words.e.spelling.E core.word text=e means=E of=k.words.sense.word core.source="wordnet 3.1"
@k.words.e-mail.noun.1 k.words.sense word=e-mail pos=noun n=1 gloss="(computer science) a system of world-wide electronic communication in which a computer user can compose a message at one terminal that can be regenerated at the recipient's terminal when the recipient logs in" synonym="electronic mail" synonym=email is_a="electronic communication" core.source="wordnet 3.1"
@k.words.e-mail.verb.1 k.words.sense word=e-mail pos=verb n=1 gloss="communicate electronically on the computer" synonym=email synonym=netmail is_a=telecommunicate core.source="wordnet 3.1"
