@k.words.entourage.noun.1 k.words.sense word=entourage pos=noun n=1 gloss="the group following and attending to some important person" synonym=cortege synonym=retinue synonym=suite is_a=gathering core.source="wordnet 3.1"
@k.words.entrance.noun.1 k.words.sense word=entrance pos=noun n=1 gloss="something that provides access (to get in or get out)" synonym=entranceway synonym=entryway synonym=entry synonym=entree is_a=access core.source="wordnet 3.1"
@k.words.entrance.noun.2 k.words.sense word=entrance pos=noun n=2 gloss="a movement into or inward" synonym=entering is_a="change of location" core.source="wordnet 3.1"
