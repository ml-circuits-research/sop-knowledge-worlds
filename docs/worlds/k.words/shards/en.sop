@k.words.entrust.verb.1 k.words.sense word=entrust pos=verb n=1 gloss="confer a trust upon" synonym=intrust synonym=trust synonym=confide synonym=commit is_a=pass core.source="wordnet 3.1"
@k.words.entrust.verb.2 k.words.sense word=entrust pos=verb n=2 gloss="put into the care or protection of someone" synonym=leave is_a=pass core.source="wordnet 3.1"
