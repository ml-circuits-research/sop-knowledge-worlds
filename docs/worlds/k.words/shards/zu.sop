@k.words.zulu.noun.1 k.words.sense word=Zulu pos=noun n=1 gloss="a member of the tall Negroid people of eastern South Africa; some live in KwaZulu-Natal under the traditional clan system but many now work in the cities" is_a=African core.source="wordnet 3.1"
@k.words.zulu.noun.2 k.words.sense word=Zulu pos=noun n=2 gloss="a community of Negroid people in eastern South Africa" instance_of=community core.source="wordnet 3.1"
@k.words.zulu.noun.3 k.words.sense word=Zulu pos=noun n=3 gloss="a Bantu language of considerable literary importance in southeastern Africa" is_a=Nguni core.source="wordnet 3.1"
