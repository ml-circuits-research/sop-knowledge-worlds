@k.words.years.noun.1 k.words.sense word=years pos=noun n=1 gloss="a late time of life" synonym="old age" synonym=age synonym=eld synonym=geezerhood is_a="time of life" core.source="wordnet 3.1"
@k.words.years.noun.2 k.words.sense word=years pos=noun n=2 gloss="a prolonged period of time" synonym="long time" synonym=age is_a="time period" core.source="wordnet 3.1"
@k.words.years.noun.3 k.words.sense word=years pos=noun n=3 gloss="the time during which someone's life continues" synonym=days is_a=life core.source="wordnet 3.1"
@k.words.yeast.noun.1 k.words.sense word=yeast pos=noun n=1 gloss="a commercial leavening agent containing yeast cells; used to raise the dough in making bread and for fermenting beer or whiskey" synonym=barm is_a=leaven core.source="wordnet 3.1"
@k.words.yeast.noun.2 k.words.sense word=yeast pos=noun n=2 gloss="any of various single-celled fungi that reproduce asexually by budding or division" is_a=fungus core.source="wordnet 3.1"
@k.words.yell.noun.1 k.words.sense word=yell pos=noun n=1 gloss="a loud utterance; often in protest or opposition" synonym=cry synonym=outcry synonym=call synonym=shout synonym=vociferation is_a=utterance core.source="wordnet 3.1"
@k.words.yell.noun.2 k.words.sense word=yell pos=noun n=2 gloss="a loud utterance of emotion (especially when inarticulate)" synonym=cry is_a=utterance core.source="wordnet 3.1"
@k.words.yell.verb.1 k.words.sense word=yell pos=verb n=1 gloss="utter a sudden loud cry" synonym=shout synonym="shout out" synonym=cry synonym=call synonym=scream synonym=holler synonym=hollo synonym=squall is_a=utter core.source="wordnet 3.1"
@k.words.yell.verb.2 k.words.sense word=yell pos=verb n=2 gloss="utter or declare in a very loud voice" synonym=scream is_a=shout core.source="wordnet 3.1"
@k.words.yelling.noun.1 k.words.sense word=yelling pos=noun n=1 gloss="uttering a loud inarticulate cry as of pain or excitement" synonym=shouting is_a=cry core.source="wordnet 3.1"
