@k.words.year.noun.1 k.words.sense word=year pos=noun n=1 gloss="a period of time containing 365 (or 366) days" synonym=twelvemonth synonym=yr is_a="time period" part_of=decade core.source="wordnet 3.1"
@k.words.year.noun.2 k.words.sense word=year pos=noun n=2 gloss="a period of time occupying a regular part of a calendar year that is used for some particular activity" is_a="time period" core.source="wordnet 3.1"
@k.words.year.noun.3 k.words.sense word=year pos=noun n=3 gloss="the period of time that it takes for a planet (as, e.g., Earth or Mars) to make a complete revolution around the sun" is_a="time period" core.source="wordnet 3.1"
@k.words.yearbook.noun.1 k.words.sense word=yearbook pos=noun n=1 gloss="a book published annually by the graduating class of a high school or college usually containing photographs of faculty and graduating students" is_a=book core.source="wordnet 3.1"
@k.words.yearbook.noun.2 k.words.sense word=yearbook pos=noun n=2 gloss="a reference book that is published regularly once every year" synonym=annual synonym=yearly is_a="reference book" core.source="wordnet 3.1"
@k.words.yearn.verb.1 k.words.sense word=yearn pos=verb n=1 gloss="desire strongly or persistently" synonym=hanker synonym=long is_a=desire core.source="wordnet 3.1"
@k.words.yearn.verb.2 k.words.sense word=yearn pos=verb n=2 gloss="have a desire for something or someone who is not present" synonym=ache synonym=yen synonym=pine synonym=languish is_a=hanker core.source="wordnet 3.1"
@k.words.yearn.verb.3 k.words.sense word=yearn pos=verb n=3 gloss="have affection for; feel tenderness for" is_a="care for" core.source="wordnet 3.1"
