# k.words/shards/s: noun and verb senses of the words from "s" to "s" (first letters "s").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.s.noun.1 k.words.sense word=s pos=noun n=1 gloss="1/60 of a minute; the basic unit of time adopted under the Systeme International d'Unites" synonym=second synonym=sec is_a="time unit" part_of=minute core.source="wordnet 3.1"
@k.words.s.noun.2 k.words.sense word=S pos=noun n=2 gloss="an abundant tasteless odorless multivalent nonmetallic element; best known in yellow crystals; occurs in many sulphide and sulphate minerals and even in native form (especially in volcanic regions)" synonym=sulfur synonym=sulphur synonym="atomic number 16" is_a="chemical element" core.source="wordnet 3.1"
@k.words.s.noun.3 k.words.sense word=S pos=noun n=3 gloss="the cardinal compass point that is at 180 degrees" synonym=south synonym="due south" synonym=southward is_a="cardinal compass point" core.source="wordnet 3.1"
@k.words.s.spelling.S core.word text=s means=S of=k.words.sense.word core.source="wordnet 3.1"
