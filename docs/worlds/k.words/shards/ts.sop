# k.words/shards/ts: noun and verb senses of the words from "tsar" to "tsunami" (first letters "ts").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.tsar.noun.1 k.words.sense word=tsar pos=noun n=1 gloss="a male monarch or emperor (especially of Russia prior to 1917)" synonym=czar synonym=tzar is_a=sovereign core.source="wordnet 3.1"
@k.words.tsk.verb.1 k.words.sense word=tsk pos=verb n=1 gloss="utter `tsk,' `tut,' or `tut-tut,' as in disapproval" synonym=tut synonym=tut-tut is_a=utter core.source="wordnet 3.1"
@k.words.tsunami.noun.1 k.words.sense word=tsunami pos=noun n=1 gloss="a cataclysm resulting from a destructive sea wave caused by an earthquake or volcanic eruption" is_a=calamity is_a=wave core.source="wordnet 3.1"
