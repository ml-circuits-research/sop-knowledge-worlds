@k.words.equal.noun.1 k.words.sense word=equal pos=noun n=1 gloss="a person who is of equal standing with another in a group" synonym=peer synonym=match synonym=compeer is_a=person core.source="wordnet 3.1"
@k.words.equal.verb.1 k.words.sense word=equal pos=verb n=1 gloss="be identical or equivalent to" synonym=be core.source="wordnet 3.1"
@k.words.equal.verb.2 k.words.sense word=equal pos=verb n=2 gloss="be equal to in quality or ability" synonym=touch synonym=rival synonym=match is_a=compete core.source="wordnet 3.1"
@k.words.equal.verb.3 k.words.sense word=equal pos=verb n=3 gloss="make equal, uniform, corresponding, or matching" synonym=match synonym=equalize synonym=equalise synonym=equate is_a=change core.source="wordnet 3.1"
@k.words.equal.forms core.word text=equalled text=equalling means=equal of=k.words.sense.word core.source="wordnet 3.1"
@k.words.equality.noun.1 k.words.sense word=equality pos=noun n=1 gloss="the quality of being the same in quantity or measure or value or status" is_a=sameness core.source="wordnet 3.1"
@k.words.equality.noun.2 k.words.sense word=equality pos=noun n=2 gloss="a state of being essentially equal or equivalent; equally balanced" synonym=equivalence synonym=equation synonym=par is_a=status core.source="wordnet 3.1"
@k.words.equation.noun.1 k.words.sense word=equation pos=noun n=1 gloss="a mathematical statement that two expressions are equal" is_a="mathematical statement" core.source="wordnet 3.1"
@k.words.equation.noun.2 k.words.sense word=equation pos=noun n=2 gloss="a state of being essentially equal or equivalent; equally balanced" synonym=equality synonym=equivalence synonym=par is_a=status core.source="wordnet 3.1"
@k.words.equation.noun.3 k.words.sense word=equation pos=noun n=3 gloss="the act of regarding as equal" synonym=equating is_a=equalization core.source="wordnet 3.1"
@k.words.equator.noun.1 k.words.sense word=equator pos=noun n=1 gloss="an imaginary line around the Earth forming the great circle that is equidistant from the north and south poles" is_a="great circle" core.source="wordnet 3.1"
@k.words.equator.noun.2 k.words.sense word=equator pos=noun n=2 gloss="a circle dividing a sphere or other surface into two usually equal and symmetrical parts" is_a=circle core.source="wordnet 3.1"
@k.words.equipment.noun.1 k.words.sense word=equipment pos=noun n=1 gloss="an instrumentality needed for an undertaking or to perform a service" is_a=instrumentality core.source="wordnet 3.1"
@k.words.equity.noun.1 k.words.sense word=equity pos=noun n=1 gloss="the difference between the market value of a property and the claims held against it" is_a=assets core.source="wordnet 3.1"
@k.words.equity.noun.2 k.words.sense word=equity pos=noun n=2 gloss="the ownership interest of shareholders in a corporation" is_a=interest core.source="wordnet 3.1"
@k.words.equity.noun.3 k.words.sense word=equity pos=noun n=3 gloss="conformity with rules or standards" synonym=fairness is_a=justice core.source="wordnet 3.1"
@k.words.equivalent.noun.1 k.words.sense word=equivalent pos=noun n=1 gloss="a person or thing equal to another in value or measure or force or effect or significance etc" is_a=cognition core.source="wordnet 3.1"
@k.words.equivalent.noun.2 k.words.sense word=equivalent pos=noun n=2 gloss="the atomic weight of an element that has the same combining capacity as a given weight of another element; the standard is 8 for oxygen" synonym="equivalent weight" synonym="combining weight" synonym=eq is_a="atomic mass" core.source="wordnet 3.1"
