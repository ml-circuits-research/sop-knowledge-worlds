@k.words.ss.noun.1 k.words.sense word=SS pos=noun n=1 supersense=noun.group gloss="the United States intelligence agency that protects current and former presidents and vice presidents and their immediate families and protects distinguished foreign visitors; detects and apprehends counterfeiters; suppresses forgery of government securities and documents" synonym="United States Secret Service" synonym="US Secret Service" synonym=USSS synonym="Secret Service" is_a="United States intelligence agency" part_of="Department of Homeland Security" core.source="wordnet 3.1"
@k.words.ss.noun.2 k.words.sense word=SS pos=noun n=2 supersense=noun.group gloss="special police force in Nazi Germany founded as a personal bodyguard for Adolf Hitler in 1925; the SS administered the concentration camps" synonym=Schutzstaffel is_a=police core.source="wordnet 3.1"
@k.words.ss.spelling.SS core.word text=ss means=SS of=k.words.sense.word core.source="wordnet 3.1"
