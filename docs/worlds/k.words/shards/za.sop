@k.words.zap.noun.1 k.words.sense word=zap pos=noun n=1 gloss="a sudden event that imparts energy or excitement, usually with a dramatic impact" is_a=event core.source="wordnet 3.1"
@k.words.zap.verb.1 k.words.sense word=zap pos=verb n=1 gloss="strike suddenly and with force" is_a=affect core.source="wordnet 3.1"
@k.words.zap.verb.2 k.words.sense word=zap pos=verb n=2 gloss="kill with or as if with a burst of gunfire or electric current or as if by shooting" synonym=vaporize is_a=kill core.source="wordnet 3.1"
@k.words.zap.verb.3 k.words.sense word=zap pos=verb n=3 gloss="strike at with firepower or bombs" synonym=nuke synonym=atomize synonym=atomise is_a=bombard core.source="wordnet 3.1"
@k.words.zap.forms core.word text=zapped text=zapping means=zap of=k.words.sense.word core.source="wordnet 3.1"
