@k.words.iii.noun.1 k.words.sense word=III pos=noun n=1 gloss="the cardinal number that is the sum of one and one and one" synonym=three synonym=3 synonym=trio synonym=threesome synonym=tierce synonym=leash synonym=troika synonym=triad synonym=trine synonym=trinity synonym=ternary synonym=ternion synonym=triplet synonym=tercet synonym=terzetto synonym=trey synonym=deuce-ace is_a=digit core.source="wordnet 3.1"
