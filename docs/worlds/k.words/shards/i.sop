@k.words.i.noun.1 k.words.sense word=I pos=noun n=1 gloss="a nonmetallic element belonging to the halogens; used especially in medicine and photography and in dyes; occurs naturally only in combination in small quantities (as in sea water or rocks)" synonym=iodine synonym=iodin synonym="atomic number 53" is_a="chemical element" is_a=halogen kind_of="chemical element" kind_of=substance kind_of=matter kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.i.noun.2 k.words.sense word=I pos=noun n=2 gloss="the smallest whole number or a numeral representing this number" synonym=one synonym=1 synonym=ace synonym=single synonym=unity is_a=digit kind_of=digit kind_of=integer kind_of=number kind_of="definite quantity" kind_of=measure kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.i.noun.3 k.words.sense word=I pos=noun n=3 gloss="the 9th letter of the Roman alphabet" synonym=i is_a=letter kind_of=letter kind_of=character kind_of="written symbol" kind_of=symbol kind_of=signal kind_of=communication kind_of=abstraction kind_of=entity core.source="wordnet 3.1"
@k.words.i.adjective.1 k.words.sense word=i pos=adjective n=1 gloss="used of a single unit or thing; not two or more" synonym=one synonym=1 synonym=ane near_opposite=ordinal core.source="wordnet 3.1"
