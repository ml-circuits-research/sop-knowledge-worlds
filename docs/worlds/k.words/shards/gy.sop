@k.words.gym.noun.1 k.words.sense word=gym pos=noun n=1 gloss="athletic facility equipped for sports or physical training" synonym=gymnasium is_a="athletic facility" kind_of="athletic facility" kind_of=facility kind_of=artifact kind_of=whole kind_of=object kind_of="physical entity" kind_of=entity core.source="wordnet 3.1"
@k.words.gymnastics.noun.1 k.words.sense word=gymnastics pos=noun n=1 gloss="a sport that involves exercises intended to display strength and balance and agility" synonym="gymnastic exercise" is_a=sport core.source="wordnet 3.1"
@k.words.gynecologist.noun.1 k.words.sense word=gynecologist pos=noun n=1 gloss="a specialist in gynecology" synonym=gynaecologist synonym="woman's doctor" is_a=specialist core.source="wordnet 3.1"
@k.words.gypsy.noun.1 k.words.sense word=gypsy pos=noun n=1 gloss="a laborer who moves from place to place as demanded by employment" synonym=itinerant synonym=gipsy is_a=laborer core.source="wordnet 3.1"
@k.words.gypsy.noun.2 k.words.sense word=Gypsy pos=noun n=2 gloss="a member of a people with dark skin and hair who speak Romany and who traditionally live by seasonal work and fortunetelling; they are believed to have originated in northern India but now are living on all continents (but mostly in Europe, North Africa, and North America)" synonym=Gipsy synonym=Romany synonym=Rommany synonym=Romani synonym=Roma synonym=Bohemian is_a=Indian core.source="wordnet 3.1"
@k.words.gypsy.noun.3 k.words.sense word=gypsy pos=noun n=3 gloss="a person who resembles a Gypsy in leading an unconventional, nomadic way of life" synonym=gipsy is_a=person core.source="wordnet 3.1"
