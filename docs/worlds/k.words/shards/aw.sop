@k.words.awake.verb.1 k.words.sense word=awake pos=verb n=1 gloss="stop sleeping" synonym="wake up" synonym=arouse synonym=awaken synonym=wake synonym="come alive" synonym=waken is_a="change state" core.source="wordnet 3.1"
