@k.words.award.noun.1 k.words.sense word=award pos=noun n=1 gloss="a grant made by a law court" synonym=awarding is_a=grant core.source="wordnet 3.1"
@k.words.award.noun.2 k.words.sense word=award pos=noun n=2 gloss="a tangible symbol signifying approval or distinction" synonym=accolade synonym=honor synonym=honour synonym=laurels is_a=symbol core.source="wordnet 3.1"
@k.words.award.noun.3 k.words.sense word=award pos=noun n=3 gloss="something given for victory or superiority in a contest or competition or for winning a lottery" synonym=prize is_a=gift core.source="wordnet 3.1"
