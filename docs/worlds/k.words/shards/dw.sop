@k.words.dwarf.noun.1 k.words.sense word=dwarf pos=noun n=1 supersense=noun.person gloss="a person who is markedly small" synonym=midget synonym=nanus is_a="small person" core.source="wordnet 3.1"
@k.words.dwarf.noun.2 k.words.sense word=dwarf pos=noun n=2 supersense=noun.person gloss="a legendary creature resembling a tiny old man; lives in the depths of the earth and guards buried treasure" synonym=gnome is_a=fairy core.source="wordnet 3.1"
@k.words.dwarf.noun.3 k.words.sense word=dwarf pos=noun n=3 supersense=noun.Tops gloss="a plant or animal that is atypically small" is_a=organism core.source="wordnet 3.1"
@k.words.dwarf.verb.1 k.words.sense word=dwarf pos=verb n=1 supersense=verb.stative gloss="make appear small by comparison" synonym=shadow synonym=overshadow is_a=dominate core.source="wordnet 3.1"
@k.words.dwarf.verb.2 k.words.sense word=dwarf pos=verb n=2 supersense=verb.social gloss="check the growth of" is_a=stunt core.source="wordnet 3.1"
