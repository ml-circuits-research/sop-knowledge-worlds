@k.words.ira.noun.1 k.words.sense word=IRA pos=noun n=1 gloss="a militant organization of Irish nationalists who used terrorism and guerilla warfare in an effort to drive British forces from Northern Ireland and achieve a united independent Ireland" synonym="Irish Republican Army" synonym="Provisional Irish Republican Army" synonym="Provisional IRA" synonym=Provos instance_of="terrorist organization" core.source="wordnet 3.1"
