@k.words.icing.noun.2 k.words.sense word=icing pos=noun n=2 gloss="a flavored sugar topping used to coat and decorate cakes" synonym=frosting synonym=ice is_a=topping core.source="wordnet 3.1"
@k.words.icing.noun.3 k.words.sense word=icing pos=noun n=3 gloss="(ice hockey) the act of shooting the puck from within your own defensive area the length of the rink beyond the opponent's goal" synonym="icing the puck" is_a=maneuver core.source="wordnet 3.1"
@k.words.icon.noun.1 k.words.sense word=icon pos=noun n=1 gloss="(computer science) a graphic symbol (usually a simple picture) that denotes a program or a command or a data file or a concept in a graphical user interface" is_a=symbol part_of="graphical user interface" core.source="wordnet 3.1"
@k.words.icon.noun.2 k.words.sense word=icon pos=noun n=2 gloss="a visual representation (of an object or scene or person or abstraction) produced on a surface" synonym=picture synonym=image synonym=ikon is_a=representation core.source="wordnet 3.1"
@k.words.icon.noun.3 k.words.sense word=icon pos=noun n=3 gloss="a conventional religious painting in oil on a small wooden panel; venerated in the Eastern Church" synonym=ikon is_a=painting core.source="wordnet 3.1"
@k.words.icu.noun.1 k.words.sense word=ICU pos=noun n=1 gloss="a hospital unit staffed and equipped to provide intensive care" synonym="intensive care unit" is_a=unit part_of=hospital core.source="wordnet 3.1"
