@k.words.iceberg.noun.1 k.words.sense word=iceberg pos=noun n=1 gloss="a large mass of ice floating at sea; usually broken off of a polar glacier" synonym=berg is_a="ice mass" is_a=floater core.source="wordnet 3.1"
@k.words.iceberg.noun.2 k.words.sense word=iceberg pos=noun n=2 gloss="lettuce with crisp tightly packed light-green leaves in a firm head" synonym="crisphead lettuce" synonym="iceberg lettuce" is_a=lettuce part_of="head lettuce" core.source="wordnet 3.1"
@k.words.icebox.noun.1 k.words.sense word=icebox pos=noun n=1 gloss="white goods in which food can be stored at low temperatures" synonym=refrigerator is_a="white goods" core.source="wordnet 3.1"
@k.words.iceland.noun.1 k.words.sense word=Iceland pos=noun n=1 gloss="an island republic on the island of Iceland; became independent of Denmark in 1944" synonym="Republic of Iceland" instance_of="European country" part_of=Iceland part_of=Europe core.source="wordnet 3.1"
@k.words.iceland.noun.2 k.words.sense word=Iceland pos=noun n=2 gloss="a volcanic island in the North Atlantic near the Arctic Circle" instance_of=island part_of=Atlantic core.source="wordnet 3.1"
