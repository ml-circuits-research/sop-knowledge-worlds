@k.words.aid.noun.3 k.words.sense word=aid pos=noun n=3 gloss="gift of money or other material help to support a person or cause" synonym="economic aid" synonym="financial aid" synonym=assistance synonym="financial assistance" synonym="economic assistance" is_a=gift core.source="wordnet 3.1"
@k.words.aid.verb.1 k.words.sense word=aid pos=verb n=1 gloss="give help or assistance; be of service" synonym=help synonym=assist is_a=support core.source="wordnet 3.1"
