@k.words.mp.noun.1 k.words.sense word=MP pos=noun n=1 gloss="a member of the military police who polices soldiers and guards prisoners" synonym="military policeman" is_a=lawman core.source="wordnet 3.1"
@k.words.mp.noun.2 k.words.sense word=MP pos=noun n=2 gloss="a military corps that enforces discipline and guards prisoners" synonym="military police" is_a=force core.source="wordnet 3.1"
@k.words.mp.spelling.MP core.word text=mp means=MP of=k.words.sense.word core.source="wordnet 3.1"
@k.words.mps.noun.1 k.words.sense word=MPS pos=noun n=1 gloss="a widely distributed system of free and fixed macrophages derived from bone marrow" synonym="mononuclear phagocyte system" synonym="system of macrophages" is_a=system part_of="reticuloendothelial system" core.source="wordnet 3.1"
@k.words.mps.spelling.MPS core.word text=mps means=MPS of=k.words.sense.word core.source="wordnet 3.1"
