@k.words.hazel.noun.1 k.words.sense word=hazel pos=noun n=1 gloss="Australian tree grown especially for ornament and its fine-grained wood and bearing edible nuts" synonym="hazel tree" synonym="Pomaderris apetala" is_a=tree core.source="wordnet 3.1"
@k.words.hazel.noun.2 k.words.sense word=hazel pos=noun n=2 gloss="the fine-grained wood of a hazelnut tree (genus Corylus) and the hazel tree (Australian genus Pomaderris)" is_a=wood core.source="wordnet 3.1"
@k.words.hazel.noun.3 k.words.sense word=hazel pos=noun n=3 gloss="any of several shrubs or small trees of the genus Corylus bearing edible nuts enclosed in a leafy husk" synonym=hazelnut synonym="hazelnut tree" is_a="nut tree" core.source="wordnet 3.1"
