@k.words.hiv.spelling.HIV core.word text=hiv means=HIV of=k.words.sense.word core.source="wordnet 3.1"
@k.words.hive.noun.1 k.words.sense word=hive pos=noun n=1 gloss="a teeming multitude" is_a=multitude core.source="wordnet 3.1"
@k.words.hive.noun.2 k.words.sense word=hive pos=noun n=2 gloss="a man-made receptacle that houses a swarm of bees" synonym=beehive is_a=receptacle part_of=apiary core.source="wordnet 3.1"
@k.words.hive.noun.3 k.words.sense word=hive pos=noun n=3 gloss="a structure that provides a natural habitation for bees; as in a hollow tree" synonym=beehive is_a=nest core.source="wordnet 3.1"
@k.words.hive.verb.1 k.words.sense word=hive pos=verb n=1 gloss="store, like bees" is_a=store core.source="wordnet 3.1"
@k.words.hive.verb.2 k.words.sense word=hive pos=verb n=2 gloss="move together in a hive or as if in a hive" is_a=meet core.source="wordnet 3.1"
@k.words.hive.verb.3 k.words.sense word=hive pos=verb n=3 gloss="gather into a hive" is_a=gather core.source="wordnet 3.1"
@k.words.hives.noun.1 k.words.sense word=hives pos=noun n=1 gloss="an itchy skin eruption characterized by weals with pale interiors and well-defined red margins; usually the result of an allergic response to insect bites or food or drugs" synonym=urtication synonym=urticaria synonym="nettle rash" is_a=rash is_a="hypersensitivity reaction" core.source="wordnet 3.1"
