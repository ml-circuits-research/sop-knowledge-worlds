# k.words/shards/on: noun and verb senses of the words from "one" to "onion" (first letters "on").
# sources: wordnet 3.1 (Princeton WordNet 3.1; words chosen with frequency-words 2018, the 20,000 most frequent, and the common things of tools/coverage.mjs)
# license: WordNet-3.0
# script: tools/import/wordnet.mjs

@k.words.one.noun.1 k.words.sense word=one pos=noun n=1 gloss="the smallest whole number or a numeral representing this number" synonym=1 synonym=I synonym=ace synonym=single synonym=unity is_a=digit core.source="wordnet 3.1"
@k.words.one.noun.2 k.words.sense word=one pos=noun n=2 gloss="a single person or thing" is_a=unit core.source="wordnet 3.1"
@k.words.onion.noun.1 k.words.sense word=onion pos=noun n=1 gloss="the bulb of an onion plant" is_a=bulb part_of=onion core.source="wordnet 3.1"
@k.words.onion.noun.2 k.words.sense word=onion pos=noun n=2 gloss="bulbous plant having hollow leaves cultivated worldwide for its rounded edible bulb" synonym="onion plant" synonym="Allium cepa" is_a="alliaceous plant" core.source="wordnet 3.1"
@k.words.onion.noun.3 k.words.sense word=onion pos=noun n=3 gloss="an aromatic flavorful vegetable" is_a=vegetable core.source="wordnet 3.1"
