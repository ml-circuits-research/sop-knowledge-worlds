@k.words.mute.noun.2 k.words.sense word=mute pos=noun n=2 gloss="a device used to soften the tone of a musical instrument" is_a="acoustic device" core.source="wordnet 3.1"
@k.words.mute.verb.1 k.words.sense word=mute pos=verb n=1 gloss="deaden (a sound or noise), especially by wrapping" synonym=muffle synonym=dull synonym=damp synonym=dampen synonym="tone down" is_a=soften core.source="wordnet 3.1"
@k.words.mutiny.noun.1 k.words.sense word=mutiny pos=noun n=1 gloss="open rebellion against constituted authority (especially by seamen or soldiers against their officers)" is_a=rebellion core.source="wordnet 3.1"
@k.words.mutiny.verb.1 k.words.sense word=mutiny pos=verb n=1 gloss="engage in a mutiny against an authority" is_a=rebel core.source="wordnet 3.1"
@k.words.mutiny.forms core.word text=mutinied means=mutiny of=k.words.sense.word core.source="wordnet 3.1"
@k.words.mutt.noun.1 k.words.sense word=mutt pos=noun n=1 gloss="an inferior dog or one of mixed breed" synonym=cur synonym=mongrel is_a=dog core.source="wordnet 3.1"
@k.words.muttering.noun.1 k.words.sense word=muttering pos=noun n=1 gloss="a low continuous indistinct sound; often accompanied by movement of the lips without the production of articulate speech" synonym=mutter synonym=murmur synonym=murmuring synonym=murmuration synonym=mussitation is_a=sound core.source="wordnet 3.1"
@k.words.muttering.noun.2 k.words.sense word=muttering pos=noun n=2 gloss="a complaint uttered in a low and indistinct tone" synonym=grumble synonym=grumbling synonym=murmur synonym=murmuring synonym=mutter is_a=complaint core.source="wordnet 3.1"
@k.words.mutton.noun.1 k.words.sense word=mutton pos=noun n=1 gloss="meat from a mature domestic sheep" synonym=mouton is_a=meat part_of="domestic sheep" core.source="wordnet 3.1"
@k.words.muzzle.noun.1 k.words.sense word=muzzle pos=noun n=1 gloss="the open circular discharging end of a gun" synonym="gun muzzle" is_a=opening part_of=gun core.source="wordnet 3.1"
@k.words.muzzle.noun.2 k.words.sense word=muzzle pos=noun n=2 gloss="forward projecting part of the head of certain animals; includes the jaws and nose" is_a=face part_of=head core.source="wordnet 3.1"
@k.words.muzzle.noun.3 k.words.sense word=muzzle pos=noun n=3 gloss="a leather or wire restraint that fits over an animal's snout (especially a dog's nose and jaws) and prevents it from eating or biting" is_a=restraint core.source="wordnet 3.1"
@k.words.muzzle.verb.1 k.words.sense word=muzzle pos=verb n=1 gloss="fit with a muzzle" is_a=equip core.source="wordnet 3.1"
@k.words.muzzle.verb.2 k.words.sense word=muzzle pos=verb n=2 gloss="prevent from speaking out" synonym=gag is_a=hush core.source="wordnet 3.1"
@k.words.muzzle.verb.3 k.words.sense word=muzzle pos=verb n=3 gloss="tie a gag around someone's mouth in order to silence them" synonym=gag is_a=tie core.source="wordnet 3.1"
