# k.layouts: named arrangements of things in a picture (row, grid, ring, landscape, face, room), the places on a
# drawable thing where another thing sits or attaches (the seat of a chair, the top of a head, the surface of a
# lake), and which kinds of thing join which (a roof on a wall, a wheel on a car, a hat on a head, an arrow on a
# box). So that a picture can be laid out, and things put on or joined to each other, from knowledge.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.layouts core.module name=k.layouts version=2 imports=k.named exports=layout exports=slot exports=relation exports=anchor exports=joins core.source="hand-core 1"

# A named arrangement. `kind` is `repeating` when it arranges any number of like things (a row, a ring) and `fixed`
# when it has named places, each for its own kind of thing (a landscape, a face). `about` says it in one sentence;
# `ordered=true` says that the order of the things means something (the steps of a flow); `usual_for` names what
# is usually arranged so (short phrases; many). Other names of the arrangement are core.word facts.
@k.layouts.layout core.type of=k.layouts.layout shared=true closed=true core.source="hand-core 1"
@k.layouts.layout.name core.slot of=k.layouts.layout key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.layout.kind core.slot of=k.layouts.layout key=kind required=true enum=repeating enum=fixed core.source="hand-core 1"
@k.layouts.layout.about core.slot of=k.layouts.layout key=about required=true kind=string core.source="hand-core 1"
@k.layouts.layout.ordered core.slot of=k.layouts.layout key=ordered kind=boolean core.source="hand-core 1"
@k.layouts.layout.usual_for core.slot of=k.layouts.layout key=usual_for many=true required=true kind=string core.source="hand-core 1"

# A place of an arrangement. `count` is `one` thing or `many`; `pair=true` says that the place is there twice, once
# on each side of the middle line (the eyes of a face); `optional=true` that it may stay empty; `holds` names what
# usually goes there (many); `arranged` names the arrangement of the things inside the place, where they have one
# (each row of a grid is a `row`); `x`, `y`, `w`, `h` are the usual box of the place in the frame of the whole
# arrangement, 0 to 100, x to the right and y down, where the arrangement has usual places (the sky of a landscape
# is its upper half). The box of a pair is that of its left one. The boxes may overlap.
@k.layouts.slot core.type of=k.layouts.slot shared=true closed=true core.source="hand-core 1"
@k.layouts.slot.layout core.slot of=k.layouts.slot key=layout id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.slot.name core.slot of=k.layouts.slot key=name id=true required=true kind=atom core.source="hand-core 1"
@k.layouts.slot.count core.slot of=k.layouts.slot key=count required=true enum=one enum=many core.source="hand-core 1"
@k.layouts.slot.pair core.slot of=k.layouts.slot key=pair kind=boolean core.source="hand-core 1"
@k.layouts.slot.optional core.slot of=k.layouts.slot key=optional kind=boolean core.source="hand-core 1"
@k.layouts.slot.holds core.slot of=k.layouts.slot key=holds many=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.slot.arranged core.slot of=k.layouts.slot key=arranged kind=atom kind=string core.source="hand-core 1"
@k.layouts.slot.x core.slot of=k.layouts.slot key=x kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.slot.y core.slot of=k.layouts.slot key=y kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.slot.w core.slot of=k.layouts.slot key=w kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.slot.h core.slot of=k.layouts.slot key=h kind=number min=0 max=100 core.source="hand-core 1"

# How two places of an arrangement sit to each other: what is in `a` is `rel` what is in `b`. `left_of` and `above`
# compare the middles; `inside`: a lies within b; `around`: a surrounds b; `on`: a rests on the upper edge of b;
# `behind`: a is further away and drawn first; `beside`: a is next to b, on either side; `aligned_row`: the middles
# are at one height; `aligned_column`: the middles are one above the other; `same_size`; `smaller_than`;
# `evenly_spaced`: the gaps are equal; `apart`: they do not touch; `joined_to`: a line or an arrow goes from a to
# b. When `a` and `b` are the same place with many things, `among` says between which of them the relation holds:
# `neighbours` (from each thing to the next, in order) or `all` (between any two).
@k.layouts.relation core.type of=k.layouts.relation shared=true closed=true core.source="hand-core 1"
@k.layouts.relation.layout core.slot of=k.layouts.relation key=layout id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.relation.a core.slot of=k.layouts.relation key=a id=true required=true kind=atom core.source="hand-core 1"
@k.layouts.relation.rel core.slot of=k.layouts.relation key=rel id=true required=true enum=left_of enum=above enum=inside enum=around enum=on enum=behind enum=beside enum=aligned_row enum=aligned_column enum=same_size enum=smaller_than enum=evenly_spaced enum=apart enum=joined_to core.source="hand-core 1"
@k.layouts.relation.b core.slot of=k.layouts.relation key=b id=true required=true kind=atom core.source="hand-core 1"
@k.layouts.relation.among core.slot of=k.layouts.relation key=among enum=neighbours enum=all core.source="hand-core 1"

# A place on a drawable thing where another thing sits or attaches. `of` names the k.objects object, `name` the
# place. `kind`: `seat` (someone sits there), `surface` (things stand or lie on it), `top` (the highest place: a hat
# on a head, a flag on a tower), `handle` (a hand holds the thing there), `hand` (the thing holds another there),
# `opening` (things go in and out: a door, the slot of a mailbox), `inside` (things are in it: a cup, the crown of a
# tree), `water` (things float or swim on it), `roof` (the roof of a building), `hook` (the thing hangs by it, or
# another hangs from it), `base` (the thing itself stands or sits there on another). `x`, `y`, `w`, `h` are the box
# of the place in the 0 to 100 frame of the object: a line when `w` or `h` is 0 (the upper edge of a seat), a point
# when both are. `part` names the part of the object that the place lies on; it is absent where the parts of the
# drawing have no names (imported drawings) or no part marks the place: the box is then all there is. `holds` names
# what usually goes there (many); for a `base`, `on` names what the thing stands or sits on. `named=model`: the
# place was chosen by a language model, from the named parts of the object or by looking at the drawing under a
# grid, only where sure, and looked at again drawn on the object.
@k.layouts.anchor core.type of=k.layouts.anchor extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.layouts.anchor.of core.slot of=k.layouts.anchor key=of id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.anchor.name core.slot of=k.layouts.anchor key=name id=true required=true kind=atom core.source="hand-core 1"
@k.layouts.anchor.kind core.slot of=k.layouts.anchor key=kind required=true enum=seat enum=surface enum=top enum=handle enum=hand enum=opening enum=inside enum=water enum=roof enum=hook enum=base core.source="hand-core 1"
@k.layouts.anchor.x core.slot of=k.layouts.anchor key=x required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.anchor.y core.slot of=k.layouts.anchor key=y required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.anchor.w core.slot of=k.layouts.anchor key=w required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.anchor.h core.slot of=k.layouts.anchor key=h required=true kind=number min=0 max=100 core.source="hand-core 1"
@k.layouts.anchor.part core.slot of=k.layouts.anchor key=part kind=atom core.source="hand-core 1"
@k.layouts.anchor.holds core.slot of=k.layouts.anchor key=holds many=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.anchor.on core.slot of=k.layouts.anchor key=on many=true kind=atom kind=string core.source="hand-core 1"

# Which kind of thing joins which: `a` is `rel` `b`. `part_of`: a is a part of b (a wheel of a car); `attaches_to`: a
# is fixed to b (a roof to a wall, an arrow to a box); `sits_on`: a rests on b and can be taken off (a hat on a head,
# a lid on a pot); `hangs_from`; `goes_in`: a is put into b (a key into a lock); `worn_on`: a is worn on that part
# of the body; `grows_on`; `held_in`; `connects`: a joins two of b (a bridge two banks, an arrow two boxes). `side`
# says where on b: `top`, `bottom`, `side` (left or right), `front`, `back`, `end`, `edge`, `corner`, `centre`,
# `inside`, `around`. Kinds are named by their common English noun. `named=model`: written by a language model, only
# where sure.
@k.layouts.joins core.type of=k.layouts.joins extends=k.named.labelled shared=true closed=true core.source="hand-core 1"
@k.layouts.joins.a core.slot of=k.layouts.joins key=a id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.joins.rel core.slot of=k.layouts.joins key=rel id=true required=true enum=part_of enum=attaches_to enum=sits_on enum=hangs_from enum=goes_in enum=worn_on enum=grows_on enum=held_in enum=connects enum=around core.source="hand-core 1"
@k.layouts.joins.b core.slot of=k.layouts.joins key=b id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.layouts.joins.side core.slot of=k.layouts.joins key=side enum=top enum=bottom enum=side enum=front enum=back enum=end enum=edge enum=corner enum=centre enum=inside enum=around core.source="hand-core 1"

