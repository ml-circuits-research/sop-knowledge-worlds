@k.layouts.layout.face k.layouts.layout name=face kind=fixed about="A face seen from the front: the eyes in the middle of the head, the eyebrows above them, the nose below, the mouth below the nose, an ear on each side, hair and a hat on top, the neck and shoulders below." usual_for="a portrait" usual_for="an avatar" usual_for="a mask" usual_for="a doll's head" usual_for="a smiley" core.source="hand-core 1"
