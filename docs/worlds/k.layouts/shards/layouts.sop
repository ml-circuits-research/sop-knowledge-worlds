# family photo
@k.layouts.layout.family_photo k.layouts.layout name="family photo" kind=fixed about="A group of people facing the viewer: the tall ones in a row at the back, the small ones in a row in front of them." usual_for="a family" usual_for="a sports team" usual_for="a school class" usual_for="a wedding party" usual_for="a band" core.source="hand-core 1"
