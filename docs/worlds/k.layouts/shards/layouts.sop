@k.layouts.relation.room.back_wall.above.floor k.layouts.relation layout=room a=back_wall rel=above b=floor core.source="hand-core 1"
@k.layouts.relation.room.back_wall.behind.furniture k.layouts.relation layout=room a=back_wall rel=behind b=furniture core.source="hand-core 1"
