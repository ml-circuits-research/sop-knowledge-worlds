# k.layouts/shards/layouts: 17 named arrangements (row, column, grid, ring, scatter, corners, stack, pyramid, tree, flow, radial, nested, border, landscape, room, family photo, face): their places, how the places sit to each other, what is usually arranged so; and other names of the arrangements.
# sources: hand-core 1 (hand-written in this repository: tools/layouts-core.mjs)
# license: CC0-1.0
# script: tools/layouts-core.mjs

# row
@k.layouts.layout.row k.layouts.layout name=row kind=repeating about="Things side by side on one line, from left to right." ordered=true usual_for="things of one kind shown side by side" usual_for="people in a queue" usual_for="houses along a street" usual_for="the letters of a word" usual_for="the wagons of a train" core.source="hand-core 1"
@k.layouts.slot.row.item k.layouts.slot layout=row name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.row.item.left_of.item k.layouts.relation layout=row a=item rel=left_of b=item among=neighbours core.source="hand-core 1"
@k.layouts.relation.row.item.aligned_row.item k.layouts.relation layout=row a=item rel=aligned_row b=item among=all core.source="hand-core 1"
@k.layouts.relation.row.item.evenly_spaced.item k.layouts.relation layout=row a=item rel=evenly_spaced b=item among=neighbours core.source="hand-core 1"

# column
@k.layouts.layout.column k.layouts.layout name=column kind=repeating about="Things one above the other, from top to bottom." ordered=true usual_for="the lines of a list" usual_for="the floors of a building" usual_for="the lights of a traffic light" usual_for="the steps of a recipe" core.source="hand-core 1"
@k.layouts.slot.column.item k.layouts.slot layout=column name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.column.item.above.item k.layouts.relation layout=column a=item rel=above b=item among=neighbours core.source="hand-core 1"
@k.layouts.relation.column.item.aligned_column.item k.layouts.relation layout=column a=item rel=aligned_column b=item among=all core.source="hand-core 1"
@k.layouts.relation.column.item.evenly_spaced.item k.layouts.relation layout=column a=item rel=evenly_spaced b=item among=neighbours core.source="hand-core 1"

# grid
@k.layouts.layout.grid k.layouts.layout name=grid kind=repeating about="Things in rows and columns, all cells the same size." usual_for="a table of values" usual_for="the windows of a tall building" usual_for="the days of a calendar" usual_for="a chessboard" usual_for="eggs in a box" usual_for="many small pictures" core.source="hand-core 1"
@k.layouts.slot.grid.row k.layouts.slot layout=grid name=row count=many holds="row of things" arranged=row core.source="hand-core 1"
@k.layouts.relation.grid.row.above.row k.layouts.relation layout=grid a=row rel=above b=row among=neighbours core.source="hand-core 1"
@k.layouts.relation.grid.row.aligned_column.row k.layouts.relation layout=grid a=row rel=aligned_column b=row among=all core.source="hand-core 1"
@k.layouts.relation.grid.row.same_size.row k.layouts.relation layout=grid a=row rel=same_size b=row among=all core.source="hand-core 1"
@k.layouts.relation.grid.row.evenly_spaced.row k.layouts.relation layout=grid a=row rel=evenly_spaced b=row among=neighbours core.source="hand-core 1"

# ring
@k.layouts.layout.ring k.layouts.layout name=ring kind=repeating about="Things in a circle, around a middle that may be empty." ordered=true usual_for="people holding hands in a circle" usual_for="the numbers of a clock" usual_for="the petals of a flower" usual_for="chairs round a table" usual_for="the stones of a necklace" core.source="hand-core 1"
@k.layouts.slot.ring.item k.layouts.slot layout=ring name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.slot.ring.centre k.layouts.slot layout=ring name=centre count=one optional=true holds="thing they stand around" core.source="hand-core 1"
@k.layouts.relation.ring.item.around.centre k.layouts.relation layout=ring a=item rel=around b=centre core.source="hand-core 1"
@k.layouts.relation.ring.item.beside.item k.layouts.relation layout=ring a=item rel=beside b=item among=neighbours core.source="hand-core 1"
@k.layouts.relation.ring.item.evenly_spaced.item k.layouts.relation layout=ring a=item rel=evenly_spaced b=item among=neighbours core.source="hand-core 1"

# scatter
@k.layouts.layout.scatter k.layouts.layout name=scatter kind=repeating about="Things spread over an area with no order, not touching." usual_for="stars in the sky" usual_for="flowers in a meadow" usual_for="sheep in a field" usual_for="toys on the floor" usual_for="fish in the sea" usual_for="raisins in a cake" core.source="hand-core 1"
@k.layouts.slot.scatter.item k.layouts.slot layout=scatter name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.scatter.item.apart.item k.layouts.relation layout=scatter a=item rel=apart b=item among=all core.source="hand-core 1"

# corners
@k.layouts.layout.corners k.layouts.layout name=corners kind=fixed about="Four things in the four corners, with or without a fifth in the middle." usual_for="four things of equal weight" usual_for="the ornaments of a page" usual_for="the players of a board game" usual_for="the five of a die" core.source="hand-core 1"
@k.layouts.slot.corners.top_left k.layouts.slot layout=corners name=top_left count=one x=0 y=0 w=30 h=30 core.source="hand-core 1"
@k.layouts.slot.corners.top_right k.layouts.slot layout=corners name=top_right count=one x=70 y=0 w=30 h=30 core.source="hand-core 1"
@k.layouts.slot.corners.bottom_left k.layouts.slot layout=corners name=bottom_left count=one x=0 y=70 w=30 h=30 core.source="hand-core 1"
@k.layouts.slot.corners.bottom_right k.layouts.slot layout=corners name=bottom_right count=one x=70 y=70 w=30 h=30 core.source="hand-core 1"
@k.layouts.slot.corners.centre k.layouts.slot layout=corners name=centre count=one optional=true x=30 y=30 w=40 h=40 core.source="hand-core 1"
@k.layouts.relation.corners.top_left.left_of.top_right k.layouts.relation layout=corners a=top_left rel=left_of b=top_right core.source="hand-core 1"
@k.layouts.relation.corners.bottom_left.left_of.bottom_right k.layouts.relation layout=corners a=bottom_left rel=left_of b=bottom_right core.source="hand-core 1"
@k.layouts.relation.corners.top_left.above.bottom_left k.layouts.relation layout=corners a=top_left rel=above b=bottom_left core.source="hand-core 1"
@k.layouts.relation.corners.top_right.above.bottom_right k.layouts.relation layout=corners a=top_right rel=above b=bottom_right core.source="hand-core 1"
@k.layouts.relation.corners.top_left.aligned_row.top_right k.layouts.relation layout=corners a=top_left rel=aligned_row b=top_right core.source="hand-core 1"
@k.layouts.relation.corners.bottom_left.aligned_row.bottom_right k.layouts.relation layout=corners a=bottom_left rel=aligned_row b=bottom_right core.source="hand-core 1"
@k.layouts.relation.corners.top_left.aligned_column.bottom_left k.layouts.relation layout=corners a=top_left rel=aligned_column b=bottom_left core.source="hand-core 1"
@k.layouts.relation.corners.top_right.aligned_column.bottom_right k.layouts.relation layout=corners a=top_right rel=aligned_column b=bottom_right core.source="hand-core 1"
@k.layouts.relation.corners.top_left.same_size.bottom_right k.layouts.relation layout=corners a=top_left rel=same_size b=bottom_right core.source="hand-core 1"

# stack
@k.layouts.layout.stack k.layouts.layout name=stack kind=repeating about="Things lying on top of each other, each resting on the one below." ordered=true usual_for="books" usual_for="plates" usual_for="boxes" usual_for="the blocks of a tower" usual_for="pancakes" usual_for="coins" core.source="hand-core 1"
@k.layouts.slot.stack.item k.layouts.slot layout=stack name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.stack.item.on.item k.layouts.relation layout=stack a=item rel=on b=item among=neighbours core.source="hand-core 1"
@k.layouts.relation.stack.item.aligned_column.item k.layouts.relation layout=stack a=item rel=aligned_column b=item among=all core.source="hand-core 1"

# pyramid
@k.layouts.layout.pyramid k.layouts.layout name=pyramid kind=repeating about="Rows on top of each other, each shorter than the one below." ordered=true usual_for="tins in a shop" usual_for="acrobats standing on each other" usual_for="oranges on a stall" usual_for="the steps of a podium" usual_for="bricks" core.source="hand-core 1"
@k.layouts.slot.pyramid.row k.layouts.slot layout=pyramid name=row count=many holds="row of things" arranged=row core.source="hand-core 1"
@k.layouts.relation.pyramid.row.on.row k.layouts.relation layout=pyramid a=row rel=on b=row among=neighbours core.source="hand-core 1"
@k.layouts.relation.pyramid.row.smaller_than.row k.layouts.relation layout=pyramid a=row rel=smaller_than b=row among=neighbours core.source="hand-core 1"
@k.layouts.relation.pyramid.row.aligned_column.row k.layouts.relation layout=pyramid a=row rel=aligned_column b=row among=all core.source="hand-core 1"

# tree
@k.layouts.layout.tree k.layouts.layout name=tree kind=fixed about="One thing at the top, its children in a row below it, each child again the top of a smaller tree; lines join parent and child." usual_for="a family tree" usual_for="kinds and their sub-kinds" usual_for="who leads whom in a company" usual_for="folders and files" usual_for="the rounds of a tournament" core.source="hand-core 1"
@k.layouts.slot.tree.root k.layouts.slot layout=tree name=root count=one holds=parent x=40 y=0 w=20 h=20 core.source="hand-core 1"
@k.layouts.slot.tree.child k.layouts.slot layout=tree name=child count=many holds=child holds="smaller tree" arranged=row x=0 y=45 w=100 h=55 core.source="hand-core 1"
@k.layouts.relation.tree.root.above.child k.layouts.relation layout=tree a=root rel=above b=child core.source="hand-core 1"
@k.layouts.relation.tree.root.aligned_column.child k.layouts.relation layout=tree a=root rel=aligned_column b=child core.source="hand-core 1"
@k.layouts.relation.tree.root.joined_to.child k.layouts.relation layout=tree a=root rel=joined_to b=child core.source="hand-core 1"
@k.layouts.relation.tree.child.left_of.child k.layouts.relation layout=tree a=child rel=left_of b=child among=neighbours core.source="hand-core 1"
@k.layouts.relation.tree.child.aligned_row.child k.layouts.relation layout=tree a=child rel=aligned_row b=child among=all core.source="hand-core 1"

# flow
@k.layouts.layout.flow k.layouts.layout name=flow kind=repeating about="Steps one after the other, an arrow from each step to the next." ordered=true usual_for="the steps of a process" usual_for="a recipe" usual_for="a life cycle" usual_for="cause and effect" usual_for="what happens in a story" usual_for="a timeline" core.source="hand-core 1"
@k.layouts.slot.flow.step k.layouts.slot layout=flow name=step count=many holds=step holds=box core.source="hand-core 1"
@k.layouts.relation.flow.step.left_of.step k.layouts.relation layout=flow a=step rel=left_of b=step among=neighbours core.source="hand-core 1"
@k.layouts.relation.flow.step.joined_to.step k.layouts.relation layout=flow a=step rel=joined_to b=step among=neighbours core.source="hand-core 1"
@k.layouts.relation.flow.step.aligned_row.step k.layouts.relation layout=flow a=step rel=aligned_row b=step among=all core.source="hand-core 1"
@k.layouts.relation.flow.step.evenly_spaced.step k.layouts.relation layout=flow a=step rel=evenly_spaced b=step among=neighbours core.source="hand-core 1"

# radial
@k.layouts.layout.radial k.layouts.layout name=radial kind=fixed about="One thing in the middle and the others around it, each joined to the middle by a line." usual_for="a mind map" usual_for="a sun with its rays" usual_for="a wheel with its spokes" usual_for="a main idea with its examples" usual_for="a town with its roads" core.source="hand-core 1"
@k.layouts.slot.radial.centre k.layouts.slot layout=radial name=centre count=one holds="main thing" x=35 y=35 w=30 h=30 core.source="hand-core 1"
@k.layouts.slot.radial.item k.layouts.slot layout=radial name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.radial.item.around.centre k.layouts.relation layout=radial a=item rel=around b=centre core.source="hand-core 1"
@k.layouts.relation.radial.centre.joined_to.item k.layouts.relation layout=radial a=centre rel=joined_to b=item core.source="hand-core 1"
@k.layouts.relation.radial.item.evenly_spaced.item k.layouts.relation layout=radial a=item rel=evenly_spaced b=item among=neighbours core.source="hand-core 1"

# nested
@k.layouts.layout.nested k.layouts.layout name=nested kind=repeating about="Things inside each other, the biggest outside." ordered=true usual_for="dolls that fit into each other" usual_for="the rings of a target" usual_for="the rings of a tree trunk" usual_for="a box in a box" usual_for="a group and its smaller groups" core.source="hand-core 1"
@k.layouts.slot.nested.item k.layouts.slot layout=nested name=item count=many holds=thing core.source="hand-core 1"
@k.layouts.relation.nested.item.around.item k.layouts.relation layout=nested a=item rel=around b=item among=neighbours core.source="hand-core 1"
@k.layouts.relation.nested.item.aligned_column.item k.layouts.relation layout=nested a=item rel=aligned_column b=item among=all core.source="hand-core 1"
@k.layouts.relation.nested.item.aligned_row.item k.layouts.relation layout=nested a=item rel=aligned_row b=item among=all core.source="hand-core 1"

# border
@k.layouts.layout.border k.layouts.layout name=border kind=fixed about="One thing in the middle and others all along the edge around it." usual_for="a picture in its frame" usual_for="a fence round a field" usual_for="the wall round a town" usual_for="seats round a pitch" usual_for="a title page with ornaments" core.source="hand-core 1"
@k.layouts.slot.border.centre k.layouts.slot layout=border name=centre count=one holds="main thing" x=15 y=15 w=70 h=70 core.source="hand-core 1"
@k.layouts.slot.border.edge k.layouts.slot layout=border name=edge count=many holds="small thing" holds=ornament holds=post core.source="hand-core 1"
@k.layouts.relation.border.edge.around.centre k.layouts.relation layout=border a=edge rel=around b=centre core.source="hand-core 1"
@k.layouts.relation.border.edge.evenly_spaced.edge k.layouts.relation layout=border a=edge rel=evenly_spaced b=edge among=neighbours core.source="hand-core 1"
@k.layouts.relation.border.edge.same_size.edge k.layouts.relation layout=border a=edge rel=same_size b=edge among=all core.source="hand-core 1"

# landscape
@k.layouts.layout.landscape k.layouts.layout name=landscape kind=fixed about="An outdoor view: the sky above the ground, far things on the horizon, water lying in the ground, small things in front." usual_for="an outdoor scene" usual_for="a farm" usual_for="a beach" usual_for="a village" usual_for="a view of the countryside" core.source="hand-core 1"
@k.layouts.slot.landscape.sky k.layouts.slot layout=landscape name=sky count=one holds=sun holds=moon holds=cloud holds=star holds=bird holds=rainbow holds=plane arranged=scatter x=0 y=0 w=100 h=50 core.source="hand-core 1"
@k.layouts.slot.landscape.far k.layouts.slot layout=landscape name=far count=many optional=true holds=mountain holds=hill holds=forest holds="far house" arranged=row x=0 y=32 w=100 h=20 core.source="hand-core 1"
@k.layouts.slot.landscape.ground k.layouts.slot layout=landscape name=ground count=one holds=tree holds=house holds=animal holds=person holds=road holds=fence x=0 y=50 w=100 h=50 core.source="hand-core 1"
@k.layouts.slot.landscape.water k.layouts.slot layout=landscape name=water count=one optional=true holds=pond holds=lake holds=river holds=boat holds=duck x=10 y=62 w=45 h=22 core.source="hand-core 1"
@k.layouts.slot.landscape.foreground k.layouts.slot layout=landscape name=foreground count=many optional=true holds=flower holds=grass holds=stone holds="small animal" arranged=row x=0 y=86 w=100 h=14 core.source="hand-core 1"
@k.layouts.relation.landscape.sky.above.ground k.layouts.relation layout=landscape a=sky rel=above b=ground core.source="hand-core 1"
@k.layouts.relation.landscape.sky.above.far k.layouts.relation layout=landscape a=sky rel=above b=far core.source="hand-core 1"
@k.layouts.relation.landscape.far.above.ground k.layouts.relation layout=landscape a=far rel=above b=ground core.source="hand-core 1"
@k.layouts.relation.landscape.far.behind.ground k.layouts.relation layout=landscape a=far rel=behind b=ground core.source="hand-core 1"
@k.layouts.relation.landscape.water.inside.ground k.layouts.relation layout=landscape a=water rel=inside b=ground core.source="hand-core 1"
@k.layouts.relation.landscape.foreground.inside.ground k.layouts.relation layout=landscape a=foreground rel=inside b=ground core.source="hand-core 1"
@k.layouts.relation.landscape.ground.behind.foreground k.layouts.relation layout=landscape a=ground rel=behind b=foreground core.source="hand-core 1"
@k.layouts.relation.landscape.water.above.foreground k.layouts.relation layout=landscape a=water rel=above b=foreground core.source="hand-core 1"
@k.layouts.relation.landscape.sky.same_size.ground k.layouts.relation layout=landscape a=sky rel=same_size b=ground core.source="hand-core 1"

# room
@k.layouts.layout.room k.layouts.layout name=room kind=fixed about="An indoor view: the floor below the back wall, the ceiling on top, furniture standing on the floor, small things on the furniture." usual_for="a kitchen" usual_for="a bedroom" usual_for="a classroom" usual_for="a shop" usual_for="any indoor scene" core.source="hand-core 1"
