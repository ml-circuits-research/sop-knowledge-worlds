@k.shapes.psys2.quadrilateral k.shapes.shape name=quadrilateral kind=flat sides=4 corners=4 round=false is_a=polygon core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.is_a.triangle k.shapes.shape name=triangle is_a=polygon core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.is_a.rectangle k.shapes.shape name=rectangle is_a=quadrilateral core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.is_a.pentagon k.shapes.shape name=pentagon is_a=polygon core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.is_a.hexagon k.shapes.shape name=hexagon is_a=polygon core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.is_a.octagon k.shapes.shape name=octagon is_a=polygon core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.rhombus k.shapes.shape name=rhombus kind=flat sides=4 corners=4 round=false is_a=quadrilateral core.source="psys2-worlds 6b63b2ba"
@k.shapes.psys2.rectangle k.shapes.shape name=rectangle thing=window thing=tv core.source="psys2-worlds 6b63b2ba"
