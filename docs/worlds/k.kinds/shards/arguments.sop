# k.kinds/shards/arguments: the 18 classes of arguments of the roles of k.actions and of the objects of the relations: the catalog types whose things fill each, and their senses.
# sources: hand-core 1 (hand-written in this repository: tools/relations-core.mjs)
# license: CC0-1.0
# script: tools/relations-core.mjs

@k.kinds.argument.thing k.kinds.argument name=thing about="a thing: one of the live world, or a thing the catalog names" live=true type=k.objects.object type=k.commonsense.thing type=k.attributes.thing type=k.scenes.thing sense=thing sense=animal sense=food sense=plant sense=person sense="body part" sense=clothing sense="body in space" example="the house" example="a cat" core.source="hand-core 1"
@k.kinds.argument.kind k.kinds.argument name=kind about="a kind of thing: what is made, what a thing is a kind of" type=k.objects.object type=k.kinds.kind type=k.words.sense type=k.animals.class type=k.space.kind sense=thing sense=animal sense=food sense=plant sense=person sense=clothing sense=shape example="a tree" example="mammal" core.source="hand-core 1"
@k.kinds.argument.place k.kinds.argument name=place about="a place: a relation and the thing it is said of (on the table), a part of a scene, or a named place" live=true type=k.layouts.relation type=k.layouts.slot type=k.scenes.scene type=k.geo.continent type=k.geo.country type=k.geo.city type=k.geo.sea type=k.geo.lake type=k.geo.river type=k.geo.mountain type=k.geo.desert sense=place example="on the table" example="in the sky" example="France" core.source="hand-core 1"
@k.kinds.argument.direction k.kinds.argument name=direction about="a direction" type=k.values.direction example="left" example="up" core.source="hand-core 1"
@k.kinds.argument.value k.kinds.argument name=value about="a value of an attribute: a colour, a step of a scale, a shape, a position, a word of a closed list" type=k.values.colour type=k.colours.colour type=k.values.step type=k.values.shape type=k.shapes.shape type=k.values.position type=k.values.fill type=k.values.shade sense=colour sense=shape example="red" example="big" example="round" core.source="hand-core 1"
@k.kinds.argument.attribute k.kinds.argument name=attribute about="an attribute of a thing: a key of a slot of its type" type=k.attributes.attribute type=k.values.scale example="colour" example="size" core.source="hand-core 1"
@k.kinds.argument.amount k.kinds.argument name=amount about="a number with a unit (k.units.measure says the unit of each key)" type=k.units.unit type=k.values.number example="2 metres" example="a bit" core.source="hand-core 1"
@k.kinds.argument.number k.kinds.argument name=number about="a number that counts or orders" type=k.values.number example="three" example="2" core.source="hand-core 1"
@k.kinds.argument.name k.kinds.argument name=name about="a name a person gives, as said" example="Ann" example="lunch" core.source="hand-core 1"
@k.kinds.argument.person k.kinds.argument name=person about="a person: a kind or a role of person, or a person of the live world" live=true type=k.people.kind type=k.people.role sense=person example="the girl" example="a doctor" core.source="hand-core 1"
@k.kinds.argument.group k.kinds.argument name=group about="a group: a named arrangement, or a group of the live world" live=true type=k.layouts.layout example="a row" example="a circle" core.source="hand-core 1"
@k.kinds.argument.topic k.kinds.argument name=topic about="what is asked about: a thing, a kind, an attribute or an act" live=true type=k.objects.object type=k.kinds.kind type=k.words.sense type=k.attributes.attribute type=k.actions.act example="the weather" example="colours" core.source="hand-core 1"
@k.kinds.argument.means k.kinds.argument name=means about="how a thing is sent or done: a channel or a tool" type=k.objects.object example="by email" example="with a rope" core.source="hand-core 1"
@k.kinds.argument.act k.kinds.argument name=act about="an action that a thing does or undergoes: an everyday action of k.actions, or an act" type=k.actions.action type=k.actions.act example="fly" example="swim" core.source="hand-core 1"
@k.kinds.argument.time k.kinds.argument name=time about="a time: a month, a weekday, a season, a part of the day, an hour, a span" type=k.time.month type=k.time.weekday type=k.time.season type=k.time.part_of_day type=k.time.hour type=k.time.duration type=k.time.ordered sense=time example="Monday" example="winter" core.source="hand-core 1"
@k.kinds.argument.word k.kinds.argument name=word about="a word of English (most in k.words), not the name of a thing of the catalog" type=k.words.sense example="moo" example="bark" core.source="hand-core 1"
@k.kinds.argument.text k.kinds.argument name=text about="a free text: a definition, a sentence, an example" example="a portable shelter" core.source="hand-core 1"
@k.kinds.argument.boolean k.kinds.argument name=boolean about="yes or no" example="true" core.source="hand-core 1"
