# license: CC0-1.0
# script: tools/structures-core.mjs

@k.kinds.structure.assignment k.kinds.structure name=assignment about="items in slots under constraints: each item is given one slot of a container; a slot holds a limited number of items" role=item role=slot role=assigned role=container role=slot_of role=capacity role=order role=constraint needs=item needs=slot core.source="hand-core 1"
@k.kinds.structure.whole_with_parts k.kinds.structure name="whole with parts" about="a whole made of parts: each part belongs to one whole, has a kind, and may have a place and a size in the whole" role=whole role=part role=part_of role=part_kind role=position role=size role=order needs=whole needs=part core.source="hand-core 1"
@k.kinds.structure.sequence k.kinds.structure name=sequence about="elements in an order (of time, of reading, of steps): each element has a position in its sequence; some have a start and an end" role=element role=position role=sequence role=element_of role=end role=start role=finish role=next needs=element needs=position core.source="hand-core 1"
@k.kinds.structure.graph k.kinds.structure name=graph about="nodes and the links between them, each link from one node to another with a label" role=node role=link role=from role=to role=label needs=node needs=link core.source="hand-core 1"
@k.kinds.structure.placement k.kinds.structure name=placement about="things placed in a space: each thing has a position, and may have a layer and a size" role=thing role=position role=space role=layer role=size needs=thing needs=position core.source="hand-core 1"
@k.kinds.structure.values_by_category k.kinds.structure name="values by category" about="numbers by category: each value belongs to a series and stands at a category" role=value role=category role=series role=value_of role=unit role=order needs=value needs=category core.source="hand-core 1"
