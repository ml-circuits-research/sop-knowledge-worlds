# k.attributes/shards/aspects: the 8 aspects of things (visual, spatial, relational, numeric, textual, geographic, temporal, social), 19 families of things, and for each family and aspect the world, type and key where the values are found.
# sources: hand-core 1 (hand-written in this repository: tools/attributes-core.mjs)
# license: CC0-1.0
# script: tools/attributes-core.mjs

@k.attributes.aspect.visual k.attributes.aspect name=visual about="how a thing looks: its drawing, colour, covering, what it is made of" shown_in=picture shown_in=card core.source="hand-core 1"
@k.attributes.aspect.spatial k.attributes.aspect name=spatial about="where a thing is and how big it is next to other things" shown_in=picture core.source="hand-core 1"
@k.attributes.aspect.relational k.attributes.aspect name=relational about="how a thing is tied to other things: its kind, its parts, what it does, eats, uses or is used for" shown_in=diagram core.source="hand-core 1"
@k.attributes.aspect.numeric k.attributes.aspect name=numeric about="what can be counted or measured about a thing" shown_in=chart core.source="hand-core 1"
@k.attributes.aspect.textual k.attributes.aspect name=textual about="what is said about a thing in words: a definition, a formal name, a sound" shown_in=document shown_in=card core.source="hand-core 1"
@k.attributes.aspect.geographic k.attributes.aspect name=geographic about="where on the Earth a thing is" shown_in=map core.source="hand-core 1"
@k.attributes.aspect.temporal k.attributes.aspect name=temporal about="when a thing is, or is usually used or seen (season, time of day, weather), how long it lasts, what comes before and after" core.source="hand-core 1"
@k.attributes.aspect.social k.attributes.aspect name=social about="what a person is among people (age, sex, family, job), and who a thing is for or used by" core.source="hand-core 1"

# Families of things.
@k.attributes.family.common_thing k.attributes.family name="common thing" about="a frequent English noun that names a physical thing (the list of 1,500 of tools/coverage.mjs)" core.source="hand-core 1"
@k.attributes.family.animal k.attributes.family name=animal about="an animal" world=k.animals type=k.animals.animal by=name core.source="hand-core 1"
@k.attributes.family.food k.attributes.family name=food about="a food" world=k.food type=k.food.food by=name core.source="hand-core 1"
@k.attributes.family.country k.attributes.family name=country about="a country" world=k.geo type=k.geo.country by=name core.source="hand-core 1"
@k.attributes.family.city k.attributes.family name=city about="a city" world=k.geo type=k.geo.city by=name core.source="hand-core 1"
@k.attributes.family.river k.attributes.family name=river about="a river" world=k.geo type=k.geo.river by=name core.source="hand-core 1"
@k.attributes.family.mountain k.attributes.family name=mountain about="a mountain" world=k.geo type=k.geo.mountain by=name core.source="hand-core 1"
@k.attributes.family.mountain_range k.attributes.family name="mountain range" about="a mountain range" world=k.geo type=k.geo.range by=name core.source="hand-core 1"
@k.attributes.family.continent k.attributes.family name=continent about="a continent" world=k.geo type=k.geo.continent by=name core.source="hand-core 1"
@k.attributes.family.kind_of_person k.attributes.family name="kind of person" about="a kind of person by age and sex" world=k.people type=k.people.kind by=name core.source="hand-core 1"
@k.attributes.family.role k.attributes.family name=role about="a job, a family role or a story role" world=k.people type=k.people.role by=name core.source="hand-core 1"
@k.attributes.family.month k.attributes.family name=month about="a month of the year" world=k.time type=k.time.month by=name core.source="hand-core 1"
@k.attributes.family.weekday k.attributes.family name=weekday about="a day of the week" world=k.time type=k.time.weekday by=name core.source="hand-core 1"
@k.attributes.family.season k.attributes.family name=season about="a season" world=k.time type=k.time.season by=name core.source="hand-core 1"
@k.attributes.family.duration k.attributes.family name=duration about="a length of time" world=k.time type=k.time.duration by=name core.source="hand-core 1"
@k.attributes.family.part_of_the_day k.attributes.family name="part of the day" about="a part of the day (morning, afternoon, evening, night)" world=k.time type=k.time.part_of_day by=name core.source="hand-core 1"
@k.attributes.family.hour k.attributes.family name=hour about="an hour of the clock" world=k.time type=k.time.hour by=name core.source="hand-core 1"
@k.attributes.family.body_in_space k.attributes.family name="body in space" about="a planet, moon, star or other body" world=k.space type=k.space.body by=name core.source="hand-core 1"
@k.attributes.family.scene_thing k.attributes.family name="scene thing" about="a thing that has a usual place and size for scenes (the things of k.scenes)" world=k.scenes type=k.scenes.thing by=name core.source="hand-core 1"

