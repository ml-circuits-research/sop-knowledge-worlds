# ---- by hand (basis=source: a published work; basis=own: own choice) ----
@k.attributes.range.k.attributes.number.size_about.man k.attributes.range type=k.attributes.number key=size_about kind=man low=1.6 high=1.83 basis=source cite="NCD Risk Factor Collaboration (2016), A century of trends in adult human height, eLife 5:e13410, doi:10.7554/eLife.13410" own="The ends are the lowest and highest national means of adult men born in 1996 in the source, rounded to a centimetre." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.woman k.attributes.range type=k.attributes.number key=size_about kind=woman low=1.5 high=1.7 basis=source cite="NCD Risk Factor Collaboration (2016), A century of trends in adult human height, eLife 5:e13410, doi:10.7554/eLife.13410" own="The ends are the lowest and highest national means of adult women born in 1996 in the source, rounded." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.person k.attributes.range type=k.attributes.number key=size_about kind=person low=1.5 high=1.83 basis=source cite="NCD Risk Factor Collaboration (2016), A century of trends in adult human height, eLife 5:e13410, doi:10.7554/eLife.13410" own="Men and women together: the lowest national mean of women to the highest of men." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.baby k.attributes.range type=k.attributes.number key=size_about kind=baby low=0.5 high=0.75 basis=source cite="WHO Multicentre Growth Reference Study Group (2006), WHO Child Growth Standards: length/height-for-age, World Health Organization" own="From the median length at birth to the median at one year, rounded." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.child k.attributes.range type=k.attributes.number key=size_about kind=child low=0.85 high=1.5 basis=source cite="WHO Multicentre Growth Reference Study Group (2006), WHO Child Growth Standards; de Onis et al. (2007), Bull. World Health Organ. 85:660-667" own="From the median height at two years to the median at twelve, rounded; boy and girl take the same range." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.boy k.attributes.range type=k.attributes.number key=size_about kind=boy low=0.85 high=1.5 basis=source cite="WHO Multicentre Growth Reference Study Group (2006); de Onis et al. (2007), Bull. World Health Organ. 85:660-667" own="As child." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.girl k.attributes.range type=k.attributes.number key=size_about kind=girl low=0.85 high=1.5 basis=source cite="WHO Multicentre Growth Reference Study Group (2006); de Onis et al. (2007), Bull. World Health Organ. 85:660-667" own="As child." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.house k.attributes.range type=k.attributes.number key=size_about kind=house low=5 high=12 basis=own cite="CTBUH Height Calculator: a residential storey is about 3.1 m floor to floor" own="One to three storeys of about 3.1 m and a roof; own choice from the storey height." core.source="hand-core 1"
@k.attributes.range.k.attributes.number.size_about.skyscraper k.attributes.range type=k.attributes.number key=size_about kind=skyscraper low=150 high=350 basis=own cite="CTBUH Height Criteria: a tall building from about 50 m or 14 storeys, supertall from 300 m" own="Own choice: most buildings called skyscrapers lie between 150 m and supertall; the source defines the classes, not this range." core.source="hand-core 1"
@k.attributes.range.w.seating.table.seats k.attributes.range type=w.seating.table key=seats low=4 high=10 basis=own own="A family table seats four to six, a banquet table eight to ten; own choice." core.source="hand-core 1"
@k.attributes.range.w.list.item.quantity k.attributes.range type=w.list.item key=quantity low=1 high=6 basis=own own="A shopping or packing list asks for one to a few of a thing; own choice." core.source="hand-core 1"
