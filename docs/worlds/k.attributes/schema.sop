# k.attributes: the attributes of kinds of things. Which attributes a kind of thing usually has (an animal: legs,
# covering, what it eats; a vehicle: wheels, what it is made of), in which world the values of an attribute are
# found, and the usual values of common things that no other world says: colour, material, wheels, what it can do,
# what it is used for.
# sources: hand-core 1 (hand-written in this repository; the usual values are labelled by a language model)
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/attributes-core.mjs

@k.attributes core.module name=k.attributes version=1 exports=attribute exports=found exports=kind exports=thing exports=aspect exports=family exports=shows exports=drawn exports=same core.source="hand-core 1"

# An attribute of things. `holds` says what kind of value it takes; `aspect` names the aspect it belongs to.
@k.attributes.attribute core.type of=k.attributes.attribute shared=true closed=true core.source="hand-core 1"
@k.attributes.attribute.name core.slot of=k.attributes.attribute key=name id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.attribute.holds core.slot of=k.attributes.attribute key=holds required=true enum=colour enum=material enum=size enum=place enum=kind enum=thing enum=number enum=verb enum=use core.source="hand-core 1"
@k.attributes.attribute.aspect core.slot of=k.attributes.attribute key=aspect required=true kind=atom core.source="hand-core 1"
@k.attributes.attribute.about core.slot of=k.attributes.attribute key=about required=true kind=string core.source="hand-core 1"

# Where the values of an attribute are found: the facts of `type` (in the world `world`) carry them under `key`,
# named by the thing. `covers` says for which things. An attribute is found in several places (the colour of a
# food in k.food, of a common thing here); the values are not copied from one world to another.
@k.attributes.found core.type of=k.attributes.found shared=true closed=true core.source="hand-core 1"
@k.attributes.found.attribute core.slot of=k.attributes.found key=attribute id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.found.world core.slot of=k.attributes.found key=world required=true kind=atom core.source="hand-core 1"
@k.attributes.found.type core.slot of=k.attributes.found key=type id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.found.key core.slot of=k.attributes.found key=key id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.found.covers core.slot of=k.attributes.found key=covers required=true kind=string core.source="hand-core 1"

# A kind of thing and the attributes (many) that things of the kind usually have.
@k.attributes.kind core.type of=k.attributes.kind shared=true closed=true core.source="hand-core 1"
@k.attributes.kind.name core.slot of=k.attributes.kind key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.kind.attribute core.slot of=k.attributes.kind key=attribute many=true required=true kind=atom core.source="hand-core 1"

# The usual values of a common thing, each only where it is plain: a missing key says nothing. `kind` names a
# k.attributes.kind; `colour` (many) is one of the eleven basic colours (the names of k.objects.part.colour and of
# k.values.colour.basic), or the one value `any`: the thing comes in any colour and has no usual one (a car, a
# ball, a shirt); `any` never stands next to a colour. How a thing is drawn is another fact: k.attributes.drawn.
# A host that needs a colour takes the usual one, then the drawn one. `material` (many) what it is usually made of; `wheels` how
# many wheels it usually has (0: it is a vehicle without wheels); `can` (many) what it can do; `used_for` (many)
# what people use it for. `named=model`: the values were given by a language model from the name of the thing.
@k.attributes.thing core.type of=k.attributes.thing shared=true closed=true core.source="hand-core 1"
@k.attributes.thing.name core.slot of=k.attributes.thing key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.thing.kind core.slot of=k.attributes.thing key=kind kind=atom kind=string core.source="hand-core 1"
@k.attributes.thing.colour core.slot of=k.attributes.thing key=colour many=true enum=black enum=white enum=grey enum=red enum=orange enum=yellow enum=green enum=blue enum=purple enum=pink enum=brown enum=any core.source="hand-core 1"
@k.attributes.thing.material core.slot of=k.attributes.thing key=material many=true kind=atom core.source="hand-core 1"
@k.attributes.thing.wheels core.slot of=k.attributes.thing key=wheels kind=integer min=0 core.source="hand-core 1"
@k.attributes.thing.can core.slot of=k.attributes.thing key=can many=true kind=atom core.source="hand-core 1"
@k.attributes.thing.used_for core.slot of=k.attributes.thing key=used_for many=true kind=string core.source="hand-core 1"
@k.attributes.thing.named core.slot of=k.attributes.thing key=named enum=model core.source="hand-core 1"

# The colours a drawable thing is drawn in: computed from the drawing of k.objects that has the name `name`
# (tools/drawn-colour.mjs), the largest first, at most three. `drawn_colour` (many) is one of the eleven basic
# colours; `drawn_shade` (many) is the nearest colour name of k.values.colour to each main fill colour. This says
# how the thing is drawn, never what colour it usually is (a car that happens to be drawn red): the usual colour
# is k.attributes.thing.colour, and the two are never mixed. The source of the fact is the source of the drawing.
@k.attributes.drawn core.type of=k.attributes.drawn shared=true closed=true core.source="hand-core 1"
@k.attributes.drawn.name core.slot of=k.attributes.drawn key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.drawn.drawn_colour core.slot of=k.attributes.drawn key=drawn_colour many=true required=true enum=black enum=white enum=grey enum=red enum=orange enum=yellow enum=green enum=blue enum=purple enum=pink enum=brown core.source="hand-core 1"
@k.attributes.drawn.drawn_shade core.slot of=k.attributes.drawn key=drawn_shade many=true kind=atom kind=string core.source="hand-core 1"

# One name, one thing across worlds (computed by tools/joins.mjs): for a name that facts of more than one world
# carry, its `sense` and the types (`in`, many) whose facts with that name are about that one thing. `only=true`:
# the name has one sense in the whole catalog; `only=false`: it has several, each sense with its own fact, and a
# host must not join facts across them. `unsure` (many): types whose fact gives no sense by itself; `by_word`
# (many): types keyed by the word whatever it means (k.words.sense, k.parts), whose gloss says which sense.
@k.attributes.same core.type of=k.attributes.same shared=true closed=true core.source="hand-core 1"
@k.attributes.same.name core.slot of=k.attributes.same key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.same.sense core.slot of=k.attributes.same key=sense id=true required=true enum=animal enum=food enum=plant enum=person enum="body part" enum=clothing enum=colour enum=shape enum=place enum=time enum="body in space" enum=thing core.source="hand-core 1"
@k.attributes.same.only core.slot of=k.attributes.same key=only required=true kind=boolean core.source="hand-core 1"
@k.attributes.same.in core.slot of=k.attributes.same key=in many=true kind=atom core.source="hand-core 1"
@k.attributes.same.unsure core.slot of=k.attributes.same key=unsure many=true kind=atom core.source="hand-core 1"
@k.attributes.same.by_word core.slot of=k.attributes.same key=by_word many=true kind=atom core.source="hand-core 1"

# An aspect: a side of a thing that one kind of view can show. `shown_in` (many) names the views that show it
# (picture, diagram, chart, map, document, card), where that is plain.
@k.attributes.aspect core.type of=k.attributes.aspect shared=true closed=true core.source="hand-core 1"
@k.attributes.aspect.name core.slot of=k.attributes.aspect key=name id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.aspect.about core.slot of=k.attributes.aspect key=about required=true kind=string core.source="hand-core 1"
@k.attributes.aspect.shown_in core.slot of=k.attributes.aspect key=shown_in many=true enum=picture enum=diagram enum=chart enum=map enum=document enum=card core.source="hand-core 1"

# A family of things that share their aspects: the things of one type of a world (`world`, `type`; the key `by`
# of that type names the thing). The family "common thing" has no type of its own.
@k.attributes.family core.type of=k.attributes.family shared=true closed=true core.source="hand-core 1"
@k.attributes.family.name core.slot of=k.attributes.family key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.family.about core.slot of=k.attributes.family key=about required=true kind=string core.source="hand-core 1"
@k.attributes.family.world core.slot of=k.attributes.family key=world kind=atom core.source="hand-core 1"
@k.attributes.family.type core.slot of=k.attributes.family key=type kind=atom core.source="hand-core 1"
@k.attributes.family.by core.slot of=k.attributes.family key=by kind=atom core.source="hand-core 1"

# A family shows an aspect: the facts of `type` (world `world`) whose key `by` is the name of the thing carry a
# value of the aspect under `key`. A family has an aspect when it has at least one such fact; how many things of
# the family have a value is counted in ASPECTS.md, not here.
@k.attributes.shows core.type of=k.attributes.shows shared=true closed=true core.source="hand-core 1"
@k.attributes.shows.family core.slot of=k.attributes.shows key=family id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.attributes.shows.aspect core.slot of=k.attributes.shows key=aspect required=true kind=atom core.source="hand-core 1"
@k.attributes.shows.world core.slot of=k.attributes.shows key=world required=true kind=atom core.source="hand-core 1"
@k.attributes.shows.type core.slot of=k.attributes.shows key=type id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.shows.key core.slot of=k.attributes.shows key=key id=true required=true kind=atom core.source="hand-core 1"
@k.attributes.shows.by core.slot of=k.attributes.shows key=by required=true kind=atom core.source="hand-core 1"

# Words for the types and keys of this world.
@k.attributes.word.aspect core.word text=aspect text=aspects text=view text=views means=k.attributes.aspect core.source="hand-core 1"
@k.attributes.word.attribute core.word text=attribute text=attributes text=property text=properties text=feature text=features means=k.attributes.attribute core.source="hand-core 1"
@k.attributes.word.colour core.word text=colour text=color text=coloured text=colored means=k.attributes.thing.colour core.source="hand-core 1"
@k.attributes.word.drawn_colour core.word text=drawn text="drawn colour" text="colour of the drawing" means=k.attributes.drawn.drawn_colour core.source="hand-core 1"
@k.attributes.word.material core.word text=material text=made text="made of" text="made from" means=k.attributes.thing.material core.source="hand-core 1"
@k.attributes.word.wheels core.word text=wheel text=wheels means=k.attributes.thing.wheels core.source="hand-core 1"
@k.attributes.word.can core.word text=can text=able means=k.attributes.thing.can core.source="hand-core 1"
@k.attributes.word.used_for core.word text=use text=used text="used for" text=for means=k.attributes.thing.used_for core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.attributes.word.key.attribute.holds core.word text=holds means=k.attributes.attribute.holds core.source="hand-core 1"
@k.attributes.word.key.attribute.aspect core.word text=aspect means=k.attributes.attribute.aspect core.source="hand-core 1"
@k.attributes.word.key.attribute.about core.word text=about means=k.attributes.attribute.about core.source="hand-core 1"
@k.attributes.word.key.found.world core.word text=world means=k.attributes.found.world core.source="hand-core 1"
@k.attributes.word.key.found.type core.word text=type means=k.attributes.found.type core.source="hand-core 1"
@k.attributes.word.key.found.key core.word text=key means=k.attributes.found.key core.source="hand-core 1"
@k.attributes.word.key.found.covers core.word text=covers means=k.attributes.found.covers core.source="hand-core 1"
@k.attributes.word.key.kind.attribute core.word text=attribute means=k.attributes.kind.attribute core.source="hand-core 1"
@k.attributes.word.key.thing.kind core.word text=kind means=k.attributes.thing.kind core.source="hand-core 1"
@k.attributes.word.key.thing.wheels core.word text=many means=k.attributes.thing.wheels core.source="hand-core 1"
@k.attributes.word.key.thing.can core.word text=do means=k.attributes.thing.can core.source="hand-core 1"
@k.attributes.word.key.thing.named core.word text=named means=k.attributes.thing.named core.source="hand-core 1"
@k.attributes.word.key.drawn.drawn_shade core.word text="drawn shade" means=k.attributes.drawn.drawn_shade core.source="hand-core 1"
@k.attributes.word.key.same.sense core.word text=sense means=k.attributes.same.sense core.source="hand-core 1"
@k.attributes.word.key.same.only core.word text=only means=k.attributes.same.only core.source="hand-core 1"
@k.attributes.word.key.same.in core.word text=in means=k.attributes.same.in core.source="hand-core 1"
@k.attributes.word.key.same.unsure core.word text=unsure means=k.attributes.same.unsure core.source="hand-core 1"
@k.attributes.word.key.same.by_word core.word text="by word" means=k.attributes.same.by_word core.source="hand-core 1"
@k.attributes.word.key.aspect.about core.word text=about means=k.attributes.aspect.about core.source="hand-core 1"
@k.attributes.word.key.aspect.shown_in core.word text="shown in" means=k.attributes.aspect.shown_in core.source="hand-core 1"
@k.attributes.word.key.family.about core.word text=about means=k.attributes.family.about core.source="hand-core 1"
@k.attributes.word.key.family.world core.word text=world means=k.attributes.family.world core.source="hand-core 1"
@k.attributes.word.key.family.type core.word text=type means=k.attributes.family.type core.source="hand-core 1"
@k.attributes.word.key.family.by core.word text=by means=k.attributes.family.by core.source="hand-core 1"
@k.attributes.word.key.shows.aspect core.word text=aspect means=k.attributes.shows.aspect core.source="hand-core 1"
@k.attributes.word.key.shows.world core.word text=world means=k.attributes.shows.world core.source="hand-core 1"
@k.attributes.word.key.shows.type core.word text=type means=k.attributes.shows.type core.source="hand-core 1"
@k.attributes.word.key.shows.key core.word text=key means=k.attributes.shows.key core.source="hand-core 1"
@k.attributes.word.key.shows.by core.word text=by means=k.attributes.shows.by core.source="hand-core 1"
