# k.objects/shards/food-2: vodka, dough, ginger, brandy. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# vodka
@k.objects.vodka k.objects.object name=vodka core.source="hand-core 1"
@k.objects.vodka.bottle k.objects.part of=vodka name=bottle shape=rectangle x=26 y=36 w=26 h=54 z=1 colour=white colour=blue core.source="hand-core 1"
@k.objects.vodka.shoulder k.objects.part of=vodka name=shoulder shape=triangle x=26 y=26 w=26 h=10 z=1 colour=white colour=blue pointing=up above=bottle core.source="hand-core 1"
@k.objects.vodka.neck k.objects.part of=vodka name=neck shape=rectangle x=34 y=14 w=10 h=16 z=2 colour=white colour=blue above=bottle core.source="hand-core 1"
@k.objects.vodka.cap k.objects.part of=vodka name=cap shape=rectangle x=33 y=6 w=12 h=9 z=3 colour=red colour=blue above=neck core.source="hand-core 1"
@k.objects.vodka.label k.objects.part of=vodka name=label shape=rectangle x=26 y=52 w=26 h=20 z=2 colour=red colour=blue inside=bottle core.source="hand-core 1"
@k.objects.vodka.label_band k.objects.part of=vodka name=label_band shape=rectangle x=26 y=59 w=26 h=5 z=3 colour=white inside=label core.source="hand-core 1"
@k.objects.vodka.shot_glass k.objects.part of=vodka name=shot_glass shape=polygon x=62 y=66 w=22 h=24 z=1 colour=white colour=blue right_of=bottle core.source="hand-core 1"
@k.objects.vodka.glass_base k.objects.part of=vodka name=glass_base shape=rectangle x=66 y=85 w=14 h=5 z=2 colour=grey colour=white inside=shot_glass core.source="hand-core 1"
@k.objects.vodka.shot_glass.p1 k.objects.point part=$k.objects.vodka.shot_glass n=1 x=62 y=66 core.source="hand-core 1"
@k.objects.vodka.shot_glass.p2 k.objects.point part=$k.objects.vodka.shot_glass n=2 x=84 y=66 core.source="hand-core 1"
@k.objects.vodka.shot_glass.p3 k.objects.point part=$k.objects.vodka.shot_glass n=3 x=80 y=90 core.source="hand-core 1"
@k.objects.vodka.shot_glass.p4 k.objects.point part=$k.objects.vodka.shot_glass n=4 x=66 y=90 core.source="hand-core 1"

# dough
@k.objects.dough k.objects.object name=dough core.source="hand-core 1"
