@k.objects.ginger.lower_knob k.objects.part of=ginger name=lower_knob kind=knob shape=oval x=36 y=58 w=22 h=20 z=1 colour=yellow colour=brown below=root core.source="hand-core 1"
@k.objects.ginger.right_knob k.objects.part of=ginger name=right_knob kind=knob shape=oval x=62 y=50 w=28 h=16 z=1 colour=yellow colour=brown right_of=root core.source="hand-core 1"
@k.objects.ginger.tip k.objects.part of=ginger name=tip kind=knob shape=oval x=76 y=18 w=12 h=12 z=0 colour=yellow colour=brown core.source="hand-core 1"
@k.objects.ginger.ring_1 k.objects.part of=ginger name=ring_1 kind=ring shape=arc x=30 y=44 w=8 h=16 z=3 colour=brown opens=left inside=root core.source="hand-core 1"
@k.objects.ginger.ring_2 k.objects.part of=ginger name=ring_2 kind=ring shape=arc x=46 y=44 w=8 h=16 z=3 colour=brown opens=left inside=root core.source="hand-core 1"
@k.objects.ginger.ring_3 k.objects.part of=ginger name=ring_3 kind=ring shape=arc x=70 y=30 w=6 h=12 z=3 colour=brown opens=left inside=upper_knob core.source="hand-core 1"
@k.objects.ginger.cut k.objects.part of=ginger name=cut shape=oval x=8 y=34 w=9 h=11 z=3 colour=white colour=yellow inside=left_knob core.source="hand-core 1"

