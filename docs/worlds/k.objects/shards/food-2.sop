@k.objects.dough.left_handle k.objects.part of=dough name=left_handle kind=handle shape=rectangle x=31 y=21 w=9 h=4 z=2 colour=brown colour=yellow left_of=roller core.source="hand-core 1"
@k.objects.dough.right_handle k.objects.part of=dough name=right_handle kind=handle shape=rectangle x=80 y=21 w=9 h=4 z=2 colour=brown colour=yellow right_of=roller core.source="hand-core 1"
@k.objects.dough.flour_1 k.objects.part of=dough name=flour_1 kind=flour shape=circle x=10 y=66 w=3 h=3 z=2 colour=white core.source="hand-core 1"
@k.objects.dough.flour_2 k.objects.part of=dough name=flour_2 kind=flour shape=circle x=84 y=68 w=3 h=3 z=2 colour=white core.source="hand-core 1"
@k.objects.dough.flour_3 k.objects.part of=dough name=flour_3 kind=flour shape=circle x=80 y=60 w=3 h=3 z=2 colour=white core.source="hand-core 1"
@k.objects.dough.crease.p1 k.objects.point part=$k.objects.dough.crease n=1 x=50 y=60 core.source="hand-core 1"
@k.objects.dough.crease.p2 k.objects.point part=$k.objects.dough.crease n=2 x=64 y=66 core.source="hand-core 1"

# ginger
@k.objects.ginger k.objects.object name=ginger core.source="hand-core 1"
