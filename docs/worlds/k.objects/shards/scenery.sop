# sandcastle
@k.objects.sandcastle k.objects.object name=sandcastle core.source="hand-core 1"
@k.objects.sandcastle.sand k.objects.part of=sandcastle name=sand shape=oval x=4 y=78 w=92 h=16 z=0 colour=yellow core.source="hand-core 1"
@k.objects.sandcastle.wall k.objects.part of=sandcastle name=wall shape=rectangle x=24 y=56 w=52 h=30 z=1 colour=yellow colour=orange core.source="hand-core 1"
@k.objects.sandcastle.left_tower k.objects.part of=sandcastle name=left_tower kind=tower left_of=keep shape=rectangle x=12 y=42 w=20 h=44 z=2 colour=yellow colour=orange core.source="hand-core 1"
@k.objects.sandcastle.right_tower k.objects.part of=sandcastle name=right_tower kind=tower right_of=keep shape=rectangle x=68 y=42 w=20 h=44 z=2 colour=yellow colour=orange core.source="hand-core 1"
@k.objects.sandcastle.keep k.objects.part of=sandcastle name=keep shape=rectangle x=40 y=30 w=20 h=30 z=2 colour=yellow colour=orange core.source="hand-core 1"
@k.objects.sandcastle.left_roof k.objects.part of=sandcastle name=left_roof kind=roof pointing=up above=left_tower shape=triangle x=10 y=26 w=24 h=16 z=3 colour=orange core.source="hand-core 1"
@k.objects.sandcastle.right_roof k.objects.part of=sandcastle name=right_roof kind=roof pointing=up above=right_tower shape=triangle x=66 y=26 w=24 h=16 z=3 colour=orange core.source="hand-core 1"
@k.objects.sandcastle.door k.objects.part of=sandcastle name=door shape=oval x=44 y=66 w=12 h=20 z=3 colour=brown inside=wall core.source="hand-core 1"
@k.objects.sandcastle.flagpole k.objects.part of=sandcastle name=flagpole shape=line x=50 y=10 w=0 h=20 z=3 colour=brown above=keep core.source="hand-core 1"
@k.objects.sandcastle.flag k.objects.part of=sandcastle name=flag shape=triangle x=50 y=10 w=14 h=9 z=4 colour=red pointing=right core.source="hand-core 1"
@k.objects.sandcastle.flagpole.p1 k.objects.point part=$k.objects.sandcastle.flagpole n=1 x=50 y=30 core.source="hand-core 1"
@k.objects.sandcastle.flagpole.p2 k.objects.point part=$k.objects.sandcastle.flagpole n=2 x=50 y=10 core.source="hand-core 1"

# Words: the plural forms and other names of the objects of this shard.
@k.objects.word.lake core.word text=lake text=lakes means=lake of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.mountain_lake core.word text="mountain lake" text="mountain lakes" text=tarn means="mountain lake" of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.river core.word text=river text=rivers text=stream text=streams text=brook means=river of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.sea core.word text=sea text=seas text=ocean text=oceans means=sea of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.sandcastle core.word text=sandcastle text=sandcastles text="sand castle" text="sand castles" means=sandcastle of=k.objects.object.name core.source="hand-core 1"
