# k.objects/shards/scenery: lake, mountain lake, river, sea, sandcastle: what a scene is made of. Parts with a primitive shape, a box in the
# 0 to 100 frame of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# lake
@k.objects.lake k.objects.object name=lake core.source="hand-core 1"
@k.objects.lake.water k.objects.part of=lake name=water shape=oval x=3 y=22 w=94 h=56 z=0 colour=blue core.source="hand-core 1"
@k.objects.lake.ripple_1 k.objects.part of=lake name=ripple_1 kind=ripple inside=water shape=line x=22 y=40 w=20 h=0 z=1 colour=white core.source="hand-core 1"
@k.objects.lake.ripple_2 k.objects.part of=lake name=ripple_2 kind=ripple inside=water shape=line x=52 y=50 w=24 h=0 z=1 colour=white core.source="hand-core 1"
@k.objects.lake.ripple_3 k.objects.part of=lake name=ripple_3 kind=ripple inside=water shape=line x=30 y=62 w=18 h=0 z=1 colour=white core.source="hand-core 1"
@k.objects.lake.ripple_1.p1 k.objects.point part=$k.objects.lake.ripple_1 n=1 x=22 y=40 core.source="hand-core 1"
@k.objects.lake.ripple_1.p2 k.objects.point part=$k.objects.lake.ripple_1 n=2 x=42 y=40 core.source="hand-core 1"
@k.objects.lake.ripple_2.p1 k.objects.point part=$k.objects.lake.ripple_2 n=1 x=52 y=50 core.source="hand-core 1"
@k.objects.lake.ripple_2.p2 k.objects.point part=$k.objects.lake.ripple_2 n=2 x=76 y=50 core.source="hand-core 1"
@k.objects.lake.ripple_3.p1 k.objects.point part=$k.objects.lake.ripple_3 n=1 x=30 y=62 core.source="hand-core 1"
@k.objects.lake.ripple_3.p2 k.objects.point part=$k.objects.lake.ripple_3 n=2 x=48 y=62 core.source="hand-core 1"

