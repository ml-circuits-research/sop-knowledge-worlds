@k.objects.sea.wave_4 k.objects.part of=sea name=wave_4 kind=wave opens=down inside=water shape=arc x=20 y=62 w=22 h=6 z=2 colour=white core.source="hand-core 1"
@k.objects.sea.wave_5 k.objects.part of=sea name=wave_5 kind=wave opens=down inside=water shape=arc x=56 y=64 w=22 h=6 z=2 colour=white core.source="hand-core 1"
