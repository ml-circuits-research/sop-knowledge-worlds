# k.genres/shards/registers: 5 registers (scientific, presentation, essay, narrative, report): person, tense, voice, sentence length, sentences per paragraph, vocabulary band, formality and what each allows.
# sources: hand-core 1 (hand-written in this repository: tools/genres-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/genres-core.mjs

@k.genres.register.scientific k.genres.register name=scientific about="Impersonal and exact: the writer as \"we\" or not at all, the present for what holds generally and the past for what was done and found, claims hedged and cited, numbers with units, terms defined." person="first plural" person_also=third tense=present passive=true sentence_min=12 sentence_typical=22 sentence_max=32 paragraph_min=3 paragraph_max=7 vocabulary_band=5 formality=formal contractions=false hedging=true citations=true units=true definitions=true direct_speech=false questions=false source=apa2020 source=swalesFeak2012 source=hyland1998 source=biberConrad2009 own="The sentence lengths, sentences per paragraph and the vocabulary band (rare and technical words allowed, defined at first use)." core.source="hand-core 1"
@k.genres.register.presentation k.genres.register name=presentation about="Spoken and direct: \"we\" and \"you\", the present tense, short sentence headlines, one assertion per slide, few words on a slide." person="first plural" person_also=second tense=present passive=false sentence_min=4 sentence_typical=10 sentence_max=16 paragraph_min=1 paragraph_max=4 vocabulary_band=3 formality=neutral contractions=true hedging=false citations=true units=true definitions=true direct_speech=false questions=true source=alley2013 source=alleyNeeley2005 source=mayer2009 source=cutts2013 own="The lengths (a headline sentence of at most about two lines), one to four sentences on a slide, and the vocabulary band." core.source="hand-core 1"
@k.genres.register.essay k.genres.register name=essay about="Argued and personal: \"I\" may state the position, the present tense, claims supported and qualified, a question to draw the reader in." person="first singular" person_also=third person_also="first plural" tense=present passive=true sentence_min=8 sentence_typical=18 sentence_max=28 paragraph_min=3 paragraph_max=6 vocabulary_band=4 formality=formal contractions=false hedging=true citations=true units=true definitions=true direct_speech=false questions=true source=hyland1990 source=hyland2005 source=toulmin1958 source=biberConrad2009 own="The sentence lengths, sentences per paragraph and the vocabulary band." core.source="hand-core 1"
@k.genres.register.narrative k.genres.register name=narrative about="Told: the third person (or \"I\" for one's own story), the past tense in the order of the events, concrete and short sentences, the characters' words in quotes." person=third person_also="first singular" tense=past passive=false sentence_min=4 sentence_typical=11 sentence_max=20 paragraph_min=1 paragraph_max=5 vocabulary_band=2 formality=informal contractions=true hedging=false citations=false units=false definitions=false direct_speech=true questions=false source=labovWaletzky1967 source=biberConrad2009 source=flesch1948 own="The sentence lengths and the vocabulary band (short sentences and common words, readable by children)." core.source="hand-core 1"
@k.genres.register.report k.genres.register name=report about="Plain and factual: \"we\", the past tense for what was done, the present for results that hold, the future for next steps, numbers with units, no hedging beyond the evidence." person="first plural" person_also=third tense=past passive=true sentence_min=8 sentence_typical=15 sentence_max=24 paragraph_min=2 paragraph_max=5 vocabulary_band=3 formality=neutral contractions=false hedging=false citations=false units=true definitions=false direct_speech=false questions=false source=niso2005 source=cutts2013 source=flesch1948 own="The sentence lengths (an average of about 15 after Cutts' 15-20), sentences per paragraph and the vocabulary band." core.source="hand-core 1"
