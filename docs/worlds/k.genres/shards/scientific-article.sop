@k.genres.step.scientific_article.introduction.1.claim_centrality k.genres.step genre="scientific article" part=introduction n=1 move="claim centrality" min=0 max=1 stage="establishing a territory" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.2.generalise k.genres.step genre="scientific article" part=introduction n=2 move=generalise min=1 max=2 stage="establishing a territory" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.3.review_previous_work k.genres.step genre="scientific article" part=introduction n=3 move="review previous work" min=1 max=3 stage="establishing a territory" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.4.indicate_a_gap k.genres.step genre="scientific article" part=introduction n=4 move="indicate a gap" min=1 max=1 stage="establishing a niche" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.4.raise_a_question k.genres.step genre="scientific article" part=introduction n=4 move="raise a question" min=1 max=1 stage="establishing a niche" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.4.counter-claim k.genres.step genre="scientific article" part=introduction n=4 move=counter-claim min=1 max=1 stage="establishing a niche" source=swales1990 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.5.state_purpose k.genres.step genre="scientific article" part=introduction n=5 move="state purpose" min=1 max=1 stage="occupying the niche" source=swales1990 source=swales2004 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.6.announce_findings k.genres.step genre="scientific article" part=introduction n=6 move="announce findings" min=0 max=1 stage="occupying the niche" source=swales2004 core.source="hand-core 1"
@k.genres.step.scientific_article.introduction.7.outline_structure k.genres.step genre="scientific article" part=introduction n=7 move="outline structure" min=0 max=1 stage="occupying the niche" source=swales2004 core.source="hand-core 1"

# methods
@k.genres.part.scientific_article.methods k.genres.part genre="scientific article" name=methods n=3 min=1 max=1 heading=Methods tense=past about="What was done: the facts used and how they were measured or compared." source=apa2020 source=sollaci2004 core.source="hand-core 1"
@k.genres.step.scientific_article.methods.1.describe_method k.genres.step genre="scientific article" part=methods n=1 move="describe method" min=2 max=5 source=apa2020 core.source="hand-core 1"

# results
@k.genres.part.scientific_article.results k.genres.part genre="scientific article" name=results n=4 min=1 max=1 heading=Results tense=past about="What was found, with numbers and units, compared where it helps." source=apa2020 source=yangAllison2003 core.source="hand-core 1"
