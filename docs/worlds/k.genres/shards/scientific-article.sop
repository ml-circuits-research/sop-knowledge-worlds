@k.genres.step.scientific_article.discussion.1.summarize k.genres.step genre="scientific article" part=discussion n=1 move=summarize min=1 max=1 tense=past about="the main findings again" source=yangAllison2003 core.source="hand-core 1"
@k.genres.step.scientific_article.discussion.2.interpret_result k.genres.step genre="scientific article" part=discussion n=2 move="interpret result" min=1 max=3 about="comment on the findings" source=yangAllison2003 source=hyland1998 core.source="hand-core 1"
@k.genres.step.scientific_article.discussion.2.compare k.genres.step genre="scientific article" part=discussion n=2 move=compare min=1 max=3 about="comment on the findings" source=yangAllison2003 source=hyland1998 core.source="hand-core 1"
@k.genres.step.scientific_article.discussion.2.surprising_fact k.genres.step genre="scientific article" part=discussion n=2 move="surprising fact" min=1 max=3 about="comment on the findings" source=yangAllison2003 source=hyland1998 core.source="hand-core 1"
@k.genres.step.scientific_article.discussion.3.state_limitation k.genres.step genre="scientific article" part=discussion n=3 move="state limitation" min=0 max=1 source=yangAllison2003 core.source="hand-core 1"
