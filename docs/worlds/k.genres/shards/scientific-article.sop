# k.genres/shards/scientific-article: the genre "scientific article": 6 parts in order with how many times each occurs, and 27 steps (the moves of each part in order, with alternatives and sentence counts).
# sources: hand-core 1 (hand-written in this repository: tools/genres-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/genres-core.mjs

@k.genres.genre.scientific_article k.genres.genre name="scientific article" about="A research article: an abstract, then introduction, methods, results and discussion (IMRaD), and an optional conclusion; the introduction makes the moves of Swales' CARS model." register=scientific unit=chapter also_move=define also_move=transition also_move="give example" source=sollaci2004 source=apa2020 source=swales1990 source=swales2004 own="The conclusion as a part of its own (optional) and the counts of sentences per move." core.source="hand-core 1"

# abstract
@k.genres.part.scientific_article.abstract k.genres.part genre="scientific article" name=abstract n=1 min=1 max=1 heading=Abstract about="The whole article in a few sentences, one for each move." source=hyland2000 source=apa2020 core.source="hand-core 1"
@k.genres.step.scientific_article.abstract.1.introduce_topic k.genres.step genre="scientific article" part=abstract n=1 move="introduce topic" min=0 max=1 stage=introduction source=hyland2000 core.source="hand-core 1"
@k.genres.step.scientific_article.abstract.2.state_purpose k.genres.step genre="scientific article" part=abstract n=2 move="state purpose" min=1 max=1 stage=purpose source=hyland2000 core.source="hand-core 1"
@k.genres.step.scientific_article.abstract.3.describe_method k.genres.step genre="scientific article" part=abstract n=3 move="describe method" min=1 max=1 stage=method tense=past source=hyland2000 core.source="hand-core 1"
@k.genres.step.scientific_article.abstract.4.report_result k.genres.step genre="scientific article" part=abstract n=4 move="report result" min=1 max=2 stage=product tense=past source=hyland2000 core.source="hand-core 1"
@k.genres.step.scientific_article.abstract.5.conclude k.genres.step genre="scientific article" part=abstract n=5 move=conclude min=1 max=1 stage=conclusion source=hyland2000 core.source="hand-core 1"

