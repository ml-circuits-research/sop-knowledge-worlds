# k.genres/shards/sources: the 24 published works the genres, moves and registers rest on: reference, year, DOI where sure, and what this world takes from each.
# sources: hand-core 1 (hand-written in this repository: tools/genres-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/genres-core.mjs

@k.genres.source.aristotle k.genres.source name=aristotle cite="Aristotle (c. 335 BCE). Poetics, chapter 7. Translated by S. H. Butcher (1895) as The Poetics of Aristotle. London: Macmillan." year=-335 finding="A whole plot has a beginning, a middle and an end: what follows nothing necessarily, what follows one thing and is followed by another, and what follows and is followed by nothing." core.source="hand-core 1"
@k.genres.source.freytag1863 k.genres.source name=freytag1863 cite="Freytag, G. (1863). Die Technik des Dramas. Leipzig: S. Hirzel. Translated by E. J. MacEwan (1895) as Technique of the Drama. Chicago: S. C. Griggs." year=1863 finding="A drama rises and falls in five parts: introduction (exposition), rising action, climax, falling action (return), and catastrophe (the outcome)." core.source="hand-core 1"
@k.genres.source.labovWaletzky1967 k.genres.source name=labovWaletzky1967 cite="Labov, W., & Waletzky, J. (1967). Narrative analysis: Oral versions of personal experience. In J. Helm (Ed.), Essays on the Verbal and Visual Arts (pp. 12-44). Seattle: University of Washington Press." year=1967 finding="A narrative has an orientation (who, where, when), a complication, an evaluation (why it is worth telling), a resolution and a coda that returns to the present; its narrative clauses are in the past tense, in the order of the events." core.source="hand-core 1"
@k.genres.source.mandlerJohnson1977 k.genres.source name=mandlerJohnson1977 cite="Mandler, J. M., & Johnson, N. S. (1977). Remembrance of things parsed: Story structure and recall. Cognitive Psychology, 9(1), 111-151." year=1977 doi="10.1016/0010-0285(77)90006-8" finding="A story is a setting and one or more episodes; an episode is a beginning, a development (a reaction, a goal, an attempt and its outcome) and an ending; stories told in this structure are recalled best." core.source="hand-core 1"
@k.genres.source.steinGlenn1979 k.genres.source name=steinGlenn1979 cite="Stein, N. L., & Glenn, C. G. (1979). An analysis of story comprehension in elementary school children. In R. O. Freedle (Ed.), New Directions in Discourse Processing (pp. 53-120). Norwood, NJ: Ablex." year=1979 finding="An episode is an initiating event, an internal response (a goal), an attempt, a consequence and a reaction, after a setting that introduces the protagonist." core.source="hand-core 1"
@k.genres.source.swales1990 k.genres.source name=swales1990 cite="Swales, J. M. (1990). Genre Analysis: English in Academic and Research Settings. Cambridge: Cambridge University Press." year=1990 finding="Research article introductions make three moves (Create a Research Space): establishing a territory (claiming centrality, generalising, reviewing previous research), establishing a niche (counter-claiming, indicating a gap, raising a question) and occupying the niche (purposes, findings, structure)." core.source="hand-core 1"
@k.genres.source.swales2004 k.genres.source name=swales2004 cite="Swales, J. M. (2004). Research Genres: Explorations and Applications. Cambridge: Cambridge University Press." year=2004 finding="In the revised CARS model the third move presents the present work: announcing it is obligatory; research questions, principal findings and the structure of the paper are optional steps." core.source="hand-core 1"
@k.genres.source.swalesFeak2012 k.genres.source name=swalesFeak2012 cite="Swales, J. M., & Feak, C. B. (2012). Academic Writing for Graduate Students: Essential Tasks and Skills (3rd ed.). Ann Arbor: University of Michigan Press." year=2012 finding="Academic texts move from general to specific, define their terms, comment on data by comparing and highlighting, use the present tense for general statements and the past for one's own procedures and results, and qualify claims." core.source="hand-core 1"
@k.genres.source.sollaci2004 k.genres.source name=sollaci2004 cite="Sollaci, L. B., & Pereira, M. G. (2004). The introduction, methods, results, and discussion (IMRAD) structure: a fifty-year survey. Journal of the Medical Library Association, 92(3), 364-367." year=2004 finding="IMRaD (introduction, methods, results, discussion) became the standard structure of original research articles, used by nearly all of them from the 1980s on." core.source="hand-core 1"
@k.genres.source.apa2020 k.genres.source name=apa2020 cite="American Psychological Association. (2020). Publication Manual of the American Psychological Association (7th ed.). Washington, DC: American Psychological Association." year=2020 doi="10.1037/0000165-000" finding="A research report has a title, an abstract, an introduction, a method, results and a discussion; the past tense is used for the method and the results, the present for implications; the active voice and the first person are preferred; numbers go with their units; claims cite their sources." core.source="hand-core 1"
@k.genres.source.hyland1998 k.genres.source name=hyland1998 cite="Hyland, K. (1998). Hedging in Scientific Research Articles. Amsterdam: John Benjamins." year=1998 finding="Scientific writers hedge their claims (may, suggest, appear, possibly) to state them with the caution the evidence allows; hedges are densest where results are interpreted." core.source="hand-core 1"
@k.genres.source.hyland2000 k.genres.source name=hyland2000 cite="Hyland, K. (2000). Disciplinary Discourses: Social Interactions in Academic Writing. Harlow: Longman." year=2000 finding="Research article abstracts make up to five moves: introduction, purpose, method, product (the results) and conclusion." core.source="hand-core 1"
@k.genres.source.hyland2005 k.genres.source name=hyland2005 cite="Hyland, K. (2005). Metadiscourse: Exploring Interaction in Writing. London: Continuum." year=2005 finding="Writers guide readers with transitions and frame markers (first, in conclusion), engage them with questions, and adjust hedges and boosters to the genre." core.source="hand-core 1"
@k.genres.source.hyland1990 k.genres.source name=hyland1990 cite="Hyland, K. (1990). A genre description of the argumentative essay. RELC Journal, 21(1), 66-78." year=1990 finding="An argumentative essay has three stages: thesis (gambit, information, proposition, evidence, marker), argument (marker, restatement, claim, support; repeated) and conclusion (marker, consolidation, affirmation, close)." core.source="hand-core 1"
@k.genres.source.toulmin1958 k.genres.source name=toulmin1958 cite="Toulmin, S. E. (1958). The Uses of Argument. Cambridge: Cambridge University Press." year=1958 finding="An argument is a claim supported by data through a warrant, with a qualifier of its force and a rebuttal that names when it does not hold." core.source="hand-core 1"
@k.genres.source.yangAllison2003 k.genres.source name=yangAllison2003 cite="Yang, R., & Allison, D. (2003). Research articles in applied linguistics: Moving from results to conclusions. English for Specific Purposes, 22(4), 365-385." year=2003 finding="Results and discussion sections report results, comment on them (interpreting, comparing with the literature), summarise them, evaluate the study (its limitations) and draw deductions (recommendations for further research)." core.source="hand-core 1"
@k.genres.source.alley2013 k.genres.source name=alley2013 cite="Alley, M. (2013). The Craft of Scientific Presentations: Critical Steps to Succeed and Critical Errors to Avoid (2nd ed.). New York: Springer." year=2013 finding="A presentation is built on a few main points announced in a mapping (agenda) slide; each slide makes one assertion, stated as a sentence headline and supported by evidence; the end summarises the points and invites questions." core.source="hand-core 1"
@k.genres.source.alleyNeeley2005 k.genres.source name=alleyNeeley2005 cite="Alley, M., & Neeley, K. A. (2005). Rethinking the design of presentation slides: A case for sentence headlines and visual evidence. Technical Communication, 52(4), 417-426." year=2005 finding="Slides with a short sentence headline and evidence instead of a topic phrase and a bullet list help the audience keep the assertion of each slide." core.source="hand-core 1"
@k.genres.source.mayer2009 k.genres.source name=mayer2009 cite="Mayer, R. E. (2009). Multimedia Learning (2nd ed.). New York: Cambridge University Press." year=2009 finding="People learn better when the organisation is signalled (an outline, headings), the material comes in parts at the learner's pace, and extraneous material is left out (signalling, segmenting, coherence)." core.source="hand-core 1"
@k.genres.source.cowan2001 k.genres.source name=cowan2001 cite="Cowan, N. (2001). The magical number 4 in short-term memory: A reconsideration of mental storage capacity. Behavioral and Brain Sciences, 24(1), 87-114." year=2001 doi="10.1017/S0140525X01003922" finding="About four chunks (three to five) are held in mind at once." core.source="hand-core 1"
@k.genres.source.niso2005 k.genres.source name=niso2005 cite="National Information Standards Organization. (2005, reaffirmed 2010). ANSI/NISO Z39.18-2005 (R2010): Scientific and Technical Reports - Preparation, Presentation, and Preservation. Bethesda, MD: NISO Press." year=2005 finding="The text of a report is a summary, an introduction (purpose and scope), methods, assumptions and procedures, results and discussion, conclusions and recommendations." core.source="hand-core 1"
@k.genres.source.biberConrad2009 k.genres.source name=biberConrad2009 cite="Biber, D., & Conrad, S. (2009). Register, Genre, and Style. Cambridge: Cambridge University Press." year=2009 finding="A register is described by its situation of use and the language features that are typical in it because they serve that situation: pronouns, tense, nominalisation, sentence length, vocabulary." core.source="hand-core 1"
@k.genres.source.flesch1948 k.genres.source name=flesch1948 cite="Flesch, R. (1948). A new readability yardstick. Journal of Applied Psychology, 32(3), 221-233." year=1948 doi="10.1037/h0057532" finding="Reading ease falls as the average sentence length in words and the average word length in syllables grow." core.source="hand-core 1"
@k.genres.source.cutts2013 k.genres.source name=cutts2013 cite="Cutts, M. (2013). Oxford Guide to Plain English (4th ed.). Oxford: Oxford University Press." year=2013 finding="Plain writing keeps the average sentence to 15-20 words, prefers the active voice and everyday words, and uses \"we\" and \"you\"." core.source="hand-core 1"
