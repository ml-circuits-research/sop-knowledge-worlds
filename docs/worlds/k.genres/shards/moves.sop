# k.genres/shards/moves: 43 rhetorical moves (what a sentence does for the reader), what a composer fills each with, and the works that name them.
# sources: hand-core 1 (hand-written in this repository: tools/genres-core.mjs; the works cited are in WORLD.md)
# license: CC0-1.0
# script: tools/genres-core.mjs

@k.genres.move.introduce_topic k.genres.move name="introduce topic" about="Name the topic and give the background a reader needs." takes=topic source=hyland1990 source=alley2013 source=niso2005 core.source="hand-core 1"
@k.genres.move.claim_centrality k.genres.move name="claim centrality" about="Say that the topic matters, or that many have studied it." takes=topic source=swales1990 core.source="hand-core 1"
@k.genres.move.generalise k.genres.move name=generalise about="State what is generally true of the topic or of its kind." takes=fact source=swales1990 source=swalesFeak2012 core.source="hand-core 1"
@k.genres.move.review_previous_work k.genres.move name="review previous work" about="Report what earlier work found, with its source." takes=fact source=swales1990 core.source="hand-core 1"
@k.genres.move.indicate_a_gap k.genres.move name="indicate a gap" about="Say what is not yet known or not yet done about the topic." takes=question source=swales1990 core.source="hand-core 1"
@k.genres.move.raise_a_question k.genres.move name="raise a question" about="Ask a question the text goes on to answer." takes=question source=swales1990 source=hyland1990 source=hyland2005 core.source="hand-core 1"
@k.genres.move.counter-claim k.genres.move name=counter-claim about="Say that something commonly believed about the topic does not hold." takes=fact source=swales1990 core.source="hand-core 1"
@k.genres.move.state_purpose k.genres.move name="state purpose" about="Say what this text does." takes=topic source=swales1990 source=swales2004 source=niso2005 core.source="hand-core 1"
@k.genres.move.announce_findings k.genres.move name="announce findings" about="Say in advance what was found." takes=facts source=swales2004 core.source="hand-core 1"
@k.genres.move.outline_structure k.genres.move name="outline structure" about="Say what the parts that follow are, in order." takes=outline source=swales2004 source=mayer2009 source=alley2013 source=hyland1990 core.source="hand-core 1"
@k.genres.move.define k.genres.move name=define about="Say what a term means at its first use (its kind and what sets it apart)." takes=fact source=swalesFeak2012 core.source="hand-core 1"
@k.genres.move.describe_method k.genres.move name="describe method" about="Say what was done and how: which facts were used and how they were measured or compared." takes=fact source=apa2020 source=hyland2000 core.source="hand-core 1"
@k.genres.move.report_result k.genres.move name="report result" about="State a finding, with its number and unit where it has one." takes=fact source=yangAllison2003 source=apa2020 source=hyland2000 core.source="hand-core 1"
@k.genres.move.compare k.genres.move name=compare about="Set two things side by side on one attribute." takes=facts source=yangAllison2003 source=swalesFeak2012 core.source="hand-core 1"
@k.genres.move.surprising_fact k.genres.move name="surprising fact" about="State a fact that goes against what the reader expects (an exception of its kind, a number far from the usual)." takes=fact source=hyland1990 core.source="hand-core 1"
@k.genres.move.give_example k.genres.move name="give example" about="Give a thing that is an instance of what was just said." takes=fact source=swalesFeak2012 source=alley2013 core.source="hand-core 1"
@k.genres.move.interpret_result k.genres.move name="interpret result" about="Say what a finding means, with the caution the evidence allows." takes=fact source=yangAllison2003 source=hyland1998 core.source="hand-core 1"
@k.genres.move.state_limitation k.genres.move name="state limitation" about="Say what the work could not show or did not cover." takes=topic source=yangAllison2003 core.source="hand-core 1"
@k.genres.move.recommend k.genres.move name=recommend about="Say what should be done or found out next." takes=question source=yangAllison2003 source=niso2005 core.source="hand-core 1"
@k.genres.move.summarize k.genres.move name=summarize about="Restate the main points briefly." takes=facts source=yangAllison2003 source=alley2013 source=niso2005 source=hyland2000 core.source="hand-core 1"
@k.genres.move.conclude k.genres.move name=conclude about="Say what it all comes to: the point of the text and why it matters." takes=topic source=hyland1990 source=hyland2000 source=niso2005 core.source="hand-core 1"
@k.genres.move.transition k.genres.move name=transition about="Lead from one part to the next (first, next, in conclusion)." takes=outline source=hyland2005 core.source="hand-core 1"
@k.genres.move.state_thesis k.genres.move name="state thesis" about="State the position the text argues for." takes=topic source=hyland1990 source=toulmin1958 core.source="hand-core 1"
@k.genres.move.state_claim k.genres.move name="state claim" about="State one point (a claim, or the assertion of a slide) that the evidence after it supports." takes=fact source=hyland1990 source=toulmin1958 source=alley2013 core.source="hand-core 1"
@k.genres.move.give_evidence k.genres.move name="give evidence" about="Give a fact that supports the claim, with its source." takes=fact source=toulmin1958 source=hyland1990 source=alley2013 core.source="hand-core 1"
@k.genres.move.counterargument k.genres.move name=counterargument about="State fairly a view or a fact against the thesis." takes=fact source=toulmin1958 core.source="hand-core 1"
@k.genres.move.rebut k.genres.move name=rebut about="Answer the counterargument: show where it does not hold." takes=fact source=toulmin1958 core.source="hand-core 1"
@k.genres.move.restate_thesis k.genres.move name="restate thesis" about="Say the thesis again, now as shown by the arguments." takes=topic source=hyland1990 core.source="hand-core 1"
@k.genres.move.state_takeaway k.genres.move name="state takeaway" about="Say in one sentence what to remember from this point." takes=topic source=alley2013 source=alleyNeeley2005 core.source="hand-core 1"
@k.genres.move.thank_audience k.genres.move name="thank audience" about="Thank the listeners." takes=none own="A convention of spoken presentations, not taken from a source." core.source="hand-core 1"
@k.genres.move.invite_questions k.genres.move name="invite questions" about="Invite the listeners to ask questions." takes=none source=alley2013 core.source="hand-core 1"
@k.genres.move.report_action k.genres.move name="report action" about="Say what was done, and when." takes=fact source=niso2005 core.source="hand-core 1"
@k.genres.move.report_problem k.genres.move name="report problem" about="Say what went wrong or held the work up." takes=fact own="Progress reports name problems met; NISO Z39.18 has no part of its own for them." core.source="hand-core 1"
@k.genres.move.next_step k.genres.move name="next step" about="Say what will be done next." takes=question source=niso2005 core.source="hand-core 1"
@k.genres.move.set_the_scene k.genres.move name="set the scene" about="Say where and when the story happens (the setting of the story plan)." takes=story source=labovWaletzky1967 source=freytag1863 source=mandlerJohnson1977 core.source="hand-core 1"
@k.genres.move.introduce_character k.genres.move name="introduce character" about="Bring a character in: who it is and what it is like (the protagonist, later the helper)." takes=story source=labovWaletzky1967 source=steinGlenn1979 core.source="hand-core 1"
@k.genres.move.state_goal k.genres.move name="state goal" about="Say what the protagonist wants or must do." takes=story source=steinGlenn1979 source=mandlerJohnson1977 core.source="hand-core 1"
@k.genres.move.complicate k.genres.move name=complicate about="Bring in what stands in the way of the goal (the obstacle)." takes=story source=labovWaletzky1967 source=freytag1863 core.source="hand-core 1"
@k.genres.move.attempt k.genres.move name=attempt about="Tell one try of the protagonist to reach the goal, and how it turned out." takes=story source=mandlerJohnson1977 source=steinGlenn1979 core.source="hand-core 1"
@k.genres.move.turning_point k.genres.move name="turning point" about="Tell the moment the story turns: the helper's gift or the thing set up earlier comes into use." takes=story source=freytag1863 core.source="hand-core 1"
@k.genres.move.resolve k.genres.move name=resolve about="Tell how the obstacle is overcome and the goal reached." takes=story source=labovWaletzky1967 source=freytag1863 source=mandlerJohnson1977 core.source="hand-core 1"
@k.genres.move.evaluate k.genres.move name=evaluate about="Say why the events matter: what a character feels, or what was at stake." takes=story source=labovWaletzky1967 core.source="hand-core 1"
@k.genres.move.end k.genres.move name=end about="Close the story: the state after the goal, a return to the start, or what was learnt." takes=story source=labovWaletzky1967 source=mandlerJohnson1977 core.source="hand-core 1"
