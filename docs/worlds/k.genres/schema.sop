# k.genres: document types (genres) as structure, rhetorical moves and register, from genre analysis and writing
# guides: a scientific article (IMRaD; the moves of an introduction after Swales' CARS), a presentation (title,
# agenda, one assertion per slide with its evidence, summary), an essay (thesis, arguments with evidence, a
# counterargument and its answer, conclusion; Hyland's stages), a story (orientation, complication, climax,
# resolution, coda; Labov and Waletzky, Freytag; the elements and their constraints are k.story's) and a report
# (summary, what was done and when, results, problems, next steps; ANSI/NISO Z39.18).
# A genre is a sequence of parts (in order, each with how many times it occurs), each part a sequence of steps (in
# order, each one rhetorical move or a choice among several, with how many sentences make it), and a register (how
# it is written: person, tense, voice, sentence length, vocabulary band, what it allows). Read by the library's
# std.compose: a composition is the plan of the genre's procedure in k.procedures, laid out by these parts and
# moves, realised in the register (the language world's templates per move and register).
# The structures and the directions of the register come from the sources (k.genres.source, WORLD.md); the numbers
# (sentence lengths, counts) are this repository's own choice within what the sources say, marked by `own`.
# sources: hand-core 1 (the schema and the facts, hand-written in this repository; the works cited are in WORLD.md)
# license: CC0-1.0
# script: none (hand-written); the shards are written by tools/genres-core.mjs

@k.genres core.module name=k.genres version=1 exports=source exports=move exports=register exports=genre exports=part exports=step core.source="hand-core 1"

# A published work a fact rests on: `name` a short id (author and year: swales1990), `cite` the reference, `year`
# of publication, `doi` where it has one, `finding` what this world takes from it, in one sentence.
@k.genres.source core.type of=k.genres.source shared=true closed=true core.source="hand-core 1"
@k.genres.source.name core.slot of=k.genres.source key=name id=true required=true kind=atom core.source="hand-core 1"
@k.genres.source.cite core.slot of=k.genres.source key=cite required=true kind=string core.source="hand-core 1"
@k.genres.source.year core.slot of=k.genres.source key=year required=true kind=integer min=-400 max=2100 core.source="hand-core 1"
@k.genres.source.doi core.slot of=k.genres.source key=doi kind=string core.source="hand-core 1"
@k.genres.source.finding core.slot of=k.genres.source key=finding required=true kind=string core.source="hand-core 1"

# A rhetorical move: what one sentence (or a few) does for the reader ("indicate a gap", "give an example", "state
# the goal"). The same names are the moves of w.document sentences and of the language world's discourse templates.
# `takes` what a composer fills it with: `fact` (a fact of the catalog), `facts` (two or more facts, compared or
# listed), `outline` (the names of the parts that follow), `question` (a question the catalog can answer), `story`
# (an element of the story plan, k.story), `topic` (the topic itself), `none` (formulaic: thanks, an invitation to
# ask); `about` in plain words; `source` (many) the works that name it; `own` where it is this repository's choice.
@k.genres.move core.type of=k.genres.move shared=true closed=true core.source="hand-core 1"
@k.genres.move.name core.slot of=k.genres.move key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.genres.move.about core.slot of=k.genres.move key=about required=true kind=string core.source="hand-core 1"
@k.genres.move.takes core.slot of=k.genres.move key=takes required=true enum=fact enum=facts enum=outline enum=question enum=story enum=topic enum=none core.source="hand-core 1"
@k.genres.move.source core.slot of=k.genres.move key=source many=true kind=atom type=k.genres.source by=name core.source="hand-core 1"
@k.genres.move.own core.slot of=k.genres.move key=own kind=string core.source="hand-core 1"

# A register: how a genre is written. `person` the grammatical person the writer takes by default ("first plural":
# we), `person_also` (many) the others it allows; `tense` the default tense (a part or a step may say another);
# `passive` whether the passive voice is allowed (active is preferred in every register); `sentence_min`,
# `sentence_typical`, `sentence_max` sentence length in words; `paragraph_min`, `paragraph_max` sentences per
# paragraph (or per slide); `vocabulary_band` the rarest word frequency band the reader is expected to know (1 the
# most frequent words, 5 rare and technical; the band of a word is k.words'); `formality`; and what it allows:
# `contractions` (don't), `hedging` (may, suggest), `citations` (a source for a claim), `units` (numbers with their
# units), `definitions` (a term defined at first use), `direct_speech` (a character's words in quotes),
# `questions` (questions to the reader). `source` (many); `own` what is this repository's choice.
@k.genres.register core.type of=k.genres.register shared=true closed=true core.source="hand-core 1"
@k.genres.register.name core.slot of=k.genres.register key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.genres.register.about core.slot of=k.genres.register key=about required=true kind=string core.source="hand-core 1"
@k.genres.register.person core.slot of=k.genres.register key=person required=true enum="first singular" enum="first plural" enum=second enum=third core.source="hand-core 1"
@k.genres.register.person_also core.slot of=k.genres.register key=person_also many=true enum="first singular" enum="first plural" enum=second enum=third core.source="hand-core 1"
@k.genres.register.tense core.slot of=k.genres.register key=tense required=true enum=present enum=past enum=future core.source="hand-core 1"
@k.genres.register.passive core.slot of=k.genres.register key=passive required=true kind=boolean core.source="hand-core 1"
@k.genres.register.sentence_min core.slot of=k.genres.register key=sentence_min required=true kind=integer min=1 max=100 core.source="hand-core 1"
@k.genres.register.sentence_typical core.slot of=k.genres.register key=sentence_typical required=true kind=integer min=1 max=100 core.source="hand-core 1"
@k.genres.register.sentence_max core.slot of=k.genres.register key=sentence_max required=true kind=integer min=1 max=100 core.source="hand-core 1"
@k.genres.register.paragraph_min core.slot of=k.genres.register key=paragraph_min required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.register.paragraph_max core.slot of=k.genres.register key=paragraph_max required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.register.vocabulary_band core.slot of=k.genres.register key=vocabulary_band required=true kind=integer min=1 max=5 core.source="hand-core 1"
@k.genres.register.formality core.slot of=k.genres.register key=formality required=true enum=formal enum=neutral enum=informal core.source="hand-core 1"
@k.genres.register.contractions core.slot of=k.genres.register key=contractions required=true kind=boolean core.source="hand-core 1"
@k.genres.register.hedging core.slot of=k.genres.register key=hedging required=true kind=boolean core.source="hand-core 1"
@k.genres.register.citations core.slot of=k.genres.register key=citations required=true kind=boolean core.source="hand-core 1"
@k.genres.register.units core.slot of=k.genres.register key=units required=true kind=boolean core.source="hand-core 1"
@k.genres.register.definitions core.slot of=k.genres.register key=definitions required=true kind=boolean core.source="hand-core 1"
@k.genres.register.direct_speech core.slot of=k.genres.register key=direct_speech required=true kind=boolean core.source="hand-core 1"
@k.genres.register.questions core.slot of=k.genres.register key=questions required=true kind=boolean core.source="hand-core 1"
@k.genres.register.source core.slot of=k.genres.register key=source many=true kind=atom type=k.genres.source by=name core.source="hand-core 1"
@k.genres.register.own core.slot of=k.genres.register key=own required=true kind=string core.source="hand-core 1"

# A genre (a document type). `register` names its register; `unit` the w.document kind its parts are written as
# (chapter, or slide for a presentation); `also_move` (many) moves allowed anywhere in it beyond its steps (a
# transition, a definition, an example); `about`; `source` (many); `own`.
@k.genres.genre core.type of=k.genres.genre shared=true closed=true core.source="hand-core 1"
@k.genres.genre.name core.slot of=k.genres.genre key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.genres.genre.about core.slot of=k.genres.genre key=about required=true kind=string core.source="hand-core 1"
@k.genres.genre.register core.slot of=k.genres.genre key=register required=true kind=atom kind=string type=k.genres.register by=name core.source="hand-core 1"
@k.genres.genre.unit core.slot of=k.genres.genre key=unit required=true enum=chapter enum=slide core.source="hand-core 1"
@k.genres.genre.also_move core.slot of=k.genres.genre key=also_move many=true kind=atom kind=string type=k.genres.move by=name core.source="hand-core 1"
@k.genres.genre.source core.slot of=k.genres.genre key=source many=true kind=atom type=k.genres.source by=name core.source="hand-core 1"
@k.genres.genre.own core.slot of=k.genres.genre key=own kind=string core.source="hand-core 1"

# A part of a genre (a chapter: the introduction of an article, the complication of a story; or a slide). `n` its
# place in the genre, from 1; `min` and `max` how many times it occurs in one document (0: it may be left out; the
# arguments of an essay: 2 to 4); `heading` the conventional heading, where the genre has one ("Methods");
# `layout` for a slide, the w.document slide layout (title, agenda, content, summary, closing); `tense` when it is
# not the register's; `about`; `source` (many); `own`.
@k.genres.part core.type of=k.genres.part shared=true closed=true core.source="hand-core 1"
@k.genres.part.genre core.slot of=k.genres.part key=genre id=true required=true kind=atom kind=string type=k.genres.genre by=name core.source="hand-core 1"
@k.genres.part.name core.slot of=k.genres.part key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.genres.part.n core.slot of=k.genres.part key=n required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.part.min core.slot of=k.genres.part key=min required=true kind=integer min=0 max=50 core.source="hand-core 1"
@k.genres.part.max core.slot of=k.genres.part key=max required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.part.heading core.slot of=k.genres.part key=heading kind=atom kind=string core.source="hand-core 1"
@k.genres.part.layout core.slot of=k.genres.part key=layout enum=title enum=agenda enum=content enum=summary enum=closing core.source="hand-core 1"
@k.genres.part.tense core.slot of=k.genres.part key=tense enum=present enum=past enum=future core.source="hand-core 1"
@k.genres.part.about core.slot of=k.genres.part key=about required=true kind=string core.source="hand-core 1"
@k.genres.part.source core.slot of=k.genres.part key=source many=true kind=atom type=k.genres.source by=name core.source="hand-core 1"
@k.genres.part.own core.slot of=k.genres.part key=own kind=string core.source="hand-core 1"

# A step of a part: at place `n` in the part (from 1), the move `move`, made by `min` to `max` sentences (0: it may
# be left out). Several steps at one place are alternatives: one of them is made there (CARS Move 2: indicate a
# gap, or raise a question, or counter-claim). `stage` names the larger move of the source it belongs to
# ("establishing a territory", Hyland's "thesis stage"); `tense` when it is not the part's or the register's;
# `about`; `source` (many).
@k.genres.step core.type of=k.genres.step shared=true closed=true core.source="hand-core 1"
@k.genres.step.genre core.slot of=k.genres.step key=genre id=true required=true kind=atom kind=string type=k.genres.genre by=name core.source="hand-core 1"
@k.genres.step.part core.slot of=k.genres.step key=part id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.genres.step.n core.slot of=k.genres.step key=n id=true required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.step.move core.slot of=k.genres.step key=move id=true required=true kind=atom kind=string type=k.genres.move by=name core.source="hand-core 1"
@k.genres.step.min core.slot of=k.genres.step key=min required=true kind=integer min=0 max=50 core.source="hand-core 1"
@k.genres.step.max core.slot of=k.genres.step key=max required=true kind=integer min=1 max=50 core.source="hand-core 1"
@k.genres.step.stage core.slot of=k.genres.step key=stage kind=atom kind=string core.source="hand-core 1"
@k.genres.step.tense core.slot of=k.genres.step key=tense enum=present enum=past enum=future core.source="hand-core 1"
@k.genres.step.about core.slot of=k.genres.step key=about kind=string core.source="hand-core 1"
@k.genres.step.source core.slot of=k.genres.step key=source many=true kind=atom type=k.genres.source by=name core.source="hand-core 1"

# Words for the types of this world.
@k.genres.word.genre core.word text=genre text=genres text="document type" text="kind of text" text="type of text" means=k.genres.genre core.source="hand-core 1"
@k.genres.word.move core.word text=move text=moves text="rhetorical move" text="rhetorical moves" means=k.genres.move core.source="hand-core 1"
@k.genres.word.register core.word text=register text=registers text=style text=tone means=k.genres.register core.source="hand-core 1"
@k.genres.word.part core.word text=part text=parts text=section text=sections text=structure means=k.genres.part core.source="hand-core 1"
@k.genres.word.step core.word text=step text=steps means=k.genres.step core.source="hand-core 1"
@k.genres.word.source core.word text=source text=sources text=reference text=references means=k.genres.source core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.genres.word.key.source.cite core.word text=cite means=k.genres.source.cite core.source="hand-core 1"
@k.genres.word.key.source.year core.word text=year means=k.genres.source.year core.source="hand-core 1"
@k.genres.word.key.source.doi core.word text=doi means=k.genres.source.doi core.source="hand-core 1"
@k.genres.word.key.source.finding core.word text=finding means=k.genres.source.finding core.source="hand-core 1"
@k.genres.word.key.move.about core.word text=about means=k.genres.move.about core.source="hand-core 1"
@k.genres.word.key.move.takes core.word text=takes means=k.genres.move.takes core.source="hand-core 1"
@k.genres.word.key.move.source core.word text=source means=k.genres.move.source core.source="hand-core 1"
@k.genres.word.key.move.own core.word text=own means=k.genres.move.own core.source="hand-core 1"
@k.genres.word.key.register.about core.word text=about means=k.genres.register.about core.source="hand-core 1"
@k.genres.word.key.register.person core.word text=person means=k.genres.register.person core.source="hand-core 1"
@k.genres.word.key.register.person_also core.word text="person also" means=k.genres.register.person_also core.source="hand-core 1"
@k.genres.word.key.register.tense core.word text=tense means=k.genres.register.tense core.source="hand-core 1"
@k.genres.word.key.register.passive core.word text=passive means=k.genres.register.passive core.source="hand-core 1"
@k.genres.word.key.register.sentence_min core.word text="sentence min" means=k.genres.register.sentence_min core.source="hand-core 1"
@k.genres.word.key.register.sentence_typical core.word text="sentence typical" means=k.genres.register.sentence_typical core.source="hand-core 1"
@k.genres.word.key.register.sentence_max core.word text="sentence max" means=k.genres.register.sentence_max core.source="hand-core 1"
@k.genres.word.key.register.paragraph_min core.word text="paragraph min" means=k.genres.register.paragraph_min core.source="hand-core 1"
