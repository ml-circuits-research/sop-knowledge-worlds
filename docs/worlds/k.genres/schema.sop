@k.genres.word.key.register.contractions core.word text=contractions means=k.genres.register.contractions core.source="hand-core 1"
@k.genres.word.key.register.hedging core.word text=hedging means=k.genres.register.hedging core.source="hand-core 1"
@k.genres.word.key.register.citations core.word text=citations means=k.genres.register.citations core.source="hand-core 1"
@k.genres.word.key.register.units core.word text=units means=k.genres.register.units core.source="hand-core 1"
@k.genres.word.key.register.definitions core.word text=definitions means=k.genres.register.definitions core.source="hand-core 1"
@k.genres.word.key.register.direct_speech core.word text="direct speech" means=k.genres.register.direct_speech core.source="hand-core 1"
@k.genres.word.key.register.questions core.word text=questions means=k.genres.register.questions core.source="hand-core 1"
@k.genres.word.key.register.source core.word text=source means=k.genres.register.source core.source="hand-core 1"
@k.genres.word.key.register.own core.word text=own means=k.genres.register.own core.source="hand-core 1"
