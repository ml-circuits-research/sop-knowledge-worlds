# k.feelings/shards/feelings: 30 feelings (happy, sad, angry, afraid, surprised, tired, excited, proud, shy, bored, lonely, worried, calm, jealous, disappointed, embarrassed, confused, curious, grateful, hopeful, nervous, ashamed, guilty, disgusted, loved, hurt, frustrated, relieved, homesick, amused): how a face shows them (k.faces expressions and variants), what usually causes them, the opposite, a kind reply; and other words for them.
# sources: hand-core 1 (hand-written in this repository: tools/feelings-core.mjs)
# license: CC0-1.0
# script: tools/feelings-core.mjs

@k.feelings.feeling.happy k.feelings.feeling name=happy tone=pleasant expression=happy caused_by="a present" caused_by="playing with friends" caused_by="good news" opposite=sad reply="I am glad you are happy! What made your day so good?" core.source="hand-core 1"
@k.feelings.feeling.sad k.feelings.feeling name=sad tone=unpleasant expression=sad caused_by="losing something" caused_by="saying goodbye" caused_by="being left out" opposite=happy reply="I am sorry you are sad. Do you want to tell me about it?" core.source="hand-core 1"
@k.feelings.feeling.angry k.feelings.feeling name=angry tone=unpleasant expression=angry caused_by="something unfair" caused_by="being teased" caused_by="a broken toy" opposite=calm reply="It is all right to be angry. Take a deep breath, and tell me what happened." core.source="hand-core 1"
@k.feelings.feeling.afraid k.feelings.feeling name=afraid tone=unpleasant expression=surprised eyebrows=sad caused_by="the dark" caused_by="a loud noise" caused_by="a big dog" opposite=calm reply="I am here with you. What is frightening you?" core.source="hand-core 1"
@k.feelings.feeling.surprised k.feelings.feeling name=surprised tone=neutral expression=surprised caused_by="something unexpected" caused_by="a surprise party" caused_by="a sudden noise" reply="What a surprise! What happened?" core.source="hand-core 1"
@k.feelings.feeling.tired k.feelings.feeling name=tired tone=unpleasant expression=sleepy caused_by="a long day" caused_by="too little sleep" caused_by="running a lot" reply="You have done a lot today. A rest will do you good." core.source="hand-core 1"
@k.feelings.feeling.excited k.feelings.feeling name=excited tone=pleasant expression=happy eyes=large caused_by="a trip tomorrow" caused_by="a birthday" caused_by="a new game" opposite=bored reply="How exciting! Tell me what you are looking forward to." core.source="hand-core 1"
@k.feelings.feeling.proud k.feelings.feeling name=proud tone=pleasant expression=happy mouth=smile caused_by="doing something hard" caused_by="a good drawing" caused_by="helping someone" opposite=ashamed reply="You can be proud of that. Well done!" core.source="hand-core 1"
@k.feelings.feeling.shy k.feelings.feeling name=shy tone=unpleasant mouth=small eyebrows=sad cheeks=blush caused_by="meeting new people" caused_by="speaking in front of others" reply="Take your time. I am happy to wait." core.source="hand-core 1"
@k.feelings.feeling.bored k.feelings.feeling name=bored tone=unpleasant expression=sleepy mouth=neutral caused_by="nothing to do" caused_by="waiting a long time" caused_by="a rainy afternoon" opposite=excited reply="Shall we think of something to do together?" core.source="hand-core 1"
@k.feelings.feeling.lonely k.feelings.feeling name=lonely tone=unpleasant expression=sad caused_by="nobody to play with" caused_by="being far from friends" opposite=loved reply="I am here, and I like talking with you. Who would you like to see?" core.source="hand-core 1"
@k.feelings.feeling.worried k.feelings.feeling name=worried tone=unpleasant mouth=small eyebrows=sad caused_by="a test" caused_by="someone being ill" caused_by="being late" opposite=calm reply="That sounds like a lot on your mind. What worries you most?" core.source="hand-core 1"
@k.feelings.feeling.calm k.feelings.feeling name=calm tone=pleasant mouth=smile eyebrows=straight eyes=closed caused_by="a quiet place" caused_by="a deep breath" caused_by="a story at bedtime" opposite=angry reply="It is good to feel calm. Enjoy the quiet." core.source="hand-core 1"
@k.feelings.feeling.jealous k.feelings.feeling name=jealous tone=unpleasant expression=angry mouth=small caused_by="someone else getting a present" caused_by="a friend playing with another child" reply="It is hard when someone else has what you want. What would you wish for?" core.source="hand-core 1"
@k.feelings.feeling.disappointed k.feelings.feeling name=disappointed tone=unpleasant expression=sad caused_by="a cancelled trip" caused_by="losing a game" caused_by="a broken promise" reply="That is a pity. You were looking forward to it." core.source="hand-core 1"
@k.feelings.feeling.embarrassed k.feelings.feeling name=embarrassed tone=unpleasant mouth=small eyebrows=sad cheeks="round blush" caused_by="a mistake in front of others" caused_by="falling over" reply="That happens to everybody. It will soon be forgotten." core.source="hand-core 1"
@k.feelings.feeling.confused k.feelings.feeling name=confused tone=unpleasant mouth=small eyebrows=raised caused_by="a hard question" caused_by="unclear instructions" reply="Let us go through it slowly, one step at a time." core.source="hand-core 1"
@k.feelings.feeling.curious k.feelings.feeling name=curious tone=pleasant mouth=smile eyebrows=raised eyes=large caused_by="a closed box" caused_by="a new animal" caused_by="a strange noise" reply="Good question! Let us find out together." core.source="hand-core 1"
@k.feelings.feeling.grateful k.feelings.feeling name=grateful tone=pleasant expression=happy mouth=smile caused_by="help from a friend" caused_by="a present" caused_by="a kind word" reply="It is lovely to say thank you. Who helped you?" core.source="hand-core 1"
@k.feelings.feeling.hopeful k.feelings.feeling name=hopeful tone=pleasant mouth=smile eyebrows=raised caused_by="a wish" caused_by="waiting for good news" reply="I hope it comes true. What are you hoping for?" core.source="hand-core 1"
@k.feelings.feeling.nervous k.feelings.feeling name=nervous tone=unpleasant mouth=wide eyebrows=sad caused_by="a first day at school" caused_by="going on stage" opposite=calm reply="Many people feel like that before something new. You can do it." core.source="hand-core 1"
@k.feelings.feeling.ashamed k.feelings.feeling name=ashamed tone=unpleasant expression=sad eyes=closed caused_by="telling a lie" caused_by="breaking a rule" opposite=proud reply="Everybody makes mistakes. Saying sorry can make it better." core.source="hand-core 1"
@k.feelings.feeling.guilty k.feelings.feeling name=guilty tone=unpleasant expression=sad caused_by="hurting someone" caused_by="breaking something and hiding it" reply="You can put it right. What could you do now?" core.source="hand-core 1"
@k.feelings.feeling.disgusted k.feelings.feeling name=disgusted tone=unpleasant mouth="tongue out" eyebrows=angry eyes=narrow caused_by="a bad smell" caused_by="rotten food" reply="Yuck, that is not nice. Let us get away from it." core.source="hand-core 1"
@k.feelings.feeling.loved k.feelings.feeling name=loved tone=pleasant expression=happy cheeks=blush caused_by="a hug" caused_by="a kind word" caused_by="being looked after" opposite=lonely reply="You are loved. That is a warm feeling." core.source="hand-core 1"
@k.feelings.feeling.hurt k.feelings.feeling name=hurt tone=unpleasant expression=sad caused_by="an unkind word" caused_by="being pushed" caused_by="a fall" reply="I am sorry that hurt you. Do you want to tell me what happened?" core.source="hand-core 1"
@k.feelings.feeling.frustrated k.feelings.feeling name=frustrated tone=unpleasant expression=angry caused_by="something that will not work" caused_by="losing again and again" reply="That is annoying. Shall we try another way, or take a short break?" core.source="hand-core 1"
@k.feelings.feeling.relieved k.feelings.feeling name=relieved tone=pleasant mouth=smile eyes=closed caused_by="finding something lost" caused_by="good news after a worry" opposite=worried reply="What a relief! Now you can breathe out." core.source="hand-core 1"
@k.feelings.feeling.homesick k.feelings.feeling name=homesick tone=unpleasant expression=sad caused_by="being away from home" caused_by="a first night away" reply="You miss home. What do you like best there?" core.source="hand-core 1"
@k.feelings.feeling.amused k.feelings.feeling name=amused tone=pleasant expression=happy mouth=grin caused_by="a joke" caused_by="a funny face" caused_by="a clown" reply="That is funny! Tell me the joke." core.source="hand-core 1"

# Words: other words for the feelings, and their nouns.
@k.feelings.word.feeling.happy core.word text=glad text=joyful text=cheerful text=pleased text=joy text=happiness means=happy of=k.feelings.feeling.name core.source="hand-core 1"
