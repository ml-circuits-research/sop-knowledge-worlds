# k.feelings: common feelings: how a face shows them, what usually causes them, the opposite feeling, and a kind
# reply to someone who has the feeling. For an avatar that shows feelings and for talk about them.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

@k.feelings core.module name=k.feelings version=2 exports=feeling core.source="hand-core 1"

# A feeling, named by the adjective for someone who has it (happy, afraid). `tone` says whether it is `pleasant`,
# `unpleasant` or `neutral` to have. How a face shows it: `expression` names the k.faces expression (style `plain`)
# that fits, where one does; `mouth`, `eyebrows`, `eyes` and `cheeks` name the variant of that k.faces slot (style
# `plain`) that shows the feeling: they are put on after the expression, or alone where no expression fits.
# `looks_like` names another feeling that a face shows in the same way: the face cannot tell the two apart (lonely,
# guilty and sad look the same), what caused the feeling does. A feeling without it has a face of its own.
# `caused_by` names things that usually cause the feeling (short phrases; many); `opposite` names the opposite
# feeling, where there is a plain one; `reply` is a kind thing to say to someone who has the feeling. Other words
# for the feeling (scared, glad, the noun fear) are core.word facts.
@k.feelings.feeling core.type of=k.feelings.feeling shared=true closed=true core.source="hand-core 1"
@k.feelings.feeling.name core.slot of=k.feelings.feeling key=name id=true required=true kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.tone core.slot of=k.feelings.feeling key=tone required=true enum=pleasant enum=unpleasant enum=neutral core.source="hand-core 1"
@k.feelings.feeling.expression core.slot of=k.feelings.feeling key=expression kind=atom kind=string type=k.faces.expression by=name core.source="hand-core 1"
@k.feelings.feeling.mouth core.slot of=k.feelings.feeling key=mouth kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.eyebrows core.slot of=k.feelings.feeling key=eyebrows kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.eyes core.slot of=k.feelings.feeling key=eyes kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.cheeks core.slot of=k.feelings.feeling key=cheeks kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.looks_like core.slot of=k.feelings.feeling key=looks_like kind=atom kind=string core.source="hand-core 1"
@k.feelings.feeling.caused_by core.slot of=k.feelings.feeling key=caused_by many=true required=true kind=string core.source="hand-core 1"
@k.feelings.feeling.opposite core.slot of=k.feelings.feeling key=opposite kind=atom kind=string type=k.feelings.feeling by=name core.source="hand-core 1"
@k.feelings.feeling.reply core.slot of=k.feelings.feeling key=reply required=true kind=string core.source="hand-core 1"

# Words for the type and keys of this world.
@k.feelings.word.feeling core.word text=feeling text=feelings text=feel text=feels text=emotion text=emotions text=mood means=k.feelings.feeling core.source="hand-core 1"
@k.feelings.word.caused_by core.word text=cause text=causes text=why text=because means=k.feelings.feeling.caused_by core.source="hand-core 1"
@k.feelings.word.opposite core.word text=opposite means=k.feelings.feeling.opposite core.source="hand-core 1"
@k.feelings.word.reply core.word text=reply text=say text=answer means=k.feelings.feeling.reply core.source="hand-core 1"
@k.feelings.word.looks_like core.word text="looks like" text="same face" text=alike means=k.feelings.feeling.looks_like core.source="hand-core 1"
@k.feelings.word.expression core.word text=expression text=face text=looks means=k.feelings.feeling.expression core.source="hand-core 1"

# Words for the keys, by rule: the name of each key, and everyday words for some (tools/key-words.mjs).
@k.feelings.word.key.feeling.tone core.word text=tone text=good text=bad means=k.feelings.feeling.tone core.source="hand-core 1"
@k.feelings.word.key.feeling.mouth core.word text=mouth means=k.feelings.feeling.mouth core.source="hand-core 1"
@k.feelings.word.key.feeling.eyebrows core.word text=eyebrows means=k.feelings.feeling.eyebrows core.source="hand-core 1"
@k.feelings.word.key.feeling.eyes core.word text=eyes means=k.feelings.feeling.eyes core.source="hand-core 1"
@k.feelings.word.key.feeling.cheeks core.word text=cheeks means=k.feelings.feeling.cheeks core.source="hand-core 1"
@k.feelings.word.key.feeling.caused_by core.word text="caused by" means=k.feelings.feeling.caused_by core.source="hand-core 1"
