# k.values/shards/sets: 19 set words (all, each, both, either, any, some, most, half, none, other, another, random, same, different, alternating, first, last, next, previous): how many of the things meant each picks, and in what manner.
# sources: hand-core 1 (hand-written in this repository: tools/values-core.mjs)
# license: CC0-1.0
# script: tools/values-core.mjs

@k.values.set_word.all k.values.set_word name=all picks=all about="every one of the things meant, taken together" core.source="hand-core 1"
@k.values.set_word.each k.values.set_word name=each picks=all manner="one by one" about="every one of the things meant, taken one at a time" core.source="hand-core 1"
@k.values.set_word.both k.values.set_word name=both picks=two about="the two things meant, together" core.source="hand-core 1"
@k.values.set_word.either k.values.set_word name=either picks=one about="one of the two things meant, no matter which" core.source="hand-core 1"
@k.values.set_word.any k.values.set_word name=any picks=one about="one of the things meant, no matter which" core.source="hand-core 1"
@k.values.set_word.some k.values.set_word name=some picks=some about="a few of the things meant, not all" core.source="hand-core 1"
@k.values.set_word.most k.values.set_word name=most picks=most about="more than half of the things meant" core.source="hand-core 1"
@k.values.set_word.half k.values.set_word name=half picks=half about="one of every two of the things meant" core.source="hand-core 1"
@k.values.set_word.none k.values.set_word name=none picks=none about="not one of the things meant" core.source="hand-core 1"
@k.values.set_word.other k.values.set_word name=other picks=rest about="the things meant that were not named or picked" core.source="hand-core 1"
@k.values.set_word.another k.values.set_word name=another picks=one manner=different about="one more thing, not one already there" core.source="hand-core 1"
@k.values.set_word.random k.values.set_word name=random manner=random about="chosen by chance, with no rule" core.source="hand-core 1"
@k.values.set_word.same k.values.set_word name=same manner=same about="equal to one another, or equal to one named before" core.source="hand-core 1"
@k.values.set_word.different k.values.set_word name=different manner=different about="not equal to one another, or not equal to one named before" core.source="hand-core 1"
@k.values.set_word.alternating k.values.set_word name=alternating picks=half manner=alternating about="one yes, the next no, and so on" core.source="hand-core 1"
@k.values.set_word.first k.values.set_word name=first picks=one manner="in order" about="the one at the start of an order" core.source="hand-core 1"
@k.values.set_word.last k.values.set_word name=last picks=one manner="in order" about="the one at the end of an order" core.source="hand-core 1"
@k.values.set_word.next k.values.set_word name=next picks=one manner="in order" about="the one after the present one" core.source="hand-core 1"
@k.values.set_word.previous k.values.set_word name=previous picks=one manner="in order" about="the one before the present one" core.source="hand-core 1"

# Words.
