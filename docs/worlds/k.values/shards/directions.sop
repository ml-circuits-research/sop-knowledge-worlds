# k.values/shards/directions: 18 directions (left, right, up, down, clockwise, north ...) with their opposite and their step in a picture, and 13 positions in a picture (top, bottom left, centre, front ...).
# sources: hand-core 1 (hand-written in this repository: tools/values-core.mjs)
# license: CC0-1.0
# script: tools/values-core.mjs

@k.values.direction.left k.values.direction name=left axis=horizontal x=-1 y=0 opposite=right core.source="hand-core 1"
@k.values.direction.right k.values.direction name=right axis=horizontal x=1 y=0 opposite=left core.source="hand-core 1"
@k.values.direction.up k.values.direction name=up axis=vertical x=0 y=-1 opposite=down core.source="hand-core 1"
@k.values.direction.down k.values.direction name=down axis=vertical x=0 y=1 opposite=up core.source="hand-core 1"
@k.values.direction.forward k.values.direction name=forward axis=depth opposite=backward core.source="hand-core 1"
@k.values.direction.backward k.values.direction name=backward axis=depth opposite=forward core.source="hand-core 1"
@k.values.direction.clockwise k.values.direction name=clockwise axis=turn opposite=anticlockwise core.source="hand-core 1"
@k.values.direction.anticlockwise k.values.direction name=anticlockwise axis=turn opposite=clockwise core.source="hand-core 1"
@k.values.direction.inward k.values.direction name=inward axis=spread opposite=outward core.source="hand-core 1"
@k.values.direction.outward k.values.direction name=outward axis=spread opposite=inward core.source="hand-core 1"
@k.values.direction.north k.values.direction name=north axis=compass x=0 y=-1 opposite=south core.source="hand-core 1"
@k.values.direction.south k.values.direction name=south axis=compass x=0 y=1 opposite=north core.source="hand-core 1"
@k.values.direction.east k.values.direction name=east axis=compass x=1 y=0 opposite=west core.source="hand-core 1"
@k.values.direction.west k.values.direction name=west axis=compass x=-1 y=0 opposite=east core.source="hand-core 1"
@k.values.direction.northeast k.values.direction name=northeast axis=compass x=1 y=-1 opposite=southwest core.source="hand-core 1"
@k.values.direction.northwest k.values.direction name=northwest axis=compass x=-1 y=-1 opposite=southeast core.source="hand-core 1"
@k.values.direction.southeast k.values.direction name=southeast axis=compass x=1 y=1 opposite=northwest core.source="hand-core 1"
@k.values.direction.southwest k.values.direction name=southwest axis=compass x=-1 y=1 opposite=northeast core.source="hand-core 1"

# Words.
@k.values.word.direction.left core.word text=leftward text=leftwards text="to the left" means=left of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.right core.word text=rightward text=rightwards text="to the right" means=right of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.up core.word text=upward text=upwards means=up of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.down core.word text=downward text=downwards means=down of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.forward core.word text=forwards text=ahead text="to the front" means=forward of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.backward core.word text=backwards text=back text="to the back" means=backward of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.anticlockwise core.word text=counterclockwise text=counter-clockwise text=anti-clockwise means=anticlockwise of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.inward core.word text=inwards text="towards the middle" means=inward of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.outward core.word text=outwards text="away from the middle" means=outward of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.north core.word text=northward text=northwards means=north of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.south core.word text=southward text=southwards means=south of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.east core.word text=eastward text=eastwards means=east of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.west core.word text=westward text=westwards means=west of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.northeast core.word text=north-east means=northeast of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.northwest core.word text=north-west means=northwest of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.southeast core.word text=south-east means=southeast of=k.values.direction.name core.source="hand-core 1"
@k.values.word.direction.southwest core.word text=south-west means=southwest of=k.values.direction.name core.source="hand-core 1"

# Positions in a picture.
@k.values.position.top k.values.position name=top row=top core.source="hand-core 1"
@k.values.position.bottom k.values.position name=bottom row=bottom core.source="hand-core 1"
@k.values.position.left k.values.position name=left column=left core.source="hand-core 1"
@k.values.position.right k.values.position name=right column=right core.source="hand-core 1"
@k.values.position.centre k.values.position name=centre column=centre row=middle core.source="hand-core 1"
@k.values.position.top_left k.values.position name="top left" column=left row=top core.source="hand-core 1"
@k.values.position.top_right k.values.position name="top right" column=right row=top core.source="hand-core 1"
@k.values.position.bottom_left k.values.position name="bottom left" column=left row=bottom core.source="hand-core 1"
@k.values.position.bottom_right k.values.position name="bottom right" column=right row=bottom core.source="hand-core 1"
@k.values.position.top_centre k.values.position name="top centre" column=centre row=top core.source="hand-core 1"
@k.values.position.bottom_centre k.values.position name="bottom centre" column=centre row=bottom core.source="hand-core 1"
@k.values.position.front k.values.position name=front depth=front core.source="hand-core 1"
@k.values.position.back k.values.position name=back depth=back core.source="hand-core 1"

# Words.
@k.values.word.position.top core.word text="upper part" text="at the top" means=top of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.bottom core.word text="lower part" text="at the bottom" means=bottom of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.left core.word text="left side" text="on the left" text="left-hand side" means=left of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.right core.word text="right side" text="on the right" text="right-hand side" means=right of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.centre core.word text=center text=middle text="in the middle" text="in the centre" text="in the center" means=centre of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.top_left core.word text="upper left" text="top left corner" text=top-left means="top left" of=k.values.position.name core.source="hand-core 1"
