@k.values.word.position.top_centre core.word text="top center" text="top middle" means="top centre" of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.bottom_centre core.word text="bottom center" text="bottom middle" means="bottom centre" of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.front core.word text=foreground text="in front" text="in the foreground" means=front of=k.values.position.name core.source="hand-core 1"
@k.values.word.position.back core.word text=background text="at the back" text="in the background" means=back of=k.values.position.name core.source="hand-core 1"
