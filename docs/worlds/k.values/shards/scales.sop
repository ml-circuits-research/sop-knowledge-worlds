# k.values/shards/scales: 13 ordered scales (size, length, width, height, thickness, amount, degree, brightness, speed, weight, temperature, distance, loudness): the steps of each from the least to the most, other words for a step, and the comparatives and superlatives that move along a scale (bigger, smallest).
# sources: hand-core 1 (hand-written in this repository: tools/values-core.mjs)
# license: CC0-1.0
# script: tools/values-core.mjs

@k.values.scale.size k.values.scale name=size about="how big a thing is" steps=5 core.source="hand-core 1"
@k.values.step.size.tiny k.values.step scale=size name=tiny rank=1 core.source="hand-core 1"
@k.values.step.size.small k.values.step scale=size name=small rank=2 core.source="hand-core 1"
