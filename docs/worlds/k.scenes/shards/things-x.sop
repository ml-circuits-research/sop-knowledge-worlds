# script: tools/scenes-core.mjs

@k.scenes.thing.x-ray k.scenes.thing name=x-ray place=indoors size=small named=model core.source="hand-core 1"
@k.scenes.thing.xray k.scenes.thing name=xray place=indoors size=small named=model core.source="hand-core 1"
@k.scenes.thing.xylophone k.scenes.thing name=xylophone place=indoors size=small named=model core.source="hand-core 1"
