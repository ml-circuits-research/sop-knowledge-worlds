@k.scenes.has.beach.sun_lounger k.scenes.has scene=beach thing="sun lounger" count=2 where=ground drawing="sun lounger" core.source="hand-core 1"
@k.scenes.has.beach.beach_ball k.scenes.has scene=beach thing="beach ball" count=1 where=ground drawing="ball beach" core.source="hand-core 1"
@k.scenes.has.beach.sandcastle k.scenes.has scene=beach thing=sandcastle count=1 where=ground side=centre drawing=sandcastle core.source="hand-core 1"
@k.scenes.has.beach.bucket k.scenes.has scene=beach thing=bucket count=1 where=ground drawing=bucket core.source="hand-core 1"
@k.scenes.has.beach.spade k.scenes.has scene=beach thing=spade count=1 where=ground drawing=spade core.source="hand-core 1"
@k.scenes.has.beach.person k.scenes.has scene=beach thing=person count=3 where=ground drawing=person core.source="hand-core 1"
