# k.scenes/shards/scenes-nature: 19 scenes in nature and the countryside (beach, farm, forest, mountains, meadow, river, lake, pond, desert, jungle, savanna, arctic, island, garden, park, orchard, campsite, field, picnic): what is usually there, how many, where in the picture, what happens there, the time, weather and season that fit; and other names of the scenes.
# sources: hand-core 1 (hand-written in this repository: tools/scenes-data.mjs)
# license: CC0-1.0
# script: tools/scenes-core.mjs

# beach
@k.scenes.scene.beach k.scenes.scene name=beach kind=outdoors ground=sand time=day weather=sunny season=summer happens=swim happens=sunbathe happens="build sandcastles" happens="play ball" happens="collect shells" drawing=beach core.source="hand-core 1"
@k.scenes.has.beach.sun k.scenes.has scene=beach thing=sun count=1 where=sky side=right drawing=sun core.source="hand-core 1"
@k.scenes.has.beach.cloud k.scenes.has scene=beach thing=cloud count=2 where=sky drawing=cloud core.source="hand-core 1"
@k.scenes.has.beach.seagull k.scenes.has scene=beach thing=seagull count=3 where=sky drawing=seagull core.source="hand-core 1"
@k.scenes.has.beach.sea k.scenes.has scene=beach thing=sea count=1 where=background fills=true drawing=sea core.source="hand-core 1"
@k.scenes.has.beach.sailboat k.scenes.has scene=beach thing=sailboat count=1 where=water on=sea drawing=sailboat core.source="hand-core 1"
@k.scenes.has.beach.palm_tree k.scenes.has scene=beach thing="palm tree" count=2 where=ground side=left drawing="palm tree" core.source="hand-core 1"
@k.scenes.has.beach.beach_umbrella k.scenes.has scene=beach thing="beach umbrella" count=2 where=ground drawing="umbrella on ground" core.source="hand-core 1"
