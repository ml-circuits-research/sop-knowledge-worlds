# k.scenes/shards/scenes-town: 15 scenes in a town and places people build (city street, village, playground, market, harbour, airport, railway station, construction site, petrol station, zoo, fairground, football pitch, swimming pool, circus, castle): what is usually there, how many, where in the picture, what happens there, the time, weather and season that fit; and other names of the scenes.
# sources: hand-core 1 (hand-written in this repository: tools/scenes-data.mjs)
# license: CC0-1.0
# script: tools/scenes-core.mjs

# city street
@k.scenes.scene.city_street k.scenes.scene name="city street" kind=outdoors ground=road time=day happens=drive happens="cross the road" happens=shop happens="wait for the bus" drawing=street core.source="hand-core 1"
@k.scenes.has.city_street.sun k.scenes.has scene="city street" thing=sun count=1 where=sky drawing=sun core.source="hand-core 1"
@k.scenes.has.city_street.cloud k.scenes.has scene="city street" thing=cloud count=2 where=sky drawing=cloud core.source="hand-core 1"
@k.scenes.has.city_street.pigeon k.scenes.has scene="city street" thing=pigeon count=3 where=sky drawing=pigeon core.source="hand-core 1"
@k.scenes.has.city_street.building k.scenes.has scene="city street" thing=building count=5 where=background drawing="office building" core.source="hand-core 1"
@k.scenes.has.city_street.shop k.scenes.has scene="city street" thing=shop count=3 where=background drawing=shop core.source="hand-core 1"
@k.scenes.has.city_street.road k.scenes.has scene="city street" thing=road count=1 where=ground side=centre fills=true drawing=road core.source="hand-core 1"
@k.scenes.has.city_street.sidewalk k.scenes.has scene="city street" thing=sidewalk count=2 where=ground drawing=sidewalk core.source="hand-core 1"
@k.scenes.has.city_street.car k.scenes.has scene="city street" thing=car count=4 where=ground drawing=car core.source="hand-core 1"
@k.scenes.has.city_street.bus k.scenes.has scene="city street" thing=bus count=1 where=ground drawing=bus core.source="hand-core 1"
@k.scenes.has.city_street.taxi k.scenes.has scene="city street" thing=taxi count=1 where=ground drawing=taxi core.source="hand-core 1"
@k.scenes.has.city_street.bicycle k.scenes.has scene="city street" thing=bicycle count=1 where=ground drawing=bicycle core.source="hand-core 1"
@k.scenes.has.city_street.truck k.scenes.has scene="city street" thing=truck count=1 where=ground drawing=truck core.source="hand-core 1"
@k.scenes.has.city_street.traffic_light k.scenes.has scene="city street" thing="traffic light" count=2 where=ground drawing="vertical traffic light" core.source="hand-core 1"
@k.scenes.has.city_street.street_lamp k.scenes.has scene="city street" thing="street lamp" count=4 where=ground core.source="hand-core 1"
@k.scenes.has.city_street.bus_stop k.scenes.has scene="city street" thing="bus stop" count=1 where=ground drawing="bus stop" core.source="hand-core 1"
