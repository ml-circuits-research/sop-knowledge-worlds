#!/bin/bash
# Refuses a push when the generated files are not what the build gives (block "Reviewer 2026-11-15 18:45"): after a
# plain `git rebase`, the merge driver `regenerate` keeps main's index.json, vocab.json, LICENSES.md and counts, which
# are then stale for the commits on top. Installed for every clone by tools/sync.sh (`git config core.hooksPath
# tools/hooks`). Fix: `npm run regenerate` (or tools/sync.sh), commit, push again. `git push --no-verify` skips it.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! npm run --silent check-generated >&2; then
  echo "pre-push: the generated files are stale (see above): run npm run regenerate or tools/sync.sh, commit, push again" >&2
  exit 1
fi
